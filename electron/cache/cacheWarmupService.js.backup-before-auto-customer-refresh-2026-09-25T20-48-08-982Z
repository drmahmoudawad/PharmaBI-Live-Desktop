function getActiveSavedConnections() {

    const activeBranchIds =
        new Set(
            getActiveBranchConnections()
        );

    return getAllSavedConnections()
        .filter(
            branch =>
                activeBranchIds.has(
                    normalizeBranchId(
                        branch?.branchId
                    )
                )
        );

}

const DEFAULT_MONTHS =
    null;


const DEFAULT_DELAY_MS =
    750;


const DEFAULT_MAX_RETRIES =
    2;


const YIELD_DELAY_MS =
    75;


/*
 * =========================================================
 * STATE
 * =========================================================
 */

const warmupState =
    new Map();


/*
 * =========================================================
 * ROUND-ROBIN ENGINE
 * =========================================================
 *
 * Only ONE warm-up worker is allowed.
 *
 * A newly added branch can be inserted into the running
 * engine through refreshWarmupQueue().
 *
 * The existing warm-up keeps running.
 * =========================================================
 */

let roundRobinEngine =
    null;

/*
 * =========================================================
 * SHARED MONTH SINGLE-FLIGHT
 * =========================================================
 */

const WARMUP_BRANCH_CONCURRENCY =
    3;

const activeMonthWork =
    new Map();

function getCurrentUtcMonth() {

    const now =
        new Date();

    return [
        now.getUTCFullYear(),
        String(now.getUTCMonth() + 1).padStart(2, "0")
    ].join("-");

}

function monthWorkKey({ branchId, month }) {

    return String(
        normalizeBranchId(branchId)
    ) + "|" + String(month);

}

function runMonthOnce({ branchId, month }, task) {

    const key =
        monthWorkKey({ branchId, month });

    const existing =
        activeMonthWork.get(key);

    if (existing) {

        console.log(
            "[cacheWarmup] SINGLE-FLIGHT JOIN branch=" +
            String(branchId) +
            " month=" +
            String(month)
        );

        return existing.promise;

    }

    const promise =
        Promise.resolve()
            .then(() => task())
            .finally(() => {

                if (
                    activeMonthWork.get(key)?.promise ===
                    promise
                ) {

                    activeMonthWork.delete(key);

                }

            });

    activeMonthWork.set(
        key,
        { promise }
    );

    return promise;

}

function warmMonthOnce(args) {

    return runMonthOnce(
        {
            branchId: args.branchId,
            month: args.month
        },
        () => warmMonth(args)
    );

}




/*
 * =========================================================
 * HELPERS
 * =========================================================
 */

function normalizeBranchId(
    branchId
) {

    const id =
        Number(
            branchId
        );


    if (
        !Number.isInteger(
            id
        ) ||
        id <= 0
    ) {

        throw new Error(
            "Invalid branchId"
        );

    }


    return id;

}


function sleep(
    ms
) {

    return new Promise(

        resolve => {

            setTimeout(

                resolve,

                Math.max(
                    0,
                    Number(ms) || 0
                )

            );

        }

    );

}


function yieldToEventLoop() {

    return new Promise(

        resolve => {

            setImmediate(
                resolve
            );

        }

    );

}


function pad2(
    value
) {

    return String(
        value
    ).padStart(
        2,
        "0"
    );

}


function toYearMonth(
    value
) {

    if (
        !value
    ) {

        return null;

    }


    const date =
        new Date(
            value
        );


    if (
        Number.isNaN(
            date.getTime()
        )
    ) {

        return null;

    }


    return [

        date.getUTCFullYear(),

        pad2(
            date.getUTCMonth() + 1
        )

    ].join(
        "-"
    );

}


/*
 * =========================================================
 * BUILD FULL HISTORICAL MONTH LIST
 * =========================================================
 */

function buildHistoricalMonthList(
    {
        newestMonth,
        oldestMonth
    }
) {

    const newest =
        String(
            newestMonth ||
            ""
        );


    const oldest =
        String(
            oldestMonth ||
            ""
        );


    if (
        !/^\d{4}-\d{2}$/.test(
            newest
        ) ||
        !/^\d{4}-\d{2}$/.test(
            oldest
        )
    ) {

        throw new Error(
            "Invalid historical month range"
        );

    }


    const [
        newestYear,
        newestMonthNumber
    ] =
        newest
            .split(
                "-"
            )
            .map(
                Number
            );


    const [
        oldestYear,
        oldestMonthNumber
    ] =
        oldest
            .split(
                "-"
            )
            .map(
                Number
            );


    const monthCount =
        (
            newestYear -
            oldestYear
        ) *
        12 +
        (
            newestMonthNumber -
            oldestMonthNumber
        ) +
        1;


    if (
        monthCount <= 0
    ) {

        throw new Error(
            "Historical month count is invalid"
        );

    }


    const result =
        [];


    for (
        let index = 0;
        index < monthCount;
        index += 1
    ) {

        const date =
            new Date(

                Date.UTC(

                    newestYear,

                    (
                        newestMonthNumber - 1
                    ) -
                    index,

                    1

                )

            );


        result.push(

            [

                date.getUTCFullYear(),

                pad2(
                    date.getUTCMonth() + 1
                )

            ].join(
                "-"
            )

        );

    }


    return result;

}


/*
 * =========================================================
 * STATE
 * =========================================================
 */

function getState(
    branchId
) {

    const id =
        normalizeBranchId(
            branchId
        );


    if (
        !warmupState.has(
            id
        )
    ) {

        warmupState.set(

            id,

            {

                running:
                    false,

                startedAt:
                    null,

                finishedAt:
                    null,

                currentMonth:
                    null,

                oldestMonth:
                    null,

                newestMonth:
                    null,

                completedMonths:
                    0,

                skippedMonths:
                    0,

                failedMonths:
                    0,

                totalMonths:
                    0,

                totalHistoricalRows:
                    0,

                localRows:
                    0,

                error:
                    null

            }

        );

    }


    return warmupState.get(
        id
    );

}


/*
 * =========================================================
 * DISCOVER HISTORY
 * =========================================================
 */

async function getSalesHistoryRange(
    {
        branchId,
        connection
    }
) {

    const id =
        normalizeBranchId(
            branchId
        );


    const savedConnection =
        connection ||
        getBranchConnection(
            id
        );


    if (
        !savedConnection
    ) {

        throw new Error(
            `No saved connection for branch ${id}`
        );

    }


    const pool =
        await getBranchPool(

            id,

            savedConnection

        );


    const result =
        await pool
            .request()
            .query(`

                SET NOCOUNT ON;

                SELECT

                    MIN(ztime)
                        AS min_sale_date,

                    MAX(ztime)
                        AS max_sale_date,

                    COUNT_BIG(*)
                        AS ticket_count

                FROM posTickets

                WHERE
                    ztime IS NOT NULL;

            `);


    const row =
        Array.isArray(
            result.recordset
        )
            ? result.recordset[0]
            : null;


    if (
        !row ||
        !row.min_sale_date ||
        !row.max_sale_date
    ) {

        return {

            hasData:
                false,

            oldestDate:
                null,

            newestDate:
                null,

            oldestMonth:
                null,

            newestMonth:
                null,

            ticketCount:
                0

        };

    }


    const oldestDate =
        new Date(
            row.min_sale_date
        );


    const newestDate =
        new Date(
            row.max_sale_date
        );


    if (
        Number.isNaN(
            oldestDate.getTime()
        ) ||
        Number.isNaN(
            newestDate.getTime()
        )
    ) {

        return {

            hasData:
                false,

            oldestDate:
                null,

            newestDate:
                null,

            oldestMonth:
                null,

            newestMonth:
                null,

            ticketCount:
                0

        };

    }


    return {

        hasData:
            true,

        oldestDate:
            oldestDate.toISOString(),

        newestDate:
            newestDate.toISOString(),

        oldestMonth:
            toYearMonth(
                oldestDate
            ),

        newestMonth:
            toYearMonth(
                newestDate
            ),

        ticketCount:
            Number(
                row.ticket_count
            ) || 0

    };

}


/*
 * =========================================================
 * RESOLVE MONTHS
 * =========================================================
 */

function resolveMonthList(
    {
        historyRange,
        months
    }
) {

    if (
        !historyRange?.hasData
    ) {

        return [];

    }


    const fullList =
        buildHistoricalMonthList({

            newestMonth:
                historyRange.newestMonth,

            oldestMonth:
                historyRange.oldestMonth

        });


    if (
        months === null ||
        months === undefined
    ) {

        return fullList;

    }


    const requested =
        Number(
            months
        );


    if (
        !Number.isFinite(
            requested
        ) ||
        requested <= 0
    ) {

        return fullList;

    }


    return fullList.slice(

        0,

        Math.min(

            Math.floor(
                requested
            ),

            fullList.length

        )

    );

}


/*
 * =========================================================
 * INITIALIZE BRANCH STATE
 * =========================================================
 */

function initializeBranchState(
    branchId,
    historyRange,
    monthsList
) {

    const state =
        getState(
            branchId
        );


    state.running =
        true;


    state.startedAt =
        new Date().toISOString();


    state.finishedAt =
        null;


    state.currentMonth =
        null;


    state.oldestMonth =
        historyRange.oldestMonth;


    state.newestMonth =
        historyRange.newestMonth;


    state.completedMonths =
        0;


    state.skippedMonths =
        0;


    state.failedMonths =
        0;


    state.totalMonths =
        monthsList.length;


    state.totalHistoricalRows =
        0;


    state.localRows =
        0;


    state.error =
        null;


    return state;

}


/*
 * =========================================================
 * WARM ONE MONTH
 * =========================================================
 */

async function warmMonth(
    {
        branchId,
        month,
        connection,
        maxRetries,
        state,
        forceRefresh = false
    }
) {

    /*
     * -----------------------------------------------------
     * LOCAL SQLITE
     * -----------------------------------------------------
     */

    try {

        if (
        !forceRefresh &&
        hasSalesMonth({
            branchId,
            month
        })
    ) {

            const cached =
        forceRefresh
            ? null
            : getMonthlySalesCache({
                branchId,
                month
            });


            const rows =
                cached?.rows;


            const rowCount =
                Array.isArray(
                    rows
                )
                    ? rows.length
                    : 0;


            if (
                rowCount > 0
            ) {

                console.log(

                    `[cacheWarmup] LOCAL SQLITE HIT branch=${branchId} month=${month} rows=${rowCount}`

                );


                return {

                    status:
                        "LOCAL_HIT",

                    month,

                    rowCount

                };

            }


            console.log(

                `[cacheWarmup] LOCAL SQLITE EMPTY branch=${branchId} month=${month} rows=0 -> SQL LOAD REQUIRED`

            );

        }

    }
    catch (
        error
    ) {

        console.error(

            `[cacheWarmup] local sqlite check failed branch=${branchId} month=${month}:`,

            error

        );

    }


    /*
     * -----------------------------------------------------
     * MEMORY / MONTHLY CACHE
     * -----------------------------------------------------
     */

    const cached =
        forceRefresh
            ? null
            : getMonthlySalesCache({
                branchId,
                month
            });


    if (
        cached &&
        Array.isArray(
            cached.rows
        )
    ) {

        try {

            if (
                !hasSalesMonth({

                    branchId,

                    month

                })
            ) {

                const localResult =
                    saveSalesMonth({

                        branchId,

                        month,

                        rows:
                            cached.rows

                    });


                state.localRows +=

                    Number(
                        localResult.processed
                    ) || 0;


                console.log(

                    `[cacheWarmup] SQLITE IMPORT FROM CACHE branch=${branchId} month=${month} rows=${localResult.processed}`

                );

            }

        }
        catch (
            error
        ) {

            console.error(

                `[cacheWarmup] SQLITE import failed branch=${branchId} month=${month}:`,

                error

            );

        }


        console.log(

            `[cacheWarmup] CACHE HIT branch=${branchId} month=${month} rows=${cached.rowCount}`

        );


        return {

            status:
                "CACHE_HIT",

            month,

            rowCount:
                Number(
                    cached.rowCount
                ) ||
                cached.rows.length

        };

    }


    /*
     * -----------------------------------------------------
     * SQL
     * -----------------------------------------------------
     */

    const range =
        getMonthDateRange(
            month
        );


    let lastError =
        null;


    for (
        let attempt = 1;
        attempt <=
        maxRetries + 1;
        attempt += 1
    ) {

        try {

            console.log(

                `[cacheWarmup] LOAD branch=${branchId} month=${month} attempt=${attempt}`

            );


            updateSalesSyncState({

                branchId,

                status:
                    "RUNNING",

                rows:
                    0

            });


            const rows =
                await getSales({

                    branchId,

                    fromDate:
                        range.fromDate,

                    toDate:
                        range.toDate,

                    connection,

                    forceRefresh:
                        Boolean(
                            forceRefresh
                        )

                });


            try {

                const localResult =
                    saveSalesMonth({

                        branchId,

                        month,

                        rows

                    });


                state.localRows +=

                    Number(
                        localResult.processed
                    ) || 0;


                console.log(

                    `[cacheWarmup] SQLITE SAVED branch=${branchId} month=${month} rows=${localResult.processed}`

                );

            }
            catch (
                localError
            ) {

                console.error(

                    `[cacheWarmup] SQLITE SAVE FAILED branch=${branchId} month=${month}:`,

                    localError

                );


                updateSalesSyncState({

                    branchId,

                    status:
                        "ERROR",

                    rows:
                        rows.length,

                    errorMessage:
                        localError?.message ||
                        String(
                            localError
                        )

                });

            }


            console.log(

                `[cacheWarmup] READY branch=${branchId} month=${month} rows=${rows.length}`

            );


            await yieldToEventLoop();


            return {

                status:
                    "LOADED",

                month,

                rowCount:
                    rows.length

            };

        }
        catch (
            error
        ) {

            lastError =
                error;


            console.error(

                `[cacheWarmup] FAILED branch=${branchId} month=${month} attempt=${attempt}:`,

                error

            );


            updateSalesSyncState({

                branchId,

                status:
                    "ERROR",

                rows:
                    state.localRows,

                errorMessage:
                    error?.message ||
                    String(
                        error
                    )

            });


            if (
                attempt <=
                maxRetries
            ) {

                await sleep(

                    1000 *
                    attempt

                );


                await yieldToEventLoop();

            }

        }

    }


    throw lastError ||
        new Error(
            `Failed to warm month ${month}`
        );

}


/*
 * =========================================================
 * DISCOVER AND ADD BRANCH TO RUNNING ENGINE
 * =========================================================
 */

async function buildBranchPlan(
    {
        branchId,
        connection,
        months,
        resetState = true
    }
) {

    const id =
        normalizeBranchId(
            branchId
        );


    const savedConnection =
        connection ||
        getBranchConnection(
            id
        );


    if (
        !savedConnection
    ) {

        throw new Error(
            `No saved connection for branch ${id}`
        );

    }


    console.log(

        `[cacheWarmup] DISCOVER HISTORY branch=${id}`

    );


    const historyRange =
        await getSalesHistoryRange({

            branchId:
                id,

            connection:
                savedConnection

        });


    if (
        !historyRange.hasData
    ) {

        console.log(

            `[cacheWarmup] NO SALES DATA branch=${id}`

        );


        return null;

    }


    const monthsList =
        resolveMonthList({

            historyRange,

            months

        });


    const state =
        resetState

            ? initializeBranchState(

                id,

                historyRange,

                monthsList

            )

            : getState(
                id
            );


    return {

        branchId:
            id,

        branch:
            savedConnection,

        historyRange,

        monthsList,

        state,

        nextMonthIndex:
            0,

        addedDynamically:
            false

    };

}


/*
 * =========================================================
 * PROCESS BRANCH MONTH
 * =========================================================
 */

async function processPlanMonth(
    {
        plan,
        month,
        delayMs,
        maxRetries,
        forceRefresh = false
    }
) {

    const {
        branchId,
        branch,
        state
    } = plan;

    state.currentMonth =
        month;

    if (
        !forceRefresh &&
        month === getCurrentUtcMonth()
    ) {

        state.skippedMonths +=
            1;

        state.currentMonth =
            null;

        console.log(
            "[cacheWarmup] CURRENT MONTH EXCLUDED FROM HISTORICAL WARM-UP branch=" +
            String(branchId) +
            " month=" +
            String(month)
        );

        return;

    }

    await sleep(
        delayMs
    );

    await yieldToEventLoop();

    try {

        const result =
            await warmMonthOnce({

                branchId,
                month,
                connection: branch,
                maxRetries,
                state,
                forceRefresh

            });

        if (
            result.status === "LOCAL_HIT" ||
            result.status === "CACHE_HIT"
        ) {

            state.skippedMonths +=
                1;

        }
        else {

            state.completedMonths +=
                1;

        }

        state.totalHistoricalRows +=
            Number(result.rowCount) || 0;

    }
    catch (
        error
    ) {

        state.failedMonths +=
            1;

        state.error =
            error?.message || String(error);

        console.error(
            "[cacheWarmup] ROUND FAILED branch=" +
            String(branchId) +
            " month=" +
            String(month) + ":",
            error
        );

        updateSalesSyncState({
            branchId,
            status: "ERROR",
            rows: state.localRows,
            errorMessage: state.error
        });

    }

    await yieldToEventLoop();

    await sleep(
        YIELD_DELAY_MS
    );

}

/*
 * =========================================================
 * FINALIZE BRANCH
 * =========================================================
 */

function finalizePlan(
    plan
) {

    const {
        branchId,
        state
    } =
        plan;


    state.running =
        false;


    state.currentMonth =
        null;


    state.finishedAt =
        new Date().toISOString();


    if (
        state.failedMonths ===
        0
    ) {

        updateSalesSyncState({

            branchId,

            status:
                "READY",

            rows:
                state.localRows

        });

    }
    else {

        updateSalesSyncState({

            branchId,

            status:
                "ERROR",

            rows:
                state.localRows,

            errorMessage:
                state.error ||
                `${state.failedMonths} month(s) failed`

        });

    }


    console.log(

        `[cacheWarmup] COMPLETE branch=${branchId} loaded=${state.completedMonths} skipped=${state.skippedMonths} failed=${state.failedMonths} rows=${state.totalHistoricalRows} localRows=${state.localRows}`

    );

}


/*
 * =========================================================
 * ROUND-ROBIN WORKER
 * =========================================================
 */

async function runRoundRobinEngine(engine) {

    const queue = [];
    const queuedBranchIds = new Set();

    function enqueue(plan) {

        if (!plan) {
            return;
        }

        if (
            plan.nextMonthIndex >=
            plan.monthsList.length
        ) {
            return;
        }

        if (
            queuedBranchIds.has(plan.branchId)
        ) {
            return;
        }

        queuedBranchIds.add(
            plan.branchId
        );

        queue.push(
            plan
        );

    }

    function drainPendingBranches() {

        if (
            engine.pendingBranches.length ===
            0
        ) {
            return;
        }

        const pending =
            engine.pendingBranches.splice(
                0,
                engine.pendingBranches.length
            );

        for (
            const plan
            of pending
        ) {

            if (
                engine.branchPlans.has(
                    plan.branchId
                )
            ) {
                continue;
            }

            plan.addedDynamically =
                true;

            plan.nextMonthIndex =
                0;

            engine.branchPlans.set(
                plan.branchId,
                plan
            );

            console.log(
                "[cacheWarmup] QUEUE REFRESH ADDED branch=" +
                String(plan.branchId) +
                " newest=" +
                String(plan.monthsList[0] || "N/A") +
                " months=" +
                String(plan.monthsList.length)
            );

            enqueue(
                plan
            );

        }

    }

    for (
        const plan
        of engine.branchPlans.values()
    ) {

        enqueue(
            plan
        );

    }

    async function worker(
        workerId
    ) {

        while (
            true
        ) {

            drainPendingBranches();

            const plan =
                queue.shift();

            if (!plan) {

                const remaining =
                    engine.pendingBranches.length > 0 ||
                    Array.from(
                        engine.branchPlans.values()
                    ).some(
                        current =>
                            current.nextMonthIndex <
                            current.monthsList.length
                    );

                if (!remaining) {
                    return;
                }

                await yieldToEventLoop();
                continue;

            }

            queuedBranchIds.delete(
                plan.branchId
            );

            if (
                plan.nextMonthIndex >=
                plan.monthsList.length
            ) {
                continue;
            }

            const month =
                plan.monthsList[
                    plan.nextMonthIndex
                ];

            console.log(
                "[cacheWarmup] WORKER=" +
                String(workerId) +
                " branch=" +
                String(plan.branchId) +
                " month=" +
                String(month)
            );

            try {

                await processPlanMonth({
                    plan,
                    month,
                    delayMs: engine.delayMs,
                    maxRetries: engine.maxRetries
                });

            }
            catch (
                error
            ) {

                console.error(
                    "[cacheWarmup] UNEXPECTED WORKER FAILURE branch=" +
                    String(plan.branchId) +
                    " month=" +
                    String(month) + ":",
                    error
                );

            }

            plan.nextMonthIndex +=
                1;

            if (
                plan.nextMonthIndex <
                plan.monthsList.length
            ) {

                enqueue(
                    plan
                );

            }

            await yieldToEventLoop();

        }

    }

    const workerCount =
        Math.min(
            WARMUP_BRANCH_CONCURRENCY,
            Math.max(
                1,
                engine.branchPlans.size
            )
        );

    console.log(
        "[cacheWarmup] BOUNDED WORKERS count=" +
        String(workerCount)
    );

    await Promise.all(
        Array.from(
            {
                length: workerCount
            },
            (_, index) =>
                worker(
                    index + 1
                )
        )
    );

    for (
        const plan
        of engine.branchPlans.values()
    ) {

        if (
            plan.nextMonthIndex >=
            plan.monthsList.length
        ) {

            finalizePlan(
                plan
            );

        }

    }

    engine.running =
        false;

    roundRobinEngine =
        null;

    console.log(
        "[cacheWarmup] BOUNDED PARALLEL FULL HISTORY WARM-UP COMPLETE."
    );

}

