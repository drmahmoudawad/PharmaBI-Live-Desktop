let currentMonthRefreshPromise =
    null;


/*
 * =========================================================
 * REFRESH CURRENT MONTH FOR ALL BRANCHES
 * =========================================================
 */

export async function refreshCurrentMonthAllBranches(
    {
        maxRetries = DEFAULT_MAX_RETRIES
    } = {}
) {

    if (
        currentMonthRefreshPromise
    ) {

        console.log(
            "[cacheWarmup] CURRENT MONTH REFRESH ALREADY RUNNING -> JOIN"
        );

        return currentMonthRefreshPromise;

    }

    currentMonthRefreshPromise =
        (async () => {

            const month =
                getCurrentUtcMonth();

            const connections =
                getActiveSavedConnections();

            console.log(
                "[cacheWarmup] CURRENT MONTH AUTO-REFRESH START month=" +
                String(month) +
                " branches=" +
                String(connections.length) +
                " concurrency=" +
                String(
                    Math.min(
                        WARMUP_BRANCH_CONCURRENCY,
                        connections.length
                    )
                )
            );

            let refreshed =
                0;

            let failed =
                0;

            for (
                let offset = 0;
                offset < connections.length;
                offset += WARMUP_BRANCH_CONCURRENCY
            ) {

                const batch =
                    connections.slice(
                        offset,
                        offset +
                            WARMUP_BRANCH_CONCURRENCY
                    );

                const results =
                    await Promise.all(
                        batch.map(
                            async branch => {

                                const branchId =
                                    normalizeBranchId(
                                        branch?.branchId
                                    );

                                const state = {
                                    localRows: 0
                                };

                                try {

                                    const result =
                                        await warmMonthOnce({

                                            branchId,
                                            month,
                                            connection: branch,
                                            maxRetries,
                                            state,
                                            forceRefresh: true

                                        });

                                    console.log(
                                        "[cacheWarmup] CURRENT MONTH REFRESHED branch=" +
                                        String(branchId) +
                                        " month=" +
                                        String(month) +
                                        " rows=" +
                                        String(result?.rowCount || 0)
                                    );

                                    return true;

                                }
                                catch (
                                    error
                                ) {

                                    console.error(
                                        "[cacheWarmup] CURRENT MONTH REFRESH FAILED branch=" +
                                        String(branchId) +
                                        " month=" +
                                        String(month) + ":",
                                        error
                                    );

                                    return false;

                                }

                            }
                        )
                    );

                for (
                    const success
                    of results
                ) {

                    if (success) {
                        refreshed += 1;
                    }
                    else {
                        failed += 1;
                    }

                }

                await yieldToEventLoop();

            }

            console.log(
                "[cacheWarmup] CURRENT MONTH AUTO-REFRESH COMPLETE month=" +
                String(month) +
                " refreshed=" +
                String(refreshed) +
                " failed=" +
                String(failed)
            );

            return {

                success:
                    failed === 0,

                month,

                refreshed,

                failed

            };

        })().finally(
            () => {

                currentMonthRefreshPromise =
                    null;

            }
        );

    return currentMonthRefreshPromise;

}

export function startAllBranchesWarmup(
    {
        months = DEFAULT_MONTHS,
        delayMs = DEFAULT_DELAY_MS,
        maxRetries = DEFAULT_MAX_RETRIES
    } = {}
) {

    /*
     * -------------------------------------------------
     * If already running, refresh instead of starting
     * another worker.
     * -------------------------------------------------
     */

    if (
        roundRobinEngine?.running
    ) {

        console.log(

            "[cacheWarmup] ENGINE ALREADY RUNNING -> REFRESH QUEUE"

        );


        refreshWarmupQueue({

            months,

            delayMs,

            maxRetries

        })
        .catch(

            error => {

                console.error(

                    "[cacheWarmup] automatic queue refresh failed:",

                    error

                );

            }

        );


        return {

            started:
                true,

            alreadyRunning:
                true,

            refreshed:
                true,

            branches:
                roundRobinEngine.branchPlans.size,

            mode:
                "ROUND_ROBIN"

        };

    }


    const connections =
        getActiveSavedConnections();


    if (
        !Array.isArray(
            connections
        ) ||
        connections.length ===
        0
    ) {

        console.log(

            "[cacheWarmup] No saved branch connections."

        );


        return {

            started:
                false,

            branches:
                0,

            mode:
                "ROUND_ROBIN"

        };

    }


    const requestedMonthLimit =

        months === null ||
        months === undefined

            ? null

            : Number(
                months
            );


    const requestedDelay =
        Number(
            delayMs
        );


    const requestedRetries =
        Number(
            maxRetries
        );


    const normalizedDelay =
        Number.isFinite(
            requestedDelay
        ) &&
        requestedDelay >= 0

            ? requestedDelay

            : DEFAULT_DELAY_MS;


    const normalizedRetries =
        Number.isInteger(
            requestedRetries
        ) &&
        requestedRetries >= 0

            ? Math.min(
                requestedRetries,
                5
            )

            : DEFAULT_MAX_RETRIES;


    const engine = {

        running:
            true,

        branchPlans:
            new Map(),

        pendingBranches:
            [],

        months:
            requestedMonthLimit,

        delayMs:
            normalizedDelay,

        maxRetries:
            normalizedRetries

    };


    roundRobinEngine =
        engine;


    console.log(

        `[cacheWarmup] QUEUED ${connections.length} branch(es) for ROUND-ROBIN ${
            requestedMonthLimit === null
                ? "FULL HISTORY"
                : "LIMITED HISTORY"
        } warm-up.`

    );


    (async () => {

        /*
         * Discover initial branches with bounded parallelism.
         * Maximum 3 branch discoveries at once.
         * A slow/failing branch must not block other branches.
         */

        for (
            let offset = 0;
            offset < connections.length;
            offset += WARMUP_BRANCH_CONCURRENCY
        ) {

            const batch =
                connections.slice(
                    offset,
                    offset +
                        WARMUP_BRANCH_CONCURRENCY
                );

            console.log(
                "[cacheWarmup] DISCOVERY BATCH start=" +
                String(offset) +
                " size=" +
                String(batch.length)
            );

            await Promise.all(
                batch.map(
                    async branch => {

                        const branchId =
                            normalizeBranchId(
                                branch.branchId
                            );

                        try {

                            const plan =
                                await buildBranchPlan({

                                    branchId,

                                    connection:
                                        branch,

                                    months:
                                        requestedMonthLimit,

                                    resetState:
                                        true

                                });

                            if (
                                plan
                            ) {

                                engine.branchPlans.set(
                                    branchId,
                                    plan
                                );

                                console.log(
                                    "[cacheWarmup] PLAN branch=" +
                                    String(branchId) +
                                    " mode=" +
                                    String(
                                        requestedMonthLimit === null
                                            ? "FULL_HISTORY"
                                            : "LIMITED"
                                    ) +
                                    " months=" +
                                    String(
                                        plan.monthsList.length
                                    ) +
                                    " newest=" +
                                    String(
                                        plan.monthsList[0] || "N/A"
                                    ) +
                                    " oldest=" +
                                    String(
                                        plan.monthsList[
                                            plan.monthsList.length - 1
                                        ] || "N/A"
                                    ) +
                                    " tickets=" +
                                    String(
                                        plan.historyRange.ticketCount
                                    )
                                );

                            }

                        }
                        catch (
                            error
                        ) {

                            const state =
                                getState(
                                    branchId
                                );

                            state.running =
                                false;

                            state.failedMonths =
                                1;

                            state.error =
                                error?.message ||
                                String(error);

                            state.finishedAt =
                                new Date().toISOString();

                            console.error(
                                "[cacheWarmup] HISTORY DISCOVERY FAILED branch=" +
                                String(branchId) + ":",
                                error
                            );

                            updateSalesSyncState({

                                branchId,

                                status:
                                    "ERROR",

                                rows:
                                    0,

                                errorMessage:
                                    state.error

                            });

                        }

                    }
                )
            );

            await yieldToEventLoop();

        }

        if (
            engine.branchPlans.size ===
            0
        ) {

            engine.running =
                false;


            roundRobinEngine =
                null;


            console.log(

                "[cacheWarmup] NOTHING TO WARM."

            );


            return;

        }


        /*
         * Start the single worker.
         */

        await runRoundRobinEngine(
            engine
        );

    })()
    .catch(

        error => {

            engine.running =
                false;


            if (
                roundRobinEngine ===
                engine
            ) {

                roundRobinEngine =
                    null;

            }


            console.error(

                "[cacheWarmup] unexpected round-robin failure:",

                error

            );

        }

    );


    return {

        started:
            true,

        branches:
            connections.length,

        mode:
            requestedMonthLimit === null
                ? "FULL_HISTORY_ROUND_ROBIN"
                : "LIMITED_ROUND_ROBIN"

    };

}


/*
 * =========================================================
 * REFRESH WARM-UP QUEUE
 * =========================================================
 *
 * Can be called while the application is running.
 *
 * Typical flow:
 *
 * Save Branch
 *      â†“
 * Connect Branch
 *      â†“
 * refreshWarmupQueue()
 *      â†“
 * Branch starts from newest month
 *
 * Electron restart is NOT required.
 * =========================================================
 */

export async function refreshWarmupQueue(
    {
        months = null,
        delayMs = null,
        maxRetries = null,
        branchId = null
    } = {}
) {

    /*
     * -----------------------------------------------------
     * No active engine.
     *
     * Start a fresh round-robin using all saved branches.
     * -----------------------------------------------------
     */

    if (
        !roundRobinEngine?.running
    ) {

        const result =
            startAllBranchesWarmup({

                months,

                delayMs:
                    delayMs === null
                        ? DEFAULT_DELAY_MS
                        : delayMs,

                maxRetries:
                    maxRetries === null
                        ? DEFAULT_MAX_RETRIES
                        : maxRetries

            });


        return {

            success:
                true,

            mode:
                "STARTED_NEW_ENGINE",

            result

        };

    }


    const connections =
        getActiveSavedConnections();


    if (
        !Array.isArray(
            connections
        )
    ) {

        return {

            success:
                false,

            mode:
                "NO_CONNECTIONS"

        };

    }


    const existingIds =
        new Set(

            Array.from(

                roundRobinEngine
                    .branchPlans
                    .keys()

            )

        );


    const pendingIds =
        new Set(

            roundRobinEngine
                .pendingBranches
                .map(
                    plan =>
                        plan.branchId
                )

        );


    const targetConnections =

        branchId === null

            ? connections.filter(

                connection => {

                    const id =
                        Number(
                            connection?.branchId
                        );


                    return (

                        Number.isInteger(
                            id
                        ) &&

                        id > 0 &&

                        !existingIds.has(
                            id
                        ) &&

                        !pendingIds.has(
                            id
                        )

                    );

                }

            )

            : connections.filter(

                connection =>

                    Number(
                        connection?.branchId
                    ) ===
                    Number(
                        branchId
                    )

            );


    /*
     * If the requested branch is already in the engine,
     * nothing needs to be re-added.
     */

    if (
        targetConnections.length ===
        0
    ) {

        console.log(

            branchId === null

                ? "[cacheWarmup] REFRESH QUEUE -> no new branches."

                : `[cacheWarmup] REFRESH QUEUE -> branch ${branchId} already queued/running.`

        );


        return {

            success:
                true,

            mode:
                "NO_NEW_BRANCHES",

            branches:
                roundRobinEngine
                    .branchPlans
                    .size

        };

    }


    const effectiveMonths =

        months === null

            ? roundRobinEngine.months

            : months;


    const effectiveDelay =

        delayMs === null

            ? roundRobinEngine.delayMs

            : Math.max(

                0,

                Number(
                    delayMs
                ) || 0

            );


    const effectiveRetries =

        maxRetries === null

            ? roundRobinEngine.maxRetries

            : Math.max(

                0,

                Math.min(

                    5,

                    Number(
                        maxRetries
                    ) || 0

                )

            );


    for (
        const branch
        of targetConnections
    ) {

        const id =
            normalizeBranchId(
                branch.branchId
            );


        try {

            const plan =
                await buildBranchPlan({

                    branchId:
                        id,

                    connection:
                        branch,

                    months:
                        effectiveMonths,

                    resetState:
                        true

                });


            if (
                !plan
            ) {

                continue;

            }


            plan.addedDynamically =
                true;


            /*
             * Force the branch to be picked up immediately
             * at the next scheduler round.
             */

            plan.nextMonthIndex =
                0;


            roundRobinEngine
                .pendingBranches
                .push(
                    plan
                );


            console.log(

                `[cacheWarmup] REFRESH QUEUE ADDED branch=${id} newest=${plan.monthsList[0] || "N/A"} oldest=${plan.monthsList[plan.monthsList.length - 1] || "N/A"} months=${plan.monthsList.length}`

            );

        }
        catch (
            error
        ) {

            const state =
                getState(
                    id
                );


            state.running =
                false;


            state.failedMonths =
                1;


            state.error =
                error?.message ||
                String(
                    error
                );


            state.finishedAt =
                new Date().toISOString();


            updateSalesSyncState({

                branchId:
                    id,

                status:
                    "ERROR",

                rows:
                    0,

                errorMessage:
                    state.error

            });


            console.error(

                `[cacheWarmup] REFRESH QUEUE DISCOVERY FAILED branch=${id}:`,

                error

            );

        }

    }


    /*
     * Update engine defaults for future added branches.
     */

    roundRobinEngine.delayMs =
        effectiveDelay;


    roundRobinEngine.maxRetries =
        effectiveRetries;


    console.log(

        `[cacheWarmup] REFRESH QUEUE COMPLETE added=${roundRobinEngine.pendingBranches.length} active=${roundRobinEngine.branchPlans.size}`

    );


    return {

        success:
            true,

        mode:
            "QUEUE_REFRESHED",

        added:
            roundRobinEngine.pendingBranches.length,

        active:
            roundRobinEngine.branchPlans.size

    };

}


/*
 * =========================================================
 * SINGLE BRANCH WARMUP
 * =========================================================
 *
 * Used by manual start.
 * =========================================================
 */

export async function warmupBranchCache(
    {
        branchId,
        months = DEFAULT_MONTHS,
        delayMs = DEFAULT_DELAY_MS,
        maxRetries = DEFAULT_MAX_RETRIES,
        connection = null
    }
) {

    const id =
        normalizeBranchId(
            branchId
        );


    const state =
        getState(
            id
        );


    if (
        state.running
    ) {

        console.log(

            `[cacheWarmup] ALREADY RUNNING branch=${id}`

        );


        return {

            success:
                true,

            alreadyRunning:
                true,

            state: {
                ...state
            }

        };

    }


    const savedConnection =
        connection ||
        getBranchConnection(
            id
        );


    if (
        !savedConnection
    ) {

        throw new Error(

            `No saved connection for branch ${id}`

        );

    }


    const requestedDelay =
        Number(
            delayMs
        );


    const requestedRetries =
        Number(
            maxRetries
        );


    const normalizedDelay =
        Number.isFinite(
            requestedDelay
        ) &&
        requestedDelay >= 0

            ? requestedDelay

            : DEFAULT_DELAY_MS;


    const normalizedRetries =
        Number.isInteger(
            requestedRetries
        ) &&
        requestedRetries >= 0

            ? Math.min(
                requestedRetries,
                5
            )

            : DEFAULT_MAX_RETRIES;


    const historyRange =
        await getSalesHistoryRange({

            branchId:
                id,

            connection:
                savedConnection

        });


    if (
        !historyRange.hasData
    ) {

        state.running =
            false;


        state.finishedAt =
            new Date().toISOString();


        return {

            success:
                true,

            branchId:
                id,

            history:
                historyRange,

            state: {
                ...state
            }

        };

    }


    const monthsList =
        resolveMonthList({

            historyRange,

            months

        });


    initializeBranchState(

        id,

        historyRange,

        monthsList

    );


    try {

        for (
            const month
            of monthsList
        ) {

            state.currentMonth =
                month;


            await sleep(
                normalizedDelay
            );


            await yieldToEventLoop();


            try {

                const result =
                    await warmMonthOnce({

                        branchId:
                            id,

                        month,

                        connection:
                            savedConnection,

                        maxRetries:
                            normalizedRetries,

                        state

                    });


                if (
                    result.status ===
                        "LOCAL_HIT" ||
                    result.status ===
                        "CACHE_HIT"
                ) {

                    state.skippedMonths +=
                        1;

                }
                else {

                    state.completedMonths +=
                        1;

                }


                state.totalHistoricalRows +=

                    Number(
                        result.rowCount
                    ) || 0;

            }
            catch (
                error
            ) {

                state.failedMonths +=
                    1;


                state.error =
                    error?.message ||
                    String(
                        error
                    );


                console.error(

                    `[cacheWarmup] BRANCH MONTH FAILED branch=${id} month=${month}:`,

                    error

                );

            }


            await yieldToEventLoop();


            await sleep(
                YIELD_DELAY_MS
            );

        }


        finalizePlan({

            branchId:
                id,

            state

        });


        return {

            success:
                state.failedMonths ===
                0,

            branchId:
                id,

            history:
                historyRange,

            state: {
                ...state
            }

        };

    }
    catch (
        error
    ) {

        state.running =
            false;


        state.failedMonths +=
            1;


        state.error =
            error?.message ||
            String(
                error
            );


        state.currentMonth =
            null;


        state.finishedAt =
            new Date().toISOString();


        updateSalesSyncState({

            branchId:
                id,

            status:
                "ERROR",

            rows:
                state.localRows,

            errorMessage:
                state.error

        });


        console.error(

            `[cacheWarmup] STOPPED branch=${id}:`,

            error

        );


        return {

            success:
                false,

            branchId:
                id,

            error:
                state.error,

            history:
                historyRange,

            state: {
                ...state
            }

        };

    }

}


/*
 * =========================================================
 * MANUAL SINGLE BRANCH
 * =========================================================
 */

export function startBranchWarmup(
    {
        branchId,
        months = DEFAULT_MONTHS,
        delayMs = DEFAULT_DELAY_MS,
        maxRetries = DEFAULT_MAX_RETRIES
    }
) {

    const id =
        normalizeBranchId(
            branchId
        );


    setTimeout(

        () => {

            warmupBranchCache({

                branchId:
                    id,

                months,

                delayMs,

                maxRetries

            })
            .catch(

                error => {

                    console.error(

                        `[cacheWarmup] unexpected manual failure ${id}:`,

                        error

                    );

                }

            );

        },

        0

    );


    return {

        started:
            true,

        branchId:
            id

    };

}


/*
 * =========================================================
 * STATUS
 * =========================================================
 */

export function getWarmupStatus(
    branchId
) {

    const id =
        normalizeBranchId(
            branchId
        );


    return {

        branchId:
            id,

        ...getState(
            id
        )

    };

}


export function getAllWarmupStatuses() {

    return Array.from(

        warmupState.entries()

    )
    .map(

        (
            [
                branchId,
                state
            ]
        ) => ({

            branchId,

            ...state

        })

    );

}


export function isWarmupRunning(
    branchId
) {

    const id =
        normalizeBranchId(
            branchId
        );


    return Boolean(

        getState(
            id
        ).running

    );

}


