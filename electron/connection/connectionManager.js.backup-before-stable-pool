import sql from "mssql";


import {
    validatePharmaFlyConnection
} from "./pharmaflyValidator.js";


const pools =
    new Map();


const connectionInFlight =
    new Map();


const SQL_CONNECTION_TIMEOUT_MS =
    30000;


const SQL_REQUEST_TIMEOUT_MS =
    120000;


function normalizeBranchId(
    branchId
) {

    const id =
        Number(
            branchId
        );


    if (
        !Number.isInteger(
            id
        ) ||
        id <= 0
    ) {

        throw new Error(
            "Invalid branchId"
        );

    }


    return id;

}


function buildConfig(
    connection
) {

    if (
        !connection ||
        typeof connection !== "object"
    ) {

        throw new Error(
            "Connection configuration is required"
        );

    }


    const server =
        String(
            connection.server ||
            ""
        ).trim();


    const port =
        Number(
            connection.port ||
            1433
        );


    const database =
        String(
            connection.database ||
            ""
        ).trim();


    const user =
        String(
            connection.user ||
            ""
        ).trim();


    const password =
        String(
            connection.password ||
            ""
        );


    if (
        !server
    ) {

        throw new Error(
            "SQL server is required"
        );

    }


    if (
        !Number.isInteger(
            port
        ) ||
        port <= 0
    ) {

        throw new Error(
            "Invalid SQL port"
        );

    }


    if (
        !database
    ) {

        throw new Error(
            "SQL database is required"
        );

    }


    if (
        !user
    ) {

        throw new Error(
            "SQL user is required"
        );

    }


    const config = {

        server,

        port,

        database,

        user,

        password,

        options: {

            encrypt:
                false,

            trustServerCertificate:
                true

        },

        pool: {

            max:
                10,

            min:
                0,

            idleTimeoutMillis:
                30000

        },

        connectionTimeout:
            SQL_CONNECTION_TIMEOUT_MS,

        requestTimeout:
            SQL_REQUEST_TIMEOUT_MS

    };


    console.log(

        `[connectionManager] SQL config server=${server} database=${database} requestTimeout=${SQL_REQUEST_TIMEOUT_MS}ms`

    );


    return config;

}


/*
 * =========================================================
 * GET BRANCH POOL
 * =========================================================
 */

export async function getBranchPool(
    branchId,
    connection
) {

    const id =
        normalizeBranchId(
            branchId
        );


    const existing =
        pools.get(
            id
        );


    if (
        existing?.connected
    ) {

        return existing;

    }


    const pending =
        connectionInFlight.get(
            id
        );


    if (
        pending
    ) {

        console.log(

            `[connectionManager] Branch ${id} connection IN-FLIGHT JOIN`

        );


        return pending;

    }


    const connectRequest =
        (async () => {

            if (
                existing
            ) {

                pools.delete(
                    id
                );


                try {

                    await existing.close();

                }
                catch {
                    // Ignore stale pool close failures.
                }

            }


            const config =
                buildConfig(
                    connection
                );


            const pool =
                new sql.ConnectionPool(
                    config
                );


            try {

                await pool.connect();


                pool.on(

                    "error",

                    error => {

                        console.error(

                            `[connectionManager] Branch ${id} pool error:`,

                            error

                        );


                        pools.delete(
                            id
                        );

                    }

                );


                pools.set(
                    id,
                    pool
                );


                console.log(

                    `[connectionManager] Branch ${id} connected requestTimeout=${SQL_REQUEST_TIMEOUT_MS}ms`

                );


                return pool;

            }
            catch (
                error
            ) {

                try {

                    await pool.close();

                }
                catch {
                    // Ignore close failures.
                }


                throw error;

            }

        })();


    connectionInFlight.set(
        id,
        connectRequest
    );


    try {

        return await connectRequest;

    }
    finally {

        if (
            connectionInFlight.get(
                id
            ) ===
            connectRequest
        ) {

            connectionInFlight.delete(
                id
            );

        }

    }

}


/*
 * =========================================================
 * TEST BRANCH CONNECTION
 * =========================================================
 */

export async function testBranchConnection(
    branchId,
    connection
) {

    const id =
        normalizeBranchId(
            branchId
        );


    const pool =
        await getBranchPool(

            id,

            connection

        );


    const pharmaFly =
        await validatePharmaFlyConnection(
            pool
        );


    return {

        branchId:
            id,

        success:
            true,

        connected:
            true,

        pharmaFly:
            true,

        ...pharmaFly

    };

}


/*
 * =========================================================
 * INSPECT posTickets COLUMNS
 * =========================================================
 *
 * Temporary diagnostic helper.
 *
 * It uses the SAME active connection used by PharmaBI.
 *
 * This lets us identify the REAL delivery-related column
 * in PharmaFly without using sqlcmd or another connection.
 *
 */

export async function inspectTableColumns(
    branchId,
    connection
) {

    const id =
        normalizeBranchId(
            branchId
        );


    const pool =
        await getBranchPool(

            id,

            connection

        );


    const result =
        await pool
            .request()
            .query(`

                SELECT

                    c.column_id,

                    c.name AS column_name,

                    ty.name AS data_type,

                    c.max_length,

                    c.is_nullable

                FROM sys.columns c

                INNER JOIN sys.tables t

                    ON t.object_id =
                       c.object_id

                INNER JOIN sys.types ty

                    ON ty.user_type_id =
                       c.user_type_id

                WHERE

                    t.name =
                    'posTickets'

                ORDER BY

                    c.column_id;

            `);


    const columns =
        Array.isArray(
            result?.recordset
        )

            ? result.recordset

            : [];


    console.log(

        `[connectionManager] posTickets columns for branch ${id}:`,

        columns

    );


    return columns;

}


/*
 * =========================================================
 * CLOSE ONE
 * =========================================================
 */

export async function closeBranchConnection(
    branchId
) {

    const id =
        normalizeBranchId(
            branchId
        );


    const pool =
        pools.get(
            id
        );


    if (
        !pool
    ) {

        return;

    }


    pools.delete(
        id
    );


    try {

        await pool.close();


        console.log(

            `[connectionManager] Branch ${id} disconnected.`

        );

    }
    catch {
        // Ignore close failures.
    }

}


/*
 * =========================================================
 * CLOSE ALL
 * =========================================================
 */

export async function closeAllConnections() {

    const activePools =
        Array.from(
            pools.values()
        );


    pools.clear();


    await Promise.all(

        activePools.map(

            async pool => {

                try {

                    await pool.close();

                }
                catch {
                    // Ignore close failures.
                }

            }

        )

    );

}


/*
 * =========================================================
 * ACTIVE CONNECTIONS
 * =========================================================
 */

export function getActiveBranchConnections() {

    return Array.from(
        pools.keys()
    );

}


export default {

    getBranchPool,

    testBranchConnection,

    inspectTableColumns,

    closeBranchConnection,

    closeAllConnections,

    getActiveBranchConnections

};
