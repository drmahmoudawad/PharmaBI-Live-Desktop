import {
    ipcMain
} from "electron";


import {
    searchMasterItems,
    resolveItem,
    getMasterItemById,
    getReviewQueue,
    searchReviewQueue,
    getReviewGroup,
    decideReview,
    decideReviewGroup,
    createMasterFromReview,
    createMasterFromReviewGroup,
    getMasterItemStats
} from "../masterItem/masterItemService.js";


export function registerMasterItemIpc() {

    ipcMain.handle(
        "master-item:search",
        async (
            _event,
            payload
        ) => {

            return {

                success:
                    true,

                results:
                    searchMasterItems(
                        payload?.query,
                        {
                            branchId:
                                payload?.branchId,

                            limit:
                                payload?.limit
                        }
                    )

            };

        }
    );


    ipcMain.handle(
        "master-item:resolve",
        async (
            _event,
            payload
        ) => {

            return resolveItem(
                payload?.query,
                {
                    branchId:
                        payload?.branchId
                }
            );

        }
    );


    ipcMain.handle(
        "master-item:get",
        async (
            _event,
            payload
        ) => {

            return {

                success:
                    true,

                item:
                    getMasterItemById(
                        payload?.masterItemId
                    )

            };

        }
    );


    ipcMain.handle(
        "master-item:reviewQueue",
        async (
            _event,
            payload
        ) => {

            return {

                success:
                    true,

                results:
                    getReviewQueue(
                        {
                            limit:
                                payload?.limit,

                            branchId:
                                payload?.branchId
                        }
                    )

            };

        }
    );


    ipcMain.handle(
        "master-item:reviewGroup",
        async (
            _event,
            payload
        ) => {

            return getReviewGroup(
                {
                    branchId:
                        payload?.branchId,

                    branchItemId:
                        payload?.branchItemId
                }
            );

        }
    );


    ipcMain.handle(
        "master-item:decide",
        async (
            _event,
            payload
        ) => {

            return decideReview(
                {
                    branchId:
                        payload?.branchId,

                    branchItemId:
                        payload?.branchItemId,

                    candidateMasterItemId:
                        payload?.candidateMasterItemId,

                    decision:
                        payload?.decision
                }
            );

        }
    );


    ipcMain.handle(
        "master-item:decide-group",
        async (
            _event,
            payload
        ) => {

            return decideReviewGroup(
                {
                    branchId:
                        payload?.branchId,

                    branchItemId:
                        payload?.branchItemId,

                    candidateMasterItemId:
                        payload?.candidateMasterItemId,

                    decision:
                        payload?.decision
                }
            );

        }
    );


    ipcMain.handle(
        "master-item:create-new",
        async (
            _event,
            payload
        ) => {

            return createMasterFromReview(
                {
                    branchId:
                        payload?.branchId,

                    branchItemId:
                        payload?.branchItemId
                }
            );

        }
    );


    ipcMain.handle(
        "master-item:create-new-group",
        async (
            _event,
            payload
        ) => {

            return createMasterFromReviewGroup(
                {
                    branchId:
                        payload?.branchId,

                    branchItemId:
                        payload?.branchItemId
                }
            );

        }
    );


    ipcMain.handle(
        "master-item:stats",
        async () => {

            return {

                success:
                    true,

                ...getMasterItemStats()

            };

        }
    );

}