/*
 * =========================================================
 * DATE RANGE HELPERS
 * =========================================================
 */

function getExclusiveDate(

    value

) {

    const normalized =
        String(
            value ||
            ""
        ).trim();


    if (
        !/^\d{4}-\d{2}-\d{2}$/.test(
            normalized
        )
    ) {

        throw new Error(
            "Invalid date. Expected YYYY-MM-DD"
        );

    }


    const [
        year,
        month,
        day
    ] =
        normalized
            .split(
                "-"
            )
            .map(
                Number
            );


    const next =
        new Date(

            Date.UTC(

                year,
                month - 1,
                day + 1

            )

        );


    return [

        next.getUTCFullYear(),

        String(
            next.getUTCMonth() + 1
        ).padStart(
            2,
            "0"
        ),

        String(
            next.getUTCDate()
        ).padStart(
            2,
            "0"
        )

    ].join(
        "-"
    );

}


/*
 * =========================================================
 * NORMALIZATION
 * =========================================================
 */

function toNumber(
    value
) {

    const number =
        Number(
            value
        );


    return Number.isFinite(
        number
    )
        ? number
        : 0;

}


function toBooleanInteger(
    value
) {

    return (

        value === true ||
        value === 1 ||
        value === "1" ||
        value === "true"

    )
        ? 1
        : 0;

}


function toNullableString(
    value
) {

    if (

        value === null ||
        value === undefined ||
        value === ""

    ) {

        return null;

    }


    return String(
        value
    );

}


function normalizeRow(
    branchId,
    row
) {

    return {

        branch_id:
            Number(
                branchId
            ),

        ticket_id:
            String(
                row?.ticketId ??
                ""
            ),

        line_id:
            String(
                row?.lineId ??
                ""
            ),

        item_id:
            toNullableString(
                row?.itemId
            ),

        item_name:
            toNullableString(
                row?.itemName
            ),

        customer_id:
            toNullableString(
                row?.customerId
            ),

        customer_name:
            toNullableString(
                row?.customerName
            ),

        date:
            toNullableString(
                row?.date
            ),

        sales_return:
            toNumber(
                row?.salesReturn
            ),

        transaction_type:
            toNullableString(
                row?.transactionType
            ),

        ticket_total:
            toNumber(
                row?.ticketTotal
            ),

        packs:
            toNumber(
                row?.packs
            ),

        units:
            toNumber(
                row?.units
            ),

        parts:
            toNumber(
                row?.parts
            ) || 1,

        base_units:
            toNumber(
                row?.baseUnits
            ),

        bonus:
            toNumber(
                row?.bonus
            ),

        sales_price:
            toNumber(
                row?.salesPrice
            ),

        unit_price:
