            )

    };

}


/*
 * =========================================================
 * SAVE ROWS
 * =========================================================
 */

export function saveSalesRows(
    {
        branchId,
        rows,
        batchSize = 5000
    }
) {

    const id =
        Number(
            branchId
        );


    if (
        !Number.isInteger(
            id
        ) ||
        id <= 0
    ) {

        throw new Error(
            "Invalid branchId"
        );

    }


    if (
        !Array.isArray(
            rows
        ) ||
        rows.length === 0
    ) {

        return {

            branchId:
                id,

            processed:
                0

        };

    }


    const db =
        openDatabase();


    const statements =
        getStatements();


    const normalizedBatchSize =
        Number.isInteger(
            Number(
                batchSize
            )
        ) &&
        Number(
            batchSize
        ) > 0

            ? Math.min(
                Number(
                    batchSize
                ),
                10000
            )

            : 5000;


    let processed =
        0;


    const insertBatch =
        db.transaction(

            batch => {

                for (
                    const row
                    of batch
                ) {

                    if (
                        row?.lineId ===
                        null ||
                        row?.lineId ===
                        undefined ||
                        String(
                            row.lineId
                        ) ===
                        ""
                    ) {

                        continue;

                    }


                    statements
                        .insertOrReplace
                        .run(

                            normalizeRow(
                                id,
                                row
                            )

                        );


                    processed +=
                        1;

                }

            }

        );


    for (
        let start = 0;

        start < rows.length;

        start += normalizedBatchSize

    ) {

        insertBatch(

            rows.slice(

                start,

                start +
                normalizedBatchSize

            )

        );

    }


    return {

        branchId:
            id,

        processed

    };

}


/*
 * =========================================================
 * GET SALES RANGE
 * =========================================================
 */

export function getSalesRows(
    {
        branchId,
        fromDate,
        toDate
    }
) {

    const id =
        Number(
            branchId
        );


    if (
        !Number.isInteger(
            id
        ) ||
        id <= 0
    ) {

        throw new Error(
            "Invalid branchId"
        );

    }


    const from =
        String(
            fromDate ||
            ""
        ).trim();


    const to =
        String(
            toDate ||
            ""
        ).trim();


    if (
        !/^\d{4}-\d{2}-\d{2}$/.test(
            from
        )
    ) {

        throw new Error(
            "Invalid fromDate. Expected YYYY-MM-DD"
        );

    }


    if (
        !/^\d{4}-\d{2}-\d{2}$/.test(
            to
        )
    ) {

        throw new Error(
            "Invalid toDate. Expected YYYY-MM-DD"
        );

    }


    const toExclusive =
        getExclusiveDate(
            to
        );


    const startedAt =
        Date.now();


    const rows =
        getStatements()
            .getSalesRange
            .all(

                id,

                `${from}T00:00:00.000Z`,

                `${toExclusive}T00:00:00.000Z`

            );


    const elapsed =
        Date.now() -
        startedAt;


    console.log(

        `[localSalesDb] READ branch=${id} range=${from}|${to} rows=${rows.length} in ${elapsed} ms`

    );


    return rows;

}


/*
 * =========================================================
 * MONTH EXISTS
 * =========================================================
 */

export function hasSalesMonth(
    {
        branchId,
        month
    }
) {

    const id =
        Number(
            branchId
        );


    const normalizedMonth =
        String(
            month ||
            ""
        );


    if (
        !/^\d{4}-\d{2}$/.test(
            normalizedMonth
        )
    ) {

        return false;

    }


    const fromDate =
        `${normalizedMonth}-01`;


    const [
        year,
        monthNumber
    ] =
        normalizedMonth
            .split(
                "-"
            )
            .map(
                Number
            );


    const nextMonth =
        new Date(

            Date.UTC(

                year,

                monthNumber,

                1

            )

        );


    const toDate = [

        nextMonth.getUTCFullYear(),

        String(
            nextMonth.getUTCMonth() + 1
        ).padStart(
            2,
            "0"
        ),

        "01"

    ].join(
        "-"
    );


    const result =
        getStatements()
            .getMonthStats
            .get(

                id,

                fromDate,

                toDate

            );


    return (
        Number(
            result?.total_rows
        ) || 0
    ) > 0;

}


/*
 * =========================================================
 * SAVE MONTH
 * =========================================================
 */

export function saveSalesMonth(
    {
        branchId,
        month,
        rows
    }
) {

    const result =
        saveSalesRows({

            branchId,

            rows

        });


    updateSalesSyncState({

        branchId,

        status:
            "READY",

        rows:
            result.processed

    });


    console.log(

        `[localSalesDb] SAVED branch=${branchId} month=${month} rows=${result.processed}`

    );


    return result;

}


