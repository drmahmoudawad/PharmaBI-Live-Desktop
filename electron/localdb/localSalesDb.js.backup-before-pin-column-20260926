    return {

        databasePath:
            getDatabasePath(),

        totalRows:
            Number(
                result?.total_rows
            ) || 0,

        branches:
            Number(
                result?.branches
            ) || 0,

        months:
            Number(
                result?.months
            ) || 0

    };

}


