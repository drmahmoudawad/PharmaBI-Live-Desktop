 * =========================================================
 * DATABASE ACCESS
 * =========================================================
 */

export function getLocalSalesDatabase() {

    return openDatabase();

}


/*
 * =========================================================
 * CLOSE
 * =========================================================
 */

export function closeLocalSalesDatabase() {

    if (
        !database
    ) {

        return;

    }


    try {

        database.close();

        console.log(
            "[localSalesDb] CLOSED"
        );

    }
    catch (
        error
    ) {

        console.error(

            "[localSalesDb] close failed:",

            error

        );

    }


    database =
        null;

}


