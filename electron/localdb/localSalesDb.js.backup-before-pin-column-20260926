/*
 * =========================================================
 * SYNC STATE
 * =========================================================
 */

export function updateSalesSyncState(
    {
        branchId,
        status,
        rows = 0,
        errorMessage = null
    }
) {

    const id =
        Number(
            branchId
        );


    const statements =
        getStatements();


    const range =
        statements
            .getDateRange
            .get(
                id
            );


    const existing =
        statements
            .getSyncState
            .get(
                id
            );


    const now =
        new Date()
            .toISOString();


    const startedAt =
        status === "RUNNING"

            ? now

            : (
                existing?.last_sync_started_at ||
                null
            );


    const finishedAt =
        status === "READY" ||
        status === "ERROR"

            ? now

            : (
                existing?.last_sync_finished_at ||
                null
            );


    statements
        .saveSyncState
        .run({

            branch_id:
                id,

            oldest_date:
                range?.oldest_date ||
                null,

            newest_date:
                range?.newest_date ||
                null,

            last_sync_started_at:
                startedAt,

            last_sync_finished_at:
                finishedAt,

            last_sync_status:
                String(
                    status ||
                    "UNKNOWN"
                ),

            last_sync_rows:
                Number(
                    rows
                ) || 0,

            total_rows:
                Number(
                    range?.total_rows
                ) || 0,

            error_message:
                errorMessage
                ? String(
                    errorMessage
                )
                : null

        });


    return statements
        .getSyncState
        .get(
            id
        );

}


