import Database from "better-sqlite3";
import path from "node:path";
import {
    app
} from "electron";


let database =
    null;


/*
 * =========================================================
 * DATABASE PATH
 * =========================================================
 */

function getDatabasePath() {

    return path.join(

        app.getPath(
            "userData"
        ),

        "pharmabi-local.db"

    );

}


/*
 * =========================================================
 * OPEN DATABASE
 * =========================================================
 */

function openDatabase() {

    if (
        database
    ) {

        return database;

    }


    database =
        new Database(
            getDatabasePath()
        );


    database.pragma(
        "journal_mode = WAL"
    );


    database.pragma(
        "synchronous = NORMAL"
    );


    database.pragma(
        "foreign_keys = ON"
    );


    database.pragma(
        "busy_timeout = 10000"
    );


    createSchema();


    console.log(

        `[localSalesDb] OPEN ${getDatabasePath()}`

    );


    return database;

}


/*
 * =========================================================
 * SCHEMA
 * =========================================================
 */

function createSchema() {

    const db =
        database;


    db.exec(`

        CREATE TABLE IF NOT EXISTS sales_history (

            id INTEGER PRIMARY KEY AUTOINCREMENT,

            branch_id INTEGER NOT NULL,

            ticket_id TEXT NOT NULL,

            line_id TEXT NOT NULL,

            item_id TEXT,

            item_name TEXT,

            customer_id TEXT,

            customer_name TEXT,

            date TEXT,

            sales_return REAL DEFAULT 0,

            transaction_type TEXT,

            ticket_total REAL DEFAULT 0,

            packs REAL DEFAULT 0,

            units REAL DEFAULT 0,

            parts REAL DEFAULT 1,

            base_units REAL DEFAULT 0,

            bonus REAL DEFAULT 0,

            sales_price REAL DEFAULT 0,

            unit_price REAL DEFAULT 0,

            gross_line_value REAL DEFAULT 0,

            discount REAL DEFAULT 0,

            extra_discount REAL DEFAULT 0,

            net_line_value REAL DEFAULT 0,

            cost_price REAL DEFAULT 0,

            unit_cost REAL DEFAULT 0,

            line_cost REAL DEFAULT 0,

            purchase_cost REAL DEFAULT 0,

            purchase_unit_cost REAL DEFAULT 0,

            purchase_date TEXT,

            purchase_invoice_id TEXT,

            purchase_invoice_code TEXT,

            purchase_vendor_id TEXT,

            purchase_parts REAL DEFAULT 1,

            source_pos_item_cost REAL DEFAULT 0,

            is_content INTEGER DEFAULT 0,

            store_id TEXT,

            sales_rep_id TEXT,

            created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,

            updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,

            UNIQUE (

                branch_id,

                line_id

            )

        );


        CREATE INDEX IF NOT EXISTS
            idx_sales_history_branch_date

        ON sales_history (

            branch_id,

            date

        );


        CREATE INDEX IF NOT EXISTS
            idx_sales_history_branch_ticket

        ON sales_history (

            branch_id,

            ticket_id

        );


        CREATE INDEX IF NOT EXISTS
            idx_sales_history_branch_item_date

        ON sales_history (

            branch_id,

            item_id,

            date

        );


        CREATE INDEX IF NOT EXISTS
            idx_sales_history_branch_customer_date

        ON sales_history (

            branch_id,

            customer_id,

            date

        );


        CREATE INDEX IF NOT EXISTS
            idx_sales_history_branch_seller_date

        ON sales_history (

            branch_id,

            sales_rep_id,

            date

        );


        CREATE INDEX IF NOT EXISTS
            idx_sales_history_date

        ON sales_history (

            date

        );


        CREATE TABLE IF NOT EXISTS sales_sync_state (

            branch_id INTEGER PRIMARY KEY,

            oldest_date TEXT,

            newest_date TEXT,

            last_sync_started_at TEXT,

            last_sync_finished_at TEXT,

            last_sync_status TEXT,

            last_sync_rows INTEGER DEFAULT 0,

            total_rows INTEGER DEFAULT 0,

            error_message TEXT

        );

    `);

}


