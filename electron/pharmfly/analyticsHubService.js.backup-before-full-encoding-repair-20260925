async function aggregateInterbranchExchanges({
  branchId,
  fromDate,
  toDate,
  connection
}) {
  const { pool } =
    await branchContext(
      branchId,
      connection
    );

  const next =
    new Date(
      `${toDate}T00:00:00Z`
    );

  next.setUTCDate(
    next.getUTCDate() + 1
  );

  const toEx =
    next
      .toISOString()
      .slice(0, 10);

  const result =
    await pool
      .request()
      .input(
        'fromDate',
        `${fromDate} 00:00:00`
      )
      .input(
        'toDateExclusive',
        `${toEx} 00:00:00`
      )
      .query(`
        SET NOCOUNT ON;

        SELECT
          px.ID AS movementId,

          px.zTime AS movementDate,

          px.ExchangeID AS exchangeId,

          LTRIM(
            RTRIM(
              COALESCE(
                e.Name,
                N'غير محدد'
              )
            )
          ) AS otherBranchName,

          px.SalesReturn,

          COALESCE(
            px.Total,
            0
          ) AS total,

          COALESCE(
            quantityTotals.packs,
            0
          ) AS packs,

          COALESCE(
            quantityTotals.units,
            0
          ) AS units,

          px.TicketType,

          px.PinNumber,

          px.xMemo

        FROM posTicketsX px

        LEFT JOIN Exchange e
          ON e.ID = px.ExchangeID

        OUTER APPLY (
          SELECT
            SUM(
              COALESCE(
                pi.Packs,
                0
              )
            ) AS packs,

            SUM(
              COALESCE(
                pi.Units,
                0
              )
            ) AS units

          FROM posItemsX pi

          WHERE
            pi.TicketID =
              px.ID

        ) quantityTotals

        WHERE
          px.ExchangeID IS NOT NULL

          AND

          px.zTime >= @fromDate

          AND

          px.zTime < @toDateExclusive

        ORDER BY
          px.zTime DESC,
          px.ID DESC;
      `);

  const rows =
    result.recordset || [];

  const counterpartMap =
    new Map();

  let outgoingTotal = 0;
  let incomingTotal = 0;

  let outgoingCount = 0;
  let incomingCount = 0;

  let outgoingPacks = 0;
  let incomingPacks = 0;

  let outgoingUnits = 0;
  let incomingUnits = 0;

  for (const row of rows) {

    const isOutgoing =
      Number(row.SalesReturn) === 1;

    const isIncoming =
      Number(row.SalesReturn) === 2;

    const amount =
      Math.abs(
        Number(row.total) || 0
      );

    const packs =
      Number(row.packs) || 0;

    const units =
      Number(row.units) || 0;

    if (isOutgoing) {
      outgoingTotal += amount;
      outgoingCount++;

      outgoingPacks += packs;
      outgoingUnits += units;
    }

    if (isIncoming) {
      incomingTotal += amount;
      incomingCount++;

      incomingPacks += packs;
      incomingUnits += units;
    }

    const name =
      String(
        row.otherBranchName ||
        'غير محدد'
      ).trim();

    const key =
      name.toLocaleLowerCase(
        'ar-EG'
      );

    if (!counterpartMap.has(key)) {
      counterpartMap.set(
        key,
        {
          branchName:
            name,

          outgoingTotal:
            0,

          incomingTotal:
            0,

          outgoingPacks:
            0,

          incomingPacks:
            0,

          outgoingUnits:
            0,

          incomingUnits:
            0,

          netTotal:
            0,

          movements:
            0
        }
      );
    }

    const target =
      counterpartMap.get(key);

    target.movements++;

    if (isOutgoing) {
      target.outgoingTotal += amount;
      target.outgoingPacks += packs;
      target.outgoingUnits += units;
    }

    if (isIncoming) {
      target.incomingTotal += amount;
      target.incomingPacks += packs;
      target.incomingUnits += units;
    }
  }

  const counterparties =
    Array.from(
      counterpartMap.values()
    )
      .map(row => ({
        branchName:
          row.branchName,

        outgoingTotal:
          r(row.outgoingTotal),

        incomingTotal:
          r(row.incomingTotal),

        outgoingPacks:
          r(row.outgoingPacks),

        incomingPacks:
          r(row.incomingPacks),

        outgoingUnits:
          r(row.outgoingUnits),

        incomingUnits:
          r(row.incomingUnits),

        netTotal:
          r(
            row.outgoingTotal -
            row.incomingTotal
          ),

        movements:
          row.movements
      }))
      .sort(
        (a, b) =>
          b.outgoingTotal +
          b.incomingTotal -
          (
            a.outgoingTotal +
            a.incomingTotal
          )
      );

  const summary = {
    movements:
      rows.length,

    outgoingCount,

    incomingCount,

    outgoingTotal:
      r(outgoingTotal),

    incomingTotal:
      r(incomingTotal),

    outgoingPacks:
      r(outgoingPacks),

    incomingPacks:
      r(incomingPacks),

    outgoingUnits:
      r(outgoingUnits),

    incomingUnits:
      r(incomingUnits),

    netTotal:
      r(
        outgoingTotal -
        incomingTotal
      ),

    counterparties:
      counterparties.length
  };

  return {
    success: true,

    type:
      'exchange-overview',

    branchId:
      id(branchId),

    fromDate,

    toDate,

    summary,

    counterparties,

    rows:
      rows.map(row => ({
        movementId:
          String(
            row.movementId
          ),

        movementDate:
          row.movementDate,

        exchangeId:
          String(
            row.exchangeId
          ),

        otherBranchName:
          String(
            row.otherBranchName ||
            'غير محدد'
          ),

        salesReturn:
          n(row.SalesReturn),

        total:
          r(
            Math.abs(
              n(row.total)
            )
          ),

        packs:
          r(row.packs),

        units:
          r(row.units),

        direction:
          Number(row.SalesReturn) === 1
            ? 'outgoing'
            : 'incoming',

        ticketType:
          n(row.TicketType),

        pinNumber:
          row.PinNumber == null
            ? null
            : String(
                row.PinNumber
              ),

        xMemo:
          row.xMemo == null
            ? ''
            : String(
                row.xMemo
              )
      }))
  };
}
async function aggregateInterbranchExchangesAllBranches({
  fromDate,
  toDate
}) {
  const connections =
    getAllSavedConnections()
      .slice()
      .sort(
        (a, b) =>
          Number(a.branchId || 0) -
          Number(b.branchId || 0)
      );

  const branches = [];
  let failedBranches = 0;

  for (const branch of connections) {

    try {

      const result =
        await aggregateInterbranchExchanges({
          branchId:
            branch.branchId,

          fromDate,

          toDate,

          connection:
            branch
        });

      const summary =
        result?.summary || {};

      branches.push({
        branchId:
          Number(
            branch.branchId
          ),

        branchName:
          String(
            branch.branchName ||
            `Branch ${branch.branchId}`
          ),

        movements:
          n(summary.movements),

        outgoingCount:
          n(summary.outgoingCount),

        incomingCount:
          n(summary.incomingCount),

        outgoingTotal:
          r(summary.outgoingTotal),

        incomingTotal:
          r(summary.incomingTotal),

        outgoingPacks:
          r(summary.outgoingPacks),

        incomingPacks:
          r(summary.incomingPacks),

        outgoingUnits:
          r(summary.outgoingUnits),

        incomingUnits:
          r(summary.incomingUnits),

        netTotal:
          r(summary.netTotal),

        counterparties:
          n(summary.counterparties)
      });

    } catch (error) {

      console.error(
        `[analyticsHub] Interbranch exchange failed for branch ${branch.branchId}:`,
        error?.message || error
      );

      failedBranches++;
    }
  }

  const total =
    branches.reduce(
