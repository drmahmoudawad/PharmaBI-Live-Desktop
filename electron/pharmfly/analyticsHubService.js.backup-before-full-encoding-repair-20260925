              false,
            message:
              'ط§ط®طھط± ظپط±ط¹ظ‹ط§ ظ„طھط­طظظٹظ„ ط§ظ„ط¹ظ…ظ„ط§ط،.'
          };

    case 'customer-retention':
      return branch
        ? getCustomerRetention({
            branchId:
              branch,
            fromDate,
            toDate
          })
        : {
            success:
              false,
            message:
              'ط§ط®طھط± ظپط±ط¹ظ‹ط§ ظ„طھط­طظظٹظ„ ط§ظ„ظ§ط­طھظپط§ط¸.'
          };

    case 'customer-churn':
      return branch
        ? getCustomerInactivity({
            branchId:
              branch,
            toDate,
            sampleLimit:
              100
          })
        : {
            success:
              false,
            message:
              'ط§ط®طھط± ظپط±ط¹ظ‹ط§ ظ„طھط­طظظٹظ„ ط¹ط¯ظ… ط§ظ„ظ†ط´ط§ط·.'
          };

    case 'customer-clv':
      return branch
        ? getCustomerClv({
            branchId:
              branch,
            fromDate,
            toDate,
            observationDays:
              365,
            limit:
              50
          })
        : {
            success:
              false,
            message:
              'ط§ط®طھط± ظپط±ط¹ظ‹ط§ ظ„طھط­طظظيظ„ CLV.'
          };

    case 'customer-cohort':
      return branch
        ? getCustomerCohort({
            branchId:
              branch,
            fromDate,
            toDate,
            maxMonths:
              24
          })
        : {
            success:
              false,
            message:
              'ط§ط®طھط± ظپط±ط¹ظ‹ط§ ظ„طھط­طظظيظ„ ط§ظ„ظ€Cohort.'
          };

    case 'operations':
    case 'inventory-overview':
    case 'inventory-risk':
    case 'inventory-reorder': {
      if (!branch) {
        return {
          success:
            false,
          message:
            'ط§ط®طھط± ظپط±ط¹ظ‹ط§ ظ„طھط­طظظٹظ„ ط§ظ„ظ…ط®ط²ظˆظ†.'
        };
      }

      const rows =
        await getSales({
          branchId:
            branch,
          fromDate,
          toDate,
          connection
        });

      const map =
        new Map();

      for (
        const row
        of rows
      ) {
        const k =
          row.itemId ||
          'UNKNOWN';

        if (
          !map.has(k)
        ) {
          map.set(
            k,
            {
              itemId:
                String(k),

              itemName:
                row.itemName ||
                'غير معروف',

              units:
                0,

              sales:
                0,

              tickets:
                new Set()
            }
          );
        }

        const x =
          map.get(k);

        x.units +=
          row.transactionType ===
          'RETURN'
            ? -Math.abs(
                n(
                  row.baseUnits
                )
              )
            : n(
                row.baseUnits
              );

        x.sales +=
          row.transactionType ===
          'RETURN'
            ? -Math.abs(
                n(
                  row.netLineValue
                )
              )
            : n(
                row.netLineValue
              );

        x.tickets.add(
          row.ticketId
        );
      }

      const items =
        [...map.values()]
          .map(
            x => ({
              ...x,

              units:
                r(x.units),

              sales:
                r(x.sales),

              tickets:
                x.tickets.size,

              velocity:
                r(
                  x.units /
                  daysBetween(
                    fromDate,
                    toDate
                  ),
                  2
                )
            })
          )
          .sort(
            (a, b) =>
              b.velocity -
              a.velocity
          );

      return {
        success:
          true,

        type:
          'inventory',

        items,

        fastMovers:
          items.slice(
            0,
            20
          ),

        slowMovers:
          [...items]
            .sort(
              (a, b) =>
                a.velocity -
                b.velocity
            )
            .slice(
              0,
              20
            )
      };
    }

    case 'purchase-overview':
    case 'purchase-opportunities': {
      if (!branch) {
        return aggregatePurchasesAllBranches({
          fromDate,
          toDate
        });
      }

      return aggregatePurchases({
        branchId:
          branch,
        fromDate,
        toDate,
        connection
      });
    }
    case 'interbranch-exchanges': {
      if (!branch) {
        return aggregateInterbranchExchangesAllBranches({
          fromDate,
          toDate
        });
      }

      return aggregateInterbranchExchanges({
        branchId:
          branch,

        fromDate,
        toDate,

        connection
      });
    }
    case 'supplier-performance': {
      if (!branch) {
        return aggregateSuppliersAllBranches({
          fromDate,
          toDate
        });
      }

      return aggregateSuppliers({
        branchId:
          branch,
        fromDate,
        toDate,
        connection
      });
    }


    case 'profit-overview':
    case 'profit-branch':
    case 'profit-product':
    case 'profit-anomalies': {
      if (!branch) {
        return getGroupSalesOverview({
          fromDate,
          toDate
        });
      }

      if (
        moduleId ===
        'profit-product'
      ) {
        return getProductProfitability({
          branchId:
            branch,
          connection,
          fromDate,
          toDate,
          limit:
            50,
          negativeMarginLimit:
            30
        });
      }

      const s =
        await getSalesSummary({
          branchId:
            branch,
          fromDate,
          toDate,
          connection
        });

      return {
        success:
          true,

        type:
          'profit',

        summary:
          s
      };
    }

    case 'branch-overview':
    case 'branch-comparison':
    case 'branch-ranking':
      return getGroupSalesOverview({
        fromDate,
        toDate
      });

    case 'staff-overview':
    case 'staff-sales':
    case 'staff-productivity':
      return branch
        ? aggregateStaff({
            branchId:
              branch,
            fromDate,
            toDate,
            connection
          })
        : {
            success:
              false,
            message:
              'ط§ط®طھط± ظپط±ط¹ظ‹ط§ ظ„طھط­طظظٹظ„ ط§ظ„ظ…ط¸ظپظٹظ†.'
          };

    case 'forecast-sales':
    case 'forecast-demand':
    case 'forecast-inventory': {
      if (!branch) {
        return {
          success:
            false,
          message:
            'اختر فرعًا للت؆بؤ.'
        };
      }

      const trend =
        await getSalesByDay({
          branchId:
            branch,
          fromDate,
          toDate,
          connection
        });

      return {
        success:
          true,

        type:
          'forecast',

        forecast:
          forecastFromTrend(
            trend
          )
      };
    }

    case 'quality-overview':
    case 'quality-cost': {
      if (!branch) {
        return {
          success:
            false,
          message:
            'اختر فرعًا لفحص جودة البيانات.'
        };
      }

      const rows =
        await getSales({
          branchId:
            branch,
          fromDate,
          toDate,
          connection
        });

      return {
        success:
          true,

        type:
          'quality',

        quality:
          qualityFromRows(
            rows
          )
      };
    }

    case 'quality-reconciliation': {
      if (!branch) {
        return {
          success:
            false,
          message:
            'اختر فرعًا للمطابقة.'
        };
      }

      const s =
        await getSalesSummary({
          branchId:
            branch,
          fromDate,
          toDate,
          connection
        });

      return {
        success:
          true,

        type:
          'reconciliation',

        reconciliation:
          s.reconciliation
      };
    }

    case 'performance':
      return branch
        ? getSalesPerformance({
            branchId:
              branch,
            fromDate,
            toDate,
            connection
          })
        : getGroupSalesOverview({
            fromDate,
            toDate
          });

    case 'connections':
      return {
        success:
          true,
        type:
          'system'
      };

    case 'cache':
      return {
        success:
          true,
        type:
          'system'
      };

    default:
      return branch
        ? getSalesSummary({
            branchId:
              branch,
            fromDate,
            toDate,
            connection
          })
        : getGroupSalesOverview({
            fromDate,
            toDate
          });
  }
}

export default {
  getAnalyticsModule
};