          n(row.movements),

        outgoingCount:
          acc.outgoingCount +
          n(row.outgoingCount),

        incomingCount:
          acc.incomingCount +
          n(row.incomingCount),

        outgoingTotal:
          acc.outgoingTotal +
          n(row.outgoingTotal),

        incomingTotal:
          acc.incomingTotal +
          n(row.incomingTotal),

        outgoingPacks:
          acc.outgoingPacks +
          n(row.outgoingPacks),

        incomingPacks:
          acc.incomingPacks +
          n(row.incomingPacks),

        outgoingUnits:
          acc.outgoingUnits +
          n(row.outgoingUnits),

        incomingUnits:
          acc.incomingUnits +
          n(row.incomingUnits),

        netTotal:
          acc.netTotal +
          n(row.netTotal)
      }),
      {
        movements: 0,
        outgoingCount: 0,
        incomingCount: 0,
        outgoingTotal: 0,
        incomingTotal: 0,
        outgoingPacks: 0,
        incomingPacks: 0,
        outgoingUnits: 0,
        incomingUnits: 0,
        netTotal: 0
      }
    );

  total.outgoingTotal =
    r(total.outgoingTotal);

  total.incomingTotal =
    r(total.incomingTotal);

  total.outgoingPacks =
    r(total.outgoingPacks);

  total.incomingPacks =
    r(total.incomingPacks);

  total.outgoingUnits =
    r(total.outgoingUnits);

  total.incomingUnits =
    r(total.incomingUnits);

  total.netTotal =
    r(total.netTotal);

  return {
    success: true,

    type:
      'exchange-group',

    branchCount:
      branches.length,

    failedBranches,

    branches,

    total
  };
}
