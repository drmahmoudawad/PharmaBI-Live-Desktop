function n(v) {
  const x = Number(v);
  return Number.isFinite(x) ? x : 0;
}

function r(v, d = 2) {
  return Number(n(v).toFixed(d));
}

function id(v) {
  const x = Number(v);

  if (!Number.isInteger(x) || x <= 0) {
    throw new Error('Invalid branchId');
  }

  return x;
}

function daysBetween(a, b) {
  const x = new Date(`${a}T00:00:00Z`);
  const y = new Date(`${b}T00:00:00Z`);

  return Math.max(
    1,
    Math.round((y - x) / 86400000) + 1
  );
}

function pct(a, b) {
  return n(b) === 0
    ? (n(a) === 0 ? 0 : null)
    : r(
        ((n(a) - n(b)) / Math.abs(n(b))) * 100,
        1
      );
}

async function branchContext(branchId, connection) {
  const branch = id(branchId);
  const pool = await getBranchPool(branch, connection);

  return {
    branchId: branch,
    pool
  };
}

async function aggregateStaff({
  branchId,
  fromDate,
  toDate,
  connection
}) {
  const rows = await getSales({
    branchId,
    fromDate,
    toDate,
    connection
  });

  const map = new Map();

  for (const row of rows) {
    const key =
      row.salesRepId ||
      'UNASSIGNED';

    if (!map.has(key)) {
      map.set(key, {
        sellerId: key,
        sales: 0,
        tickets: new Set(),
        units: 0
      });
    }

    const b = map.get(key);

    if (row.transactionType === 'RETURN') {
      b.sales -=
        Math.abs(
          n(row.netLineValue)
        );
    } else {
      b.sales +=
        n(row.netLineValue);
    }

    b.units +=
      row.transactionType === 'RETURN'
        ? -Math.abs(
            n(row.baseUnits)
          )
        : n(row.baseUnits);

    b.tickets.add(
      row.ticketId
    );
  }

  const result =
    [...map.values()]
      .map(x => ({
        sellerId:
          String(
            x.sellerId
          ),

        sales:
          r(x.sales),

        invoices:
          x.tickets.size,

        averageInvoice:
          r(
            x.tickets.size
              ? x.sales /
                x.tickets.size
              : 0
          ),

        units:
          r(x.units)
      }))
      .sort(
        (a, b) =>
          b.sales -
          a.sales
      );

  return {
    success: true,
    branchId:
      id(branchId),
    fromDate,
    toDate,
    sellers:
      result,
    totals: {
      sales:
        r(
          result.reduce(
            (s, x) =>
              s + x.sales,
            0
          )
        ),

      invoices:
        result.reduce(
          (s, x) =>
            s + x.invoices,
          0
        )
    }
  };
}

/*
 * =========================================================
 * PURCHASE ANALYTICS
 *
 * Purchase profit:
 *
 * Net purchase before discount
 *   = gross purchases before discount
 *     - gross purchase returns before discount
 *
 * Net actual purchase cost
 *   = PurchaseInvoices.total for purchases
 *     - purchase return totals
 *
 * Purchase profit
 *   = net purchase before discount
 *     - net actual purchase cost
 *
 * CostPrice is NOT used here.
 * =========================================================
 */

async function aggregatePurchases({
  branchId,
  fromDate,
  toDate,
  connection
}) {
  const { pool } =
    await branchContext(
      branchId,
      connection
    );

  const rangeTo =
    new Date(
      `${toDate}T00:00:00Z`
    );

  rangeTo.setUTCDate(
    rangeTo.getUTCDate() + 1
  );

  const toEx =
    rangeTo
      .toISOString()
      .slice(0, 10);

  const result =
    await pool
      .request()
      .input(
        'fromDate',
        `${fromDate} 00:00:00`
      )
      .input(
        'toDateExclusive',
        `${toEx} 00:00:00`
      )
      .query(`
        SET NOCOUNT ON;

        WITH InvoiceScope AS (
          SELECT
            pi.ID,
            pi.vendor_id,
            pi.SalesReturn,
            pi.total,
            COALESCE(
              pi.ztime,
              pi.inv_date
            ) AS PurchaseDate
          FROM PurchaseInvoices pi
          WHERE
            COALESCE(
              pi.ztime,
              pi.inv_date
            ) >= @fromDate
            AND
            COALESCE(
              pi.ztime,
              pi.inv_date
            ) < @toDateExclusive
        ),

        LineScope AS (
          SELECT
            p.ID,
            p.inv_id,
            p.item_id,
            p.packs,
            p.units,
            p.sprice,
            i.Parts,
            s.SalesReturn
          FROM PurchaseItems p
          INNER JOIN InvoiceScope s
            ON s.ID = p.inv_id
          LEFT JOIN Items i
            ON i.ID = p.item_id
        )

        SELECT

          (
            SELECT COUNT(*)
            FROM InvoiceScope
          ) AS invoices,

          (
            SELECT COUNT(*)
            FROM InvoiceScope
            WHERE SalesReturn = 1
          ) AS purchaseInvoices,

          (
            SELECT COUNT(*)
            FROM InvoiceScope
            WHERE SalesReturn = 2
          ) AS returnInvoices,

          (
            SELECT COUNT(*)
            FROM LineScope
          ) AS lines,

          (
            SELECT COUNT(DISTINCT item_id)
            FROM LineScope
            WHERE
              item_id IS NOT NULL
              AND item_id <> 0
          ) AS items,

          (
            SELECT COUNT(DISTINCT vendor_id)
            FROM InvoiceScope
            WHERE vendor_id IS NOT NULL
          ) AS suppliers,

          (
            SELECT COALESCE(
              SUM(
                CASE
                  WHEN SalesReturn = 1
                  THEN COALESCE(total, 0)
                  ELSE 0
                END
              ),
              0
            )
            FROM InvoiceScope
          ) AS purchaseTotal,

          (
            SELECT COALESCE(
              SUM(
                CASE
                  WHEN SalesReturn = 2
                  THEN ABS(
                    COALESCE(total, 0)
                  )
                  ELSE 0
                END
              ),
              0
            )
            FROM InvoiceScope
          ) AS returnTotal,

          (
            SELECT COALESCE(
              SUM(
                CASE
                  WHEN
                    SalesReturn = 1
                    AND item_id <> 0
                  THEN
                    COALESCE(
                      sprice,
                      0
                    )
                    *
                    (
                      COALESCE(
                        packs,
                        0
                      )
                      +
                      (
                        COALESCE(
                          units,
                          0
                        )
                        /
                        CASE
                          WHEN
                            COALESCE(
                              Parts,
                              0
                            ) > 0
                          THEN Parts
                          ELSE 1
                        END
                      )
                    )
                  ELSE 0
                END
              ),
              0
            )
            FROM LineScope
          ) AS grossPurchaseBeforeDiscount,

          (
            SELECT COALESCE(
              SUM(
                CASE
                  WHEN
                    SalesReturn = 2
                    AND item_id <> 0
                  THEN
                    COALESCE(
                      sprice,
                      0
                    )
                    *
                    (
                      COALESCE(
                        packs,
                        0
                      )
                      +
                      (
                        COALESCE(
                          units,
                          0
                        )
                        /
                        CASE
                          WHEN
                            COALESCE(
                              Parts,
                              0
                            ) > 0
                          THEN Parts
                          ELSE 1
                        END
                      )
                    )
                  ELSE 0
                END
              ),
              0
            )
            FROM LineScope
          ) AS grossReturnsBeforeDiscount;
      `);

  const x =
    result.recordset?.[0] ||
    {};

  const invoices =
    n(x.invoices);

  const purchaseInvoices =
    n(x.purchaseInvoices);

  const returnInvoices =
    n(x.returnInvoices);

  const lines =
    n(x.lines);

  const items =
    n(x.items);

  const suppliers =
    n(x.suppliers);

  const purchaseTotal =
    n(x.purchaseTotal);

  const returnTotal =
    n(x.returnTotal);

  const grossPurchaseBeforeDiscount =
    n(
      x.grossPurchaseBeforeDiscount
    );

  const grossReturnsBeforeDiscount =
    n(
      x.grossReturnsBeforeDiscount
    );

  const netPurchaseBeforeDiscount =
    grossPurchaseBeforeDiscount -
    grossReturnsBeforeDiscount;

  const netPurchaseCost =
    purchaseTotal -
    returnTotal;

  const purchaseProfit =
    netPurchaseBeforeDiscount -
    netPurchaseCost;

  const purchaseMarginPercent =
    netPurchaseBeforeDiscount !== 0
      ? (
          purchaseProfit /
          netPurchaseBeforeDiscount
        ) *
        100
      : 0;

  const salesSummary =
    await getSalesSummary({
      branchId,
      fromDate,
      toDate,
      connection
    });

  return {
    success: true,

    branchId:
      id(branchId),

    fromDate,
    toDate,

    invoices,
    purchaseInvoices,
    returnInvoices,

    lines,
    items,
    suppliers,

    /*
     * Backward compatibility
     * with existing UI.
     */
    purchaseValue:
      r(netPurchaseCost),

    purchaseTotal:
      r(purchaseTotal),

    returnTotal:
      r(returnTotal),

    netPurchaseCost:
      r(netPurchaseCost),

    grossPurchaseBeforeDiscount:
      r(
        grossPurchaseBeforeDiscount
      ),

    grossReturnsBeforeDiscount:
      r(
        grossReturnsBeforeDiscount
      ),

    netPurchaseBeforeDiscount:
      r(
        netPurchaseBeforeDiscount
      ),

    purchaseProfit:
      r(purchaseProfit),

    purchaseMarginPercent:
      r(
        purchaseMarginPercent,
        2
      ),

    salesTotal:
      r(
        salesSummary?.netSales
      ),

    salesProfit:
      r(
        salesSummary?.netProfit
      ),

    salesMarginPercent:
      r(
        salesSummary?.grossMargin,
        2
      )
  };
}

/*
 * =========================================================
 * SUPPLIER PURCHASE ANALYTICS
 *
 * Every supplier gets:
 *
 * - invoices
 * - lines
 * - items
 * - purchaseTotal
 * - returnTotal
 * - netPurchaseCost
 * - grossPurchaseBeforeDiscount
 * - grossReturnsBeforeDiscount
 * - netPurchaseBeforeDiscount
 * - purchaseProfit
 * - purchaseMarginPercent
 *
 * Same exact purchase-profit formula used above.
 * =========================================================
 */

async function aggregateSuppliers({
  branchId,
  fromDate,
  toDate,
  connection
}) {
  const { pool } =
    await branchContext(
      branchId,
      connection
    );

  const next =
    new Date(
      `${toDate}T00:00:00Z`
    );

  next.setUTCDate(
    next.getUTCDate() + 1
  );

  const toEx =
    next
      .toISOString()
      .slice(0, 10);

  const result =
    await pool
      .request()
      .input(
        'fromDate',
        `${fromDate} 00:00:00`
      )
      .input(
        'toDateExclusive',
        `${toEx} 00:00:00`
      )
      .query(`
        SET NOCOUNT ON;

        WITH InvoiceScope AS (
          SELECT
            pi.ID,
            pi.vendor_id,
            pi.SalesReturn,

            COALESCE(
              pi.total,
              0
            ) AS total

          FROM PurchaseInvoices pi

          WHERE
            COALESCE(
              pi.ztime,
              pi.inv_date
            ) >= @fromDate

            AND

            COALESCE(
              pi.ztime,
              pi.inv_date
            ) < @toDateExclusive
        ),

        SupplierInvoiceTotals AS (
          SELECT
            vendor_id,

            COUNT(*) AS invoices,

            SUM(
              CASE
                WHEN SalesReturn = 1
                THEN total
                ELSE 0
              END
            ) AS purchaseTotal,

            SUM(
              CASE
                WHEN SalesReturn = 2
                THEN ABS(total)
                ELSE 0
              END
            ) AS returnTotal

          FROM InvoiceScope

          GROUP BY
            vendor_id
        ),

        SupplierLineTotals AS (
          SELECT
            s.vendor_id,

            COUNT(
              p.ID
            ) AS lines,

            COUNT(
              DISTINCT
              CASE
                WHEN
                  p.item_id IS NOT NULL
                  AND
                  p.item_id <> 0
                THEN p.item_id
              END
            ) AS items,

            SUM(
              CASE
                WHEN
                  s.SalesReturn = 1
                THEN
                  ABS(
                    COALESCE(
                      p.packs,
                      0
                    )
                  )
                ELSE 0
              END
            ) AS purchasePacks,

            SUM(
              CASE
                WHEN
                  s.SalesReturn = 2
                THEN
                  ABS(
                    COALESCE(
                      p.packs,
                      0
                    )
                  )
                ELSE 0
              END
            ) AS returnPacks,

            SUM(
              CASE
                WHEN
                  s.SalesReturn = 1
                THEN
                  ABS(
                    COALESCE(
                      p.units,
                      0
                    )
                  )
                ELSE 0
              END
            ) AS purchaseUnits,

            SUM(
              CASE
                WHEN
                  s.SalesReturn = 2
                THEN
                  ABS(
                    COALESCE(
                      p.units,
                      0
                    )
                  )
                ELSE 0
              END
            ) AS returnUnits,

            SUM(
              CASE
                WHEN
                  s.SalesReturn = 1
                  AND
                  p.item_id <> 0
                THEN
                  COALESCE(
                    p.sprice,
                    0
                  )
                  *
                  (
                    COALESCE(
                      p.packs,
                      0
                    )
                    +
                    (
                      COALESCE(
                        p.units,
                        0
                      )
                      /
                      CASE
                        WHEN
                          COALESCE(
                            i.Parts,
                            0
                          ) > 0
                        THEN i.Parts
                        ELSE 1
                      END
                    )
                  )
                ELSE 0
              END
            ) AS grossPurchaseBeforeDiscount,

            SUM(
              CASE
                WHEN
                  s.SalesReturn = 2
                  AND
                  p.item_id <> 0
                THEN
                  COALESCE(
                    p.sprice,
                    0
                  )
                  *
                  (
                    COALESCE(
                      p.packs,
                      0
                    )
                    +
                    (
                      COALESCE(
                        p.units,
                        0
                      )
                      /
                      CASE
                        WHEN
                          COALESCE(
                            i.Parts,
                            0
                          ) > 0
                        THEN i.Parts
                        ELSE 1
                      END
                    )
                  )
                ELSE 0
              END
            ) AS grossReturnsBeforeDiscount

          FROM InvoiceScope s

          INNER JOIN PurchaseItems p
            ON p.inv_id = s.ID

          LEFT JOIN Items i
            ON i.ID = p.item_id

          GROUP BY
            s.vendor_id
        )

        SELECT TOP 100

          COALESCE(
            NULLIF(
              LTRIM(
                RTRIM(
                  c.Name
                )
              ),
              ''
            ),
            CONVERT(
              varchar(64),
              i.vendor_id
            ),
            'UNASSIGNED'
          ) AS supplierName,

          COALESCE(
            CONVERT(
              varchar(64),
              i.vendor_id
            ),
            'UNASSIGNED'
          ) AS supplierId,

          COALESCE(
            i.invoices,
            0
          ) AS invoices,

          COALESCE(
            l.lines,
            0
          ) AS lines,

          COALESCE(
            l.items,
            0
          ) AS items,

          COALESCE(
            i.purchaseTotal,
            0
          ) AS purchaseTotal,

          COALESCE(
            i.returnTotal,
            0
          ) AS returnTotal,

          (
            COALESCE(
              i.purchaseTotal,
              0
            )
            -
            COALESCE(
              i.returnTotal,
              0
            )
          ) AS netPurchaseCost,

          COALESCE(
            l.purchasePacks,
            0
          ) AS purchasePacks,

          COALESCE(
            l.returnPacks,
            0
          ) AS returnPacks,

          (
            COALESCE(
              l.purchasePacks,
              0
            )
            -
            COALESCE(
              l.returnPacks,
              0
            )
          ) AS netPacks,

          COALESCE(
            l.purchaseUnits,
            0
          ) AS purchaseUnits,

          COALESCE(
            l.returnUnits,
            0
          ) AS returnUnits,

          (
            COALESCE(
              l.purchaseUnits,
              0
            )
            -
            COALESCE(
              l.returnUnits,
              0
            )
          ) AS netUnits,

          COALESCE(
            l.grossPurchaseBeforeDiscount,
            0
          ) AS grossPurchaseBeforeDiscount,

          COALESCE(
            l.grossReturnsBeforeDiscount,
            0
          ) AS grossReturnsBeforeDiscount,

          (
            COALESCE(
              l.grossPurchaseBeforeDiscount,
              0
            )
            -
            COALESCE(
              l.grossReturnsBeforeDiscount,
              0
            )
          ) AS netPurchaseBeforeDiscount,

          (
            (
              COALESCE(
                l.grossPurchaseBeforeDiscount,
                0
              )
              -
              COALESCE(
                l.grossReturnsBeforeDiscount,
                0
              )
            )
            -
            (
              COALESCE(
                i.purchaseTotal,
                0
              )
              -
              COALESCE(
                i.returnTotal,
                0
              )
            )
          ) AS purchaseProfit

        FROM SupplierInvoiceTotals i

        LEFT JOIN Cards c
          ON c.ID = i.vendor_id

        LEFT JOIN SupplierLineTotals l
          ON
            (
              l.vendor_id =
                i.vendor_id

              OR

              (
                l.vendor_id IS NULL
                AND
                i.vendor_id IS NULL
              )
            )

        ORDER BY
          purchaseProfit DESC;
      `);

  return {
    success: true,

    branchId:
      id(branchId),

    fromDate,

    toDate,

    suppliers:
      (
        result.recordset ||
        []
      ).map(x => {

        const netPurchaseBeforeDiscount =
          n(
            x.netPurchaseBeforeDiscount
          );

        const purchaseProfit =
          n(
            x.purchaseProfit
          );

        return {
          supplierId:
            String(
              x.supplierId
            ),

          supplierName:
            String(
              x.supplierName ||
              x.supplierId ||
              'UNASSIGNED'
            ),

          invoices:
            n(x.invoices),

          lines:
            n(x.lines),

          items:
            n(x.items),

          purchaseTotal:
            r(
              x.purchaseTotal
            ),

          returnTotal:
            r(
              x.returnTotal
            ),

          netPurchaseCost:
            r(
              x.netPurchaseCost
            ),

          purchasePacks:
            r(
              x.purchasePacks
            ),

          returnPacks:
            r(
              x.returnPacks
            ),

          netPacks:
            r(
              x.netPacks
            ),

          purchaseUnits:
            r(
              x.purchaseUnits
            ),

          returnUnits:
            r(
              x.returnUnits
            ),

          netUnits:
            r(
              x.netUnits
            ),

          grossPurchaseBeforeDiscount:
            r(
              x.grossPurchaseBeforeDiscount
            ),

          grossReturnsBeforeDiscount:
            r(
              x.grossReturnsBeforeDiscount
            ),

          netPurchaseBeforeDiscount:
            r(
              netPurchaseBeforeDiscount
            ),

          purchaseProfit:
            r(
              purchaseProfit
            ),

          purchaseMarginPercent:
            netPurchaseBeforeDiscount !== 0
              ? r(
                  (
                    purchaseProfit /
                    netPurchaseBeforeDiscount
                  ) * 100
                )
              : 0,

          purchaseValue:
            r(
              x.netPurchaseCost
            )
        };
      })
  };
}
async function aggregateSuppliersAllBranches({
  fromDate,
  toDate
}) {
  const connections =
    getAllSavedConnections()
      .slice()
      .sort(
        (a, b) =>
          Number(a.branchId || 0) -
          Number(b.branchId || 0)
      );

  const supplierMap =
    new Map();

  for (const branch of connections) {

    const result =
      await aggregateSuppliers({
        branchId:
          branch.branchId,

        fromDate,

        toDate,

        connection:
          branch
      });

    const rows =
      Array.isArray(
        result?.suppliers
      )
        ? result.suppliers
        : [];

    for (const row of rows) {

      const supplierName =
        String(
          row?.supplierName ??
          row?.supplierId ??
          ''
        ).trim();

      if (!supplierName) {
        continue;
      }

      const key =
        supplierName.toLocaleLowerCase(
          'ar-EG'
        );

      if (!supplierMap.has(key)) {

        supplierMap.set(
          key,
          {
            supplierId:
              `GROUP:${key}`,

            supplierName,

            invoices: 0,
            lines: 0,
            items: 0,

            purchaseTotal: 0,
            returnTotal: 0,
            netPurchaseCost: 0,

            purchasePacks: 0,
            returnPacks: 0,
            netPacks: 0,

            purchaseUnits: 0,
            returnUnits: 0,
            netUnits: 0,

            grossPurchaseBeforeDiscount: 0,
            grossReturnsBeforeDiscount: 0,

            netPurchaseBeforeDiscount: 0,
            purchaseProfit: 0
          }
        );

      }

      const target =
        supplierMap.get(key);

      target.invoices +=
        n(row?.invoices);

      target.lines +=
        n(row?.lines);

      target.items +=
        n(row?.items);

      target.purchaseTotal +=
        n(row?.purchaseTotal);

      target.returnTotal +=
        n(row?.returnTotal);

      target.netPurchaseCost +=
        n(row?.netPurchaseCost);

      target.purchasePacks +=
        n(row?.purchasePacks);

      target.returnPacks +=
        n(row?.returnPacks);

      target.netPacks +=
        n(row?.netPacks);

      target.purchaseUnits +=
        n(row?.purchaseUnits);

      target.returnUnits +=
        n(row?.returnUnits);

      target.netUnits +=
        n(row?.netUnits);

      target.grossPurchaseBeforeDiscount +=
        n(
          row?.grossPurchaseBeforeDiscount
        );

      target.grossReturnsBeforeDiscount +=
        n(
          row?.grossReturnsBeforeDiscount
        );

      target.netPurchaseBeforeDiscount +=
        n(
          row?.netPurchaseBeforeDiscount
        );

      target.purchaseProfit +=
        n(
          row?.purchaseProfit
        );
    }
  }

  const suppliers =
    Array.from(
      supplierMap.values()
    )
      .map(row => ({

        ...row,

        purchaseTotal:
          r(
            row.purchaseTotal
          ),

        returnTotal:
          r(
            row.returnTotal
          ),

        netPurchaseCost:
          r(
            row.netPurchaseCost
          ),

        purchasePacks:
          r(
            row.purchasePacks
          ),

        returnPacks:
          r(
            row.returnPacks
          ),

        netPacks:
          r(
            row.netPacks
          ),

        purchaseUnits:
          r(
            row.purchaseUnits
          ),

        returnUnits:
          r(
