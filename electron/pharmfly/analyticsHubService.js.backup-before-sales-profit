function n(v) {
  const x = Number(v);
  return Number.isFinite(x) ? x : 0;
}

function r(v, d = 2) {
  return Number(n(v).toFixed(d));
}

function id(v) {
  const x = Number(v);

  if (!Number.isInteger(x) || x <= 0) {
    throw new Error('Invalid branchId');
  }

  return x;
}

function daysBetween(a, b) {
  const x = new Date(`${a}T00:00:00Z`);
  const y = new Date(`${b}T00:00:00Z`);

  return Math.max(
    1,
    Math.round((y - x) / 86400000) + 1
  );
}

function pct(a, b) {
  return n(b) === 0
    ? (n(a) === 0 ? 0 : null)
    : r(
        ((n(a) - n(b)) / Math.abs(n(b))) * 100,
        1
      );
}

async function branchContext(branchId, connection) {
  const branch = id(branchId);
  const pool = await getBranchPool(branch, connection);

  return {
    branchId: branch,
    pool
  };
}

async function aggregateStaff({
  branchId,
  fromDate,
  toDate,
  connection
}) {
  const rows = await getSales({
    branchId,
    fromDate,
    toDate,
    connection
  });

  const map = new Map();

  for (const row of rows) {
    const key =
      row.salesRepId ||
      'UNASSIGNED';

    if (!map.has(key)) {
      map.set(key, {
        sellerId: key,
        sales: 0,
        tickets: new Set(),
        units: 0
      });
    }

    const b = map.get(key);

    if (row.transactionType === 'RETURN') {
      b.sales -=
        Math.abs(
          n(row.netLineValue)
        );
    } else {
      b.sales +=
        n(row.netLineValue);
    }

    b.units +=
      row.transactionType === 'RETURN'
        ? -Math.abs(
            n(row.baseUnits)
          )
        : n(row.baseUnits);

    b.tickets.add(
      row.ticketId
    );
  }

  const result =
    [...map.values()]
      .map(x => ({
        sellerId:
          String(
            x.sellerId
          ),

        sales:
          r(x.sales),

        invoices:
          x.tickets.size,

        averageInvoice:
          r(
            x.tickets.size
              ? x.sales /
                x.tickets.size
              : 0
          ),

        units:
          r(x.units)
      }))
      .sort(
        (a, b) =>
          b.sales -
          a.sales
      );

  return {
    success: true,
    branchId:
      id(branchId),
    fromDate,
    toDate,
    sellers:
      result,
    totals: {
      sales:
        r(
          result.reduce(
            (s, x) =>
              s + x.sales,
            0
          )
        ),

      invoices:
        result.reduce(
          (s, x) =>
            s + x.invoices,
          0
        )
    }
  };
}

/*
 * =========================================================
 * PURCHASE ANALYTICS
 *
 * Purchase profit:
 *
 * Net purchase before discount
 *   = gross purchases before discount
 *     - gross purchase returns before discount
 *
 * Net actual purchase cost
 *   = PurchaseInvoices.total for purchases
 *     - purchase return totals
 *
 * Purchase profit
 *   = net purchase before discount
 *     - net actual purchase cost
 *
 * CostPrice is NOT used here.
 * =========================================================
 */

async function aggregatePurchases({
  branchId,
  fromDate,
  toDate,
  connection
}) {
  const { pool } =
    await branchContext(
      branchId,
      connection
    );

  const rangeTo =
    new Date(
      `${toDate}T00:00:00Z`
    );

  rangeTo.setUTCDate(
    rangeTo.getUTCDate() + 1
  );

  const toEx =
    rangeTo
      .toISOString()
      .slice(0, 10);

  const result =
    await pool
      .request()
      .input(
        'fromDate',
        `${fromDate} 00:00:00`
      )
      .input(
        'toDateExclusive',
        `${toEx} 00:00:00`
      )
      .query(`
        SET NOCOUNT ON;

        WITH InvoiceScope AS (
          SELECT
            pi.ID,
            pi.vendor_id,
            pi.SalesReturn,
            pi.total,
            COALESCE(
              pi.ztime,
              pi.inv_date
            ) AS PurchaseDate
          FROM PurchaseInvoices pi
          WHERE
            COALESCE(
              pi.ztime,
              pi.inv_date
            ) >= @fromDate
            AND
            COALESCE(
              pi.ztime,
              pi.inv_date
            ) < @toDateExclusive
        ),

        LineScope AS (
          SELECT
            p.ID,
            p.inv_id,
            p.item_id,
            p.packs,
            p.units,
            p.sprice,
            i.Parts,
            s.SalesReturn
          FROM PurchaseItems p
          INNER JOIN InvoiceScope s
            ON s.ID = p.inv_id
          LEFT JOIN Items i
            ON i.ID = p.item_id
        )

        SELECT

          (
            SELECT COUNT(*)
            FROM InvoiceScope
          ) AS invoices,

          (
            SELECT COUNT(*)
            FROM InvoiceScope
            WHERE SalesReturn = 1
          ) AS purchaseInvoices,

          (
            SELECT COUNT(*)
            FROM InvoiceScope
            WHERE SalesReturn = 2
          ) AS returnInvoices,

          (
            SELECT COUNT(*)
            FROM LineScope
          ) AS lines,

          (
            SELECT COUNT(DISTINCT item_id)
            FROM LineScope
            WHERE
              item_id IS NOT NULL
              AND item_id <> 0
          ) AS items,

          (
            SELECT COUNT(DISTINCT vendor_id)
            FROM InvoiceScope
            WHERE vendor_id IS NOT NULL
          ) AS suppliers,

          (
            SELECT COALESCE(
              SUM(
                CASE
                  WHEN SalesReturn = 1
                  THEN COALESCE(total, 0)
                  ELSE 0
                END
              ),
              0
            )
            FROM InvoiceScope
          ) AS purchaseTotal,

          (
            SELECT COALESCE(
              SUM(
                CASE
                  WHEN SalesReturn = 2
                  THEN ABS(
                    COALESCE(total, 0)
                  )
                  ELSE 0
                END
              ),
              0
            )
            FROM InvoiceScope
          ) AS returnTotal,

          (
            SELECT COALESCE(
              SUM(
                CASE
                  WHEN
                    SalesReturn = 1
                    AND item_id <> 0
                  THEN
                    COALESCE(
                      sprice,
                      0
                    )
                    *
                    (
                      COALESCE(
                        packs,
                        0
                      )
                      +
                      (
                        COALESCE(
                          units,
                          0
                        )
                        /
                        CASE
                          WHEN
                            COALESCE(
                              Parts,
                              0
                            ) > 0
                          THEN Parts
                          ELSE 1
                        END
                      )
                    )
                  ELSE 0
                END
              ),
              0
            )
            FROM LineScope
          ) AS grossPurchaseBeforeDiscount,

          (
            SELECT COALESCE(
              SUM(
                CASE
                  WHEN
                    SalesReturn = 2
                    AND item_id <> 0
                  THEN
                    COALESCE(
                      sprice,
                      0
                    )
                    *
                    (
                      COALESCE(
                        packs,
                        0
                      )
                      +
                      (
                        COALESCE(
                          units,
                          0
                        )
                        /
                        CASE
                          WHEN
                            COALESCE(
                              Parts,
                              0
                            ) > 0
                          THEN Parts
                          ELSE 1
                        END
                      )
                    )
                  ELSE 0
                END
              ),
              0
            )
            FROM LineScope
          ) AS grossReturnsBeforeDiscount;
      `);

  const x =
    result.recordset?.[0] ||
    {};

  const invoices =
    n(x.invoices);

  const purchaseInvoices =
    n(x.purchaseInvoices);

  const returnInvoices =
    n(x.returnInvoices);

  const lines =
    n(x.lines);

  const items =
    n(x.items);

  const suppliers =
    n(x.suppliers);

  const purchaseTotal =
    n(x.purchaseTotal);

  const returnTotal =
    n(x.returnTotal);

  const grossPurchaseBeforeDiscount =
    n(
      x.grossPurchaseBeforeDiscount
    );

  const grossReturnsBeforeDiscount =
    n(
      x.grossReturnsBeforeDiscount
    );

  const netPurchaseBeforeDiscount =
    grossPurchaseBeforeDiscount -
    grossReturnsBeforeDiscount;

  const netPurchaseCost =
    purchaseTotal -
    returnTotal;

  const purchaseProfit =
    netPurchaseBeforeDiscount -
    netPurchaseCost;

  const purchaseMarginPercent =
    netPurchaseBeforeDiscount !== 0
      ? (
          purchaseProfit /
          netPurchaseBeforeDiscount
        ) *
        100
      : 0;

  return {
    success: true,

    branchId:
      id(branchId),

    fromDate,
    toDate,

    invoices,
    purchaseInvoices,
    returnInvoices,

    lines,
    items,
    suppliers,

    /*
     * Backward compatibility
     * with existing UI.
     */
    purchaseValue:
      r(netPurchaseCost),

    purchaseTotal:
      r(purchaseTotal),

    returnTotal:
      r(returnTotal),

    netPurchaseCost:
      r(netPurchaseCost),

    grossPurchaseBeforeDiscount:
      r(
        grossPurchaseBeforeDiscount
      ),

    grossReturnsBeforeDiscount:
      r(
        grossReturnsBeforeDiscount
      ),

    netPurchaseBeforeDiscount:
      r(
        netPurchaseBeforeDiscount
      ),

    purchaseProfit:
      r(purchaseProfit),

    purchaseMarginPercent:
      r(
        purchaseMarginPercent,
        2
      )
  };
}

/*
 * =========================================================
 * SUPPLIER PURCHASE ANALYTICS
 *
 * Every supplier gets:
 *
 * - invoices
 * - lines
 * - items
 * - purchaseTotal
 * - returnTotal
 * - netPurchaseCost
 * - grossPurchaseBeforeDiscount
 * - grossReturnsBeforeDiscount
 * - netPurchaseBeforeDiscount
 * - purchaseProfit
 * - purchaseMarginPercent
 *
 * Same exact purchase-profit formula used above.
 * =========================================================
 */

async function aggregateSuppliers({
  branchId,
  fromDate,
  toDate,
  connection
}) {
  const { pool } =
    await branchContext(
      branchId,
      connection
    );

  const next =
    new Date(
      `${toDate}T00:00:00Z`
    );

  next.setUTCDate(
    next.getUTCDate() + 1
  );

  const toEx =
    next
      .toISOString()
      .slice(0, 10);

  const result =
    await pool
      .request()
      .input(
        'fromDate',
        `${fromDate} 00:00:00`
      )
      .input(
        'toDateExclusive',
        `${toEx} 00:00:00`
      )
      .query(`
        SET NOCOUNT ON;

        WITH InvoiceScope AS (
          SELECT
            pi.ID,
            pi.vendor_id,
            pi.SalesReturn,
            COALESCE(
              pi.total,
              0
            ) AS total

          FROM PurchaseInvoices pi

          WHERE
            COALESCE(
              pi.ztime,
              pi.inv_date
            ) >= @fromDate

            AND

            COALESCE(
              pi.ztime,
              pi.inv_date
            ) < @toDateExclusive
        ),

        SupplierInvoiceTotals AS (
          SELECT

            vendor_id,

            COUNT(*) AS invoices,

            SUM(
              CASE
                WHEN SalesReturn = 1
                THEN total
                ELSE 0
              END
            ) AS purchaseTotal,

            SUM(
              CASE
                WHEN SalesReturn = 2
                THEN ABS(total)
                ELSE 0
              END
            ) AS returnTotal

          FROM InvoiceScope

          GROUP BY
            vendor_id
        ),

        SupplierLineTotals AS (
          SELECT

            s.vendor_id,

            COUNT(
              p.ID
            ) AS lines,

            COUNT(
              DISTINCT
              CASE
                WHEN
                  p.item_id IS NOT NULL
                  AND
                  p.item_id <> 0
                THEN p.item_id
              END
            ) AS items,

            SUM(
              CASE
                WHEN
                  s.SalesReturn = 1
                  AND
                  p.item_id <> 0
                THEN
                  COALESCE(
                    p.sprice,
                    0
                  )
                  *
                  (
                    COALESCE(
                      p.packs,
                      0
                    )
                    +
                    (
                      COALESCE(
                        p.units,
                        0
                      )
                      /
                      CASE
                        WHEN
                          COALESCE(
                            i.Parts,
                            0
                          ) > 0
                        THEN i.Parts
                        ELSE 1
                      END
                    )
                  )
                ELSE 0
              END
            )
            AS grossPurchaseBeforeDiscount,

            SUM(
              CASE
                WHEN
                  s.SalesReturn = 2
                  AND
                  p.item_id <> 0
                THEN
                  COALESCE(
                    p.sprice,
                    0
                  )
                  *
                  (
                    COALESCE(
                      p.packs,
                      0
                    )
                    +
                    (
                      COALESCE(
                        p.units,
                        0
                      )
                      /
                      CASE
                        WHEN
                          COALESCE(
                            i.Parts,
                            0
                          ) > 0
                        THEN i.Parts
                        ELSE 1
                      END
                    )
                  )
                ELSE 0
              END
            )
            AS grossReturnsBeforeDiscount

          FROM InvoiceScope s

          INNER JOIN PurchaseItems p
            ON p.inv_id = s.ID

          LEFT JOIN Items i
            ON i.ID = p.item_id

          GROUP BY
            s.vendor_id
        )

        SELECT TOP 100

          COALESCE(
            NULLIF(
              LTRIM(
                RTRIM(
                  c.Name
                )
              ),
              ''
            ),
            CONVERT(
              varchar(64),
              i.vendor_id
            ),
            'UNASSIGNED'
          ) AS supplierName,

          COALESCE(
            CONVERT(
              varchar(64),
              i.vendor_id
            ),
            'UNASSIGNED'
          ) AS supplierId,

          COALESCE(
            i.invoices,
            0
          ) AS invoices,

          COALESCE(
            l.lines,
            0
          ) AS lines,

          COALESCE(
            l.items,
            0
          ) AS items,

          COALESCE(
            i.purchaseTotal,
            0
          ) AS purchaseTotal,

          COALESCE(
            i.returnTotal,
            0
          ) AS returnTotal,

          (
            COALESCE(
              i.purchaseTotal,
              0
            )
            -
            COALESCE(
              i.returnTotal,
              0
            )
          ) AS netPurchaseCost,

          COALESCE(
            l.grossPurchaseBeforeDiscount,
            0
          ) AS grossPurchaseBeforeDiscount,

          COALESCE(
            l.grossReturnsBeforeDiscount,
            0
          ) AS grossReturnsBeforeDiscount,

          (
            COALESCE(
              l.grossPurchaseBeforeDiscount,
              0
            )
            -
            COALESCE(
              l.grossReturnsBeforeDiscount,
              0
            )
          ) AS netPurchaseBeforeDiscount,

          (
            (
              COALESCE(
                l.grossPurchaseBeforeDiscount,
                0
              )
              -
              COALESCE(
                l.grossReturnsBeforeDiscount,
                0
              )
            )
            -
            (
              COALESCE(
                i.purchaseTotal,
                0
              )
              -
              COALESCE(
                i.returnTotal,
                0
              )
            )
          ) AS purchaseProfit

        FROM SupplierInvoiceTotals i

        LEFT JOIN Cards c
          ON c.ID = i.vendor_id

        LEFT JOIN SupplierLineTotals l
          ON
            (
              l.vendor_id =
                i.vendor_id

              OR

              (
                l.vendor_id IS NULL
                AND
                i.vendor_id IS NULL
              )
            )

        ORDER BY
          purchaseProfit DESC;
      `);

  return {
    success: true,

    branchId:
      id(branchId),

    fromDate,
    toDate,

    suppliers:
      (
        result.recordset ||
        []
      ).map(x => {

        const netPurchaseBeforeDiscount =
          n(
            x.netPurchaseBeforeDiscount
          );

        const purchaseProfit =
          n(
            x.purchaseProfit
          );

        return {
          supplierId:
            String(
              x.supplierId
            ),

          supplierName:
            String(
              x.supplierName ||
              x.supplierId ||
              '??? ????'
            ),

          invoices:
            n(x.invoices),

          lines:
            n(x.lines),

          items:
            n(x.items),

          purchaseTotal:
            r(
              x.purchaseTotal
            ),

          returnTotal:
            r(
              x.returnTotal
            ),

          netPurchaseCost:
            r(
              x.netPurchaseCost
            ),

          grossPurchaseBeforeDiscount:
            r(
              x.grossPurchaseBeforeDiscount
            ),

          grossReturnsBeforeDiscount:
            r(
              x.grossReturnsBeforeDiscount
            ),

          netPurchaseBeforeDiscount:
            r(
              netPurchaseBeforeDiscount
            ),

          purchaseProfit:
            r(
              purchaseProfit
            ),

          purchaseMarginPercent:
            netPurchaseBeforeDiscount !== 0
              ? r(
                  (
                    purchaseProfit /
                    netPurchaseBeforeDiscount
                  ) * 100,
                  2
                )
              : 0,

          /*
           * Existing UI compatibility.
           */
          purchaseValue:
            r(
              x.netPurchaseCost
            )
        };
      })
  };
}


async function aggregateSuppliersAllBranches({
  fromDate,
  toDate
}) {
  const connections =
    getAllSavedConnections()
      .slice()
      .sort(
        (a, b) =>
          Number(a.branchId || 0) -
          Number(b.branchId || 0)
      );

  const supplierMap = new Map();

  for (const branch of connections) {
    const result =
      await aggregateSuppliers({
        branchId:
          branch.branchId,
        fromDate,
        toDate,
        connection:
          branch
      });

    const rows =
      Array.isArray(result?.suppliers)
        ? result.suppliers
        : [];

    for (const row of rows) {
      const supplierName =
        String(
          row?.supplierName ??
          row?.supplierId ??
          ''
        ).trim();

      if (!supplierName) {
        continue;
      }

      const key =
        supplierName.toLocaleLowerCase('ar-EG');

      if (!supplierMap.has(key)) {
        supplierMap.set(
          key,
          {
            supplierId:
              `GROUP:${key}`,

            supplierName,

            invoices: 0,
            lines: 0,
            items: 0,

            purchaseTotal: 0,
            returnTotal: 0,
            netPurchaseCost: 0,

            grossPurchaseBeforeDiscount: 0,
            grossReturnsBeforeDiscount: 0,

            netPurchaseBeforeDiscount: 0,
            purchaseProfit: 0
          }
        );
      }

      const target =
        supplierMap.get(key);

      target.invoices +=
        n(row?.invoices);

      target.lines +=
        n(row?.lines);

      target.items +=
        n(row?.items);

      target.purchaseTotal +=
        n(row?.purchaseTotal);

      target.returnTotal +=
        n(row?.returnTotal);

      target.netPurchaseCost +=
        n(row?.netPurchaseCost);

      target.grossPurchaseBeforeDiscount +=
        n(row?.grossPurchaseBeforeDiscount);

      target.grossReturnsBeforeDiscount +=
        n(row?.grossReturnsBeforeDiscount);

      target.netPurchaseBeforeDiscount +=
        n(row?.netPurchaseBeforeDiscount);

      target.purchaseProfit +=
        n(row?.purchaseProfit);
    }
  }

  const suppliers =
    Array.from(
      supplierMap.values()
    )
      .map(row => ({
        ...row,

        purchaseTotal:
          r(row.purchaseTotal),

        returnTotal:
          r(row.returnTotal),

        netPurchaseCost:
          r(row.netPurchaseCost),

        grossPurchaseBeforeDiscount:
          r(row.grossPurchaseBeforeDiscount),

        grossReturnsBeforeDiscount:
          r(row.grossReturnsBeforeDiscount),

        netPurchaseBeforeDiscount:
          r(row.netPurchaseBeforeDiscount),

        purchaseProfit:
          r(row.purchaseProfit),

        purchaseMarginPercent:
          row.netPurchaseBeforeDiscount !== 0
            ? r(
                (
                  row.purchaseProfit /
                  row.netPurchaseBeforeDiscount
                ) * 100,
                2
              )
            : 0,

        purchaseValue:
          r(row.netPurchaseCost)
      }))
      .sort(
        (a, b) =>
          b.purchaseProfit -
          a.purchaseProfit
      );

  const total =
    suppliers.reduce(
      (acc, row) => ({
        invoices:
          acc.invoices +
          n(row.invoices),

        lines:
          acc.lines +
          n(row.lines),

        items:
          acc.items +
          n(row.items),

        purchaseTotal:
          acc.purchaseTotal +
          n(row.purchaseTotal),

        returnTotal:
          acc.returnTotal +
          n(row.returnTotal),

        netPurchaseCost:
          acc.netPurchaseCost +
          n(row.netPurchaseCost),

        grossPurchaseBeforeDiscount:
          acc.grossPurchaseBeforeDiscount +
          n(row.grossPurchaseBeforeDiscount),

        grossReturnsBeforeDiscount:
          acc.grossReturnsBeforeDiscount +
          n(row.grossReturnsBeforeDiscount),

        netPurchaseBeforeDiscount:
          acc.netPurchaseBeforeDiscount +
          n(row.netPurchaseBeforeDiscount),

        purchaseProfit:
          acc.purchaseProfit +
          n(row.purchaseProfit)
      }),
      {
        invoices: 0,
        lines: 0,
        items: 0,
        purchaseTotal: 0,
        returnTotal: 0,
        netPurchaseCost: 0,
        grossPurchaseBeforeDiscount: 0,
        grossReturnsBeforeDiscount: 0,
        netPurchaseBeforeDiscount: 0,
        purchaseProfit: 0
      }
    );

  total.purchaseMarginPercent =
    total.netPurchaseBeforeDiscount !== 0
      ? r(
          (
            total.purchaseProfit /
            total.netPurchaseBeforeDiscount
          ) * 100,
          2
        )
      : 0;

  return {
    success: true,

    type: 'supplier-group',

    branchCount:
      connections.length,

    suppliers,

    total: {
      ...total
    }
  };
}
function qualityFromRows(rows) {
  let missingCost = 0;
  let zeroCost = 0;
  let suspicious = 0;
  let lines = 0;

  for (const row of rows) {
    lines++;

    const cost =
      n(row.lineCost);

    const source =
      n(row.sourcePosItemCost);

    if (!n(row.costPrice)) {
      missingCost++;
    }

    if (cost === 0) {
      zeroCost++;
    }

    if (source < 0) {
      suspicious++;
    }
  }

  return {
    lines,
    missingCost,
    zeroCost,
    suspicious,

    missingCostRate:
      lines
        ? r(
            (missingCost / lines) *
              100,
            1
          )
        : 0,

    zeroCostRate:
      lines
        ? r(
            (zeroCost / lines) *
              100,
            1
          )
        : 0
  };
}

function forecastFromTrend(rows) {
  const y =
    rows.map(
      x => n(x.netSales)
    );

  const count =
    y.length;

  if (count === 0) {
    return {
      available: false,
      history: [],
      forecast: [],
      slope: 0
    };
  }

  const x =
    rows.map(
      (_, i) =>
        i + 1
    );

  const xm =
    x.reduce(
      (a, b) =>
        a + b,
      0
    ) / count;

  const ym =
    y.reduce(
      (a, b) =>
        a + b,
      0
    ) / count;

  let num = 0;
  let den = 0;

  for (
    let i = 0;
    i < count;
    i++
  ) {
    num +=
      (
        x[i] - xm
      ) *
      (
        y[i] - ym
      );

    den +=
      (
        x[i] - xm
      ) ** 2;
  }

  const slope =
    den
      ? num / den
      : 0;

  const intercept =
    ym -
    slope * xm;

  const horizon =
    Math.min(
      30,
      Math.max(
        7,
        Math.round(
          count * 0.25
        ) || 7
      )
    );

  const forecast =
    Array.from(
      {
        length:
          horizon
      },
      (_, i) => ({
        day:
          i + 1,

        value:
          r(
            Math.max(
              0,
              intercept +
              slope *
              (
                count +
                i +
                1
              )
            )
          )
      })
    );

  return {
    available: true,

    history:
      rows.map(
        x => ({
          date:
            x.date,
          value:
            r(
              x.netSales
            )
        })
      ),

    forecast,

    slope:
      r(slope)
  };
}

async function aggregatePurchasesAllBranches({
  fromDate,
  toDate
}) {
  const connections =
    getAllSavedConnections();

  const branches =
    connections
      .filter(
        branch =>
          Number.isInteger(
            Number(branch?.branchId)
          ) &&
          Number(branch.branchId) > 0
      )
      .sort(
        (a, b) =>
          Number(a.branchId) -
          Number(b.branchId)
      );

  const rows = await Promise.all(
    branches.map(
      async branch => {
        const result =
          await aggregatePurchases({
            branchId:
              Number(branch.branchId),
            fromDate,
            toDate,
            connection: branch
          });

        return {
          branchId:
            Number(branch.branchId),

          branchName:
            String(
              branch.branchName ||
              `Branch ${branch.branchId}`
            ),

          invoices:
            n(result?.invoices),

          purchaseInvoices:
            n(result?.purchaseInvoices),

          returnInvoices:
            n(result?.returnInvoices),

          lines:
            n(result?.lines),

          items:
            n(result?.items),

          suppliers:
            n(result?.suppliers),

          purchaseTotal:
            r(result?.purchaseTotal),

          returnTotal:
            r(result?.returnTotal),

          netPurchaseCost:
            r(result?.netPurchaseCost),

          grossPurchaseBeforeDiscount:
            r(
              result?.grossPurchaseBeforeDiscount
            ),

          grossReturnsBeforeDiscount:
            r(
              result?.grossReturnsBeforeDiscount
            ),

          netPurchaseBeforeDiscount:
            r(
              result?.netPurchaseBeforeDiscount
            ),

          purchaseProfit:
            r(result?.purchaseProfit),

          purchaseMarginPercent:
            r(
              result?.purchaseMarginPercent
            )
        };
      }
    )
  );

  const total =
    rows.reduce(
      (acc, row) => ({
        invoices:
          acc.invoices +
          n(row.invoices),

        purchaseInvoices:
          acc.purchaseInvoices +
          n(row.purchaseInvoices),

        returnInvoices:
          acc.returnInvoices +
          n(row.returnInvoices),

        lines:
          acc.lines +
          n(row.lines),

        items:
          acc.items +
          n(row.items),

        suppliers:
          acc.suppliers +
          n(row.suppliers),

        purchaseTotal:
          acc.purchaseTotal +
          n(row.purchaseTotal),

        returnTotal:
          acc.returnTotal +
          n(row.returnTotal),

        netPurchaseCost:
          acc.netPurchaseCost +
          n(row.netPurchaseCost),

        grossPurchaseBeforeDiscount:
          acc.grossPurchaseBeforeDiscount +
          n(
            row.grossPurchaseBeforeDiscount
          ),

        grossReturnsBeforeDiscount:
          acc.grossReturnsBeforeDiscount +
          n(
            row.grossReturnsBeforeDiscount
          ),

        netPurchaseBeforeDiscount:
          acc.netPurchaseBeforeDiscount +
          n(
            row.netPurchaseBeforeDiscount
          ),

        purchaseProfit:
          acc.purchaseProfit +
          n(row.purchaseProfit)
      }),
      {
        invoices: 0,
        purchaseInvoices: 0,
        returnInvoices: 0,
        lines: 0,
        items: 0,
        suppliers: 0,
        purchaseTotal: 0,
        returnTotal: 0,
        netPurchaseCost: 0,
        grossPurchaseBeforeDiscount: 0,
        grossReturnsBeforeDiscount: 0,
        netPurchaseBeforeDiscount: 0,
        purchaseProfit: 0
      }
    );

  total.purchaseMarginPercent =
    total.netPurchaseBeforeDiscount > 0
      ? r(
          (
            total.purchaseProfit /
            total.netPurchaseBeforeDiscount
          ) * 100
        )
      : 0;

  return {
    success: true,
    type: 'purchase-group',
    branchCount: rows.length,
    branches: rows,
    total,
    ...total
  };
}


