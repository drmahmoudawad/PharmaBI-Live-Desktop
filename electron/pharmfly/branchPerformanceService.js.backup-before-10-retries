const HISTORY_MONTHS_DEFAULT = 12;
const COMPARISON_HISTORY_MONTHS_DEFAULT = 12;

const CACHE_TTL_MS =
    15 * 60 * 1000;

const FORECAST_CALIBRATION_TARGET_ERROR =
    0.05;

const FORECAST_CALIBRATION_MAX_ADJUSTMENT =
    0.10;

const FORECAST_CALIBRATION_MONTHS =
    6;

const performanceCache = new Map();


function number(value) {
    const result = Number(value);

    return Number.isFinite(result)
        ? result
        : 0;
}


function round(value, decimals = 2) {
    const factor = 10 ** decimals;

    return Math.round(
        (number(value) + Number.EPSILON) * factor
    ) / factor;
}


function validateDate(value, fieldName) {
    const text =
        String(value || "").trim();

    if (!/^\d{4}-\d{2}-\d{2}$/.test(text)) {
        throw new Error(
            `Invalid ${fieldName}. Expected YYYY-MM-DD`
        );
    }

    const date =
        new Date(`${text}T00:00:00Z`);

    if (Number.isNaN(date.getTime())) {
        throw new Error(
            `Invalid ${fieldName}: ${text}`
        );
    }

    return text;
}


function daysInclusive(
    fromDate,
    toDate
) {
    const from =
        new Date(
            `${fromDate}T00:00:00Z`
        ).getTime();

    const to =
        new Date(
            `${toDate}T00:00:00Z`
        ).getTime();

    return Math.max(
        1,
        Math.floor(
            (to - from) / 86400000
        ) + 1
    );
}


function addMonths(
    year,
    monthIndex,
    delta
) {
    return new Date(
        Date.UTC(
            year,
            monthIndex + delta,
            1
        )
    );
}


function monthKeyFromDate(
    dateText
) {
    const date =
        new Date(
            `${dateText}T00:00:00Z`
        );

    return [
        date.getUTCFullYear(),
        String(
            date.getUTCMonth() + 1
        ).padStart(2, "0")
    ].join("-");
}


function monthKeyToRange(
    monthKey
) {
    if (!/^\d{4}-\d{2}$/.test(monthKey)) {
        throw new Error(
            `Invalid month key: ${monthKey}`
        );
    }

    const [
        yearText,
        monthText
    ] = monthKey.split("-");

    const year =
        Number(yearText);

    const month =
        Number(monthText);

    const first =
        new Date(
            Date.UTC(
                year,
                month - 1,
                1
            )
        );

    const last =
        new Date(
            Date.UTC(
                year,
                month,
                0
            )
        );

    return {
        fromDate:
            first.toISOString().slice(0, 10),

        toDate:
            last.toISOString().slice(0, 10)
    };
}


function getMonthKeys(
    endDate,
    count
) {
    const end =
        new Date(
            `${endDate}T00:00:00Z`
        );

    const result = [];

    const start =
        addMonths(
            end.getUTCFullYear(),
            end.getUTCMonth(),
            -(count - 1)
        );

    for (
        let cursor = start;
        cursor <= end;
        cursor = addMonths(
            cursor.getUTCFullYear(),
            cursor.getUTCMonth(),
            1
        )
    ) {
        result.push(
            [
                cursor.getUTCFullYear(),
                String(
                    cursor.getUTCMonth() + 1
                ).padStart(2, "0")
            ].join("-")
        );
    }

    return result;
}


function isSameMonth(
    monthKey,
    dateText
) {
    return (
        monthKey ===
        monthKeyFromDate(dateText)
    );
}


function clamp(
    value,
    min,
    max
) {
    return Math.min(
        max,
        Math.max(min, value)
    );
}


function roundTo(
    value,
    step = 500
) {
    if (
        !Number.isFinite(
            Number(value)
        ) ||
        value <= 0
    ) {
        return 0;
    }

    return Math.round(
        Number(value) / step
    ) * step;
}


function cacheKey(
    branchId,
    monthKey
) {
    return [
        "branch-performance-v1",
        Number(branchId),
        monthKey
    ].join("|");
}


function getCachedMonth(
    branchId,
    monthKey
) {
    const key =
        cacheKey(
            branchId,
            monthKey
        );

    const entry =
        performanceCache.get(
            key
        );

    if (!entry) {
        return null;
    }

    if (
        Date.now() -
        entry.createdAt >
        CACHE_TTL_MS
    ) {
        performanceCache.delete(
            key
        );

        return null;
    }

    return entry.data;
}


function setCachedMonth(
    branchId,
    monthKey,
    data
) {
    const key =
        cacheKey(
            branchId,
            monthKey
        );

    performanceCache.set(
        key,
        {
            createdAt: Date.now(),
            data
        }
    );
}


function sumEmployeeUnits(
    employees
) {
    return (
        Array.isArray(employees)
            ? employees
            : []
    ).reduce(
        (
            total,
            employee
        ) =>
            total +
            number(
                employee?.units
            ),
        0
    );
}


function linearSlope(
    values
) {
    const clean =
        (
            Array.isArray(values)
                ? values
                : []
        ).map(
            value => number(value)
        );

    if (
        clean.length < 2
    ) {
        return 0;
    }

    const n =
        clean.length;

    const xMean =
        (n - 1) / 2;

    const yMean =
        clean.reduce(
            (sum, value) =>
                sum + value,
            0
        ) / n;

    let numerator = 0;
    let denominator = 0;

    for (
        let index = 0;
        index < n;
        index += 1
    ) {
        const x =
            index - xMean;

        const y =
            clean[index] - yMean;

        numerator +=
            x * y;

        denominator +=
            x * x;
    }

    if (denominator === 0) {
        return 0;
    }

    return numerator / denominator;
}


function coefficientOfVariation(
    values
) {
    const clean =
        (
            Array.isArray(values)
                ? values
                : []
        )
        .map(
            value => number(value)
        )
        .filter(
            value =>
                Number.isFinite(value)
        );

    if (
        clean.length < 2
    ) {
        return 0;
    }

    const mean =
        clean.reduce(
            (sum, value) =>
                sum + value,
            0
        ) / clean.length;

    if (mean === 0) {
        return 1;
    }

    const variance =
        clean.reduce(
            (
                sum,
                value
            ) =>
                sum +
                (
                    (value - mean) ** 2
                ),
            0
        ) / clean.length;

    const standardDeviation =
        Math.sqrt(
            variance
        );

    return (
        standardDeviation /
        Math.abs(mean)
    );
}


function getStabilityIndex(
    values
) {
    const cv =
        coefficientOfVariation(
            values
        );

    return round(
        clamp(
            100 -
            (cv * 100),
            0,
            100
        )
    );
}


function calculateWeightedRecent(
    values
) {
    const clean =
        (
            Array.isArray(values)
                ? values
                : []
        ).map(
            value => number(value)
        );

    if (
        clean.length === 0
    ) {
        return 0;
    }

    const recent =
        clean.slice(
            -6
        );

    let weightedTotal = 0;
    let weightsTotal = 0;

    for (
        let index = 0;
        index < recent.length;
        index += 1
    ) {
        const weight =
            index + 1;

        weightedTotal +=
            recent[index] *
            weight;

        weightsTotal +=
            weight;
    }

    return weightsTotal > 0
        ? weightedTotal / weightsTotal
        : 0;
}


function normalizeBranch(
    branch
) {
    return {
        branchId:
            Number(
                branch?.branchId
            ),

        branchName:
            String(
                branch?.branchName ||
                `ط§ظ„ظپط±ط¹ ${branch?.branchId || ""}`
            ).trim(),

        connection: {
            ...branch
        }
    };
}


/* =========================================================
 * FORECAST CALIBRATION
 *
 * Uses completed months where:
 * 1. A program forecast was saved.
 * 2. The actual average daily sales is available.
 *
 * The latest six usable months receive increasing weights.
 *
 * Positive bias:
 * actual > forecast
 * => the program has been under-forecasting.
 *
 * Negative bias:
 * actual < forecast
 * => the program has been over-forecasting.
 *
 * The correction only acts on the portion of systematic bias
 * outside the desired آ±5% range and is capped at آ±10%.
 * ========================================================= */

function calculateForecastCalibration(
    branchId,
    monthly
) {
    const emptyResult = {
        factor: 1,

        adjustmentPct: 0,

        weightedBiasPct: 0,

        weightedAbsoluteErrorPct: 0,

        recordsUsed: 0,

        targetErrorPct:
            FORECAST_CALIBRATION_TARGET_ERROR *
            100,

        maxAdjustmentPct:
            FORECAST_CALIBRATION_MAX_ADJUSTMENT *
            100,

        status:
            "insufficient-history",

        history: []
    };


    let targets = [];

    try {
        targets =
            getAllBranchTargets();
    }
    catch (
        error
    ) {
        console.error(
            "[ForecastCalibration] Failed to load forecast history:",
            error
        );

        return emptyResult;
    }


    if (
        !Array.isArray(
            targets
        )
    ) {
        return emptyResult;
    }


    const branchTargets =
        targets.filter(
            record =>
                Number(
                    record?.branchId
                ) ===
                Number(
                    branchId
                )
        );


    const targetByMonth =
        new Map();


    branchTargets.forEach(
        record => {
            if (
                record?.month
            ) {
                targetByMonth.set(
                    record.month,
                    record
                );
            }
        }
    );


    const usable =
        (
            Array.isArray(
                monthly
            )
                ? monthly
                : []
        )
        .filter(
            row => {
                const actual =
                    number(
                        row?.averageDailySales
                    );

                const target =
                    targetByMonth.get(
                        row?.month
                    );

                const programForecast =
                    number(
                        target?.programTargetADaily
                    );

                return (
                    actual > 0 &&
                    programForecast > 0
                );
            }
        )
        .slice(
            -FORECAST_CALIBRATION_MONTHS
        );


    if (
        usable.length < 2
    ) {
        return {
            ...emptyResult,

            recordsUsed:
                usable.length,

            history:
                usable.map(
                    row => ({
                        month:
                            row.month,

                        actualDaily:
                            round(
                                row.averageDailySales
                            ),

                        programDaily:
                            round(
                                targetByMonth.get(
                                    row.month
                                )?.programTargetADaily
                            )
                    })
                )
        };
    }


    let weightedBiasTotal = 0;
    let weightedAbsoluteErrorTotal = 0;
    let weightsTotal = 0;


    const history =
        usable.map(
            (
                row,
                index
            ) => {
                const actualDaily =
                    number(
                        row.averageDailySales
                    );

                const programDaily =
                    number(
                        targetByMonth.get(
                            row.month
                        )?.programTargetADaily
                    );

                const signedError =
                    (
                        actualDaily -
                        programDaily
                    ) /
                    programDaily;

                const absoluteError =
                    Math.abs(
                        signedError
                    );

                const weight =
                    index + 1;

                weightedBiasTotal +=
                    signedError *
                    weight;

                weightedAbsoluteErrorTotal +=
                    absoluteError *
                    weight;

                weightsTotal +=
                    weight;

                return {
                    month:
                        row.month,

                    actualDaily:
                        round(
                            actualDaily
                        ),

                    programDaily:
                        round(
                            programDaily
                        ),

                    signedErrorPct:
                        round(
                            signedError * 100
                        ),

                    absoluteErrorPct:
                        round(
                            absoluteError * 100
                        ),

                    weight
                };
            }
        );


    const weightedBias =
        weightsTotal > 0
            ? weightedBiasTotal /
              weightsTotal
            : 0;


    const weightedAbsoluteError =
        weightsTotal > 0
            ? weightedAbsoluteErrorTotal /
              weightsTotal
            : 0;


    /*
     * We target the boundary of آ±5%.
     *
     * Example:
     * bias = +10%
     * correction = +5%
     *
     * bias = -10%
     * correction = -5%
     *
     * bias = +3%
     * correction = 0%
     */

    let adjustment =
        0;


    if (
        Math.abs(
            weightedBias
        ) >
        FORECAST_CALIBRATION_TARGET_ERROR
    ) {
        adjustment =
            weightedBias -
            (
                Math.sign(
                    weightedBias
                ) *
                FORECAST_CALIBRATION_TARGET_ERROR
            );
    }


    adjustment =
        clamp(
            adjustment,
            -FORECAST_CALIBRATION_MAX_ADJUSTMENT,
            FORECAST_CALIBRATION_MAX_ADJUSTMENT
        );


    const factor =
        1 +
        adjustment;


    return {
        factor:
            round(
                factor,
                6
            ),

        adjustmentPct:
            round(
                adjustment * 100
            ),

        weightedBiasPct:
            round(
                weightedBias * 100
            ),

        weightedAbsoluteErrorPct:
            round(
                weightedAbsoluteError * 100
            ),

        recordsUsed:
            usable.length,

        targetErrorPct:
            FORECAST_CALIBRATION_TARGET_ERROR *
            100,

        maxAdjustmentPct:
            FORECAST_CALIBRATION_MAX_ADJUSTMENT *
            100,

        status:
            adjustment === 0
                ? "within-target-bias"
                : "calibrated",

        history
    };
}


async function loadMonthMetrics(
    branch,
    monthKey,
    overrideToDate = null
) {
    const cached =
        getCachedMonth(
            branch.branchId,
            monthKey
        );

    if (cached) {
        return cached;
    }

    const range =
        monthKeyToRange(
            monthKey
        );

    let effectiveToDate =
        range.toDate;

    if (
        overrideToDate &&
        isSameMonth(
            monthKey,
            overrideToDate
        )
    ) {
        effectiveToDate =
            overrideToDate;
    }

    const overview =
        await getDashboardOverview({
            branchId:
                branch.branchId,

            fromDate:
                range.fromDate,

            toDate:
                effectiveToDate,

            connection:
                branch.connection
        });

    const days =
        daysInclusive(
            range.fromDate,
            effectiveToDate
        );

    const totalSales =
        number(
            overview?.totalSales
        );

    const invoiceCount =
        number(
            overview?.invoiceCount
        );

    const totalUnits =
        sumEmployeeUnits(
            overview?.employees
        );

    const deliverySales =
        number(
            overview?.deliverySales
        );

    const deliveryOrders =
        number(
            overview?.deliveryTickets
        );

    const result = {
        month:
            monthKey,

        fromDate:
            range.fromDate,

        toDate:
            effectiveToDate,

        days,

        totalSales:
            round(
                totalSales
            ),

        averageDailySales:
            round(
                totalSales / days
            ),

        invoiceCount:
            round(
                invoiceCount
            ),

        averageDailyInvoices:
            round(
                invoiceCount / days
            ),

        totalCustomers:
            round(
                number(
                    overview?.averageDailyCustomers
                ) * days
            ),

        averageDailyCustomers:
            round(
                number(
                    overview?.averageDailyCustomers
                )
            ),

        totalUnits:
            round(
                totalUnits
            ),

        averageDailyUnits:
            round(
                totalUnits / days
            ),

        averageInvoiceValue:
            round(
                invoiceCount > 0
                    ? totalSales /
                      invoiceCount
                    : 0
            ),

        deliverySales:
            round(
                deliverySales
            ),

        averageDailyDeliverySales:
            round(
                deliverySales / days
            ),

        deliveryOrders:
            round(
                deliveryOrders
            ),

        averageDailyDeliveryOrders:
            round(
                deliveryOrders / days
            ),

        averageDeliveryOrderValue:
            round(
                deliveryOrders > 0
                    ? deliverySales /
                      deliveryOrders
                    : 0
            )
    };

    setCachedMonth(
        branch.branchId,
        monthKey,
        result
    );

    return result;
}


async function loadBranchHistory(
    branch,
    endDate,
    monthsCount,
    overrideCurrentMonth = true
) {
    const monthKeys =
        getMonthKeys(
            endDate,
            monthsCount
        );

    const currentMonth =
        monthKeyFromDate(
            endDate
        );

    const results = [];

    for (
        const monthKey
        of monthKeys
    ) {

        const row =
            await loadMonthMetrics(
                branch,
                monthKey,
                overrideCurrentMonth &&
                monthKey ===
                currentMonth
                    ? endDate
                    : null
            );

        results.push(
            row
        );

    }

    return results;
}


function calculateBranchIndicators(
    monthly
) {
    if (
        !Array.isArray(monthly) ||
        monthly.length === 0
    ) {
        return {
            growthPct: 0,
            developmentPct: 0,
            stabilityIndex: 0,
            trendSlope: 0,
            averageDailySales12m: 0
        };
    }

    const sales =
        monthly.map(
            row =>
                number(
                    row.averageDailySales
                )
        );

    const current =
        sales.at(-1) || 0;

    const previous =
        sales.length > 1
            ? sales.at(-2) || 0
            : current;

    const baselineCount =
        Math.min(
            3,
            sales.length
        );

    const baseline =
        baselineCount > 0
            ? sales
                .slice(
                    0,
                    baselineCount
                )
                .reduce(
                    (
                        sum,
                        value
                    ) =>
                        sum + value,
                    0
                ) /
                baselineCount
            : 0;

    const growthPct =
        previous > 0
            ? (
                (
                    current -
                    previous
                ) /
                previous
            ) * 100
            : 0;

    const developmentPct =
        baseline > 0
            ? (
                (
                    current -
                    baseline
                ) /
                baseline
            ) * 100
            : 0;

    const recentStabilityValues =
        sales.length >= 6
            ? sales.slice(-6)
            : sales;

    return {
        growthPct:
            round(
                growthPct
            ),

        developmentPct:
            round(
                developmentPct
            ),

        stabilityIndex:
            getStabilityIndex(
                recentStabilityValues
            ),

        trendSlope:
            round(
                linearSlope(
                    recentStabilityValues
                )
            ),

        averageDailySales12m:
            round(
                sales.reduce(
                    (
                        sum,
                        value
                    ) =>
                        sum + value,
                    0
                ) /
                sales.length
            )
    };
}


function withDerivedMetrics(
    monthly
) {
    return monthly.map(
        (
            row,
            index
        ) => {
            const previous =
                index > 0
                    ? monthly[index - 1]
                    : null;

            const salesGrowthPct =
                previous &&
                number(
                    previous.averageDailySales
                ) !== 0
                    ? (
                        (
                            number(
                                row.averageDailySales
                            ) -
                            number(
                                previous.averageDailySales
                            )
                        ) /
                        number(
                            previous.averageDailySales
                        )
                    ) * 100
                    : null;

            const deliveryGrowthPct =
                previous &&
                number(
                    previous.averageDailyDeliverySales
                ) !== 0
                    ? (
                        (
                            number(
                                row.averageDailyDeliverySales
                            ) -
                            number(
                                previous.averageDailyDeliverySales
                            )
                        ) /
                        number(
                            previous.averageDailyDeliverySales
                        )
                    ) * 100
                    : null;

            return {
                ...row,

                salesGrowthPct:
                    salesGrowthPct === null
                        ? null
                        : round(
                            salesGrowthPct
                        ),

                deliveryGrowthPct:
                    deliveryGrowthPct === null
                        ? null
                        : round(
                            deliveryGrowthPct
                        )
            };
        }
    );
}


function sortBranchesBy(
    branches,
    field,
    direction = "desc"
) {
    return [
        ...branches
    ].sort(
        (
            a,
            b
        ) => {
            const valueA =
                number(
                    a?.[field]
                );

            const valueB =
                number(
                    b?.[field]
                );

            return direction === "asc"
                ? valueA - valueB
                : valueB - valueA;
        }
    );
}


export async function getBranchPerformance(
    {
        branchId,
        toDate,
        connection = null,
        historyMonths =
            HISTORY_MONTHS_DEFAULT,
        mode = "branch",
        month = null
    }
) {
    const endDate =
        validateDate(
            toDate,
            "toDate"
        );

    const numericHistoryMonths =
        Number.isInteger(
            Number(historyMonths)
        )
            ? clamp(
                Number(historyMonths),
                3,
                24
            )
            : HISTORY_MONTHS_DEFAULT;

    if (
        mode === "comparison"
    ) {
        return getBranchComparison({
            toDate:
                endDate,

            month,

            historyMonths:
                numericHistoryMonths
        });
    }

    const numericBranchId =
        Number(branchId);

    if (
        !Number.isInteger(
            numericBranchId
        ) ||
        numericBranchId <= 0
    ) {
        throw new Error(
            "Invalid branchId"
        );
    }

    const branch =
        normalizeBranch(
            connection &&
            Number(
                connection?.branchId
            ) ===
            numericBranchId

                ? connection

                : {
                    ...(
                        getAllSavedConnections()
                            .find(
                                item =>
                                    Number(
                                        item.branchId
                                    ) ===
                                    numericBranchId
                            ) || {}
                    ),

                    branchId:
                        numericBranchId
                }
        );

    const monthly =
        await loadBranchHistory(
            branch,
            endDate,
            numericHistoryMonths,
            true
        );

    const derivedMonthly =
        withDerivedMetrics(
            monthly
        );

    const indicators =
        calculateBranchIndicators(
            derivedMonthly
        );

    const latest =
        derivedMonthly.at(-1) ||
        null;

    const previous =
        derivedMonthly.length > 1
            ? derivedMonthly.at(-2)
            : null;

    return {
        success: true,

        mode: "branch",

        branchId:
            branch.branchId,

        branchName:
            branch.branchName,

        historyMonths:
            numericHistoryMonths,

        latest,

        previous,

        indicators,

        monthly:
            derivedMonthly,

        comparisonReference: {
            description:
                "ظƒظ„ ظ…ط¤ط´ط±ط§طھ ط§ظ„ظپط±ط¹ طھط¹طھظ…ط¯ ط¹ظ„ظ‰ ظ…طھظˆط³ط· ظٹظˆظ…ظٹ ط¯ط§ط®ظ„ ظƒظ„ ط´ظ‡ط±."
        }
    };
}


async function getBranchComparison(
    {
        toDate,
        month,
        historyMonths
    }
) {
    const selectedMonth =
        month &&
        /^\d{4}-\d{2}$/.test(
            String(month)
        )
            ? String(month)
            : monthKeyFromDate(
                toDate
            );

    const range =
        monthKeyToRange(
            selectedMonth
        );

    const sameMonthCurrent =
        selectedMonth ===
        monthKeyFromDate(
            toDate
        );

    const effectiveToDate =
        sameMonthCurrent
            ? toDate
            : range.toDate;

    const branches =
        getAllSavedConnections()
            .map(
                normalizeBranch
            )
            .filter(
                branch =>
                    Number.isInteger(
                        branch.branchId
                    ) &&
                    branch.branchId > 0
            );

    if (
        branches.length === 0
    ) {
        return {
            success: true,

            mode: "comparison",

            month:
                selectedMonth,

            branches: [],

            growthRanking: [],

            developmentRanking: [],

            stabilityRanking: []
        };
    }

    const branchSettledResults =
        await Promise.allSettled(
            branches.map(
                async branch => {
                    const monthly =
                        await loadBranchHistory(
                            branch,
                            effectiveToDate,
                            historyMonths,
                            true
                        );

                    const derivedMonthly =
                        withDerivedMetrics(
                            monthly
                        );

                    const latest =
                        derivedMonthly.find(
                            row =>
                                row.month ===
                                selectedMonth
                        ) ||
                        derivedMonthly.at(-1) ||
                        null;

                    const indicators =
                        calculateBranchIndicators(
                            derivedMonthly
                        );

                    return {
                        available: true,
                        branchId:
                            branch.branchId,
                        branchName:
                            branch.branchName,
                        latest,
                        indicators,
                        monthly:
                            derivedMonthly,
                        error:
                            null
                    };
                }
            )
        );

    const branchResults =
        branchSettledResults.map(
            (result, index) => {
                const branch =
                    branches[index];

                if (
                    result.status ===
                    "fulfilled"
                ) {
                    return result.value;
                }

                const errorMessage =
                    result.reason?.message ||
                    String(
                        result.reason ||
                        "Unknown branch connection error"
                    );

                console.error(
                    `[Branch Comparison] Branch ${branch.branchId} failed:`,
                    result.reason
                );

                return {
                    available: false,
                    branchId:
                        branch.branchId,
                    branchName:
                        branch.branchName,
                    latest:
                        null,
                    indicators:
                        null,
                    monthly:
                        [],
                    error:
                        errorMessage
                };
            }
        );

    const normalized =
        branchResults.map(
            item => {
                const available =
                    item.available !== false;

                return {
                    ...item,

                    averageDailySales:
                        available
                            ? number(
                                item.latest?.averageDailySales
                            )
                            : null,

                    averageDailyInvoices:
                        available
                            ? number(
                                item.latest?.averageDailyInvoices
                            )
                            : null,

                    averageDailyCustomers:
                        available
                            ? number(
                                item.latest?.averageDailyCustomers
                            )
                            : null,

                    averageDailyUnits:
                        available
                            ? number(
                                item.latest?.averageDailyUnits
                            )
                            : null,

                    averageInvoiceValue:
                        available
                            ? number(
                                item.latest?.averageInvoiceValue
                            )
                            : null,

                    averageDailyDeliverySales:
                        available
                            ? number(
                                item.latest?.averageDailyDeliverySales
                            )
                            : null,

                    averageDailyDeliveryOrders:
                        available
                            ? number(
                                item.latest?.averageDailyDeliveryOrders
                            )
                            : null,

                    averageDeliveryOrderValue:
                        available
                            ? number(
                                item.latest?.averageDeliveryOrderValue
                            )
                            : null,

                    growthPct:
                        available
                            ? number(
                                item.indicators?.growthPct
                            )
                            : null,

                    developmentPct:
                        available
                            ? number(
                                item.indicators?.developmentPct
                            )
                            : null,

                    stabilityIndex:
                        available
                            ? number(
                                item.indicators?.stabilityIndex
                            )
                            : null
                };
            }
        );

    const rankingEligible =
        normalized.filter(
            item =>
                item.available !== false
        );

    const growthRanking =
        sortBranchesBy(
            normalized,
            "growthPct"
        );

    const developmentRanking =
        sortBranchesBy(
            normalized,
            "developmentPct"
        );

    const stabilityRanking =
        sortBranchesBy(
            normalized,
            "stabilityIndex"
        );

    const rankingPosition =
        new Map();

    for (
        const [field, list]
        of [
            [
                "growth",
                growthRanking
            ],
            [
                "development",
                developmentRanking
            ],
            [
                "stability",
                stabilityRanking
            ]
        ]
    ) {
        list.forEach(
            (
                item,
                index
            ) => {
                const key =
                    Number(
                        item.branchId
                    );

                if (
                    !rankingPosition.has(
                        key
                    )
                ) {
                    rankingPosition.set(
                        key,
                        {}
                    );
                }

                rankingPosition
                    .get(key)[field] =
                    index + 1;
            }
        );
    }

    const finalBranches =
        normalized.map(
            item => ({
                ...item,

                rankGrowth:
                    rankingPosition
                        .get(
                            Number(
                                item.branchId
                            )
                        )
                        ?.growth ||
                    null,

                rankDevelopment:
                    rankingPosition
                        .get(
                            Number(
                                item.branchId
                            )
                        )
                        ?.development ||
                    null,

                rankStability:
                    rankingPosition
                        .get(
                            Number(
                                item.branchId
                            )
                        )
                        ?.stability ||
                    null
            })
        );

    return {
        success: true,

        mode: "comparison",

        month:
            selectedMonth,

        fromDate:
            range.fromDate,

        toDate:
            effectiveToDate,

        historyMonths,

        branches:
            finalBranches,

        growthRanking,

        developmentRanking,

        stabilityRanking,

        methodology: {
            growth:
                "ط¢ط®ط± ط´ظ‡ط± ظ…ظ‚ط§ط¨ظ„ ط§ظ„ط´ظ‡ط± ط§ظ„ط³ط§ط¨ظ‚ ط§ط¹طھظ…ط§ط¯ظ‹ط§ ط¹ظ„ظ‰ ظ…طھظˆط³ط· ط§ظ„ظ…ط¨ظٹط¹ط§طھ ط§ظ„ظٹظˆظ…ظٹط©.",

            development:
                "ط¢ط®ط± ط´ظ‡ط± ظ…ظ‚ط§ط¨ظ„ ظ…طھظˆط³ط· ط£ظˆظ„ 3 ط£ط´ظ‡ط± ظپظٹ ظپطھط±ط© ط§ظ„طھط­ظ„ظٹظ„.",

            stability:
                "ظ…ط¤ط´ط± ط§ط³طھظ‚ط±ط§ط± ظ…ط¨ظ†ظٹ ط¹ظ„ظ‰ ظ…ط¹ط§ظ…ظ„ ط§ظ„ط§ط®طھظ„ط§ظپ CV ظ„ط¢ط®ط± 6 ط£ط´ظ‡ط±.",

            allMetrics:
