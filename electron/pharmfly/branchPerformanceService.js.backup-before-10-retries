    const recentSeries =
        salesSeries.slice(-6);

    const weightedRecent =
        calculateWeightedRecent(
            salesSeries
        );

    const slope =
        linearSlope(
            recentSeries
        );

    const trendForecast =
        Math.max(
            0,
            weightedRecent +
            slope
        );

    const targetMonthNumber =
        targetMonthDate
            .getUTCMonth() + 1;

    const seasonalRow =
        monthly.find(
            row =>
                Number(
                    String(
                        row.month
                    ).slice(5)
                ) ===
                targetMonthNumber
        );

    const seasonalDaily =
        seasonalRow
            ? number(
                seasonalRow.averageDailySales
            )
            : null;


    /*
     * ---------------------------------------------------------
     * RAW FORECAST
     * ---------------------------------------------------------
     */

    let rawForecastDaily =
        trendForecast;


    if (
        seasonalDaily !== null &&
        seasonalDaily > 0
    ) {
        rawForecastDaily =
            (
                trendForecast * 0.70
            ) +
            (
                seasonalDaily * 0.30
            );
    }


    rawForecastDaily =
        Math.max(
            0,
            rawForecastDaily
        );


    /*
     * ---------------------------------------------------------
     * HISTORICAL FORECAST CALIBRATION
     * ---------------------------------------------------------
     */

    const calibration =
        calculateForecastCalibration(
            branch.branchId,
            monthly
        );


    const forecastDaily =
        Math.max(
            0,
            rawForecastDaily *
            calibration.factor
        );


    /*
     * ---------------------------------------------------------
     * PROGRAM A / B
     * ---------------------------------------------------------
     */

    const targetADaily =
        roundTo(
            forecastDaily,
            500
        );

    const targetBDaily =
        roundTo(
            Math.max(
                targetADaily * 1.08,
                forecastDaily * 1.08
            ),
            500
        );


    const targetDays =
        daysInclusive(
            targetMonthRange.fromDate,
            targetMonthRange.toDate
        );


    const baseMethod =
        seasonalDaily !== null &&
        seasonalDaily > 0
            ? "70% trend + 30% same-month historical seasonality"
            : "weighted recent average + trend";


    const method =
        calibration.status ===
            "calibrated"
            ? `${baseMethod} + historical forecast calibration`
            : baseMethod;


    return {
        success: true,

        mode: "forecast",

        branchId:
            branch.branchId,

        branchName:
            branch.branchName,

        historyMonths:
            minimumHistory,

        targetMonth:
            targetMonthKey,

        targetMonthDays:
            targetDays,

        forecast: {
            dailySales:
                round(
                    forecastDaily
                ),

            rawDailySales:
                round(
                    rawForecastDaily
                ),

            monthlySales:
                round(
                    forecastDaily *
                    targetDays
                ),

            rawMonthlySales:
                round(
