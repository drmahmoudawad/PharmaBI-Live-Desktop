        }
    };
}


export async function getBranchForecast(
    {
        branchId,
        toDate,
        connection = null,
        historyMonths = HISTORY_MONTHS_DEFAULT
    }
) {
    const endDate =
        validateDate(
            toDate,
            "toDate"
        );

    const numericBranchId =
        Number(branchId);

    if (
        !Number.isInteger(
            numericBranchId
        ) ||
        numericBranchId <= 0
    ) {
        throw new Error(
            "Invalid branchId"
        );
    }

    const branch =
        normalizeBranch(
            connection &&
            Number(
                connection?.branchId
            ) === numericBranchId

                ? connection

                : {
                    ...(
                        getAllSavedConnections()
                            .find(
                                item =>
                                    Number(
                                        item.branchId
                                    ) ===
                                    numericBranchId
                            ) || {}
                    ),

                    branchId:
                        numericBranchId
                }
        );

    const date =
        new Date(
            `${endDate}T00:00:00Z`
        );

    const currentMonthIndex =
        date.getUTCMonth();

    const currentYear =
        date.getUTCFullYear();

    const previousMonth =
        new Date(
            Date.UTC(
                currentYear,
                currentMonthIndex - 1,
                1
            )
        );

    const historyEndDate =
        new Date(
            Date.UTC(
                previousMonth.getUTCFullYear(),
                previousMonth.getUTCMonth() + 1,
                0
            )
        )
        .toISOString()
        .slice(0, 10);

    const targetMonthDate =
        new Date(
            Date.UTC(
                currentYear,
                currentMonthIndex + 1,
                1
            )
        );

    const targetMonthKey =
        [
            targetMonthDate.getUTCFullYear(),
            String(
                targetMonthDate.getUTCMonth() + 1
            ).padStart(2, "0")
        ].join("-");

    const targetMonthRange =
        monthKeyToRange(
            targetMonthKey
        );

    const minimumHistory =
        Number.isInteger(
            Number(historyMonths)
