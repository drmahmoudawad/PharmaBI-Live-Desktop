import {
    getAllSavedConnections
} from "../settings/connectionStore.js";

import {
    getDashboardOverview
} from "./dashboardOverviewService.js";


const HISTORY_MONTHS_DEFAULT = 12;
const COMPARISON_HISTORY_MONTHS_DEFAULT = 12;

const CACHE_TTL_MS =
    15 * 60 * 1000;

const performanceCache = new Map();


function number(value) {
    const result = Number(value);

    return Number.isFinite(result)
        ? result
        : 0;
}


function round(value, decimals = 2) {
    const factor = 10 ** decimals;

    return Math.round(
        (number(value) + Number.EPSILON) * factor
    ) / factor;
}


function validateDate(value, fieldName) {
    const text =
        String(value || "").trim();

    if (!/^\d{4}-\d{2}-\d{2}$/.test(text)) {
        throw new Error(
            `Invalid ${fieldName}. Expected YYYY-MM-DD`
        );
    }

    const date =
        new Date(`${text}T00:00:00Z`);

    if (Number.isNaN(date.getTime())) {
        throw new Error(
            `Invalid ${fieldName}: ${text}`
        );
    }

    return text;
}


function daysInclusive(
    fromDate,
    toDate
) {
    const from =
        new Date(
            `${fromDate}T00:00:00Z`
        ).getTime();

    const to =
        new Date(
            `${toDate}T00:00:00Z`
        ).getTime();

    return Math.max(
        1,
        Math.floor(
            (to - from) / 86400000
        ) + 1
    );
}


function addMonths(
    year,
    monthIndex,
    delta
) {
    return new Date(
        Date.UTC(
            year,
            monthIndex + delta,
            1
        )
    );
}


function monthKeyFromDate(
    dateText
) {
    const date =
        new Date(
            `${dateText}T00:00:00Z`
        );

    return [
        date.getUTCFullYear(),
        String(
            date.getUTCMonth() + 1
        ).padStart(2, "0")
    ].join("-");
}


function monthKeyToRange(
    monthKey
) {
    if (!/^\d{4}-\d{2}$/.test(monthKey)) {
        throw new Error(
            `Invalid month key: ${monthKey}`
        );
    }

    const [
        yearText,
        monthText
    ] = monthKey.split("-");

    const year =
        Number(yearText);

    const month =
        Number(monthText);

    const first =
        new Date(
            Date.UTC(
                year,
                month - 1,
                1
            )
        );

    const last =
        new Date(
            Date.UTC(
                year,
                month,
                0
            )
        );

    return {
        fromDate:
            first.toISOString().slice(0, 10),

        toDate:
            last.toISOString().slice(0, 10)
    };
}


function getMonthKeys(
    endDate,
    count
) {
    const end =
        new Date(
            `${endDate}T00:00:00Z`
        );

    const result = [];

    const start =
        addMonths(
            end.getUTCFullYear(),
            end.getUTCMonth(),
            -(count - 1)
        );

    for (
        let cursor = start;
        cursor <= end;
        cursor = addMonths(
            cursor.getUTCFullYear(),
            cursor.getUTCMonth(),
            1
        )
    ) {
        result.push(
            [
                cursor.getUTCFullYear(),
                String(
                    cursor.getUTCMonth() + 1
                ).padStart(2, "0")
            ].join("-")
        );
    }

    return result;
}


function isSameMonth(
    monthKey,
    dateText
) {
    return (
        monthKey ===
        monthKeyFromDate(dateText)
    );
}


function clamp(
    value,
    min,
    max
) {
    return Math.min(
        max,
        Math.max(min, value)
    );
}


function roundTo(
    value,
    step = 500
) {
    if (
        !Number.isFinite(
            Number(value)
        ) ||
        value <= 0
    ) {
        return 0;
    }

    return Math.round(
        Number(value) / step
    ) * step;
}


function cacheKey(
    branchId,
    monthKey
) {
    return [
        "branch-performance-v1",
        Number(branchId),
        monthKey
    ].join("|");
}


function getCachedMonth(
    branchId,
    monthKey
) {
    const key =
        cacheKey(
            branchId,
            monthKey
        );

    const entry =
        performanceCache.get(
            key
        );

    if (!entry) {
        return null;
    }

    if (
        Date.now() -
        entry.createdAt >
        CACHE_TTL_MS
    ) {
        performanceCache.delete(
            key
        );

        return null;
    }

    return entry.data;
}


function setCachedMonth(
    branchId,
    monthKey,
    data
) {
    const key =
        cacheKey(
            branchId,
            monthKey
        );

    performanceCache.set(
        key,
        {
            createdAt: Date.now(),
            data
        }
    );
}


function sumEmployeeUnits(
    employees
) {
    return (
        Array.isArray(employees)
            ? employees
            : []
    ).reduce(
        (
            total,
            employee
        ) =>
            total +
            number(
                employee?.units
            ),
        0
    );
}


function linearSlope(
    values
) {
    const clean =
        (
            Array.isArray(values)
                ? values
                : []
        ).map(
            value => number(value)
        );

    if (
        clean.length < 2
    ) {
        return 0;
    }

    const n =
        clean.length;

    const xMean =
        (n - 1) / 2;

    const yMean =
        clean.reduce(
            (sum, value) =>
                sum + value,
            0
        ) / n;

    let numerator = 0;
    let denominator = 0;

    for (
        let index = 0;
        index < n;
        index += 1
    ) {
        const x =
            index - xMean;

        const y =
            clean[index] - yMean;

        numerator +=
            x * y;

        denominator +=
            x * x;
    }

    if (denominator === 0) {
        return 0;
    }

    return numerator / denominator;
}


function coefficientOfVariation(
    values
) {
    const clean =
        (
            Array.isArray(values)
                ? values
                : []
        )
        .map(
            value => number(value)
        )
        .filter(
            value =>
                Number.isFinite(value)
        );

    if (
        clean.length < 2
    ) {
        return 0;
    }

    const mean =
        clean.reduce(
            (sum, value) =>
                sum + value,
            0
        ) / clean.length;

    if (mean === 0) {
        return 1;
    }

    const variance =
        clean.reduce(
            (
                sum,
                value
            ) =>
                sum +
                (
                    (value - mean) ** 2
                ),
            0
        ) / clean.length;

    const standardDeviation =
        Math.sqrt(
            variance
        );

    return (
        standardDeviation /
        Math.abs(mean)
    );
}


function getStabilityIndex(
    values
) {
    const cv =
        coefficientOfVariation(
            values
        );

    return round(
        clamp(
            100 -
            (cv * 100),
            0,
            100
        )
    );
}


function calculateWeightedRecent(
    values
) {
    const clean =
        (
            Array.isArray(values)
                ? values
                : []
        ).map(
            value => number(value)
        );

    if (
        clean.length === 0
    ) {
        return 0;
    }

    const recent =
        clean.slice(
            -6
        );

    let weightedTotal = 0;
    let weightsTotal = 0;

    for (
        let index = 0;
        index < recent.length;
        index += 1
    ) {
        const weight =
            index + 1;

        weightedTotal +=
            recent[index] *
            weight;

        weightsTotal +=
            weight;
    }

    return weightsTotal > 0
        ? weightedTotal / weightsTotal
        : 0;
}


function normalizeBranch(
    branch
) {
    return {
        branchId:
            Number(
                branch?.branchId
            ),

        branchName:
            String(
                branch?.branchName ||
                `الفرع ${branch?.branchId || ""}`
            ).trim(),

        connection: {
            ...branch
        }
    };
}


async function loadMonthMetrics(
    branch,
    monthKey,
    overrideToDate = null
) {
    const cached =
        getCachedMonth(
            branch.branchId,
            monthKey
        );

    if (cached) {
        return cached;
    }

    const range =
        monthKeyToRange(
            monthKey
        );

    let effectiveToDate =
        range.toDate;

    if (
        overrideToDate &&
        isSameMonth(
            monthKey,
            overrideToDate
        )
    ) {
        effectiveToDate =
            overrideToDate;
    }

    const overview =
        await getDashboardOverview({
            branchId:
                branch.branchId,

            fromDate:
                range.fromDate,

            toDate:
                effectiveToDate,

            connection:
                branch.connection
        });

    const days =
        daysInclusive(
            range.fromDate,
            effectiveToDate
        );

    const totalSales =
        number(
            overview?.totalSales
        );

    const invoiceCount =
        number(
            overview?.invoiceCount
        );

    const totalUnits =
        sumEmployeeUnits(
            overview?.employees
        );

    const deliverySales =
        number(
            overview?.deliverySales
        );

    const deliveryOrders =
        number(
            overview?.deliveryTickets
        );

    const result = {
        month:
            monthKey,

        fromDate:
            range.fromDate,

        toDate:
            effectiveToDate,

        days,

        totalSales:
            round(
                totalSales
            ),

        averageDailySales:
            round(
                totalSales / days
            ),

        invoiceCount:
            round(
                invoiceCount
            ),

        averageDailyInvoices:
            round(
                invoiceCount / days
            ),

        totalCustomers:
            round(
                number(
                    overview?.averageDailyCustomers
                ) * days
            ),

        averageDailyCustomers:
            round(
                number(
                    overview?.averageDailyCustomers
                )
            ),

        totalUnits:
            round(
                totalUnits
            ),

        averageDailyUnits:
            round(
                totalUnits / days
            ),

        averageInvoiceValue:
            round(
                invoiceCount > 0
                    ? totalSales /
                      invoiceCount
                    : 0
            ),

        deliverySales:
            round(
                deliverySales
            ),

        averageDailyDeliverySales:
            round(
                deliverySales / days
            ),

        deliveryOrders:
            round(
                deliveryOrders
            ),

        averageDailyDeliveryOrders:
            round(
                deliveryOrders / days
            ),

        averageDeliveryOrderValue:
            round(
                deliveryOrders > 0
                    ? deliverySales /
                      deliveryOrders
                    : 0
            )
    };

    setCachedMonth(
        branch.branchId,
        monthKey,
        result
    );

    return result;
}


async function loadBranchHistory(
    branch,
    endDate,
    monthsCount,
    overrideCurrentMonth = true
) {
    const monthKeys =
        getMonthKeys(
            endDate,
            monthsCount
        );

    const currentMonth =
        monthKeyFromDate(
            endDate
        );

    const results =
        await Promise.all(
            monthKeys.map(
                monthKey =>
                    loadMonthMetrics(
                        branch,
                        monthKey,
                        overrideCurrentMonth &&
                        monthKey ===
                        currentMonth
                            ? endDate
                            : null
                    )
            )
        );

    return results;
}


function calculateBranchIndicators(
    monthly
) {
    if (
        !Array.isArray(monthly) ||
        monthly.length === 0
    ) {
        return {
            growthPct: 0,
            developmentPct: 0,
            stabilityIndex: 0,
            trendSlope: 0,
            averageDailySales12m: 0
        };
    }

    const sales =
        monthly.map(
            row =>
                number(
                    row.averageDailySales
                )
        );

    const current =
        sales.at(-1) || 0;

    const previous =
        sales.length > 1
            ? sales.at(-2) || 0
            : current;

    const baselineCount =
        Math.min(
            3,
            sales.length
        );

    const baseline =
        baselineCount > 0
            ? sales
                .slice(
                    0,
                    baselineCount
                )
                .reduce(
                    (
                        sum,
                        value
                    ) =>
                        sum + value,
                    0
                ) /
                baselineCount
            : 0;

    const growthPct =
        previous > 0
            ? (
                (
                    current -
                    previous
                ) /
                previous
            ) * 100
            : 0;

    const developmentPct =
        baseline > 0
            ? (
                (
                    current -
                    baseline
                ) /
                baseline
            ) * 100
            : 0;

    const recentStabilityValues =
        sales.length >= 6
            ? sales.slice(-6)
            : sales;

    return {
        growthPct:
            round(
                growthPct
            ),

        developmentPct:
            round(
                developmentPct
            ),

        stabilityIndex:
            getStabilityIndex(
                recentStabilityValues
            ),

        trendSlope:
            round(
                linearSlope(
                    recentStabilityValues
                )
            ),

        averageDailySales12m:
            round(
                sales.reduce(
                    (
                        sum,
                        value
                    ) =>
                        sum + value,
                    0
                ) /
                sales.length
            )
    };
}


function withDerivedMetrics(
    monthly
) {
    return monthly.map(
        (
            row,
            index
        ) => {
            const previous =
                index > 0
                    ? monthly[index - 1]
                    : null;

            const salesGrowthPct =
                previous &&
                number(
                    previous.averageDailySales
                ) !== 0
                    ? (
                        (
                            number(
                                row.averageDailySales
                            ) -
                            number(
                                previous.averageDailySales
                            )
                        ) /
                        number(
                            previous.averageDailySales
                        )
                    ) * 100
                    : null;

            const deliveryGrowthPct =
                previous &&
                number(
                    previous.averageDailyDeliverySales
                ) !== 0
                    ? (
                        (
                            number(
                                row.averageDailyDeliverySales
                            ) -
                            number(
                                previous.averageDailyDeliverySales
                            )
                        ) /
                        number(
                            previous.averageDailyDeliverySales
                        )
                    ) * 100
                    : null;

            return {
                ...row,

                salesGrowthPct:
                    salesGrowthPct === null
                        ? null
                        : round(
                            salesGrowthPct
                        ),

                deliveryGrowthPct:
                    deliveryGrowthPct === null
                        ? null
                        : round(
                            deliveryGrowthPct
                        )
            };
        }
    );
}


function sortBranchesBy(
    branches,
    field,
    direction = "desc"
) {
    return [
        ...branches
    ].sort(
        (
            a,
            b
        ) => {
            const valueA =
                number(
                    a?.[field]
                );

            const valueB =
                number(
                    b?.[field]
                );

            return direction === "asc"
                ? valueA - valueB
                : valueB - valueA;
        }
    );
}


export async function getBranchPerformance(
    {
        branchId,
        toDate,
        connection = null,
        historyMonths =
            HISTORY_MONTHS_DEFAULT,
        mode = "branch",
        month = null
    }
) {
    const endDate =
        validateDate(
            toDate,
            "toDate"
        );

    const numericHistoryMonths =
        Number.isInteger(
            Number(historyMonths)
        )
            ? clamp(
                Number(historyMonths),
                3,
                24
            )
            : HISTORY_MONTHS_DEFAULT;

    if (
        mode === "comparison"
    ) {
        return getBranchComparison({
            toDate:
                endDate,

            month,
            historyMonths:
                numericHistoryMonths
        });
    }

    const numericBranchId =
        Number(branchId);

    if (
        !Number.isInteger(
            numericBranchId
        ) ||
        numericBranchId <= 0
    ) {
        throw new Error(
            "Invalid branchId"
        );
    }

    const branch =
        normalizeBranch(
            connection && Number(connection?.branchId) === numericBranchId
                ? connection
                : {
                    ...(
                        getAllSavedConnections()
                            .find(
                                item =>
                                    Number(
                                        item.branchId
                                    ) ===
                                    numericBranchId
                            ) || {}
                    ),
                    branchId:
                        numericBranchId
                }
        );

    const monthly =
        await loadBranchHistory(
            branch,
            endDate,
            numericHistoryMonths,
            true
        );

    const derivedMonthly =
        withDerivedMetrics(
            monthly
        );

    const indicators =
        calculateBranchIndicators(
            derivedMonthly
        );

    const latest =
        derivedMonthly.at(-1) ||
        null;

    const previous =
        derivedMonthly.length > 1
            ? derivedMonthly.at(-2)
            : null;

    return {
        success: true,

        mode: "branch",

        branchId:
            branch.branchId,

        branchName:
            branch.branchName,

        historyMonths:
            numericHistoryMonths,

        latest,

        previous,

        indicators,

        monthly:
            derivedMonthly,

        comparisonReference: {
            description:
                "كل مؤشرات الفرع تعتمد على متوسط يومي داخل كل شهر."
        }
    };
}


async function getBranchComparison(
    {
        toDate,
        month,
        historyMonths
    }
) {
    const selectedMonth =
        month &&
        /^\d{4}-\d{2}$/.test(
            String(month)
        )
            ? String(month)
            : monthKeyFromDate(
                toDate
            );

    const range =
        monthKeyToRange(
            selectedMonth
        );

    const sameMonthCurrent =
        selectedMonth ===
        monthKeyFromDate(
            toDate
        );

    const effectiveToDate =
        sameMonthCurrent
            ? toDate
            : range.toDate;

    const branches =
        getAllSavedConnections()
            .map(
                normalizeBranch
            )
            .filter(
                branch =>
                    Number.isInteger(
                        branch.branchId
                    ) &&
                    branch.branchId > 0
            );

    if (
        branches.length === 0
    ) {
        return {
            success: true,
            mode: "comparison",
            month: selectedMonth,
            branches: [],
            growthRanking: [],
            developmentRanking: [],
            stabilityRanking: []
        };
    }

    const branchResults =
        await Promise.all(
            branches.map(
                async branch => {
                    const monthly =
                        await loadBranchHistory(
                            branch,
                            effectiveToDate,
                            historyMonths,
                            true
                        );

                    const derivedMonthly =
                        withDerivedMetrics(
                            monthly
                        );

                    const latest =
                        derivedMonthly.find(
                            row =>
                                row.month ===
                                selectedMonth
                        ) ||
                        derivedMonthly.at(-1) ||
                        null;

                    const indicators =
                        calculateBranchIndicators(
                            derivedMonthly
                        );

                    return {
                        branchId:
                            branch.branchId,

                        branchName:
                            branch.branchName,

                        latest,

                        indicators,

                        monthly:
                            derivedMonthly
                    };
                }
            )
        );

    const normalized =
        branchResults.map(
            item => ({
                ...item,

                averageDailySales:
                    number(
                        item.latest?.averageDailySales
                    ),

                averageDailyInvoices:
                    number(
                        item.latest?.averageDailyInvoices
                    ),

                averageDailyCustomers:
                    number(
                        item.latest?.averageDailyCustomers
                    ),

                averageDailyUnits:
                    number(
                        item.latest?.averageDailyUnits
                    ),

                averageInvoiceValue:
                    number(
                        item.latest?.averageInvoiceValue
                    ),

                averageDailyDeliverySales:
                    number(
                        item.latest?.averageDailyDeliverySales
                    ),

                averageDailyDeliveryOrders:
                    number(
                        item.latest?.averageDailyDeliveryOrders
                    ),

                averageDeliveryOrderValue:
                    number(
                        item.latest?.averageDeliveryOrderValue
                    ),

                growthPct:
                    number(
                        item.indicators?.growthPct
                    ),

                developmentPct:
                    number(
                        item.indicators?.developmentPct
                    ),

                stabilityIndex:
                    number(
                        item.indicators?.stabilityIndex
                    )
            })
        );

    const growthRanking =
        sortBranchesBy(
            normalized,
            "growthPct"
        );

    const developmentRanking =
        sortBranchesBy(
            normalized,
            "developmentPct"
        );

    const stabilityRanking =
        sortBranchesBy(
            normalized,
            "stabilityIndex"
        );

    const rankingPosition =
        new Map();

    for (
        const [field, list]
        of [
            [
                "growth",
                growthRanking
            ],
            [
                "development",
                developmentRanking
            ],
            [
                "stability",
                stabilityRanking
            ]
        ]
    ) {
        list.forEach(
            (
                item,
                index
            ) => {
                const key =
                    Number(
                        item.branchId
                    );

                if (
                    !rankingPosition.has(
                        key
                    )
                ) {
                    rankingPosition.set(
                        key,
                        {}
                    );
                }

                rankingPosition
                    .get(key)[field] =
                    index + 1;
            }
        );
    }

    const finalBranches =
        normalized.map(
            item => ({
                ...item,

                rankGrowth:
                    rankingPosition
                        .get(
                            Number(
                                item.branchId
                            )
                        )
                        ?.growth ||
                    null,

                rankDevelopment:
                    rankingPosition
                        .get(
                            Number(
                                item.branchId
                            )
                        )
                        ?.development ||
                    null,

                rankStability:
                    rankingPosition
                        .get(
                            Number(
                                item.branchId
                            )
                        )
                        ?.stability ||
                    null
            })
        );

    return {
        success: true,

        mode: "comparison",

        month:
            selectedMonth,

        fromDate:
            range.fromDate,

        toDate:
            effectiveToDate,

        historyMonths,

        branches:
            finalBranches,

        growthRanking,

        developmentRanking,

        stabilityRanking,

        methodology: {
            growth:
                "آخر شهر مقابل الشهر السابق اعتماداً على متوسط المبيعات اليومية.",

            development:
                "آخر شهر مقابل متوسط أول 3 أشهر في فترة التحليل اعتماداً على متوسط المبيعات اليومية.",

            stability:
                "مؤشر استقرار مبني على معامل الاختلاف CV لآخر 6 أشهر؛ كلما ارتفع المؤشر كانت الحركة الشهرية أكثر استقراراً.",

            allMetrics:
                "كل المقارنات التشغيلية تعتمد على متوسط يومي داخل كل شهر وليس إجمالي الشهر."
        }
    };
}


export async function getBranchForecast(
    {
        branchId,
        toDate,
        connection = null,
        historyMonths = HISTORY_MONTHS_DEFAULT
    }
) {
    const endDate =
        validateDate(
            toDate,
            "toDate"
        );

    const numericBranchId =
        Number(branchId);

    if (
        !Number.isInteger(
            numericBranchId
        ) ||
        numericBranchId <= 0
    ) {
        throw new Error(
            "Invalid branchId"
        );
    }

    const branch =
        normalizeBranch(
            connection &&
            Number(
                connection?.branchId
            ) === numericBranchId

                ? connection

                : {
                    ...(
                        getAllSavedConnections()
                            .find(
                                item =>
                                    Number(
                                        item.branchId
                                    ) ===
                                    numericBranchId
                            ) || {}
                    ),

                    branchId:
                        numericBranchId
                }
        );

    const date =
        new Date(
            `${endDate}T00:00:00Z`
        );

    const currentMonthIndex =
        date.getUTCMonth();

    const currentYear =
        date.getUTCFullYear();

    const previousMonth =
        new Date(
            Date.UTC(
                currentYear,
                currentMonthIndex - 1,
                1
            )
        );

    const historyEndDate =
        new Date(
            Date.UTC(
                previousMonth.getUTCFullYear(),
                previousMonth.getUTCMonth() + 1,
                0
            )
        )
        .toISOString()
        .slice(0, 10);

    const targetMonthDate =
        new Date(
            Date.UTC(
                currentYear,
                currentMonthIndex + 1,
                1
            )
        );

    const targetMonthKey =
        [
            targetMonthDate.getUTCFullYear(),
            String(
                targetMonthDate.getUTCMonth() + 1
            ).padStart(2, "0")
        ].join("-");

    const targetMonthRange =
        monthKeyToRange(
            targetMonthKey
        );

    const minimumHistory =
        Number.isInteger(
            Number(historyMonths)
        )
            ? clamp(
                Number(historyMonths),
                6,
                24
            )
            : 12;

    const historicalMonthly =
        await loadBranchHistory(
            branch,
            historyEndDate,
            minimumHistory,
            false
        );

    const monthly =
        withDerivedMetrics(
            historicalMonthly
        );

    const salesSeries =
        monthly.map(
            row =>
                number(
                    row.averageDailySales
                )
        );

    const recentSeries =
        salesSeries.slice(-6);

    const weightedRecent =
        calculateWeightedRecent(
            salesSeries
        );

    const slope =
        linearSlope(
            recentSeries
        );

    const trendForecast =
        Math.max(
            0,
            weightedRecent +
            slope
        );

    const targetMonthNumber =
        targetMonthDate
            .getUTCMonth() + 1;

    const seasonalRow =
        monthly.find(
            row =>
                Number(
                    String(
                        row.month
                    ).slice(5)
                ) ===
                targetMonthNumber
        );

    const seasonalDaily =
        seasonalRow
            ? number(
                seasonalRow.averageDailySales
            )
            : null;

    let forecastDaily =
        trendForecast;

    if (
        seasonalDaily !== null &&
        seasonalDaily > 0
    ) {
        forecastDaily =
            (
                trendForecast * 0.70
            ) +
            (
                seasonalDaily * 0.30
            );
    }

    forecastDaily =
        Math.max(
            0,
            forecastDaily
        );

    const targetADaily =
        roundTo(
            forecastDaily,
            500
        );

    const targetBDaily =
        roundTo(
            Math.max(
                targetADaily * 1.08,
                forecastDaily * 1.08
            ),
            500
        );

    const targetDays =
        daysInclusive(
            targetMonthRange.fromDate,
            targetMonthRange.toDate
        );

    return {
        success: true,

        mode: "forecast",

        branchId:
            branch.branchId,

        branchName:
            branch.branchName,

        historyMonths:
            minimumHistory,

        targetMonth:
            targetMonthKey,

        targetMonthDays:
            targetDays,

        forecast: {
            dailySales:
                round(
                    forecastDaily
                ),

            monthlySales:
                round(
                    forecastDaily *
                    targetDays
                ),

            method:
                seasonalDaily !== null &&
                seasonalDaily > 0

                    ? "70% trend + 30% same-month historical seasonality"

                    : "weighted recent average + trend"
        },

        programTargets: {
            targetA: {
                daily:
                    targetADaily,

                monthly:
                    round(
                        targetADaily *
                        targetDays
                    ),

                description:
                    "الهدف الأساسي القابل للتحقيق بالمجهود الطبيعي."
            },

            targetB: {
                daily:
                    targetBDaily,

                monthly:
                    round(
                        targetBDaily *
                        targetDays
                    ),

                description:
                    "الهدف الممتد الذي يحتاج مجهوداً واستمراراً أعلى."
            }
        },

        managementTargets: {
            targetA: null,
            targetB: null
        },

        historicalMonthly:
            monthly,

        methodology: {
            base:
                "متوسط المبيعات اليومية داخل كل شهر.",

            recentWeight:
                "متوسط مرجح لآخر 6 أشهر.",

            trend:
                "اتجاه خطي لآخر 6 أشهر.",

            seasonality:
                seasonalDaily !== null &&
                seasonalDaily > 0
                    ? "تم استخدام نفس الشهر من السنة السابقة بنسبة 30%."
                    : "لا يوجد تاريخ كافٍ لاستخدام نفس الشهر من السنة السابقة.",

            targetA:
                "يساوي التوقع البرنامجي بعد التقريب لأقرب 500 جنيه.",

            targetB:
                "أعلى من الهدف A بحوالي 8% بعد التقريب لأقرب 500 جنيه.",

            profit:
                "الربح والهامش غير داخلين في الحسابات الحالية."
        }
    };
}


export function clearBranchPerformanceCache() {
    performanceCache.clear();
}


export function getBranchPerformanceCacheStats() {
    return {
        entries:
            performanceCache.size,

        keys:
            Array.from(
                performanceCache.keys()
            )
    };
}


export default {
    getBranchPerformance,
    getBranchForecast,
    clearBranchPerformanceCache,
    getBranchPerformanceCacheStats
};