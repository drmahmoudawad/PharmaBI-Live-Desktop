function createWhatsAppService() {

    let client =
        null;

    let status =
        "disconnected";

    let qrCodeData =
        null;

    let isReady =
        false;

    let initializing =
        false;

    let eventSink =
        null;

    let initializedListeners =
        false;


    function emitEvent(
        event,
        payload = {}
    ) {

        if (
            typeof eventSink !==
            "function"
        ) {

            return;

        }

        try {

            eventSink(
                event,
                payload
            );

        }
        catch (
            error
        ) {

            console.warn(
                "[WhatsApp] Event sink error:",
                error?.message ||
                    error
            );

        }

    }


    function getState() {

        return {
            status,
            isReady,
            qr:
                qrCodeData,
            provider:
                PROVIDER
        };

    }


    function ensureClient() {

        if (
            client
        ) {

            return client;

        }

        client =
            new Client(
                {
                    authStrategy:
                        new LocalAuth(
                            {
                                clientId:
                                    CLIENT_ID,
                                dataPath:
                                    SESSION_DIR
                            }
                        ),

                    puppeteer:
                        {
                            headless:
                                true,

                            args:
                                [
                                    "--no-sandbox",
                                    "--disable-setuid-sandbox",
                                    "--disable-dev-shm-usage"
                                ]
                        }
                }
            );


        if (
            initializedListeners
        ) {

            return client;

        }

        initializedListeners =
            true;


        /*
         * =====================================================
         * QR
         * =====================================================
         */

        client.on(
            "qr",
            async qr => {

                status =
                    "connecting";

                isReady =
                    false;

                try {

                    qrCodeData =
                        await qrcode.toDataURL(
                            qr
                        );

                }
                catch (
                    error
                ) {

                    console.error(
                        "[WhatsApp] QR generation failed:",
                        error?.message ||
                            error
                    );

                    qrCodeData =
                        qr;

                }


                emitEvent(
                    "qr",
                    {
                        qr:
                            qrCodeData,
                        status
                    }
                );

            }
        );


        /*
         * =====================================================
         * AUTHENTICATED
         * =====================================================
         */

        client.on(
            "authenticated",
            () => {

                status =
                    "authenticated";

                emitEvent(
                    "authenticated",
                    {
                        status
                    }
                );

            }
        );


        /*
         * =====================================================
         * READY
         * =====================================================
         */

        client.on(
            "ready",
            () => {

                isReady =
                    true;

                status =
                    "ready";

                qrCodeData =
                    null;

                const info =
                    client.info ||
                    null;

                const displayPhoneNumber =
                    normalizePhone(
                        info?.wid?.user
                    );

                let accountId =
                    null;

                try {

                    const db =
                        getDatabase();

                    accountId =
                        ensureWhatsAppAccount(
                            db,
                            {
                                accountName:
                                    info?.pushname ||
                                    info?.me?.pushname ||
                                    "PharmaBI WhatsApp",

                                displayPhoneNumber:
                                    displayPhoneNumber,

                                status:
                                    "ready"
                            }
                        );

                }
                catch (
                    error
                ) {

                    console.warn(
                        "[WhatsApp] Account persistence failed:",
                        error?.message ||
                            error
                    );

                }


                console.log(
                    "[WhatsApp] Ready:",
                    {
                        phone:
                            displayPhoneNumber,
                        accountId
                    }
                );


                emitEvent(
                    "ready",
                    {
                        status,
                        isReady,
                        phone:
                            displayPhoneNumber,
                        accountId
                    }
                );

            }
        );


        /*
         * =====================================================
         * AUTH FAILURE
         * =====================================================
         */

        client.on(
            "auth_failure",
            message => {

                isReady =
                    false;

                status =
                    "error";

                qrCodeData =
                    null;

                console.error(
                    "[WhatsApp] Auth failure:",
                    message
                );


                emitEvent(
                    "auth_failure",
                    {
                        status,
                        message:
                            sanitizeText(
                                message
                            )
                    }
                );

            }
        );


        /*
         * =====================================================
         * DISCONNECTED
         * =====================================================
         */

        client.on(
            "disconnected",
            reason => {

                isReady =
                    false;

                status =
                    "disconnected";

                qrCodeData =
                    null;


                try {

                    const db =
                        getDatabase();

                    db.prepare(
                        `
                        UPDATE crm_whatsapp_accounts
                        SET
                            status = 'disconnected',
                            updated_at = datetime('now')
                        WHERE
                            provider = ?
                        `
                    )
                        .run(
                            PROVIDER
                        );

                }
                catch (
                    error
                ) {

                    console.warn(
                        "[WhatsApp] Account disconnect persistence failed:",
                        error?.message ||
                            error
                    );

                }


                emitEvent(
                    "disconnected",
                    {
                        status,
                        reason:
                            sanitizeText(
                                reason
                            )
                    }
                );

            }
        );


        /*
         * =====================================================
         * STATE CHANGE
         * =====================================================
         */

        client.on(
            "change_state",
            state => {

                emitEvent(
                    "state_changed",
                    {
                        status,
                        state:
                            sanitizeText(
                                state
                            )
                    }
                );

            }
        );


        /*
         * =====================================================
         * INBOUND MESSAGE
         * =====================================================
         */

        client.on(
            "message",
            async message => {

                try {

                    await handleInboundMessage(
                        message
                    );

                }
                catch (
                    error
                ) {

                    console.error(
                        "[WhatsApp] Inbound message handler failed:",
                        error
                    );

                }

            }
        );


        /*
         * =====================================================
         * MESSAGE ACK
         * =====================================================
         */

        client.on(
            "message_ack",
            async (
                message,
                ack
            ) => {

                try {

                    await handleMessageAck(
                        message,
                        ack
                    );

                }
                catch (
                    error
                ) {

                    console.error(
                        "[WhatsApp] Message ACK handler failed:",
                        error
                    );

                }

            }
        );


        return client;

    }


    /*
     * =========================================================
     * INBOUND MESSAGE
     * =========================================================
     */

    async function handleInboundMessage(
        message
    ) {

        if (
            !message
        ) {

            return null;

        }


        let from = null;

        const rawFrom = String(message.from || "").trim();
        const rawAuthor = String(message.author || "").trim();

        const isEgyptianMobile = value =>
            /^20(10|11|12|15)\d{8}$/.test(
                String(value || "")
            );

        const normalizeCandidate = value => {
            const cleaned = String(value || "")
                .replace(/@(c\.us|s\.whatsapp\.net)$/i, "");

            const normalized = normalizePhone(cleaned);

            return isEgyptianMobile(normalized)
                ? normalized
                : null;
        };

        /*
         * WhatsApp may send a LID instead of the real phone.
         * getContactLidAndPhone() returns the real PN.
         */

        try {

            if (
                client &&
                typeof client.getContactLidAndPhone === "function"
            ) {

                const identities = [
                    rawFrom,
                    rawAuthor
                ].filter(Boolean);

                if (identities.length > 0) {

                    const mappings =
                        await client.getContactLidAndPhone(
                            identities
                        );

                    from =
                        (Array.isArray(mappings) ? mappings : [])
                            .map(item =>
                                normalizeCandidate(item?.pn)
                            )
                            .find(Boolean) ||
                        null;

                }

            }

        }
        catch (error) {

            console.warn(
                "[WhatsApp] LID-to-phone lookup failed:",
                error?.message || error
            );

        }

        /* Direct contact fallback, only if it is a real phone. */

        if (!from) {

            try {

                if (typeof message.getContact === "function") {

                    const contact =
                        await message.getContact();

                    from =
                        normalizeCandidate(
                            contact?.number
                        );

                }

            }
            catch (error) {

                console.warn(
                    "[WhatsApp] Contact lookup failed:",
                    error?.message || error
                );

            }

        }

        /* Raw sender fallback, only if it is a real phone. */

        if (!from) {

            from = normalizeCandidate(rawFrom);

        }

        console.log(
            "[WhatsApp INBOUND IDENTITY]",
            {
                rawFrom,
                rawAuthor,
                resolvedPhone: from
            }
        );

        if (!from) {

            return null;

        }
        const db =
            getDatabase();


        const providerMessageId =
            serializeMessageId(
                message.id
            );


        const body =
            sanitizeText(
                message.body
            );


        const messageType =
            getMessageType(
                message.type
            );


        /*
         * =====================================================
         * GLOBAL WHATSAPP ACCOUNT
         * =====================================================
         */

        const account =
            db.prepare(
                `
                SELECT
                    id
                FROM crm_whatsapp_accounts
                WHERE
                    provider = ?
                ORDER BY
                    id
                LIMIT 1
                `
            )
                .get(
                    PROVIDER
                );


        const whatsappAccountId =
            toPositiveInteger(
                account?.id
            );


        /*
         * =====================================================
         * RESOLVE CUSTOMER
         *
         * Priority:
         *
         * 1. Latest outbound message to this number.
         * 2. Unique CRM phone match.
         * 3. Otherwise NEW CUSTOMER.
         *
         * =====================================================
         */

        let branchId =
            null;

        let customerId =
            null;

        let customerName =
            null;

        let resolutionSource =
            null;


        const latestOutbound =
            db.prepare(
                `
                SELECT
                    branch_id,
                    customer_id
                FROM crm_whatsapp_messages
                WHERE
                    direction = 'OUTBOUND'
                    AND recipient_phone = ?
                    AND branch_id IS NOT NULL
                    AND customer_id IS NOT NULL
                ORDER BY
                    id DESC
                LIMIT 1
                `
            )
                .get(
                    from
                );


        if (
            latestOutbound?.branch_id &&
            latestOutbound?.customer_id !== null &&
            latestOutbound?.customer_id !== undefined
        ) {

            branchId =
                toPositiveInteger(
                    latestOutbound.branch_id
                );

            customerId =
                String(
                    latestOutbound.customer_id
                );

            resolutionSource =
                "LATEST_OUTBOUND";


            const outboundProfile =
                db.prepare(
                    `
                    SELECT
                        customer_name
                    FROM crm_customer_profiles
                    WHERE
                        branch_id = ?
                        AND customer_id = ?
                    LIMIT 1
                    `
                )
                    .get(
                        branchId,
                        customerId
                    );


            customerName =
                outboundProfile?.customer_name ||
                null;

        }


        if (
            !branchId ||
            !customerId
        ) {

            const phoneMatches =
                db.prepare(
                    `
                    SELECT
                        branch_id,
                        customer_id,
                        customer_name
                    FROM crm_customer_profiles
                    WHERE
                        whatsapp_phone_normalized = ?
                    ORDER BY
                        branch_id,
                        customer_id
                    `
                )
                    .all(
                        from
                    );


            if (
                phoneMatches.length === 1
            ) {

                branchId =
                    toPositiveInteger(
                        phoneMatches[0].branch_id
                    );

                customerId =
                    phoneMatches[0].customer_id !== null &&
                    phoneMatches[0].customer_id !== undefined
                        ? String(
                            phoneMatches[0].customer_id
                        )
                        : null;

                customerName =
                    phoneMatches[0].customer_name ||
                    null;

                resolutionSource =
                    "CRM_PHONE";

            }

        }


        /*
         * =====================================================
         * UNMATCHED / NEW CUSTOMER
         * =====================================================
         */

        if (
            !branchId ||
            !customerId
        ) {

            const status =
                "NEW";


            let unmatchedId =
                null;


            try {

                const result =
                    db.prepare(
                        `
                        INSERT OR IGNORE INTO
                            crm_whatsapp_unmatched_messages (
                                whatsapp_account_id,
                                phone,
                                message_type,
                                body_text,
                                provider_message_id,
                                message_timestamp,
                                status
                            )
                        VALUES (
                            ?,
                            ?,
                            ?,
                            ?,
                            ?,
                            ?,
                            ?
                        )
                        `
                    )
                        .run(
                            whatsappAccountId,
                            from,
                            messageType,
                            body,
                            providerMessageId,
                            Number(
                                message.timestamp ||
                                0
                            ) || null,
                            status
                        );


                unmatchedId =
                    result.lastInsertRowid;


                if (
                    !unmatchedId &&
                    providerMessageId
                ) {

                    const existing =
