 * MESSAGE FORMATTING
 * =========================================================
 */

function replaceToken(
    message,
    token,
    value
) {

    const safeValue =
        sanitizeText(
            value
        );

    const escapedToken =
        token.replace(
            /[.*+?^${}()|[\]\\]/g,
            "\\$&"
        );

    return message.replace(
        new RegExp(
            `\\{\\{?${escapedToken}\\}\\}?`,
            "gi"
        ),
        safeValue
    );

}


function formatMessage(
    {
        message = "",
        templateText = "",
        customerName = "",
        branchName = "",
        amount = "",
        dueDate = "",
        itemName = ""
    } = {}
) {

    let finalMessage =
        sanitizeText(
            message
        );

    if (
        !finalMessage.trim()
    ) {

        finalMessage =
            sanitizeText(
                templateText
            );

    }

    finalMessage =
        replaceToken(
            finalMessage,
            "name",
            customerName ||
                "ط·آ¹ط¸â€¦ط¸ظ¹ط¸â€‍ط¸â€ ط·آ§ ط·آ§ط¸â€‍ط·آ¹ط·آ²ط¸ظ¹ط·آ²"
        );

    finalMessage =
        replaceToken(
            finalMessage,
            "customer_name",
            customerName ||
                "ط·آ¹ط¸â€¦ط¸ظ¹ط¸â€‍ط¸â€ ط·آ§ ط·آ§ط¸â€‍ط·آ¹ط·آ²ط¸ظ¹ط·آ²"
        );

    finalMessage =
        replaceToken(
            finalMessage,
            "branch",
            branchName
        );

    finalMessage =
        replaceToken(
            finalMessage,
            "branch_name",
            branchName
        );

    finalMessage =
        replaceToken(
            finalMessage,
            "amount",
            amount
        );

    finalMessage =
        replaceToken(
            finalMessage,
            "dueDate",
            dueDate
        );

    finalMessage =
        replaceToken(
            finalMessage,
            "due_date",
            dueDate
        );

    finalMessage =
        replaceToken(
            finalMessage,
            "itemName",
            itemName
        );

    finalMessage =
        replaceToken(
            finalMessage,
            "item_name",
            itemName
        );

    return finalMessage.trim();

}


