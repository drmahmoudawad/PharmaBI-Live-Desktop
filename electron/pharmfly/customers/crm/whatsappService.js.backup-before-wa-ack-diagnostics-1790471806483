    async function handleMessageAck(
        message,
        ack
    ) {

        const providerMessageId =
            serializeMessageId(
                message?.id
            );

        if (
            !providerMessageId
        ) {

            return null;

        }

        const statusFromAck =
            getAckStatus(
                ack
            );

        const db =
            getDatabase();


        const existing =
            db.prepare(
                `
                SELECT
                    id,
                    branch_id,
                    customer_id,
                    campaign_id,
                    campaign_target_id,
                    interaction_id,
                    recipient_phone
                FROM crm_whatsapp_messages
                WHERE provider_message_id = ?
                ORDER BY id DESC
                LIMIT 1
                `
            )
                .get(
                    providerMessageId
                );


        if (
            !existing
        ) {

            return null;

        }


        const updates =
            {
                status:
                    statusFromAck,

                deliveredAt:
                    null,

                readAt:
                    null,

                failedAt:
                    null
            };


        if (
            statusFromAck ===
            "delivered" ||
            statusFromAck ===
            "read"
        ) {

            updates.deliveredAt =
                "datetime('now')";

        }

        if (
            statusFromAck ===
            "read"
        ) {

            updates.readAt =
                "datetime('now')";

        }

        if (
            statusFromAck ===
            "failed"
        ) {

            updates.failedAt =
                "datetime('now')";

        }


        if (
            statusFromAck ===
            "delivered"
        ) {

            db.prepare(
                `
                UPDATE crm_whatsapp_messages
                SET
                    status = 'delivered',
                    delivered_at =
                        COALESCE(
                            delivered_at,
                            datetime('now')
                        )
                WHERE id = ?
                `
            )
                .run(
                    existing.id
                );

        }
        else if (
            statusFromAck ===
            "read"
        ) {

            db.prepare(
                `
                UPDATE crm_whatsapp_messages
                SET
                    status = 'read',
                    delivered_at =
                        COALESCE(
                            delivered_at,
                            datetime('now')
                        ),
                    read_at =
                        COALESCE(
                            read_at,
                            datetime('now')
                        )
                WHERE id = ?
                `
            )
                .run(
                    existing.id
                );

        }
        else if (
            statusFromAck ===
            "failed"
        ) {

            db.prepare(
                `
                UPDATE crm_whatsapp_messages
                SET
                    status = 'failed',
                    failed_at =
                        COALESCE(
                            failed_at,
                            datetime('now')
                        )
                WHERE id = ?
                `
            )
                .run(
                    existing.id
                );

        }


        try {

            db.prepare(
                `
                INSERT INTO crm_whatsapp_events (
                    whatsapp_message_id,
                    branch_id,
                    customer_id,
                    provider_event_id,
                    provider_message_id,
                    event_type,
                    event_at,
                    payload_json,
                    created_at
                )
                VALUES (
                    ?,
                    ?,
                    ?,
                    ?,
                    ?,
                    ?,
                    datetime('now'),
                    ?,
                    datetime('now')
                )
                `
            )
                .run(
                    existing.id,
                    existing.branch_id ||
                        null,
                    existing.customer_id,
                    null,
                    providerMessageId,
                    statusFromAck.toUpperCase(),
                    JSON.stringify(
                        {
                            ack:
                                Number(
                                    ack
                                )
                        }
                    )
                );

        }
        catch (
            error
        ) {

            console.warn(
                "[WhatsApp] ACK event persistence failed:",
                error?.message ||
                    error
            );

        }


        if (
            existing.interaction_id
        ) {

            try {

                db.prepare(
                    `
                    UPDATE crm_interactions
                    SET
                        outcome = ?,
                        occurred_at = datetime('now')
                    WHERE id = ?
                    `
                )
                    .run(
                        statusFromAck.toUpperCase(),
                        existing.interaction_id
                    );

            }
            catch {
                // Non-critical.
            }

        }


        emitEvent(
            "message_ack",
            {
                messageId:
                    existing.id,

                providerMessageId,

                branchId:
                    existing.branch_id ||
                    null,

                customerId:
                    existing.customer_id ||
                    null,

                phone:
                    existing.recipient_phone ||
                    null,

                campaignId:
                    existing.campaign_id ||
                    null,

                campaignTargetId:
                    existing.campaign_target_id ||
                    null,

                ack:
                    Number(
                        ack
                    ),

                status:
                    statusFromAck
            }
        );


        return {
            messageId:
                existing.id,
            providerMessageId,
            status:
                statusFromAck
        };

    }


