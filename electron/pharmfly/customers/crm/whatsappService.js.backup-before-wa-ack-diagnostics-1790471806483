function toPositiveInteger(
    value
) {

    const number =
        Number(value);

    return Number.isInteger(number) &&
        number > 0
        ? number
        : null;

}


function normalizePhone(
    phone
) {

    let cleaned =
        String(
            phone ?? ""
        )
            .replace(
                /\D/g,
                ""
            );

    if (
        !cleaned
    ) {

        return null;

    }

    if (
        cleaned.startsWith("00")
    ) {

        cleaned =
            cleaned.slice(2);

    }

    /*
     * Egypt local mobile format:
     * 010xxxxxxxx
     * 011xxxxxxxx
     * 012xxxxxxxx
     * 015xxxxxxxx
     *
     * becomes:
     * 2010xxxxxxxx
     * 2011xxxxxxxx
     * 2012xxxxxxxx
     * 2015xxxxxxxx
     */

    if (
        cleaned.startsWith("0")
    ) {

        cleaned =
            `20${cleaned.slice(1)}`;

    }

    return cleaned;

}


function toChatId(
    phone
) {

    const normalized =
        normalizePhone(
            phone
        );

    if (
        !normalized
    ) {

        throw new Error(
            "ط·آ±ط¸â€ڑط¸â€¦ ط·آ§ط¸â€‍ط¸â€،ط·آ§ط·ع¾ط¸ظ¾ ط·ط›ط¸ظ¹ط·آ± ط·آµط·آ§ط¸â€‍ط·آ­."
        );

    }

    return `${normalized}@c.us`;

}


function formatDateFromUnixTimestamp(
    timestamp
) {

    const number =
        Number(timestamp);

    if (
        !Number.isFinite(number) ||
        number <= 0
    ) {

        return new Date().toISOString();

    }

    return new Date(
        number * 1000
    ).toISOString();

}


function sleep(
    milliseconds
) {

    return new Promise(
        resolve => {
            setTimeout(
                resolve,
                milliseconds
            );
        }
    );

}


function sanitizeText(
    value
) {

    if (
        value === null ||
        value === undefined
    ) {

        return "";

    }

    return String(
        value
    );

}


function serializeMessageId(
    id
) {

    if (
        !id
    ) {

        return null;

    }

    if (
        typeof id === "string"
    ) {

        return id;

    }

    return (
        id._serialized ||
        id.id ||
        null
    );

}


function getMessageType(
    type
) {

    const normalized =
        String(
            type || "TEXT"
        )
            .trim()
            .toUpperCase();

    return normalized || "TEXT";

}


function getAckStatus(
    ack
) {

    const value =
        Number(ack);

    /*
     * whatsapp-web.js 1.34.x:
     * -1 = ERROR
     *  0 = PENDING
     *  1 = SERVER
     *  2 = DEVICE
     *  3 = READ
     *  4 = PLAYED
     */

    if (
        value < 0
    ) {

        return "failed";

    }

    if (
        value >= 3
    ) {

        return "read";

    }

    if (
        value >= 2
    ) {

        return "delivered";

    }

    if (
        value >= 1
    ) {

        return "sent";

    }

    return "queued";

}


