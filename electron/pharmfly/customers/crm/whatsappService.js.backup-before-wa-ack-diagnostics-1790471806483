function findCustomerProfile(
    db,
    {
        branchId = null,
        customerId = null,
        phone = null
    } = {}
) {

    if (
        branchId &&
        customerId
    ) {

        const exact =
            db.prepare(
                `
                SELECT
                    branch_id,
                    customer_id,
                    customer_name,
                    whatsapp_phone,
                    whatsapp_phone_normalized,
                    whatsapp_opt_in
                FROM crm_customer_profiles
                WHERE
                    branch_id = ?
                    AND customer_id = ?
                LIMIT 1
                `
            )
                .get(
                    branchId,
                    String(customerId)
                );

        if (
            exact
        ) {

            return exact;

        }

    }

    if (
        customerId
    ) {

        const byCustomer =
            db.prepare(
                `
                SELECT
                    branch_id,
                    customer_id,
                    customer_name,
                    whatsapp_phone,
                    whatsapp_phone_normalized,
                    whatsapp_opt_in
                FROM crm_customer_profiles
                WHERE customer_id = ?
                ORDER BY branch_id
                LIMIT 1
                `
            )
                .get(
                    String(customerId)
                );

        if (
            byCustomer
        ) {

            return byCustomer;

        }

    }

    const normalizedPhone =
        normalizePhone(
            phone
        );

    if (
        normalizedPhone
    ) {

        const byPhone =
            db.prepare(
                `
                SELECT
                    branch_id,
                    customer_id,
                    customer_name,
                    whatsapp_phone,
                    whatsapp_phone_normalized,
                    whatsapp_opt_in
                FROM crm_customer_profiles
                WHERE
                    whatsapp_phone_normalized = ?
                ORDER BY
                    CASE
                        WHEN branch_id = ? THEN 0
                        ELSE 1
                    END,
                    branch_id
                LIMIT 1
                `
            )
                .get(
                    normalizedPhone,
                    branchId || -1
                );

        if (
            byPhone
        ) {

            return byPhone;

        }

    }

    return null;

}


function getTemplate(
    db,
    {
        templateId = null,
        templateName = null
    } = {}
) {

    const id =
        toPositiveInteger(
            templateId
        );

    if (
        id
    ) {

        return db.prepare(
            `
            SELECT
                *
            FROM crm_whatsapp_templates
            WHERE id = ?
            LIMIT 1
            `
        )
            .get(
                id
            );

    }

    const name =
        sanitizeText(
            templateName
        )
            .trim();

    if (
        name
    ) {

        return db.prepare(
            `
            SELECT
                *
            FROM crm_whatsapp_templates
            WHERE template_name = ?
            ORDER BY id DESC
            LIMIT 1
            `
        )
            .get(
                name
            );

    }

    return null;

}


function ensureWhatsAppAccount(
    db,
    {
        branchId = null,
        accountName = null,
        displayPhoneNumber = null,
        status = null
    } = {}
) {

    const normalizedBranchId =
        toPositiveInteger(
            branchId
        );

    const existing =
        db.prepare(
            `
            SELECT
                id
            FROM crm_whatsapp_accounts
            WHERE
                provider = ?
            ORDER BY
                id
            LIMIT 1
            `
        )
            .get(
                PROVIDER
            );

    const name =
        sanitizeText(
            accountName
        )
            .trim() ||
        "PharmaBI WhatsApp";

    if (
        existing?.id
    ) {

        db.prepare(
            `
            UPDATE crm_whatsapp_accounts
            SET
                branch_id = NULL,
                account_name = ?,
                display_phone_number =
                    COALESCE(
                        ?,
                        display_phone_number
                    ),
                status =
                    COALESCE(
                        ?,
                        status
                    ),
                last_connected_at =
                    CASE
                        WHEN ? = 'ready'
                        THEN datetime('now')
                        ELSE last_connected_at
                    END,
                updated_at =
                    datetime('now')
            WHERE id = ?
            `
        )
            .run(
                name,
                displayPhoneNumber || null,
                status || null,
                status || null,
                existing.id
            );

        return existing.id;

    }

    const result =
        db.prepare(
            `
            INSERT INTO crm_whatsapp_accounts (
                branch_id,
                provider,
                account_name,
                display_phone_number,
                status,
                created_at,
                updated_at
            )
            VALUES (
                ?,
                ?,
                ?,
                ?,
                ?,
                datetime('now'),
                datetime('now')
            )
            `
        )
            .run(
                normalizedBranchId,
                PROVIDER,
                name,
                displayPhoneNumber || null,
                status || "disconnected"
            );

    return result.lastInsertRowid;

}


/*
