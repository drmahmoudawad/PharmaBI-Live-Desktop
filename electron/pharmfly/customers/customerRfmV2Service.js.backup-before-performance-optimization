function toNumber(
    value
) {

    const number =
        Number(
            value
        );


    return Number.isFinite(
        number
    )
        ? number
        : 0;

}


function round2(
    value
) {

    return Math.round(
        (
            toNumber(
                value
            ) +
            Number.EPSILON
        ) * 100
    ) / 100;

}


function round4(
    value
) {

    return Math.round(
        (
            toNumber(
                value
            ) +
            Number.EPSILON
        ) * 10000
    ) / 10000;

}


function normalizeDate(
    value
) {

    const text =
        String(
            value ||
            ""
        ).trim();


    if (
        !/^\d{4}-\d{2}-\d{2}$/.test(
            text
        )
    ) {

        throw new Error(
            "Invalid date. Expected YYYY-MM-DD"
        );

    }


    return text;

}


function addDays(
    dateText,
    days
) {

    const date =
        new Date(
            `${dateText}T00:00:00.000Z`
        );


    date.setUTCDate(
        date.getUTCDate() +
        Number(days)
    );


    return date
        .toISOString()
        .slice(
            0,
            10
        );

}


function dateDifferenceDays(
    fromDate,
    toDate
) {

    const from =
        new Date(
            `${fromDate}T00:00:00.000Z`
        );


    const to =
        new Date(
            `${toDate}T00:00:00.000Z`
        );


    return Math.max(
        0,
        Math.floor(
            (
                to.getTime() -
                from.getTime()
            ) /
            (
                1000 *
                60 *
                60 *
                24
            )
        )
    );

}


function percentileRank(
    values,
    value
) {

    if (
        values.length <= 1
    ) {

        return 0.5;

    }


    let less =
        0;


    let equal =
        0;


    for (
        const item
        of values
    ) {

        if (
            item < value
        ) {

            less +=
                1;

        }
        else if (
            item === value
        ) {

            equal +=
                1;

        }

    }


    return (
        less +
        (
            equal /
            2
        )
    ) /
    values.length;

}


function scoreLowerIsBetter(
    values,
    value
) {

    const rank =
        percentileRank(
            values,
            value
        );


    if (
        rank <= 0.20
    ) {

        return 5;

    }


    if (
        rank <= 0.40
    ) {

        return 4;

    }


    if (
        rank <= 0.60
    ) {

        return 3;

    }


    if (
        rank <= 0.80
    ) {

        return 2;

    }


    return 1;

}


function scoreHigherIsBetter(
    values,
    value
) {

    const rank =
        percentileRank(
            values,
            value
        );


    if (
        rank >= 0.80
    ) {

        return 5;

    }


    if (
        rank >= 0.60
    ) {

        return 4;

    }


    if (
        rank >= 0.40
    ) {

        return 3;

    }


    if (
        rank >= 0.20
    ) {

        return 2;

    }


    return 1;

}


function average(
    values
) {

    if (
        !values.length
    ) {

        return 0;

    }


    return (
        values.reduce(
            (
                total,
                value
            ) =>
                total +
                toNumber(
                    value
                ),
            0
        ) /
        values.length
    );

}


function calculatePurchaseInterval(
    purchaseDates
) {

    if (
        purchaseDates.length < 2
    ) {

        return 0;

    }


    const sorted =
        purchaseDates
            .slice()
            .sort();


    const intervals =
        [];


    for (
        let index = 1;
        index < sorted.length;
        index += 1
    ) {

        intervals.push(
            dateDifferenceDays(
                sorted[index - 1],
                sorted[index]
            )
        );

    }


    return round2(
        average(
            intervals
        )
    );

}


function calculateMonthlyFrequency(
    ticketCount,
    observationDays
) {

    if (
        observationDays <= 0
    ) {

        return 0;

    }


    return round4(
        (
            toNumber(
                ticketCount
            ) /
            observationDays
        ) *
        30.4375
    );

}


function calculateTrend(
    recentSales,
    previousSales,
    recentDays,
    previousDays
) {

    const recentDaily =
        recentDays > 0
            ? recentSales / recentDays
            : 0;


    const previousDaily =
        previousDays > 0
            ? previousSales / previousDays
            : 0;


    if (
        previousDaily <= 0 &&
        recentDaily > 0
    ) {

        return {

            trend:
                "GROWING",

            score:
                100,

            percent:
                null

        };

    }


    if (
        previousDaily <= 0
    ) {

        return {

            trend:
                "STABLE",

            score:
                50,

            percent:
                0

        };

    }


    const percent =
        (
            (
                recentDaily -
                previousDaily
            ) /
            previousDaily
        ) *
        100;


    if (
        percent >= 20
    ) {

        return {

            trend:
                "GROWING",

            score:
                Math.min(
                    100,
                    Math.round(
                        50 +
                        percent
                    )
                ),

            percent:
                round2(
                    percent
                )

        };

    }


    if (
        percent <= -20
    ) {

        return {

            trend:
                "DECLINING",

            score:
                Math.max(
                    0,
                    Math.round(
                        50 +
                        percent
                    )
                ),

            percent:
                round2(
                    percent
                )

        };

    }


    return {

        trend:
            "STABLE",

        score:
            Math.max(
                0,
                Math.min(
                    100,
                    Math.round(
                        50 +
                        (
                            percent /
                            2
                        )
                    )
                )
            ),

        percent:
            round2(
                percent
            )

    };

}


function determineLifecycle(
    {
        ticketCount,
        recencyDays,
        averageDaysBetweenPurchases,
        trend,
        firstPurchaseDate,
        lastPurchaseDate,
        analysisDate
    }
) {

    if (
        ticketCount <= 1
    ) {

        if (
            firstPurchaseDate &&
            lastPurchaseDate &&
            dateDifferenceDays(
                firstPurchaseDate,
                analysisDate
            ) <= 60
        ) {

            return "NEW";

        }

    }


    const expectedInterval =
        averageDaysBetweenPurchases > 0
            ? averageDaysBetweenPurchases
            : 30;


    if (
        recencyDays <=
        Math.max(
            30,
            Math.round(
                expectedInterval *
                1.5
            )
        )
    ) {

        if (
            ticketCount >= 8
        ) {

            return "LOYAL";

        }


        if (
            trend === "GROWING"
        ) {

            return "GROWING";

        }


        return "ACTIVE";

    }


    if (
        recencyDays <=
        Math.max(
            60,
            Math.round(
                expectedInterval *
                2.5
            )
        )
    ) {

        return "AT_RISK";

    }


    if (
        ticketCount >= 3
    ) {

        return "DORMANT";

    }


    return "INACTIVE";

}


function determineSegment(
    r,
    f,
    m,
    lifecycle
) {

    if (
        lifecycle === "NEW"
    ) {

        return "NEW_PROMISING";

    }


    if (
        r >= 4 &&
        f >= 4 &&
        m >= 4
    ) {

        return "CHAMPIONS";

    }


    if (
        r >= 4 &&
        f >= 3 &&
        m >= 3
    ) {

        return "LOYAL";

    }


    if (
        r >= 4 &&
        f <= 2
    ) {

        return "PROMISING";

    }


    if (
        r <= 2 &&
        f >= 4 &&
        m >= 4
    ) {

        return "HIGH_VALUE_AT_RISK";

    }


    if (
        r <= 2 &&
        f >= 3
    ) {

        return "AT_RISK";

    }


    if (
        r <= 2 &&
        f <= 2
    ) {

        return "DORMANT";

    }


    if (
        r >= 4 &&
        m >= 4
    ) {

        return "HIGH_VALUE_ACTIVE";

    }


    if (
        f >= 4
    ) {

        return "FREQUENT";

    }


    return "REGULAR";

}


function getRecommendedAction(
    segment
) {

    const actions = {

        CHAMPIONS:
            "RETENTION_VIP",

        LOYAL:
            "UPSELL_CROSS_SELL",

        NEW_PROMISING:
            "ACTIVATION",

        PROMISING:
            "SECOND_PURCHASE",

        HIGH_VALUE_AT_RISK:
            "URGENT_WIN_BACK",

        AT_RISK:
            "WIN_BACK",

        DORMANT:
            "REACTIVATION",

        HIGH_VALUE_ACTIVE:
            "VALUE_GROWTH",

        FREQUENT:
            "BASKET_GROWTH",

        REGULAR:
            "NURTURE"

    };


    return (
        actions[
            segment
        ] ||
        "NURTURE"
    );

}


function getCrmPriority(
    {
        customerValueScore,
        recencyScore,
        trendScore,
        lifecycle,
        segment
    }
) {

    let score =
        (
            customerValueScore *
            0.40
        ) +
        (
            recencyScore *
            10 *
            0.20
        ) +
        (
            trendScore *
            0.15
        );


    if (
        lifecycle === "AT_RISK"
    ) {

        score +=
            15;

    }


    if (
        lifecycle === "DORMANT"
    ) {

        score +=
            10;

    }


    if (
        segment ===
        "HIGH_VALUE_AT_RISK"
    ) {

        score +=
            15;

    }


    if (
        segment ===
        "CHAMPIONS"
    ) {

        score +=
            10;

    }


    return Math.min(
        100,
        Math.max(
            0,
            Math.round(
                score
            )
        )
    );

}


function getPriorityLevel(
    score
) {

    if (
        score >= 85
    ) {

        return "URGENT";

    }


    if (
        score >= 70
    ) {

        return "HIGH";

    }


    if (
        score >= 50
    ) {

        return "MEDIUM";

    }


    return "LOW";

}


function getCustomerValueScore(
    {
        netSales,
        grossProfit,
        tickets,
        salesValues,
        grossProfitValues,
        ticketValues
    }
) {

    const salesScore =
        scoreHigherIsBetter(
            salesValues,
            netSales
        );


    const profitScore =
        scoreHigherIsBetter(
            grossProfitValues,
            grossProfit
        );


    const frequencyScore =
        scoreHigherIsBetter(
            ticketValues,
            tickets
        );


    return Math.round(
        (
            (
                salesScore *
                0.40
            ) +
            (
                profitScore *
                0.40
            ) +
            (
                frequencyScore *
                0.20
            )
        ) *
        20
    );

}


function buildRows(
    db,
    branchId,
    fromDate,
    toDate
) {

    const toExclusive =
        addDays(
            toDate,
            1
        );


    return db.prepare(`
        SELECT
            customer_id,
            MAX(customer_name) AS customer_name,

            COUNT(
                DISTINCT CASE
                    WHEN transaction_type = 'SALE'
                    THEN ticket_id
                END
            ) AS ticket_count,

            MIN(
                CASE
                    WHEN transaction_type = 'SALE'
                    THEN substr(date, 1, 10)
                END
            ) AS first_purchase_date,

            MAX(
                CASE
                    WHEN transaction_type = 'SALE'
                    THEN substr(date, 1, 10)
                END
            ) AS last_purchase_date,

            SUM(
                CASE
                    WHEN transaction_type = 'SALE'
                    THEN ABS(COALESCE(net_line_value, 0))
                    ELSE 0
                END
            ) AS gross_sales,

            SUM(
                CASE
                    WHEN transaction_type = 'RETURN'
                    THEN ABS(COALESCE(net_line_value, 0))
                    ELSE 0
                END
            ) AS returns,

            SUM(
                CASE
                    WHEN transaction_type = 'SALE'
                    THEN ABS(COALESCE(net_line_value, 0))
                    WHEN transaction_type = 'RETURN'
                    THEN -ABS(COALESCE(net_line_value, 0))
                    ELSE 0
                END
            ) AS net_sales,

            SUM(
                CASE
                    WHEN transaction_type = 'SALE'
                    THEN ABS(COALESCE(line_cost, 0))
                    WHEN transaction_type = 'RETURN'
                    THEN -ABS(COALESCE(line_cost, 0))
                    ELSE 0
                END
            ) AS net_cost

        FROM sales_history

        WHERE
            branch_id = ?
            AND customer_id IS NOT NULL
            AND TRIM(customer_id) <> ''
            AND CAST(customer_id AS INTEGER) > 0
            AND transaction_type IN ('SALE', 'RETURN')
            AND date >= ?
            AND date < ?

        GROUP BY
            customer_id

    `).all(
        Number(branchId),
        `${fromDate}T00:00:00.000Z`,
        `${toExclusive}T00:00:00.000Z`
    );

}


function buildPurchaseDates(
    db,
    branchId,
    fromDate,
    toDate
) {

    const toExclusive =
        addDays(
            toDate,
            1
        );


    const rows =
        db.prepare(`
            SELECT
                customer_id,
                substr(date, 1, 10) AS purchase_date
            FROM sales_history
            WHERE
                branch_id = ?
                AND customer_id IS NOT NULL
                AND TRIM(customer_id) <> ''
                AND CAST(customer_id AS INTEGER) > 0
                AND transaction_type = 'SALE'
                AND date >= ?
                AND date < ?
            GROUP BY
                customer_id,
                substr(date, 1, 10)
            ORDER BY
                customer_id,
                purchase_date
        `).all(
            Number(branchId),
            `${fromDate}T00:00:00.000Z`,
            `${toExclusive}T00:00:00.000Z`
        );


    const map =
        new Map();


    for (
        const row
        of rows
    ) {

        const customerId =
            String(
                row.customer_id
            );


        if (
            !map.has(
                customerId
            )
        ) {

            map.set(
                customerId,
                []
            );

        }


        map.get(
            customerId
        ).push(
            String(
                row.purchase_date
            )
        );

    }


    return map;

}


function buildTrendData(
    db,
    branchId,
    analysisDate,
    trendDays
) {

    const recentToDate =
        analysisDate;


    const recentFromDate =
        addDays(
            analysisDate,
            -trendDays + 1
        );


    const previousToDate =
        addDays(
            recentFromDate,
            -1
        );


    const previousFromDate =
        addDays(
            previousToDate,
            -trendDays + 1
        );


    const rows =
        db.prepare(`
            SELECT

                customer_id,

                SUM(
                    CASE
                        WHEN transaction_type = 'SALE'
                            THEN ABS(COALESCE(net_line_value, 0))
                        WHEN transaction_type = 'RETURN'
                            THEN -ABS(COALESCE(net_line_value, 0))
                        ELSE 0
                    END
                ) AS net_sales,

                CASE
                    WHEN substr(date, 1, 10) BETWEEN ? AND ?
                        THEN 'RECENT'
                    ELSE 'PREVIOUS'
                END AS period

            FROM sales_history

            WHERE
                branch_id = ?
                AND customer_id IS NOT NULL
                AND TRIM(customer_id) <> ''
                AND CAST(customer_id AS INTEGER) > 0
                AND transaction_type IN ('SALE', 'RETURN')
                AND date >= ?
                AND date < ?

            GROUP BY
                customer_id,
                period

        `).all(
            recentFromDate,
            recentToDate,
            Number(branchId),
            `${previousFromDate}T00:00:00.000Z`,
            `${addDays(recentToDate, 1)}T00:00:00.000Z`
        );


    const map =
        new Map();


    for (
        const row
        of rows
    ) {

        const customerId =
            String(
                row.customer_id
            );


        if (
            !map.has(
                customerId
            )
        ) {

            map.set(
                customerId,
                {

                    recentSales:
                        0,

                    previousSales:
                        0

                }
            );

        }


        const item =
            map.get(
                customerId
            );


        if (
            row.period ===
            "RECENT"
        ) {

            item.recentSales +=
                toNumber(
                    row.net_sales
                );

        }
        else {

            item.previousSales +=
                toNumber(
                    row.net_sales
                );

        }

    }


    return {

        map,

        recentFromDate,

        recentToDate,

        previousFromDate,

        previousToDate

    };

}


