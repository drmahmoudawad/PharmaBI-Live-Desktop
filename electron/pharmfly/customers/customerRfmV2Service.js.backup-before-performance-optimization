                @last_purchase_date,
                @recency_days,
                @ticket_count,
                @net_sales,
                @gross_profit,
                @average_ticket_value,
                @average_days_between_purchases,
                @monthly_frequency,
                @r_score,
                @f_score,
                @m_score,
                @rfm_score,
                @rfm_total,
