                            customer.customerValueScore,

                        priority_score:
                            customer.crmPriorityScore,

                        priority_level:
                            customer.crmPriorityLevel,

                        crm_eligibility:
                            customer.crmEligibility,

                        recommended_action:
                            customer.recommendedAction,

                        purchase_trend:
                            customer.purchaseTrend,

                        purchase_trend_score:
                            customer.purchaseTrendScore

                    });


                    upsertProfile.run({

                        branch_id:
                            Number(
                                branchId
                            ),

                        customer_id:
                            customer.customerId,

                        customer_name:
                            customer.customerName,

                        first_purchase_date:
                            customer.firstPurchaseDate,

                        last_purchase_date:
                            customer.lastPurchaseDate,

                        total_tickets:
                            customer.ticketCount,

                        total_net_sales:
                            customer.netSales,

                        total_gross_profit:
                            customer.grossProfit,

                        average_ticket_value:
                            customer.averageTicketValue,

                        average_days_between_purchases:
                            customer.averageDaysBetweenPurchases,

                        purchase_frequency_monthly:
                            customer.monthlyFrequency,

                        r_score:
                            customer.r,

                        f_score:
                            customer.f,

                        m_score:
                            customer.m,

                        rfm_score:
                            customer.rfmScore,

                        rfm_total:
                            customer.rfmTotal,

                        segment_code:
                            customer.segmentCode,

                        lifecycle_stage:
                            customer.lifecycleStage,

                        behavior_score:
                            customer.behaviorScore,

                        customer_value_score:
                            customer.customerValueScore,

                        crm_priority_score:
                            customer.crmPriorityScore,

                        crm_priority_level:
                            customer.crmPriorityLevel,

                        crm_eligibility:
                            customer.crmEligibility,

                        recommended_action:
                            customer.recommendedAction,

                        purchase_trend:
                            customer.purchaseTrend,

                        purchase_trend_score:
                            customer.purchaseTrendScore

                    });

                }


                return snapshotId;

            }
        );


    const snapshotId =
        transaction();


    crmDb.close();


    return snapshotId;

}


/*
 * =========================================================
 * MAIN RFM V2
 * =========================================================
 */

export async function getCustomerRfmV2(
    {
        branchId,
        analysisDate,
        observationDays = 365,
        trendDays = 90,
        minTickets = 1,
        saveSnapshot = true
    }
) {

    const numericBranchId =
        Number(
            branchId
        );


    if (
        !Number.isInteger(
            numericBranchId
        ) ||
        numericBranchId <= 0
    ) {

        throw new Error(
            "Invalid branchId"
        );

    }


    const normalizedAnalysisDate =
        normalizeDate(
            analysisDate
        );


    const normalizedObservationDays =
        Math.max(
            30,
            Math.min(
                1825,
                Math.floor(
                    Number(
                        observationDays
                    ) ||
                    365
                )
            )
        );


    const normalizedTrendDays =
        Math.max(
            30,
            Math.min(
                365,
                Math.floor(
                    Number(
                        trendDays
                    ) ||
                    90
                )
            )
        );


    const observationFromDate =
        addDays(
            normalizedAnalysisDate,
            -normalizedObservationDays + 1
        );


    const observationToDate =
        normalizedAnalysisDate;


    const recentToDate =
        normalizedAnalysisDate;


    const recentFromDate =
        addDays(
            normalizedAnalysisDate,
            -normalizedTrendDays + 1
        );


    const previousToDate =
        addDays(
            recentFromDate,
            -1
        );


    const previousFromDate =
        addDays(
            previousToDate,
            -normalizedTrendDays + 1
        );


    const db =
        getLocalSalesDatabase();


    const rawRows =
        loadCustomerDataset(
            db,
            {

                branchId:
                    numericBranchId,

                observationFromDate,

                observationToDate,

                recentFromDate,

                recentToDate,

                previousFromDate,

                previousToDate

            }
        );


    const filteredRows =
        rawRows.filter(
            row =>
                Number(
                    row.ticket_count
                ) >=
                Math.max(
                    1,
                    Number(
                        minTickets
                    ) || 1
                )
        );


    if (
        filteredRows.length === 0
    ) {

        return {

            success:
                true,

            snapshotId:
                null,

            branchId:
                numericBranchId,

            analysisDate:
                normalizedAnalysisDate,

            observationFromDate,

            observationToDate,

            observationDays:
                normalizedObservationDays,

            trendDays:
                normalizedTrendDays,

            customers:
                [],

            summary: {

                customers:
                    0,

                netSales:
                    0,

                grossProfit:
                    0,

                averageCustomerValue:
                    0,

                averageTicketValue:
                    0,

                averageRecencyDays:
                    0,

                averageMonthlyFrequency:
                    0,

                segments:
                    [],

                lifecycle:
                    [],

                growingCustomers:
                    0,

                decliningCustomers:
                    0,

                crmEligibleCustomers:
                    0

            }

        };

    }


    const recencyValues =
        [];


    const frequencyValues =
        [];


    const monetaryValues =
        [];


    const grossProfitValues =
        [];


    for (
        const row
        of filteredRows
    ) {

        const lastPurchaseDate =
            row.last_purchase_date;


        const recencyDays =
            lastPurchaseDate
                ? dateDifferenceDays(
                    lastPurchaseDate,
                    normalizedAnalysisDate
                )
                : 9999;


        const netSales =
            Math.max(
                0,
                toNumber(
                    row.net_sales
                )
            );


        const grossProfit =
            toNumber(
                row.net_sales
            ) -
            toNumber(
                row.net_cost
            );


        recencyValues.push(
            recencyDays
        );


        frequencyValues.push(
            Number(
                row.ticket_count
            ) ||
            0
        );


        monetaryValues.push(
            netSales
        );


        grossProfitValues.push(
            grossProfit
        );

    }


    const scoredCustomers =
        filteredRows.map(
            row => {

                const customerId =
                    String(
                        row.customer_id
                    );


                const ticketCount =
                    Number(
                        row.ticket_count
                    ) ||
                    0;


                const netSales =
                    round2(
                        row.net_sales
                    );


                const netCost =
                    toNumber(
                        row.net_cost
                    );


                const grossProfit =
                    round2(
                        netSales -
                        netCost
                    );


                const firstPurchaseDate =
                    row.first_purchase_date ||
                    null;


                const lastPurchaseDate =
                    row.last_purchase_date ||
                    null;


                const recencyDays =
                    lastPurchaseDate
                        ? dateDifferenceDays(
                            lastPurchaseDate,
                            normalizedAnalysisDate
                        )
                        : 9999;


                const averageDaysBetweenPurchases =
                    round2(
                        row.average_interval
                    );


                const monthlyFrequency =
                    calculateMonthlyFrequency(
                        ticketCount,
                        normalizedObservationDays
                    );


                const averageTicketValue =
                    ticketCount > 0
                        ? round2(
                            netSales /
                            ticketCount
                        )
                        : 0;


                const recentSales =
                    Math.max(
                        0,
                        toNumber(
                            row.recent_sales
                        )
                    );


                const previousSales =
                    Math.max(
                        0,
                        toNumber(
                            row.previous_sales
                        )
                    );


                const trendResult =
                    calculateTrend(
                        recentSales,
                        previousSales,
                        normalizedTrendDays
                    );


                const r =
                    scoreLowerIsBetter(
                        recencyValues,
                        recencyDays
                    );


                const f =
                    scoreHigherIsBetter(
                        frequencyValues,
                        ticketCount
                    );


                const m =
                    scoreHigherIsBetter(
                        monetaryValues,
                        Math.max(
                            0,
                            netSales
                        )
                    );


                const lifecycle =
                    determineLifecycle({

                        ticketCount,

                        recencyDays,

                        averageDaysBetweenPurchases,

                        trend:
                            trendResult.trend,

                        firstPurchaseDate,

                        lastPurchaseDate,

                        analysisDate:
                            normalizedAnalysisDate

                    });


                const segmentCode =
                    determineSegment(
                        r,
                        f,
                        m,
                        lifecycle
                    );


                const customerValueScore =
                    getCustomerValueScore({

                        netSales,

                        grossProfit,

                        tickets:
                            ticketCount,

                        salesValues:
                            monetaryValues,

                        grossProfitValues,

                        ticketValues:
                            frequencyValues

                    });


                const behaviorScore =
                    Math.max(
                        0,
                        Math.min(
                            100,
                            Math.round(
                                (
                                    (
                                        f *
                                        20
                                    ) *
                                    0.25

                                ) +

                                (
                                    (
                                        m *
                                        20
                                    ) *
                                    0.20

                                ) +

                                (
                                    trendResult.score *
                                    0.30

                                ) +

                                (
                                    (
                                        100 -
                                        Math.min(
                                            100,
                                            recencyDays
                                        )
                                    ) *
                                    0.25

                                )
                            )
                        )
                    );


                const crmPriorityScore =
                    getCrmPriority({

                        customerValueScore,

                        recencyScore:
                            r,

                        trendScore:
                            trendResult.score,

                        lifecycle,

                        segment:
                            segmentCode

                    });


                const crmPriorityLevel =
                    getPriorityLevel(
                        crmPriorityScore
                    );


                const crmEligibility =
                    ticketCount > 0
                        ? 1
                        : 0;


                return {

                    customerId,

                    customerName:
                        row.customer_name ||
                        "غير معروف",

                    firstPurchaseDate,

                    lastPurchaseDate,

                    recencyDays,

                    ticketCount,

                    netSales,

                    grossProfit,

                    averageTicketValue,

                    averageDaysBetweenPurchases,

                    monthlyFrequency,

                    r,

                    f,

                    m,

                    rfmScore:
                        `${r}${f}${m}`,

                    rfmTotal:
                        r +
                        f +
                        m,

                    segmentCode,

                    lifecycleStage:
                        lifecycle,

                    behaviorScore,

                    customerValueScore,

                    crmPriorityScore,

                    crmPriorityLevel,

                    crmEligibility,

                    recommendedAction:
                        getRecommendedAction(
                            segmentCode
                        ),

                    purchaseTrend:
                        trendResult.trend,

                    purchaseTrendScore:
                        trendResult.score,

                    purchaseTrendPercent:
                        trendResult.percent,

                    recent90Sales:
                        round2(
                            recentSales
                        ),

                    previous90Sales:
                        round2(
                            previousSales
                        )

                };

            }
        );


    scoredCustomers.sort(
        (
            a,
            b
        ) => {

            if (
                b.crmPriorityScore !==
                a.crmPriorityScore
            ) {

                return (
                    b.crmPriorityScore -
                    a.crmPriorityScore
                );

            }


            if (
                b.customerValueScore !==
                a.customerValueScore
            ) {

                return (
                    b.customerValueScore -
                    a.customerValueScore
                );

            }


            return (
                b.netSales -
                a.netSales
            );

        }
    );


    const totalNetSales =
        scoredCustomers.reduce(
            (
                total,
                customer
            ) =>
                total +
                customer.netSales,
            0
        );


    const totalGrossProfit =
        scoredCustomers.reduce(
            (
                total,
                customer
            ) =>
                total +
                customer.grossProfit,
            0
        );


    const segmentsMap =
        new Map();


    const lifecycleMap =
        new Map();


    for (
        const customer
        of scoredCustomers
    ) {

        if (
            !segmentsMap.has(
                customer.segmentCode
            )
        ) {

            segmentsMap.set(
                customer.segmentCode,
                {

                    code:
                        customer.segmentCode,

                    customers:
                        0,

                    netSales:
                        0,

                    grossProfit:
                        0

                }
            );

        }


        const segment =
            segmentsMap.get(
                customer.segmentCode
            );


        segment.customers +=
            1;

        segment.netSales +=
            customer.netSales;

        segment.grossProfit +=
            customer.grossProfit;


        if (
            !lifecycleMap.has(
                customer.lifecycleStage
            )
        ) {

            lifecycleMap.set(
                customer.lifecycleStage,
                {

                    stage:
                        customer.lifecycleStage,

                    customers:
                        0,

                    netSales:
                        0

                }
            );

        }


        const lifecycle =
            lifecycleMap.get(
                customer.lifecycleStage
            );


        lifecycle.customers +=
            1;

        lifecycle.netSales +=
            customer.netSales;

    }


    const segments =
        Array.from(
            segmentsMap.values()
        )
        .map(
            item => ({

                ...item,

                netSales:
                    round2(
                        item.netSales
                    ),

                grossProfit:
                    round2(
                        item.grossProfit
                    )

            })
        )
        .sort(
            (
                a,
                b
            ) =>
                b.netSales -
                a.netSales
        );


    const lifecycle =
        Array.from(
            lifecycleMap.values()
        )
        .map(
            item => ({

                ...item,

                netSales:
                    round2(
                        item.netSales
                    )

            })
        )
        .sort(
            (
                a,
                b
            ) =>
                b.customers -
                a.customers
        );


    const growingCustomers =
        scoredCustomers.filter(
            customer =>
                customer.purchaseTrend ===
                "GROWING"
        ).length;


    const decliningCustomers =
        scoredCustomers.filter(
            customer =>
                customer.purchaseTrend ===
                "DECLINING"
        ).length;


    const crmEligibleCustomers =
        scoredCustomers.filter(
            customer =>
                customer.crmEligibility ===
                1
        ).length;


    let snapshotId =
        null;


    if (
        saveSnapshot
    ) {

        snapshotId =
            saveRfmSnapshot({

                branchId:
                    numericBranchId,

                analysisDate:
                    normalizedAnalysisDate,

                observationFromDate,

                observationToDate,

                observationDays:
                    normalizedObservationDays,

                customers:
                    scoredCustomers,

                totalNetSales,

                totalGrossProfit

            });

    }


    return {

        success:
            true,

        snapshotId,

        branchId:
            numericBranchId,

        analysisDate:
            normalizedAnalysisDate,

        observationFromDate,

        observationToDate,

        observationDays:
            normalizedObservationDays,

        trendDays:
            normalizedTrendDays,

        summary: {

            customers:
                scoredCustomers.length,

            netSales:
                round2(
                    totalNetSales
                ),

            grossProfit:
                round2(
                    totalGrossProfit
                ),

            averageCustomerValue:
                round2(
                    totalNetSales /
                    Math.max(
                        1,
                        scoredCustomers.length
                    )
                ),

            averageTicketValue:
                round2(
                    average(
                        scoredCustomers.map(
                            customer =>
                                customer.averageTicketValue
                        )
                    )
                ),

            averageRecencyDays:
                round2(
                    average(
                        scoredCustomers.map(
                            customer =>
                                customer.recencyDays
                        )
                    )
                ),

            averageMonthlyFrequency:
                round4(
                    average(
                        scoredCustomers.map(
                            customer =>
                                customer.monthlyFrequency
                        )
                    )
                ),

            segments,

            lifecycle,

            growingCustomers,

            decliningCustomers,

            crmEligibleCustomers

        },

        customers:
            scoredCustomers

    };

}


export default {

    getCustomerRfmV2

};