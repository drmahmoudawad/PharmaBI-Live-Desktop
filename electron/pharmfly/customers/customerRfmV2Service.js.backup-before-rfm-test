function toNumber(
    value
) {

    const number =
        Number(
            value
        );


    return Number.isFinite(
        number
    )
        ? number
        : 0;

}


function round2(
    value
) {

    return Math.round(
        (
            toNumber(
                value
            ) +
            Number.EPSILON
        ) * 100
    ) / 100;

}


function round4(
    value
) {

    return Math.round(
        (
            toNumber(
                value
            ) +
            Number.EPSILON
        ) * 10000
    ) / 10000;

}


function normalizeDate(
    value
) {

    const text =
        String(
            value ||
            ""
        ).trim();


    if (
        !/^\d{4}-\d{2}-\d{2}$/.test(
            text
        )
    ) {

        throw new Error(
            "Invalid date. Expected YYYY-MM-DD"
        );

    }


    return text;

}


function addDays(
    dateText,
    days
) {

    const date =
        new Date(
            `${dateText}T00:00:00.000Z`
        );


    date.setUTCDate(
        date.getUTCDate() +
        Number(
            days
        )
    );


    return date
        .toISOString()
        .slice(
            0,
            10
        );

}


function dateDifferenceDays(
    fromDate,
    toDate
) {

    const from =
        new Date(
            `${fromDate}T00:00:00.000Z`
        );


    const to =
        new Date(
            `${toDate}T00:00:00.000Z`
        );


    return Math.max(
        0,
        Math.floor(
            (
                to.getTime() -
                from.getTime()
            ) /
            86400000
        )
    );

}


function percentileRank(
    values,
    value
) {

    if (
        values.length <= 1
    ) {

        return 0.5;

    }


    let less =
        0;


    let equal =
        0;


    for (
        const item
        of values
    ) {

        if (
            item < value
        ) {

            less +=
                1;

        }
        else if (
            item === value
        ) {

            equal +=
                1;

        }

    }


    return (
        less +
        (
            equal /
            2
        )
    ) /
    values.length;

}


function scoreLowerIsBetter(
    values,
    value
) {

    const rank =
        percentileRank(
            values,
            value
        );


    if (
        rank <= 0.20
    ) {

        return 5;

    }


    if (
        rank <= 0.40
    ) {

        return 4;

    }


    if (
        rank <= 0.60
    ) {

        return 3;

    }


    if (
        rank <= 0.80
    ) {

        return 2;

    }


    return 1;

}


function scoreHigherIsBetter(
    values,
    value
) {

    const rank =
        percentileRank(
            values,
            value
        );


    if (
        rank >= 0.80
    ) {

        return 5;

    }


    if (
        rank >= 0.60
    ) {

        return 4;

    }


    if (
        rank >= 0.40
    ) {

        return 3;

    }


    if (
        rank >= 0.20
    ) {

        return 2;

    }


    return 1;

}


function average(
    values
) {

    if (
        !values.length
    ) {

        return 0;

    }


    return (
        values.reduce(
            (
                total,
                value
            ) =>
                total +
                toNumber(
                    value
                ),
            0
        ) /
        values.length
    );

}


function calculateMonthlyFrequency(
    ticketCount,
    observationDays
) {

    if (
        observationDays <= 0
    ) {

        return 0;

    }


    return round4(
        (
            toNumber(
                ticketCount
            ) /
            observationDays
        ) *
        30.4375
    );

}


function calculateTrend(
    recentSales,
    previousSales,
    days
) {

    const recentDaily =
        days > 0
            ? recentSales / days
            : 0;


    const previousDaily =
        days > 0
            ? previousSales / days
            : 0;


    if (
        previousDaily <= 0 &&
        recentDaily > 0
    ) {

        return {

            trend:
                "GROWING",

            score:
                100,

            percent:
                null

        };

    }


    if (
        previousDaily <= 0
    ) {

        return {

            trend:
                "STABLE",

            score:
                50,

            percent:
                0

        };

    }


    const percent =
        (
            (
                recentDaily -
                previousDaily
            ) /
            previousDaily
        ) *
        100;


    if (
        percent >= 20
    ) {

        return {

            trend:
                "GROWING",

            score:
                Math.min(
                    100,
                    Math.round(
                        50 +
                        percent
                    )
                ),

            percent:
                round2(
                    percent
                )

        };

    }


    if (
        percent <= -20
    ) {

        return {

            trend:
                "DECLINING",

            score:
                Math.max(
                    0,
                    Math.round(
                        50 +
                        percent
                    )
                ),

            percent:
                round2(
                    percent
                )

        };

    }


    return {

        trend:
            "STABLE",

        score:
            Math.max(
                0,
                Math.min(
                    100,
                    Math.round(
                        50 +
                        (
                            percent /
                            2
                        )
                    )
                )
            ),

        percent:
            round2(
                percent
            )

    };

}


function determineLifecycle(
    {
        ticketCount,
        recencyDays,
        averageDaysBetweenPurchases,
        trend,
        firstPurchaseDate,
        lastPurchaseDate,
        analysisDate
    }
) {

    if (
        ticketCount <= 1
    ) {

        if (
            firstPurchaseDate &&
            lastPurchaseDate &&
            dateDifferenceDays(
                firstPurchaseDate,
                analysisDate
            ) <= 60
        ) {

            return "NEW";

        }

    }


    const expectedInterval =
        averageDaysBetweenPurchases > 0
            ? averageDaysBetweenPurchases
            : 30;


    if (
        recencyDays <=
        Math.max(
            30,
            Math.round(
                expectedInterval *
                1.5
            )
        )
    ) {

        if (
            ticketCount >= 8
        ) {

            return "LOYAL";

        }


        if (
            trend ===
            "GROWING"
        ) {

            return "GROWING";

        }


        return "ACTIVE";

    }


    if (
        recencyDays <=
        Math.max(
            60,
            Math.round(
                expectedInterval *
                2.5
            )
        )
    ) {

        return "AT_RISK";

    }


    if (
        ticketCount >= 3
    ) {

        return "DORMANT";

    }


    return "INACTIVE";

}


function determineSegment(
    r,
    f,
    m,
    lifecycle
) {

    if (
        lifecycle ===
        "NEW"
    ) {

        return "NEW_PROMISING";

    }


    if (
        r >= 4 &&
        f >= 4 &&
        m >= 4
    ) {

        return "CHAMPIONS";

    }


    if (
        r >= 4 &&
        f >= 3 &&
        m >= 3
    ) {

        return "LOYAL";

    }


    if (
        r >= 4 &&
        f <= 2
    ) {

        return "PROMISING";

    }


    if (
        r <= 2 &&
        f >= 4 &&
        m >= 4
    ) {

        return "HIGH_VALUE_AT_RISK";

    }


    if (
        r <= 2 &&
        f >= 3
    ) {

        return "AT_RISK";

    }


    if (
        r <= 2 &&
        f <= 2
    ) {

        return "DORMANT";

    }


    if (
        r >= 4 &&
        m >= 4
    ) {

        return "HIGH_VALUE_ACTIVE";

    }


    if (
        f >= 4
    ) {

        return "FREQUENT";

    }


    return "REGULAR";

}


function getRecommendedAction(
    segment
) {

    const actions = {

        CHAMPIONS:
            "RETENTION_VIP",

        LOYAL:
            "UPSELL_CROSS_SELL",

        NEW_PROMISING:
            "ACTIVATION",

        PROMISING:
            "SECOND_PURCHASE",

        HIGH_VALUE_AT_RISK:
            "URGENT_WIN_BACK",

        AT_RISK:
            "WIN_BACK",

        DORMANT:
            "REACTIVATION",

        HIGH_VALUE_ACTIVE:
            "VALUE_GROWTH",

        FREQUENT:
            "BASKET_GROWTH",

        REGULAR:
            "NURTURE"

    };


    return (
        actions[
            segment
        ] ||
        "NURTURE"
    );

}


function getPriorityLevel(
    score
) {

    if (
        score >= 85
    ) {

        return "URGENT";

    }


    if (
        score >= 70
    ) {

        return "HIGH";

    }


    if (
        score >= 50
    ) {

        return "MEDIUM";

    }


    return "LOW";

}


function getCustomerValueScore(
    {
        netSales,
        grossProfit,
        tickets,
        salesValues,
        grossProfitValues,
        ticketValues
    }
) {

    const salesScore =
        scoreHigherIsBetter(
            salesValues,
            Math.max(
                0,
                netSales
            )
        );


    const profitScore =
        scoreHigherIsBetter(
            grossProfitValues,
            grossProfit
        );


    const frequencyScore =
        scoreHigherIsBetter(
            ticketValues,
            tickets
        );


    return Math.round(
        (
            (
                salesScore *
                0.40
            ) +
            (
                profitScore *
                0.40
            ) +
            (
                frequencyScore *
                0.20
            )
        ) *
        20
    );

}


function getCrmPriority(
    {
        customerValueScore,
        recencyScore,
        trendScore,
        lifecycle,
        segment
    }
) {

    let score =
        (
            customerValueScore *
            0.40
        ) +
        (
            recencyScore *
            10 *
            0.20
        ) +
        (
            trendScore *
            0.15
        );


    if (
        lifecycle ===
        "AT_RISK"
    ) {

        score +=
            15;

    }


    if (
        lifecycle ===
        "DORMANT"
    ) {

        score +=
            10;

    }


    if (
        segment ===
        "HIGH_VALUE_AT_RISK"
    ) {

        score +=
            15;

    }


    if (
        segment ===
        "CHAMPIONS"
    ) {

        score +=
            10;

    }


    return Math.min(
        100,
        Math.max(
            0,
            Math.round(
                score
            )
        )
    );

}


/*
 * =========================================================
 * FAST SQL DATASET
 *
 * One primary range scan.
 * Customer daily purchase dates + interval statistics
 * are derived from the same filtered dataset.
 * =========================================================
 */

function loadCustomerDataset(
    db,
    {
        branchId,
        observationFromDate,
        observationToDate,
        recentFromDate,
        recentToDate,
        previousFromDate,
        previousToDate
    }
) {

    const observationToExclusive =
        addDays(
            observationToDate,
            1
        );


    const startedAt =
        Date.now();


    const rows =
        db.prepare(`

            WITH filtered AS (

                SELECT

                    customer_id,

                    MAX(
                        customer_name
                    ) OVER (
                        PARTITION BY
                            customer_id
                    ) AS resolved_customer_name,

                    substr(
                        date,
                        1,
                        10
                    ) AS sale_date,

                    transaction_type,

                    ticket_id,

                    ABS(
                        COALESCE(
                            net_line_value,
                            0
                        )
                    ) AS line_value,

                    ABS(
                        COALESCE(
                            line_cost,
                            0
                        )
                    ) AS line_cost

                FROM sales_history

                WHERE

                    branch_id = ?

                    AND customer_id IS NOT NULL

                    AND TRIM(
                        customer_id
                    ) <> ''

                    AND CAST(
                        customer_id AS INTEGER
                    ) > 0

                    AND transaction_type IN (
                        'SALE',
                        'RETURN'
                    )

                    AND date >= ?

                    AND date < ?

            ),

            customer_daily AS (

                SELECT

                    customer_id,

                    sale_date

                FROM filtered

                WHERE
                    transaction_type =
                    'SALE'

                GROUP BY

                    customer_id,

                    sale_date

            ),

            daily_intervals AS (

                SELECT

                    customer_id,

                    (
                        julianday(
                            sale_date
                        ) -
                        julianday(
                            LAG(
                                sale_date
                            ) OVER (
                                PARTITION BY
                                    customer_id
                                ORDER BY
                                    sale_date
                            )
                        )
                    ) AS day_interval

                FROM customer_daily

            ),

            interval_stats AS (

                SELECT

                    customer_id,

                    AVG(
                        day_interval
                    ) AS average_interval

                FROM daily_intervals

                WHERE
                    day_interval IS NOT NULL

                GROUP BY
                    customer_id

            ),

            customer_stats AS (

                SELECT

                    customer_id,

                    MAX(
                        resolved_customer_name
                    ) AS customer_name,

                    COUNT(
                        DISTINCT CASE
                            WHEN transaction_type =
                                'SALE'
                            THEN ticket_id
                        END
                    ) AS ticket_count,

                    MIN(
                        CASE
                            WHEN transaction_type =
                                'SALE'
                            THEN sale_date
                        END
                    ) AS first_purchase_date,

                    MAX(
                        CASE
                            WHEN transaction_type =
                                'SALE'
                            THEN sale_date
                        END
                    ) AS last_purchase_date,

                    SUM(
                        CASE
                            WHEN transaction_type =
                                'SALE'
                            THEN line_value
                            ELSE 0
                        END
                    ) AS gross_sales,

                    SUM(
                        CASE
                            WHEN transaction_type =
                                'RETURN'
                            THEN line_value
                            ELSE 0
                        END
                    ) AS returns,

                    SUM(
                        CASE
                            WHEN transaction_type =
                                'SALE'
                            THEN line_value

                            WHEN transaction_type =
                                'RETURN'
                            THEN -line_value

                            ELSE 0

                        END
                    ) AS net_sales,

                    SUM(
                        CASE
                            WHEN transaction_type =
                                'SALE'
                            THEN line_cost

                            WHEN transaction_type =
                                'RETURN'
                            THEN -line_cost

                            ELSE 0

                        END
                    ) AS net_cost,

                    SUM(
                        CASE
                            WHEN transaction_type =
                                'SALE'
                                AND sale_date >= ?
                                AND sale_date <= ?
                            THEN line_value

                            WHEN transaction_type =
                                'RETURN'
                                AND sale_date >= ?
                                AND sale_date <= ?
                            THEN -line_value

                            ELSE 0

                        END
                    ) AS recent_sales,

                    SUM(
                        CASE
                            WHEN transaction_type =
                                'SALE'
                                AND sale_date >= ?
                                AND sale_date <= ?
                            THEN line_value

                            WHEN transaction_type =
                                'RETURN'
                                AND sale_date >= ?
                                AND sale_date <= ?
                            THEN -line_value

                            ELSE 0

                        END
                    ) AS previous_sales

                FROM filtered

                GROUP BY
                    customer_id

            )

            SELECT

                customer_stats.*,

                COALESCE(
                    interval_stats.average_interval,
                    0
                ) AS average_interval

            FROM customer_stats

            LEFT JOIN interval_stats

                ON interval_stats.customer_id =
                   customer_stats.customer_id

            ORDER BY
                customer_stats.customer_id

        `).all(

            Number(
                branchId
            ),

            `${observationFromDate}T00:00:00.000Z`,

            `${observationToExclusive}T00:00:00.000Z`,

            recentFromDate,
            recentToDate,

            recentFromDate,
            recentToDate,

            previousFromDate,
            previousToDate,

            recentFromDate,
            recentToDate,

            previousFromDate,
            previousToDate

        );


    const elapsed =
        Date.now() -
        startedAt;


    console.log(
        `[RFM V2] SQL dataset branch=${branchId} rows=${rows.length} in ${elapsed} ms`
    );


    return rows;

}


