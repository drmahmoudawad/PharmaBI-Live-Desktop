export async function getTicketReconciliation(
    {
        branchId,
        fromDate,
        toDate,
        connection = null
    }
) {

    const rows =
        await getSales({

            branchId,

            fromDate,

            toDate,

            connection

        });


    const tickets =
        new Map();


    for (
        const row
        of rows
    ) {

        if (
            !tickets.has(
                row.ticketId
            )
        ) {

            tickets.set(

                row.ticketId,

                {

                    ticketId:
                        row.ticketId,

                    date:
                        row.date,

                    transactionType:
                        row.transactionType,

                    ticketTotal:
                        row.ticketTotal,

                    lineGross:
                        0,

                    lineDiscount:
                        0,

                    lineExtraDiscount:
                        0,

                    lineNet:
                        0,

                    lineCost:
                        0,

                    units:
                        0,

                    lineCount:
                        0

                }

            );

        }


        const ticket =
            tickets.get(
                row.ticketId
            );


        ticket.lineGross +=
            row.grossLineValue;


        ticket.lineDiscount +=
            row.discount;


        ticket.lineExtraDiscount +=
            row.extraDiscount;


        ticket.lineNet +=
            row.netLineValue;


        ticket.lineCost +=
            row.lineCost;


        ticket.units +=
            row.baseUnits;


        ticket.lineCount +=
            1;

    }


    return Array.from(
        tickets.values()
    )
    .map(
        ticket => {

            const difference =
                ticket.ticketTotal -
                ticket.lineNet;


            return {

                ...ticket,

                reconciliationDifference:
                    difference,

                absDifference:
                    Math.abs(
                        difference
                    ),

                isReconciled:
                    Math.abs(
                        difference
                    ) <=
                    RECONCILIATION_TOLERANCE

            };

        }
    );

}


/*
 * =========================================================
 * SALES SUMMARY
 * =========================================================
 */

export async function getSalesSummary(
    {
        branchId,
        fromDate,
        toDate,
        connection = null,
        includeReconciliation = true
    }
) {

    const rows =
        await getSales({

            branchId,

            fromDate,

            toDate,

            connection

        });


    let grossSales =
        0;


    let returns =
        0;


    let grossCost =
        0;


    let returnCost =
        0;


    let grossUnits =
        0;


    let returnedUnits =
        0;


    let deliverySales =
        0;


    let deliveryReturns =
        0;


    const saleTickets =
        new Set();


    const returnTickets =
        new Set();


    const deliveryTickets =
        new Set();


    for (
        const row
        of rows
    ) {

        /*
         * =====================================================
         * DELIVERY CLASSIFICATION
         * =====================================================
         *
         * This follows the existing PharmaFly dashboard logic:
         *
         * a customer-linked ticket with a non-empty Cards.Name
         * is treated as a delivery/customer order.
         *
         * DeliveryBoyId is intentionally NOT used because our
         * database tests showed it is NULL/0 on the target branch.
         *
         */

        const isDelivery =
            String(
                row?.customerName ||
                ""
            ).trim() !== "";


        if (
            row.transactionType ===
            "RETURN"
        ) {

            const returnValue =
                Math.abs(
                    row.netLineValue
                );


            returns +=
                returnValue;


            returnCost +=
                Math.abs(
                    row.lineCost
                );


            returnedUnits +=
                Math.abs(
                    row.baseUnits
                );


            returnTickets.add(
                row.ticketId
            );


            if (
                isDelivery
            ) {

                deliveryReturns +=
                    returnValue;

            }

        }
        else {

            grossSales +=
                row.netLineValue;


            grossCost +=
                row.lineCost;


            grossUnits +=
                row.baseUnits;


            saleTickets.add(
                row.ticketId
            );


            if (
                isDelivery
            ) {

                deliverySales +=
                    row.netLineValue;


                deliveryTickets.add(
                    row.ticketId
                );

            }

        }

    }


    const netSales =
        grossSales -
        returns;


    const netCost =
        grossCost -
        returnCost;


    const netUnits =
        grossUnits -
        returnedUnits;


    const netDeliverySales =
        deliverySales -
        deliveryReturns;


    let reconciliation = [];
    let absoluteDifference = 0;
    let ticketsWithDifference = 0;

    if (
        includeReconciliation
    ) {

        reconciliation =
            await getTicketReconciliation({

                branchId,

                fromDate,

                toDate,

                connection

            });


        absoluteDifference =
            reconciliation.reduce(

                (
                    total,
                    ticket
                ) =>

                    total +
                    Math.abs(
                        ticket.reconciliationDifference
                    ),

                0

            );


        ticketsWithDifference =
            reconciliation.filter(

                ticket =>
                    !ticket.isReconciled

            ).length;

    }


    return {

        branchId:
            Number(
                branchId
            ),

        fromDate,

        toDate,

        rows:
            rows.length,

        saleLines:
            rows.filter(

                row =>
                    row.transactionType ===
                    "SALE"

            ).length,

        returnLines:
            rows.filter(

                row =>
                    row.transactionType ===
                    "RETURN"

            ).length,

        saleTickets:
            saleTickets.size,

        returnTickets:
            returnTickets.size,

        grossSales,

        returns,

        netSales,


        /*
         * =====================================================
         * DELIVERY RESULTS
         * =====================================================
         */

        deliverySales:
            netDeliverySales,

        deliveryTickets:
            deliveryTickets.size,

        deliveryShare:

            netSales !== 0

                ? (

                    netDeliverySales /
                    netSales

                ) *
                100

                : 0,


        grossCost,

        returnCost,

        netCost,

        grossProfit:
            grossSales -
            grossCost,

        netProfit:
            netSales -
            netCost,

        grossMargin:

            netSales !== 0

                ? (

                    (
                        netSales -
                        netCost
                    ) /
                    netSales

                ) *
                100

                : 0,

        grossUnits,

        returnedUnits,

        netUnits,

        averageTicket:

            saleTickets.size > 0

                ? grossSales /
                  saleTickets.size

                : 0,

        returnRate:

            grossSales > 0

                ? (

                    returns /
                    grossSales

                ) *
                100

                : 0,

        reconciliation: {

            ticketCount:
                reconciliation.length,

            ticketsWithDifference,

            absoluteDifference,

            tolerance:
                RECONCILIATION_TOLERANCE

        }

    };

}


/*
 * =========================================================
 * SALES BY DAY
 * =========================================================
 */

export async function getSalesByDay(
    {
        branchId,
        fromDate,
        toDate,
        connection = null
    }
) {

    const rows =
        await getSales({

            branchId,

            fromDate,

            toDate,

            connection

        });


    const days =
        new Map();


    for (
        const row
        of rows
    ) {

        if (
            !row.date
        ) {

            continue;

        }


        const day =
            row.date.slice(
                0,
                10
            );


        if (
            !days.has(
                day
            )
        ) {

            days.set(

                day,

                {

                    date:
                        day,

                    sales:
                        0,

                    returns:
                        0,

                    netSales:
                        0,

                    cost:
                        0,

                    profit:
                        0,

                    units:
                        0,

                    tickets:
                        new Set()

                }

            );

        }


        const bucket =
            days.get(
                day
            );


        if (
            row.transactionType ===
            "RETURN"
        ) {

            bucket.returns +=
                Math.abs(
                    row.netLineValue
                );


            bucket.cost +=
                Math.abs(
                    row.lineCost
                );

        }
        else {

            bucket.sales +=
                row.netLineValue;


            bucket.cost +=
                row.lineCost;

        }


        bucket.netSales =
            bucket.sales -
            bucket.returns;


        bucket.profit =
            bucket.netSales -
            bucket.cost;


        bucket.units +=
            row.baseUnits;


        bucket.tickets.add(
            row.ticketId
        );

    }


    return Array.from(
        days.values()
    )
    .map(
        bucket => ({

            date:
                bucket.date,

            sales:
                bucket.sales,

            returns:
                bucket.returns,

            netSales:
                bucket.netSales,

            cost:
                bucket.cost,

            profit:
                bucket.profit,

            units:
                bucket.units,

            tickets:
                bucket.tickets.size

        })
    )
    .sort(

        (
            a,
            b
        ) =>
            a.date.localeCompare(
                b.date
            )

    );

}


/*
 * =========================================================
 * SALES BY HOUR
 * =========================================================
 */

export async function getSalesByHour(
    {
        branchId,
        fromDate,
        toDate,
        connection = null
    }
) {

    const rows =
        await getSales({

            branchId,

            fromDate,

            toDate,

            connection

        });


    const hours =
        Array.from(

            {
                length:
                    24

            },

            (
                _,
                hour
            ) => ({

                hour,

                sales:
                    0,

                returns:
                    0,

                netSales:
                    0,

                cost:
                    0,

                profit:
                    0,

                units:
                    0,

                tickets:
                    new Set()

            })

        );


    for (
        const row
        of rows
    ) {

        if (
            !row.date
        ) {

            continue;

        }


        const hour =
            Number(
                String(
                    row.date
                ).slice(11, 13)
            );


        const bucket =
            hours[
                hour
            ];


        if (
            row.transactionType ===
            "RETURN"
        ) {

            bucket.returns +=
                Math.abs(
                    row.netLineValue
                );


            bucket.cost +=
                Math.abs(
                    row.lineCost
                );

        }
        else {

            bucket.sales +=
                row.netLineValue;


            bucket.cost +=
                row.lineCost;

        }


        bucket.netSales =
            bucket.sales -
            bucket.returns;


        bucket.profit =
            bucket.netSales -
            bucket.cost;


        bucket.units +=
            row.baseUnits;


        bucket.tickets.add(
            row.ticketId
        );

    }


    return hours.map(
        bucket => ({

            hour:
                bucket.hour,

            sales:
                bucket.sales,

            returns:
                bucket.returns,

            netSales:
                bucket.netSales,

            cost:
                bucket.cost,

            profit:
                bucket.profit,

            units:
                bucket.units,

            tickets:
                bucket.tickets.size

        })
    );

}


