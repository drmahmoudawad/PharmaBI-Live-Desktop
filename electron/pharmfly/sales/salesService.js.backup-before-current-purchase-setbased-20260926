const CUSTOMER_NAME_CACHE_TTL_MS =
    5 * 60 * 1000;

const customerNameCache =
    new Map();


function buildCustomerCacheFingerprint(
    connection
) {

    return [
        connection?.server ?? "",
        connection?.port ?? "",
        connection?.database ?? "",
        connection?.user ?? ""
    ].join("|");

}


async function loadCustomerNameMap(
    {
        branchId,
        pool,
        connection
    }
) {

    const fingerprint =
        buildCustomerCacheFingerprint(
            connection
        );

    const existing =
        customerNameCache.get(
            Number(branchId)
        );


    if (
        existing &&
        existing.fingerprint === fingerprint &&
        Date.now() -
            existing.loadedAt <
            CUSTOMER_NAME_CACHE_TTL_MS
    ) {

        return existing.map;

    }


    try {

        const result =
            await pool
                .request()
                .query(`
                    SET NOCOUNT ON;

                    SELECT
                        Id,
                        Name,
                        IsHDCustomer
                    FROM dbo.Cards
                    WHERE Id IS NOT NULL;
                `);


        const map =
            new Map();

        const deliveryCustomerIds =
            new Set();


        for (
            const row
            of result?.recordset || []
        ) {

            map.set(
                String(row.Id),
                row.Name ?? null
            );

            if (
                row.IsHDCustomer === true ||
                row.IsHDCustomer === 1 ||
                String(
                    row.IsHDCustomer
                ).toLowerCase() === "true"
            ) {
                deliveryCustomerIds.add(
                    String(
                        row.Id
                    )
                );
            }

        }


        map.deliveryCustomerIds =
            deliveryCustomerIds;


        customerNameCache.set(
            Number(branchId),
            {
                fingerprint,
                loadedAt:
                    Date.now(),
                map
            }
        );


        console.log(
            "[salesService] Customer name map loaded",
            `branch=${branchId}`,
            `rows=${map.size}`
        );


        return map;

    }
    catch (error) {

        console.error(
            `[salesService] Customer name map failed branch=${branchId}:`,
            error
        );

        return new Map();

    }

}

async function queryPharmaFlySales(
    {
        branchId,
        fromDate,
        toDate,
        connection = null
    }
) {

    const numericBranchId =
        normalizeBranchId(
            branchId
        );


    const savedConnection =
        connection ||
        normalizeConnection(
            numericBranchId
        );


    const pool =
        await getBranchPool(

            numericBranchId,

            savedConnection

        );


    const {
        fromDateSql,
        toDateExclusiveSql
    } =
        createDateRange(

            fromDate,

            toDate

        );


    await runSalesDiagnostic({

        pool,

        fromDateSql,

        toDateExclusiveSql,

        branchId:
            numericBranchId,

        fromDate,

        toDate

    });


    const sqlStartedAt =
        Date.now();


    console.log(

        `[salesService] SQL START ${numericBranchId}|${fromDate}|${toDate}`

    );


    const result =
        await pool
            .request()
            .input(
                "fromDate",
                fromDateSql
            )
            .input(
                "toDateExclusive",
                toDateExclusiveSql
            )
            .query(
                buildOptimizedSalesQuery()
            );


    const sqlElapsed =
        Date.now() -
        sqlStartedAt;


    const rawRows =
        Array.isArray(
            result.recordset
        )

            ? result.recordset

            : [];


    const customerNameById =
        await loadCustomerNameMap({
            branchId:
                numericBranchId,
            pool,
            connection:
                savedConnection
        });


    for (
        const row
        of rawRows
    ) {

        const customerId =
            row?.customer_id;


        row.customer_name =
            customerId === null ||
            customerId === undefined

                ? null

                : (
                    customerNameById.get(
                        String(customerId)
                    ) ?? null
                );

        row.is_delivery_customer =
            Boolean(
                customerId !== null &&
                customerId !== undefined &&
                customerNameById.deliveryCustomerIds instanceof Set &&
                customerNameById.deliveryCustomerIds.has(
                    String(customerId)
                )
            );

    }

    const rows =
        sortSalesRows(

            rawRows.map(
                normalizeSaleRow
            )

        );


    console.log(

        `[salesService] SQL ${numericBranchId}|${fromDate}|${toDate} -> ${rows.length} rows in ${sqlElapsed} ms`

    );


    return rows;

}


