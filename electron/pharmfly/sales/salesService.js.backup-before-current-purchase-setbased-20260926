async function getSalesFromLocalFirstStrategy({
    branchId,
    fromDate,
    toDate,
    connection,
    forceRefresh = false
}) {
    if (forceRefresh) {
        return null;
    }

    const today = getTodayUtcDate();

    const completedToDate =
        minSalesDate(
            toDate,
            today
        );

    const currentFromDate =
        maxSalesDate(
            fromDate,
            today
        );

    let covered = false;

    let localRows = [];

    let currentDayRows = [];

    /*
     * COMPLETED DAYS
     * Read directly from local SQLite.
     */
    if (fromDate < completedToDate) {

        const startedAt =
            Date.now();

        const rows =
            await getLocalSalesRows({
                branchId,
                fromDate,
                toDate: completedToDate
            });

        localRows =
            Array.isArray(rows)
                ? rows.map(normalizeLocalSaleRow)
                : [];

        console.log(
            `[salesService] LOCAL SQLITE READ branch=${branchId} ${fromDate} -> ${completedToDate} rows=${localRows.length} in ${Date.now() - startedAt} ms`
        );

        if (localRows.length > 0) {
            covered = true;
        }
        else {
            console.log(
                `[salesService] LOCAL SQLITE EMPTY -> SQL FALLBACK branch=${branchId} ${fromDate} -> ${completedToDate}`
            );
        }
    }

    /*
     * CURRENT UTC DAY
     * Keep SQL Server for live/fresh data.
     */

    /*
     * =====================================================
     * LOCAL CUSTOMER NAME ENRICHMENT
     * =====================================================
     *
     * Historical sales come from SQLite for speed.
     * Resolve only missing customer names from Cards.
     */

    const customerIdsNeedingNames = [

        ...new Set(

            localRows

                .filter(

                    row =>

                        row &&

                        row.customerId != null &&

                        String(
                            row.customerName || ""
                        ).trim() === ""

                )

                .map(

                    row =>
                        String(
                            row.customerId
                        ).trim()

                )

                .filter(

                    id =>
                        id !== "" &&
                        id !== "0"

                )

        )

    ];


    if (
        customerIdsNeedingNames.length > 0
    ) {

        try {

            const customerPool =
                await getBranchPool(
                    Number(branchId),
                    connection
                );


            const customerNameById =
                new Map();


            const chunkSize = 500;


            for (
                let start = 0;
                start < customerIdsNeedingNames.length;
                start += chunkSize
            ) {

                const chunk =
                    customerIdsNeedingNames.slice(
                        start,
                        start + chunkSize
                    );


                const request =
                    customerPool.request();


                const placeholders =
                    chunk.map(
                        (id, index) => {

                            const parameterName =
                                "localCustomerId" +
                                index;

                            request.input(
                                parameterName,
                                Number(id)
                            );

                            return "@" +
                                parameterName;

                        }
                    );


                const sql =

                    "SET NOCOUNT ON; " +

                    "SELECT ID, Name " +

                    "FROM dbo.Cards " +

                    "WHERE ID IN (" +

                    placeholders.join(", ") +

                    ");";


                const result =
                    await request.query(
                        sql
                    );


                for (
                    const card
                    of result?.recordset || []
                ) {

                    if (
                        card?.ID === null ||
                        card?.ID === undefined
                    ) {

                        continue;

                    }


                    const id =
                        String(
                            card.ID
                        ).trim();


                    const name =
                        String(
                            card.Name || ""
                        ).trim();


                    if (
                        id &&
                        name
                    ) {

                        customerNameById.set(
                            id,
                            name
                        );

                    }

                }

            }


            let enrichedRows = 0;


            for (
                const row
                of localRows
            ) {

                const customerId =
                    row?.customerId == null
                        ? ""
                        : String(
                            row.customerId
                        ).trim();


                if (
                    !customerId ||
                    customerId === "0"
                ) {

                    continue;

                }


                if (
                    String(
                        row.customerName || ""
                    ).trim() !== ""
                ) {

                    continue;

                }


                const customerName =
                    customerNameById.get(
                        customerId
                    ) || null;


                if (
                    customerName
                ) {

                    row.customerName =
                        customerName;

                    enrichedRows += 1;

                }

            }


            console.log(
                "[salesService] LOCAL CUSTOMER NAME ENRICH " +
                "branch=" + branchId +
                " ids=" +
                customerIdsNeedingNames.length +
                " rows=" +
                enrichedRows
            );

        }
        catch (
            error
        ) {

            console.warn(
                "[salesService] local customer name enrichment failed " +
                "branch=" + branchId + ":",
                error?.message || error
            );

        }

    }

    /*
     * APPLY AUTHORITATIVE DELIVERY CUSTOMER FLAG
     * TO LOCAL SQLITE ROWS.
     */
    if (
        localRows.length > 0
    ) {

        try {

            const customerPool =
                await getBranchPool(
                    Number(branchId),
                    connection
                );

            const customerNameMap =
                await loadCustomerNameMap({
                    branchId:
                        Number(branchId),
                    pool:
                        customerPool,
                    connection
                });

            const deliveryCustomerIds =
                customerNameMap?.deliveryCustomerIds instanceof Set
                    ? customerNameMap.deliveryCustomerIds
                    : new Set();

            for (
                const row
                of localRows
            ) {

                const customerId =
                    row?.customerId === null ||
                    row?.customerId === undefined
                        ? ""
                        : String(
                            row.customerId
                        ).trim();

                row.isDeliveryCustomer =
                    Boolean(
                        customerId &&
                        customerId !== "0" &&
                        deliveryCustomerIds.has(
                            customerId
                        )
                    );

            }

            console.log(
                "[salesService] LOCAL DELIVERY FLAG APPLIED " +
                "branch=" +
                branchId +
                " rows=" +
                localRows.length
            );

        }
        catch (
            error
        ) {

            console.warn(
                "[salesService] local delivery flag failed " +
                "branch=" +
                branchId +
                ":",
                error?.message ||
                error
            );

            for (
                const row
                of localRows
            ) {

                row.isDeliveryCustomer =
                    false;

            }

        }

    }

    /*
     * CURRENT DAY
     * toDate is inclusive at the application level.
     * SQL Server receives an exclusive upper bound.
     */

    const includesCurrentDay =
        currentFromDate <= today &&
        toDate >= today;

    if (includesCurrentDay) {

        covered = true;

        const nextDay = new Date(
            today + "T00:00:00Z"
        );

        nextDay.setUTCDate(
            nextDay.getUTCDate() + 1
        );

        const currentDayToDate =
            toDate === today
                ? nextDay.toISOString().slice(0, 10)
                : toDate;

        const currentDayKey =
            [
                branchId,
                currentFromDate,
                currentDayToDate
            ].join("|");

        let currentDayLoaded = false;

        const now = Date.now();

        if (!forceRefresh) {

            const cachedCurrentDay =
                currentDayResultCache.get(
                    currentDayKey
                );

            if (
                cachedCurrentDay &&
                now - cachedCurrentDay.timestamp <
                    CURRENT_DAY_CACHE_TTL_MS
            ) {

                currentDayRows =
                    cachedCurrentDay.rows;

                currentDayLoaded = true;

                console.log(
                    "[salesService] CURRENT DAY CACHE HIT branch=" +
                    branchId +
                    " " + currentFromDate +
                    " -> " + currentDayToDate +
                    " rows=" + currentDayRows.length
                );

            }

        }

        if (!currentDayLoaded) {

            let request =
                currentDayInFlight.get(
                    currentDayKey
                );

            if (!request) {

                const startedAt = Date.now();

                console.log(
                    "[salesService] CURRENT DAY SQL START branch=" +
                    branchId +
                    " " + currentFromDate +
                    " -> " + currentDayToDate
                );

                request =
                    queryPharmaFlySales({
                        branchId,
                        fromDate: currentFromDate,
                        toDate: currentDayToDate,
                        connection
                    })
                    .then(
                        rows => {

                            if (!forceRefresh) {
                                currentDayResultCache.set(
                                    currentDayKey,
                                    {
                                        rows,
                                        timestamp: Date.now()
                                    }
                                );
                            }

                            console.log(
                                "[salesService] CURRENT DAY SQL branch=" +
                                branchId +
                                " " + currentFromDate +
                                " -> " + currentDayToDate +
                                " rows=" + rows.length +
                                " in " +
                                (Date.now() - startedAt) +
                                " ms"
                            );

                            return rows;
                        }
                    )
                    .finally(
                        () => {
                            currentDayInFlight.delete(
                                currentDayKey
                            );
                        }
                    );

                currentDayInFlight.set(
                    currentDayKey,
                    request
                );

            }
            else {

                console.log(
                    "[salesService] CURRENT DAY SINGLE-FLIGHT JOIN branch=" +
                    branchId +
                    " " + currentFromDate +
                    " -> " + currentDayToDate
                );

            }

            currentDayRows =
                await request;

        }

    }

        if (!covered) {
        return null;
    }

    const combinedRows = [
        ...localRows,
        ...currentDayRows
    ];

    combinedRows.sort(
        (a, b) => {
            const dateCompare =
                String(a.date || "").localeCompare(
                    String(b.date || "")
                );

            if (dateCompare !== 0) {
                return dateCompare;
            }

            const ticketCompare =
                Number(a.ticketId || 0) -
                Number(b.ticketId || 0);

            if (ticketCompare !== 0) {
                return ticketCompare;
            }

            return (
                Number(a.lineId || 0) -
                Number(b.lineId || 0)
            );
        }
    );

    return combinedRows;
}

