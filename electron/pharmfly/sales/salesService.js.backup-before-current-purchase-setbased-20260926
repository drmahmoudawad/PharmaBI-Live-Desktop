/*
 * =========================================================
 * BASIC HELPERS
 * =========================================================
 */

function toNumber(
    value
) {

    const number =
        Number(
            value
        );


    return Number.isFinite(
        number
    )
        ? number
        : 0;

}


function normalizeDate(
    value
) {

    if (
        value === null ||
        value === undefined
    ) {

        return null;

    }


    const date =
        new Date(
            value
        );


    if (
        Number.isNaN(
            date.getTime()
        )
    ) {

        return null;

    }


    return date.toISOString();

}


function getCurrentMonthKey() {

    const now =
        new Date();

    return (
        `${now.getFullYear()}-` +
        `${String(
            now.getMonth() + 1
        ).padStart(
            2,
            "0"
        )}`
    );

}


function rangeTouchesCurrentMonth(
    fromDate,
    toDate
) {

    const currentMonth =
        getCurrentMonthKey();

    const startMonth =
        String(
            fromDate
        ).slice(
            0,
            7
        );

    const endMonth =
        String(
            toDate
        ).slice(
            0,
            7
        );

    return (
        startMonth <= currentMonth &&
        currentMonth <= endMonth
    );

}

function normalizeBranchId(
    branchId
) {

    const id =
        Number(
            branchId
        );


    if (
        !Number.isInteger(
            id
        ) ||
        id <= 0
    ) {

        throw new Error(
            "Invalid branchId"
        );

    }


    return id;

}


function normalizeConnection(
    branchId
) {

    const connection =
        getBranchConnection(
            branchId
        );


    if (
        !connection
    ) {

        throw new Error(
            `No saved PharmaFly connection for branch ${branchId}`
        );

    }


    return connection;

}


/*
 * =========================================================
 * DATE RANGE
 * =========================================================
 */

function createDateRange(
    fromDate,
    toDate
) {

    const from =
        String(
            fromDate ||
            ""
        ).trim();


    const to =
        String(
            toDate ||
            ""
        ).trim();


    if (
        !/^\d{4}-\d{2}-\d{2}$/.test(
            from
        )
    ) {

        throw new Error(
            "Invalid fromDate. Expected YYYY-MM-DD"
        );

    }


    if (
        !/^\d{4}-\d{2}-\d{2}$/.test(
            to
        )
    ) {

        throw new Error(
            "Invalid toDate. Expected YYYY-MM-DD"
        );

    }


    const fromParts =
        from
            .split(
                "-"
            )
            .map(
                Number
            );


    const toParts =
        to
            .split(
                "-"
            )
            .map(
                Number
            );


    const fromCheck =
        new Date(

            Date.UTC(

                fromParts[0],

                fromParts[1] - 1,

                fromParts[2]

            )

        );


    const toCheck =
        new Date(

            Date.UTC(

                toParts[0],

                toParts[1] - 1,

                toParts[2]

            )

        );


    if (
        fromCheck.getUTCFullYear() !==
            fromParts[0] ||

        fromCheck.getUTCMonth() !==
            fromParts[1] - 1 ||

        fromCheck.getUTCDate() !==
            fromParts[2]
    ) {

        throw new Error(
            "Invalid fromDate"
        );

    }


    if (
        toCheck.getUTCFullYear() !==
            toParts[0] ||

        toCheck.getUTCMonth() !==
            toParts[1] - 1 ||

        toCheck.getUTCDate() !==
            toParts[2]
    ) {

        throw new Error(
            "Invalid toDate"
        );

    }


    if (
        fromCheck >
        toCheck
    ) {

        throw new Error(
            "fromDate cannot be greater than toDate"
        );

    }


    const nextDay =
        new Date(

            Date.UTC(

                toParts[0],

                toParts[1] - 1,

                toParts[2] + 1

            )

        );


    const nextDayString =
        [

            nextDay.getUTCFullYear(),

            String(
                nextDay.getUTCMonth() + 1
            ).padStart(
                2,
                "0"
            ),

            String(
                nextDay.getUTCDate()
            ).padStart(
                2,
                "0"
            )

        ].join(
            "-"
        );


    return {

        fromDateSql:
            `${from} 00:00:00`,

        toDateExclusiveSql:
            `${nextDayString} 00:00:00`,

        fromDate:
            from,

        toDate:
            to

    };

}


/*
 * =========================================================
 * DATE HELPERS
 * =========================================================
 */

function parseIsoDate(
    value
) {

    if (
        !value
    ) {

        return null;

    }


    const date =
        new Date(
            value
        );


    if (
        Number.isNaN(
            date.getTime()
        )
    ) {

        return null;

    }


    return date;

}


function isFullCalendarMonth(
    fromDate,
    toDate
) {

    const from =
        String(
            fromDate
        );


    const to =
        String(
            toDate
        );


    const month =
        from.slice(
            0,
            7
        );


    if (
        to.slice(
            0,
            7
        ) !==
        month
    ) {

        return false;

    }


    const range =
        getMonthDateRange(
            month
        );


    return (

        range.fromDate ===
        from &&

        range.toDate ===
        to

    );

}


function filterRowsByDate(
    rows,
    fromDate,
    toDate
) {

    if (
        !Array.isArray(
            rows
        )
    ) {

        return [];

    }


    const from =
        new Date(
            `${fromDate}T00:00:00.000Z`
        );


    const to =
        new Date(
            `${toDate}T23:59:59.999Z`
        );


    const fromTime =
        from.getTime();


    const toTime =
        to.getTime();


    return rows.filter(

        row => {

            const rowDate =
                parseIsoDate(
                    row?.date
                );


            if (
                !rowDate
            ) {

                return false;

            }


            const time =
                rowDate.getTime();


            return (

                time >=
                fromTime &&

                time <=
                toTime

            );

        }

    );

}


function sortSalesRows(
    rows
) {

    return rows.sort(

        (
            a,
            b
        ) => {

            const dateA =
                parseIsoDate(
                    a?.date
                )?.getTime() ||
                0;


            const dateB =
                parseIsoDate(
                    b?.date
                )?.getTime() ||
                0;


            if (
                dateA !==
                dateB
            ) {

                return dateA -
                    dateB;

            }


            const ticketA =
                String(
                    a?.ticketId ||
                    ""
                );


            const ticketB =
                String(
                    b?.ticketId ||
                    ""
                );


            if (
                ticketA <
                ticketB
            ) {

                return -1;

            }


            if (
                ticketA >
                ticketB
            ) {

                return 1;

            }


            return String(
                a?.lineId ||
                ""
            ).localeCompare(

                String(
                    b?.lineId ||
                    ""
                )

            );

        }

    );

}


/*
 * =========================================================
 * CACHE KEYS
 * =========================================================
 */

function buildSalesCacheKey(
    {
        branchId,
        fromDate,
        toDate
    }
) {

    return [

        SALES_CACHE_VERSION,

        Number(
            branchId
        ),

        String(
            fromDate
        ),

        String(
            toDate
        )

    ].join(
        "|"
    );

}


function buildMonthlyInFlightKey(
    branchId,
    month
) {

    return [

        "monthly-v3",

        normalizeBranchId(
            branchId
        ),

        String(
            month
        )

    ].join(
        "|"
    );

}


/*
 * =========================================================
 * MEMORY CACHE
 * =========================================================
 */

function getCachedSales(
    key
) {

    const entry =
        salesCache.get(
            key
        );


    if (
        !entry
    ) {

        return null;

    }


    if (
        Date.now() -
        entry.createdAt >
        SALES_CACHE_TTL_MS
    ) {

        salesCache.delete(
            key
        );


        return null;

    }


    salesCache.delete(
        key
    );


    salesCache.set(
        key,
        entry
    );


    return entry.rows;

}


function setCachedSales(
    key,
    rows
) {

    salesCache.delete(
        key
    );


    salesCache.set(

        key,

        {

            rows,

            createdAt:
                Date.now()

        }

    );


    while (
        salesCache.size >
        SALES_CACHE_MAX_ENTRIES
    ) {

        const oldestKey =
            salesCache
                .keys()
                .next()
                .value;


        if (
            oldestKey ===
            undefined
        ) {

            break;

        }


        salesCache.delete(
            oldestKey
        );

    }

}


/*
 * =========================================================
 * CLEAR SALES CACHE
 * =========================================================
 */

export function clearSalesCache(
    {
        branchId = null,
        fromDate = null,
        toDate = null
    } = {}
) {

    if (
        branchId === null &&
        fromDate === null &&
        toDate === null
    ) {

        salesCache.clear();

        monthlyInFlight.clear();


        clearPersistentCache({

            cacheGroup:
                SALES_CACHE_GROUP

        });


        return;

    }


    for (
        const key
        of Array.from(
            salesCache.keys()
        )
    ) {

        const parts =
            key.split(
                "|"
            );


        const keyBranchId =
            Number(
                parts[1]
            );


        const keyFromDate =
            parts[2];


        const keyToDate =
            parts[3];


        const matchesBranch =
            branchId === null ||
            keyBranchId ===
                Number(
                    branchId
                );


        const matchesFrom =
            fromDate === null ||
            keyFromDate ===
                String(
                    fromDate
                );


        const matchesTo =
            toDate === null ||
            keyToDate ===
                String(
                    toDate
                );


        if (
            matchesBranch &&
            matchesFrom &&
            matchesTo
        ) {

            salesCache.delete(
                key
            );

        }

    }

}


