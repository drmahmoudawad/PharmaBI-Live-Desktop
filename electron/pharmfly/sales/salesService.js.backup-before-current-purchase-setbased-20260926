}


/*
 * =========================================================
 * MONTHLY CACHE
 * =========================================================
 */

function getCachedMonth(
    branchId,
    month
) {

    try {

        const cached =
            getMonthlySalesCache({

                branchId,

                month

            });


        if (
            !cached ||
            !Array.isArray(
                cached.rows
            )
        ) {

            return null;

        }


        return cached.rows;

    }
    catch (
        error
    ) {

        console.error(

            `[salesService] monthly cache read failed branch=${branchId} month=${month}:`,

            error

        );


        return null;

    }

}


function calculateMonthDistanceInclusive(
    startMonth,
    endMonth
) {

    const [
        startYear,
        startMonthNumber
    ] =
        startMonth
            .split(
                "-"
            )
            .map(
                Number
            );


    const [
        endYear,
        endMonthNumber
    ] =
        endMonth
            .split(
                "-"
            )
            .map(
                Number
            );


    const distance =
        (
            endYear -
            startYear
        ) *
        12 +
        (
            endMonthNumber -
            startMonthNumber
        ) +
        1;


    if (
        distance <= 0
    ) {

        throw new Error(
            "Invalid month range"
        );

    }


    return distance;

}


/*
 * =========================================================
 * COMBINE MONTHLY CACHE
 * =========================================================
 */

function combineMonthlyCache(
    {
        branchId,
        fromDate,
        toDate
    }
) {

    const startMonth =
        fromDate.slice(
            0,
            7
        );


    const endMonth =
        toDate.slice(
            0,
            7
        );


    const monthCount =
        calculateMonthDistanceInclusive(

            startMonth,

            endMonth

        );


    const months =
        buildMonthList({

            endMonth,

            months:
                monthCount

        })
        .reverse();


    const collected =
        [];


    for (
        const month
        of months
    ) {

        const rows =
            getCachedMonth(

                branchId,

                month

            );


        if (
            !rows
        ) {

            return {

                complete:
                    false,

                rows:
                    []

            };

        }


        collected.push(
            ...rows
        );

    }


    return {

        complete:
            true,

        rows:
            filterRowsByDate(

                collected,

                fromDate,

                toDate

            )

    };

}


/*
 * =========================================================
 * LOAD ONE MONTH
 * =========================================================
 */

async function loadMonthlySales(
    {
        branchId,
        month,
        connection
    }
) {

    const cached =
        getCachedMonth(

            branchId,

            month

        );


    if (
        cached
    ) {

        console.log(

            `[salesService] MONTHLY CACHE HIT branch=${branchId} month=${month} rows=${cached.length}`

        );


        return cached;

    }


    const monthlyKey =
        buildMonthlyInFlightKey(

            branchId,

            month

        );


    const existingRequest =
        monthlyInFlight.get(
            monthlyKey
        );


    if (
        existingRequest
    ) {

        console.log(

            `[salesService] MONTHLY IN-FLIGHT JOIN ${monthlyKey}`

        );


        return existingRequest;

    }


    const request =
        (async () => {

            try {

                console.log(

                    `[salesService] MONTHLY CACHE MISS branch=${branchId} month=${month}`

                );


                const range =
                    getMonthDateRange(
                        month
                    );


                const rows =
                    await queryPharmaFlySales({

                        branchId,

                        fromDate:
                            range.fromDate,

                        toDate:
                            range.toDate,

                        connection

                    });


                try {

                    setMonthlySalesCache({

                        branchId,

                        month,

                        rows

                    });


                    console.log(

                        `[salesService] MONTHLY CACHE SAVED branch=${branchId} month=${month} rows=${rows.length}`

                    );

                }
                catch (
                    error
                ) {

                    console.error(

                        `[salesService] monthly cache write failed branch=${branchId} month=${month}:`,

                        error

                    );

                }


                return rows;

            }
            finally {

                if (
                    monthlyInFlight.get(
                        monthlyKey
                    ) ===
                    request
                ) {

                    monthlyInFlight.delete(
                        monthlyKey
                    );

                }

            }

        })();


    monthlyInFlight.set(

        monthlyKey,

        request

    );


    return request;

}


/*
 * =========================================================
 * MONTHLY STRATEGY
 * =========================================================
 */

function addOneDayISO(
    dateText
) {

    const date =
        new Date(
            `${dateText}T00:00:00Z`
        );

    date.setUTCDate(
        date.getUTCDate() + 1
    );

    return date
        .toISOString()
        .slice(
            0,
            10
        );

}


function rowDateOnly(
    row
) {

    const value =
        row?.date ??
        row?.ticketDate ??
        row?.ticket_ztime ??
        null;

    if (
        !value
    ) {

        return "";

    }

    const parsed =
        new Date(
            value
        );

    if (
        Number.isNaN(
            parsed.getTime()
        )
    ) {

        return String(
            value
        ).slice(
            0,
            10
        );

    }

    return parsed
        .toISOString()
        .slice(
            0,
            10
        );

}


async function loadCurrentMonthIncremental(
    {
        branchId,
        fromDate,
        toDate,
        connection
    }
) {

    const month =
        fromDate.slice(
            0,
            7
        );


    if (
        month !==
        toDate.slice(
            0,
            7
        )
    ) {

        return null;

    }


    if (
        !rangeTouchesCurrentMonth(
            fromDate,
            toDate
        )
    ) {

        return null;

    }


    const cachedRows =
        getCachedMonth(
            branchId,
            month
        );


    /*
     * No local monthly cache:
     * let the normal direct SQL path handle it.
     */
    if (
        !Array.isArray(
            cachedRows
        ) ||
        cachedRows.length === 0
    ) {

        console.log(

            `[salesService] CURRENT MONTH CACHE EMPTY -> DIRECT RANGE ${branchId}|${fromDate}|${toDate}`

        );

        return null;

    }


    const cachedMaxDate =
        cachedRows.reduce(

            (
                maxDate,
                row
            ) => {

                const date =
                    rowDateOnly(
                        row
                    );

                if (
                    !date
                ) {

                    return maxDate;

                }

                return date >
                    maxDate
                    ? date
                    : maxDate;

            },

            ""

        );


    let refreshFromDate =
        fromDate;


    if (
        cachedMaxDate &&
        cachedMaxDate >
            refreshFromDate
    ) {

        refreshFromDate =
            cachedMaxDate;

    }


    /*
     * The current day must always be refreshed because new
     * tickets can continue to arrive during the day.
     */
    if (
        cachedMaxDate >=
        toDate
    ) {

        refreshFromDate =
            toDate;

    }


    console.log(

        `[salesService] CURRENT MONTH INCREMENTAL branch=${branchId} cacheMax=${cachedMaxDate || "none"} refresh=${refreshFromDate}|${toDate}`

    );


    const liveRows =
        await queryPharmaFlySales({

            branchId,

            fromDate:
                refreshFromDate,

            toDate:
                addOneDayISO(
                    toDate
                ),

            connection

        });


    /*
     * Keep cached history before refreshFromDate.
     * Replace the overlapping/current period with fresh SQL rows.
     */
    const preservedRows =
        cachedRows.filter(

            row =>
                rowDateOnly(
                    row
                ) <
                refreshFromDate

        );


    const mergedRows = [

        ...preservedRows,

        ...liveRows

    ];


    const sortedRows =
        sortSalesRows(
            mergedRows
        );


    try {

        setMonthlySalesCache({

            branchId,

            month,

            rows:
                sortedRows

        });


        console.log(

            `[salesService] CURRENT MONTH CACHE UPDATED branch=${branchId} month=${month} rows=${sortedRows.length}`

        );

    }
    catch (
        error
    ) {

        console.error(

            `[salesService] current month cache update failed branch=${branchId} month=${month}:`,

            error

        );

    }


    return filterRowsByDate(

        sortedRows,

        fromDate,

        toDate

    );

}

async function getSalesFromMonthlyStrategy(
    {
        branchId,
        fromDate,
        toDate,
        connection,
        forceRefresh
    }
) {

    if (
        forceRefresh
    ) {

        return null;

    }


    /*
     * Current calendar month is mutable.
     * Never trust monthly cache for it.
     */
    if (
        rangeTouchesCurrentMonth(
            fromDate,
            toDate
        )
    ) {

        const incrementalRows =
            await loadCurrentMonthIncremental({

                branchId,

                fromDate,

                toDate,

                connection

            });


        if (
            Array.isArray(
                incrementalRows
            )
        ) {

            console.log(

                `[salesService] CURRENT MONTH INCREMENTAL RESULT ${branchId}|${fromDate}|${toDate} -> ${incrementalRows.length} rows`

            );


            return incrementalRows;

        }


        console.log(

            `[salesService] CURRENT MONTH INCREMENTAL UNAVAILABLE -> DIRECT RANGE ${branchId}|${fromDate}|${toDate}`

        );

    }


    const combined =
        combineMonthlyCache({

            branchId,

            fromDate,

            toDate

        });


    if (
        combined.complete
    ) {

        const rows =
            sortSalesRows(
                combined.rows
            );


        console.log(

            `[salesService] MONTHLY CACHE COMBINED ${branchId}|${fromDate}|${toDate} -> ${rows.length} rows`

        );


        return rows;

    }


    /*
     * For a partial month request, do NOT load the entire month.
     * The normal range query below will fetch only the requested
     * date range.
     */
    if (
        fromDate.slice(
            0,
            7
        ) ===
        toDate.slice(
            0,
            7
        )
    ) {

        const month =
            fromDate.slice(
                0,
                7
            );

        const monthRange =
            getMonthDateRange(
                month
            );

        const isFullMonth =
            fromDate === monthRange.fromDate &&
            toDate === monthRange.toDate;

        if (
            !isFullMonth
        ) {

            console.log(
                `[salesService] PARTIAL MONTH -> RANGE QUERY ${branchId}|${fromDate}|${toDate}`
            );

            return null;

        }


        const rows =
            await loadMonthlySales({

                branchId,

                month,

                connection

            });


        return sortSalesRows(

            filterRowsByDate(

                rows,

                fromDate,

                toDate

            )

        );

    }


    const startMonth =
        fromDate.slice(
            0,
            7
        );


    const endMonth =
        toDate.slice(
            0,
            7
        );


    const monthCount =
        calculateMonthDistanceInclusive(

            startMonth,

            endMonth

        );


    const months =
        buildMonthList({

            endMonth,

            months:
                monthCount

        })
        .reverse();


    const collected =
        [];


    for (
        const month
        of months
    ) {

        const rows =
            await loadMonthlySales({

                branchId,

                month,

                connection

            });


        collected.push(
            ...rows
        );

    }


    return sortSalesRows(

        filterRowsByDate(

            collected,

            fromDate,

            toDate

        )

    );

}


/*
 * =========================================================
 * NORMALIZE SALES ROW
 * =========================================================
 */

function normalizeSaleRow(
    row
) {

    const salesReturn =
        toNumber(
            row.sales_return
        );


    const isReturn =
        salesReturn === 2;


    const packs =
        toNumber(
            row.packs
        );


    const units =
        toNumber(
            row.units
        );


    const lineParts =
        toNumber(
            row.line_parts
        );


    const itemParts =
        toNumber(
            row.item_parts
        );


    const parts =
        lineParts > 0

            ? lineParts

            : (

                itemParts > 0

                    ? itemParts

                    : 1

            );


    const salesPrice =
        toNumber(
            row.line_sales_price
        );


    const unitPrice =
        parts > 0

            ? salesPrice /
              parts

            : salesPrice;


    const baseUnits =
        (
            packs *
            parts
        ) +
        units;


    const grossLineValue =
        baseUnits *
        unitPrice;


    const discount =
        toNumber(
            row.line_discount
        );


    const extraDiscount =
        toNumber(
            row.line_extra_discount
        );


    const netLineValue =
        grossLineValue -
        discount -
        extraDiscount;


    const lastPurchaseCost =
        toNumber(
            row.last_purchase_cost
        );


    const purchaseParts =
        toNumber(
            row.last_purchase_parts
        ) > 0

            ? toNumber(
                row.last_purchase_parts
            )

            : (

                parts > 0

                    ? parts

                    : 1

            );


    const purchaseUnitCost =
        lastPurchaseCost > 0

            ? (

                purchaseParts > 0

                    ? lastPurchaseCost /
                      purchaseParts

                    : lastPurchaseCost

            )

            : 0;


    const lineCost =
        baseUnits *
        purchaseUnitCost;


    return {

        ticketId:
            String(
                row.ticket_id
            ),


        lineId:
            String(
                row.line_id
            ),


        itemId:
            row.item_id === null ||
            row.item_id === undefined

                ? null

                : String(
                    row.item_id
                ),


        itemName:
            row.item_name ||
            null,


        customerId:
            row.customer_id === null ||
            row.customer_id === undefined

                ? null

                : String(
                    row.customer_id
                ),


        /*
         * REQUIRED FOR DELIVERY ANALYTICS.
         */

        customerName:
            row.customer_name ||
            null,

        isDeliveryCustomer:
            Boolean(
                row.is_delivery_customer
            ),


        date:
            normalizeDate(
                row.ticket_ztime
            ),


        salesReturn,


        transactionType:
            isReturn
                ? "RETURN"
                : "SALE",


        ticketTotal:
            toNumber(
                row.ticket_total
            ),


        packs,


        units,


        parts,


        baseUnits,


        bonus:
            toNumber(
                row.bonus
            ),


        salesPrice,


        unitPrice,


        grossLineValue,


        discount,


        extraDiscount,


        netLineValue,


        costPrice:
            lastPurchaseCost,


        unitCost:
            purchaseUnitCost,


        lineCost,


        purchaseCost:
            lastPurchaseCost,


        purchaseUnitCost,


        purchaseDate:
            normalizeDate(
                row.last_purchase_date
            ),


        purchaseInvoiceId:
            row.last_purchase_invoice_id === null ||
            row.last_purchase_invoice_id === undefined

                ? null

                : String(
                    row.last_purchase_invoice_id
                ),


        purchaseInvoiceCode:
            row.last_purchase_invoice_code ||
            null,


        purchaseVendorId:
            row.last_purchase_vendor_id === null ||
            row.last_purchase_vendor_id === undefined

                ? null

                : String(
                    row.last_purchase_vendor_id
                ),


        purchaseParts,


        sourcePosItemCost:
            toNumber(
                row.line_cost
            ),


        isContent:
            Boolean(
                row.is_content
            ),


        storeId:
            row.line_store_id === null ||
            row.line_store_id === undefined

                ? (

                    row.ticket_store_id === null ||
                    row.ticket_store_id === undefined

                        ? null

                        : String(
                            row.ticket_store_id
                        )

                )

                : String(
                    row.line_store_id
                ),


        salesRepId:
            row.sales_rep_id === null ||
            row.sales_rep_id === undefined

                ? null

                : String(
                    row.sales_rep_id
                )

    };

}


/*
 * =========================================================
 * SALES DIAGNOSTIC
 * =========================================================
 */

const ENABLE_SALES_DIAGNOSTIC = true;


const diagnosticAlreadyRun =
    new Set();


async function runSalesDiagnostic(
    {
        pool,
        fromDateSql,
        toDateExclusiveSql,
        branchId,
        fromDate,
        toDate
    }
) {

    if (
        !ENABLE_SALES_DIAGNOSTIC
        ||
        Number(branchId) !== 2
        ||
        !String(fromDate).startsWith("2026-09-")
    ) {

        return;

    }


    const key =
        `${branchId}|${fromDate}|${toDate}`;


    if (
        diagnosticAlreadyRun.has(
            key
        )
    ) {

        return;

    }


    diagnosticAlreadyRun.add(
        key
    );


    try {

        console.log(
            `[salesDiagnostic] START branch=${branchId} range=${fromDate}|${toDate}`
        );


        /*
         * -----------------------------------------------------
         * STAGE 1: SALES BASE
         * -----------------------------------------------------
         */

        let started =
            Date.now();

        const salesBaseResult =
            await pool
                .request()
                .input(
                    "fromDate",
                    fromDateSql
                )
                .input(
                    "toDateExclusive",
                    toDateExclusiveSql
                )
                .query(`
                    SET NOCOUNT ON;

                    SELECT
                        COUNT_BIG(*) AS line_count,
                        COUNT(DISTINCT t.ID) AS invoice_count,

                        SUM(
                            CASE
                                WHEN t.SalesReturn = 1
                                THEN ISNULL(t.Total, 0)
                                ELSE 0
                            END
                        ) AS sales_total,

                        SUM(
                            CASE
                                WHEN t.SalesReturn = 2
                                THEN ISNULL(t.Total, 0)
                                ELSE 0
                            END
                        ) AS returns_total,

                        SUM(
                            CASE
                                WHEN t.SalesReturn = 1
                                THEN ISNULL(t.Total, 0)
                                WHEN t.SalesReturn = 2
                                THEN -ABS(ISNULL(t.Total, 0))
                                ELSE 0
                            END
                        ) AS net_total

                    FROM posTickets t
                    INNER JOIN posItems pi
                        ON pi.TicketID = t.ID
                    WHERE
                        t.ztime >= @fromDate
                        AND t.ztime < @toDateExclusive;
                `);

        let elapsed =
            Date.now() - started;

        const stage1 = salesBaseResult?.recordset?.[0] || {};

        const salesRows =
            Number(stage1?.line_count) || 0;

        console.log(
            `[salesDiagnostic] STAGE1 ` +
            `lines=${salesRows} ` +
            `invoices=${Number(stage1?.invoice_count) || 0} ` +
            `sales=${Number(stage1?.sales_total) || 0} ` +
            `returns=${Number(stage1?.returns_total) || 0} ` +
            `net=${Number(stage1?.net_total) || 0} ` +
            `ms=${elapsed}`
        );


        /*
         * STAGE 1B: SALES BY STORE ID
         * Read directly from posTickets.
         * Do NOT join posItems here because t.Total
         * would be repeated once per item line.
         */

        const storeResult =
            await pool
                .request()
                .input(
                    "fromDate",
                    fromDateSql
                )
                .input(
                    "toDateExclusive",
                    toDateExclusiveSql
                )
                .query(`
                    SET NOCOUNT ON;

                    SELECT
                        ISNULL(
                            CONVERT(varchar(50), t.StoreID),
                            'NULL'
                        ) AS store_id,

                        COUNT_BIG(*) AS invoice_count,

                        SUM(
                            CASE
                                WHEN t.SalesReturn = 1
                                THEN ISNULL(t.Total, 0)
                                ELSE 0
                            END
                        ) AS sales_total,

                        SUM(
                            CASE
                                WHEN t.SalesReturn = 2
                                THEN ABS(ISNULL(t.Total, 0))
                                ELSE 0
                            END
                        ) AS returns_total

                    FROM posTickets t

                    WHERE
                        t.ztime >= @fromDate
                        AND t.ztime < @toDateExclusive

                    GROUP BY
                        ISNULL(
                            CONVERT(varchar(50), t.StoreID),
                            'NULL'
                        )

                    ORDER BY
                        invoice_count DESC;
                `);


        for (
            const row
            of storeResult?.recordset || []
        ) {

            const storeSales =
                Number(row?.sales_total) || 0;

            const storeReturns =
                Number(row?.returns_total) || 0;

            console.log(
                `[salesDiagnostic] STORE ` +
                `storeId=${row?.store_id} ` +
                `invoices=${Number(row?.invoice_count) || 0} ` +
                `sales=${storeSales} ` +
                `returns=${storeReturns} ` +
                `net=${storeSales - storeReturns}`
            );

        }


        /*
         * -----------------------------------------------------
         * STAGE 2: NEEDED ITEMS
         * -----------------------------------------------------
         */

        started =
            Date.now();

        const neededItemsResult =
            await pool
                .request()
                .input(
                    "fromDate",
                    fromDateSql
                )
                .input(
                    "toDateExclusive",
                    toDateExclusiveSql
                )
                .query(`
                    SET NOCOUNT ON;

                    SELECT COUNT(DISTINCT pi.ItemID) AS item_count
                    FROM posTickets t
                    INNER JOIN posItems pi
                        ON pi.TicketID = t.ID
                    WHERE
                        t.ztime >= @fromDate
                        AND t.ztime < @toDateExclusive
                        AND pi.ItemID IS NOT NULL;
                `);

        elapsed =
            Date.now() - started;

        const neededItems =
            Number(
                neededItemsResult?.recordset?.[0]?.item_count
            ) || 0;

        console.log(
            `[salesDiagnostic] STAGE2 NeededItems count=${neededItems} ms=${elapsed}`
        );


        /*
         * -----------------------------------------------------
         * STAGE 3: PURCHASES INSIDE RANGE
         * -----------------------------------------------------
         */

        started =
            Date.now();

        const purchasesResult =
            await pool
                .request()
                .input(
                    "fromDate",
                    fromDateSql
                )
                .input(
                    "toDateExclusive",
                    toDateExclusiveSql
                )
                .query(`
                    SET NOCOUNT ON;

                    SELECT COUNT_BIG(*) AS purchase_rows
                    FROM PurchaseItems pitem
                    INNER JOIN PurchaseInvoices pinv
                        ON pinv.ID = pitem.inv_id
                    INNER JOIN (
                        SELECT DISTINCT
                            pi.ItemID AS item_id
                        FROM posTickets t
                        INNER JOIN posItems pi
                            ON pi.TicketID = t.ID
                        WHERE
                            t.ztime >= @fromDate
                            AND t.ztime < @toDateExclusive
                            AND pi.ItemID IS NOT NULL
                    ) needed
                        ON needed.item_id = pitem.item_id
                    WHERE
                        COALESCE(
                            pinv.ztime,
                            pinv.inv_date
                        ) >= @fromDate
                        AND COALESCE(
                            pinv.ztime,
                            pinv.inv_date
                        ) < @toDateExclusive;
                `);

        elapsed =
            Date.now() - started;

        const purchaseRows =
            Number(
                purchasesResult?.recordset?.[0]?.purchase_rows
            ) || 0;

        console.log(
            `[salesDiagnostic] STAGE3 Purchases rows=${purchaseRows} ms=${elapsed}`
        );


        /*
         * -----------------------------------------------------
         * STAGE 4: PREVIOUS PURCHASE LOOKUP
         * -----------------------------------------------------
         */

        started =
            Date.now();

        const previousPurchaseResult =
            await pool
                .request()
                .input(
                    "fromDate",
                    fromDateSql
                )
                .query(`
                    SET NOCOUNT ON;

                    SELECT COUNT_BIG(*) AS resolved_items
                    FROM (
                        SELECT DISTINCT
                            pi.ItemID AS item_id
                        FROM posTickets t
                        INNER JOIN posItems pi
                            ON pi.TicketID = t.ID
                        WHERE
                            t.ztime >= @fromDate
                            AND t.ztime < DATEADD(
                                DAY,
                                31,
                                @fromDate
                            )
                            AND pi.ItemID IS NOT NULL
                    ) needed
                    OUTER APPLY (
                        SELECT TOP 1
                            pitem.ID
                        FROM PurchaseItems pitem
                        INNER JOIN PurchaseInvoices pinv
                            ON pinv.ID = pitem.inv_id
                        WHERE
                            pitem.item_id = needed.item_id
                            AND COALESCE(
                                pinv.ztime,
                                pinv.inv_date
                            ) < @fromDate
                        ORDER BY
                            COALESCE(
                                pinv.ztime,
                                pinv.inv_date
                            ) DESC,
                            pinv.ID DESC,
                            pitem.ID DESC
                    ) previousPurchase;
                `);

        elapsed =
            Date.now() - started;

        const previousResolved =
            Number(
                previousPurchaseResult?.recordset?.[0]?.resolved_items
            ) || 0;

        console.log(
            `[salesDiagnostic] STAGE4 PreviousPurchase resolved=${previousResolved} ms=${elapsed}`
        );


        console.log(
            `[salesDiagnostic] COMPLETE branch=${branchId}`
        );

    }
    catch (
        error
    ) {

        console.error(
            "[salesDiagnostic] FAILED:",
            error
        );

    }

}

/*
 * =========================================================
 * OPTIMIZED SALES QUERY
 * =========================================================
 *
 * IMPORTANT:
 *
 * 1. Cards is joined ONLY to obtain customer_name.
 * 2. Purchase lookup is limited to the requested period
 *    plus one previous-purchase fallback per item.
 * 3. No full purchase-history join.
 * 4. No delivery logic is pushed into SQL.
 * 5. Delivery classification is done in getSalesSummary().
 *
 */

function buildOptimizedSalesQuery() {

    return `

        SET NOCOUNT ON;


        IF OBJECT_ID(
            'tempdb..#SalesBase'
        ) IS NOT NULL

            DROP TABLE #SalesBase;


        IF OBJECT_ID(
            'tempdb..#NeededItems'
        ) IS NOT NULL

            DROP TABLE #NeededItems;


        IF OBJECT_ID(
            'tempdb..#Purchases'
        ) IS NOT NULL

            DROP TABLE #Purchases;


        IF OBJECT_ID(
            'tempdb..#PreviousPurchases'
        ) IS NOT NULL

            DROP TABLE #PreviousPurchases;


        /*
         * =====================================================
         * SALES WINDOW
         * =====================================================
         */

        SELECT

            t.ID
                AS ticket_id,

            t.ztime
                AS ticket_ztime,

            t.SalesReturn
                AS sales_return,

            t.CustomerID
                AS customer_id,


            t.Total
                AS ticket_total,

            t.StoreID
                AS ticket_store_id,

            t.SalesRepID
                AS sales_rep_id,

            t.PinNumber
                AS pin_number,


            pi.ID
                AS line_id,

            pi.ItemID
                AS item_id,

            i.name
                AS item_name,

            i.Parts
                AS item_parts,

            pi.Packs
                AS packs,

            pi.Units
                AS units,

            pi.iParts
                AS line_parts,

            pi.Bonus
                AS bonus,

            pi.SalesPrice
                AS line_sales_price,

            pi.Cost
                AS line_cost,

            pi.Discount
                AS line_discount,

            pi.ExtraDiscount
                AS line_extra_discount,

            pi.IsContent
                AS is_content,

            pi.StoreID
                AS line_store_id


        INTO #SalesBase


        FROM posTickets t


        INNER JOIN posItems pi

            ON pi.TicketID =
               t.ID


LEFT JOIN Items i

            ON i.ID =
               pi.ItemID


        WHERE

            t.ztime >= @fromDate

        AND

            t.ztime < @toDateExclusive;


        CREATE NONCLUSTERED INDEX

            IX_SalesBase_Item_Date_Line

        ON #SalesBase (

            item_id,

            ticket_ztime,

            line_id

        );


        /*
         * =====================================================
         * NEEDED ITEMS
         * =====================================================
         */

        SELECT DISTINCT

            item_id

        INTO #NeededItems


        FROM #SalesBase


        WHERE

            item_id IS NOT NULL;


        CREATE UNIQUE CLUSTERED INDEX

            IX_NeededItems_Item

        ON #NeededItems (

            item_id

        );


        /*
         * =====================================================
         * PURCHASES INSIDE REQUESTED WINDOW
         * =====================================================
         */

        SELECT

            pitem.item_id
                AS item_id,

            pitem.CostPrice
                AS purchase_cost,

            COALESCE(
                pinv.ztime,
                pinv.inv_date
            )
                AS purchase_date,

            pinv.ID
                AS purchase_invoice_id,

            pinv.inv_code
                AS purchase_invoice_code,

            pinv.vendor_id
                AS purchase_vendor_id,

            pitem.ID
                AS purchase_item_id


        INTO #Purchases


        FROM PurchaseItems pitem


        INNER JOIN PurchaseInvoices pinv

            ON pinv.ID =
               pitem.inv_id


        INNER JOIN #NeededItems needed

            ON needed.item_id =
               pitem.item_id


        WHERE

            COALESCE(
                pinv.ztime,
                pinv.inv_date
            ) >= @fromDate

        AND

            COALESCE(
                pinv.ztime,
                pinv.inv_date
            ) < @toDateExclusive;


        CREATE CLUSTERED INDEX

            IX_Purchases_Item_Date

        ON #Purchases (

            item_id,

            purchase_date,

            purchase_invoice_id,

            purchase_item_id

        );


        /*
         * =====================================================
         * PREVIOUS PURCHASE FALLBACK
         * =====================================================
         *
         * Get only the latest historical purchase for each
         * needed item. This avoids ranking the complete purchase
         * history with ROW_NUMBER().
         */

        SELECT

            needed.item_id,

            previousPurchase.purchase_cost,

            previousPurchase.purchase_date,

            previousPurchase.purchase_invoice_id,

            previousPurchase.purchase_invoice_code,

            previousPurchase.purchase_vendor_id,

            previousPurchase.purchase_item_id

        INTO #PreviousPurchases

        FROM #NeededItems needed

        OUTER APPLY (

            SELECT TOP 1

                pitem.CostPrice
                    AS purchase_cost,

                COALESCE(
                    pinv.ztime,
                    pinv.inv_date
                )
                    AS purchase_date,

                pinv.ID
                    AS purchase_invoice_id,

                pinv.inv_code
                    AS purchase_invoice_code,

                pinv.vendor_id
                    AS purchase_vendor_id,

                pitem.ID
                    AS purchase_item_id

            FROM PurchaseItems pitem

            INNER JOIN PurchaseInvoices pinv

                ON pinv.ID =
                   pitem.inv_id

            WHERE

                pitem.item_id =
                    needed.item_id

            AND

                COALESCE(
                    pinv.ztime,
                    pinv.inv_date
                ) < @fromDate

            ORDER BY

                COALESCE(
                    pinv.ztime,
                    pinv.inv_date
                ) DESC,

                pinv.ID DESC,

                pitem.ID DESC

        ) previousPurchase;


        CREATE UNIQUE CLUSTERED INDEX

            IX_PreviousPurchases_Item

        ON #PreviousPurchases (

            item_id

        );


        /*
         * =====================================================
         * FINAL RESULT
         * =====================================================
         */

        SELECT

            s.ticket_id,

            s.ticket_ztime,

            s.sales_return,

            s.customer_id,


            s.ticket_total,

            s.ticket_store_id,

            s.sales_rep_id,
            s.pin_number,
            s.line_id,

            s.item_id,

            s.item_name,

            s.item_parts,

            s.packs,

            s.units,

            s.line_parts,

            s.bonus,

            s.line_sales_price,

            s.line_cost,

            s.line_discount,

            s.line_extra_discount,

            s.is_content,

            s.line_store_id,


            CASE
    WHEN currentPurchase.purchase_item_id IS NOT NULL
    THEN currentPurchase.purchase_cost
    ELSE previousPurchase.purchase_cost
END
    AS last_purchase_cost,

CASE
    WHEN currentPurchase.purchase_item_id IS NOT NULL
    THEN currentPurchase.purchase_date
    ELSE previousPurchase.purchase_date
END
    AS last_purchase_date,

CASE
    WHEN currentPurchase.purchase_item_id IS NOT NULL
    THEN currentPurchase.purchase_invoice_id
    ELSE previousPurchase.purchase_invoice_id
END
    AS last_purchase_invoice_id,

CASE
    WHEN currentPurchase.purchase_item_id IS NOT NULL
    THEN currentPurchase.purchase_invoice_code
    ELSE previousPurchase.purchase_invoice_code
END
    AS last_purchase_invoice_code,

CASE
    WHEN currentPurchase.purchase_item_id IS NOT NULL
    THEN currentPurchase.purchase_vendor_id
    ELSE previousPurchase.purchase_vendor_id
END
    AS last_purchase_vendor_id,


            s.item_parts
                AS last_purchase_parts


        FROM #SalesBase s


        LEFT JOIN #PreviousPurchases previousPurchase

            ON previousPurchase.item_id =
               s.item_id


        OUTER APPLY (

            SELECT TOP 1

                p.purchase_cost,

                p.purchase_date,

                p.purchase_invoice_id,

                p.purchase_invoice_code,

                p.purchase_vendor_id,

                p.purchase_item_id

            FROM #Purchases p

            WHERE

                p.item_id =
                    s.item_id

            AND

                p.purchase_date <=
                    s.ticket_ztime

            ORDER BY

                p.purchase_date DESC,

                p.purchase_invoice_id DESC,

                p.purchase_item_id DESC

        ) currentPurchase;


    `;

}


