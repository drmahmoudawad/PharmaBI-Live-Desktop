import {
    getAllSavedConnections
} from "../settings/connectionStore.js";

import {
    getBranchPool
} from "../connection/connectionManager.js";

import {
    getSales
} from "./sales/salesService.js";


const HISTORY_MONTHS_DEFAULT =
    12;


function number(
    value
) {

    const result =
        Number(
            value
        );

    return Number.isFinite(
        result
    )
        ? result
        : 0;

}


function round(
    value,
    decimals = 2
) {

    const factor =
        10 ** decimals;

    return Math.round(
        (
            number(
                value
            ) +
            Number.EPSILON
        ) *
        factor
    ) / factor;

}


function validateDate(
    value,
    fieldName
) {

    const text =
        String(
            value || ""
        ).trim();

    if (
        !/^\d{4}-\d{2}-\d{2}$/.test(
            text
        )
    ) {

        throw new Error(
            `Invalid ${fieldName}. Expected YYYY-MM-DD`
        );

    }

    const date =
        new Date(
            `${text}T00:00:00Z`
        );

    if (
        Number.isNaN(
            date.getTime()
        )
    ) {

        throw new Error(
            `Invalid ${fieldName}: ${text}`
        );

    }

    return text;

}


function firstDayOfMonth(
    year,
    monthIndex
) {

    return new Date(
        Date.UTC(
            year,
            monthIndex,
            1
        )
    );

}


function lastDayOfMonth(
    year,
    monthIndex
) {

    return new Date(
        Date.UTC(
            year,
            monthIndex + 1,
            0
        )
    );

}


function addDay(
    dateText
) {

    const date =
        new Date(
            `${dateText}T00:00:00Z`
        );

    date.setUTCDate(
        date.getUTCDate() + 1
    );

    return date
        .toISOString()
        .slice(
            0,
            10
        );

}


function toDateText(
    date
) {

    return date
        .toISOString()
        .slice(
            0,
            10
        );

}


function monthKey(
    date
) {

    return date
        .toISOString()
        .slice(
            0,
            7
        );

}


function daysCoveredInMonth(
    month,
    toDate
) {

    const [
        year,
        monthNumber
    ] =
        String(
            month
        )
            .split("-")
            .map(
                Number
            );

    const start =
        firstDayOfMonth(
            year,
            monthNumber - 1
        );

    const end =
        lastDayOfMonth(
            year,
            monthNumber - 1
        );

    const effectiveEnd =
        Math.min(
            end.getTime(),
            new Date(
                `${toDate}T00:00:00Z`
            ).getTime()
        );

    return Math.max(
        1,
        Math.floor(
            (
                effectiveEnd -
                start.getTime()
            ) /
            86400000
        ) + 1
    );

}


function buildHistoryRange(
    toDate,
    historyMonths
) {

    const end =
        new Date(
            `${toDate}T00:00:00Z`
        );

    const start =
        firstDayOfMonth(
            end.getUTCFullYear(),
            end.getUTCMonth() -
                (
                    historyMonths -
                    1
                )
        );

    return {

        fromDate:
            toDateText(
                start
            ),

        toDate

    };

}


function createMonthBucket(
    month
) {

    return {

        month,

        sales:
            0,

        invoices:
            new Set()

    };

}


function employeeMetricBucket() {

    return new Map();

}


function getMonthlyMetrics(
    bucket,
    days
) {

    const sales =
        number(
            bucket?.sales
        );

    const invoices =
        bucket?.invoices
            instanceof Set

            ? bucket
                .invoices
                .size

            : number(
                bucket?.invoices
            );

    return {

        sales:
            round(
                sales
            ),

        invoices,

        averageDailySales:
            round(
                sales /
                Math.max(
                    1,
                    days
                )
            ),

        averageDailyInvoices:
            round(
                invoices /
                Math.max(
                    1,
                    days
                )
            ),

        averageInvoice:
            round(
                invoices
                    ? sales /
                      invoices
                    : 0
            )

    };

}


function scoreMonth(
    metrics,
    maxMetrics
) {

    const salesPart =
        maxMetrics
            .averageDailySales > 0

            ? (
                metrics
                    .averageDailySales /
                maxMetrics
                    .averageDailySales
            ) *
            40

            : 0;

    const invoicesPart =
        maxMetrics
            .averageDailyInvoices > 0

            ? (
                metrics
                    .averageDailyInvoices /
                maxMetrics
                    .averageDailyInvoices
            ) *
            30

            : 0;

    const invoicePart =
        maxMetrics
            .averageInvoice > 0

            ? (
                metrics
                    .averageInvoice /
                maxMetrics
                    .averageInvoice
            ) *
            30

            : 0;

    return round(
        Math.max(
            0,
            Math.min(
                100,
                salesPart +
                invoicesPart +
                invoicePart
            )
        )
    );

}


function scoreLabel(
    score
) {

    if (
        score >= 90
    ) {

        return "ممتاز";

    }

    if (
        score >= 75
    ) {

        return "جيد جداً";

    }

    if (
        score >= 60
    ) {

        return "جيد";

    }

    return "يحتاج متابعة";

}


function resolveConnection(
    branchId,
    connection
) {

    if (
        connection &&
        typeof connection ===
            "object" &&
        connection.server
    ) {

        return {

            ...connection,

            branchId:
                Number(
                    branchId
                )

        };

    }

    const branches =
        getAllSavedConnections();

    const found =
        branches.find(
            item =>
                Number(
                    item?.branchId
                ) ===
                Number(
                    branchId
                )
        );

    if (
        !found
    ) {

        throw new Error(
            `Branch ${branchId} connection was not found.`
        );

    }

    return found;

}


async function loadEmployeeContext({
    branchId,
    connection,
    fromDate,
    toDate
}) {

    const pool =
        await getBranchPool(
            Number(
                branchId
            ),
            connection
        );

    const ticketResult =
        await pool
            .request()

            .input(
                "fromDate",
                `${fromDate} 00:00:00`
            )

            .input(
                "toDateExclusive",
                `${addDay(
                    toDate
                )} 00:00:00`
            )

            .query(`

                SET NOCOUNT ON;

                SELECT

                    t.ID AS ticket_id,

                    CONVERT(
                        nvarchar(100),
                        t.PinNumber
                    ) AS employee_id

                FROM dbo.posTickets t

                WHERE

                    t.ztime >= @fromDate

                AND

                    t.ztime < @toDateExclusive

                AND

                    t.PinNumber IS NOT NULL

                AND

                    CONVERT(
                        nvarchar(100),
                        t.PinNumber
                    ) NOT IN (
                        N'',
                        N'0'
                    );

            `);

    const employeeIdByTicket =
        new Map();

    const employeeIds =
        new Set();

    for (
        const row
        of ticketResult?.recordset || []
    ) {

        const ticketId =
            String(
                row?.ticket_id ??
                ""
            ).trim();

        const employeeId =
            String(
                row?.employee_id ??
                ""
            ).trim();

        if (
            !ticketId ||
            !employeeId ||
            employeeId ===
                "0"
        ) {

            continue;

        }

        employeeIdByTicket.set(
            ticketId,
            employeeId
        );

        employeeIds.add(
            employeeId
        );

    }

    const names =
        new Map();

    if (
        employeeIds.size ===
        0
    ) {

        return {

            employeeIdByTicket,

            names

        };

    }

    const request =
        pool.request();

    const placeholders =
        Array
            .from(
                employeeIds
            )
            .map(
                (
                    employeeId,
                    index
                ) => {

                    const parameterName =
                        `employeeCardId${index}`;

                    request.input(
                        parameterName,
                        employeeId
                    );

                    return `@${parameterName}`;

                }
            );

    const cardsResult =
        await request.query(`

            SET NOCOUNT ON;

            SELECT

                CONVERT(
                    nvarchar(100),
                    c.ID
                ) AS employee_id,

                LTRIM(
                    RTRIM(
                        CONVERT(
                            nvarchar(400),
                            c.Name
                        )
                    )
                ) AS employee_name

            FROM dbo.Cards c

            WHERE

                ISNULL(
                    c.IsEmployee,
                    0
                ) = 1

            AND

                CONVERT(
                    nvarchar(100),
                    c.ID
                ) IN (
                    ${placeholders.join(
                        ", "
                    )}
                )

            AND

                NULLIF(
                    LTRIM(
                        RTRIM(
                            CONVERT(
                                nvarchar(400),
                                c.Name
                            )
                        )
                    ),
                    ''
                ) IS NOT NULL;

        `);

    for (
        const row
        of cardsResult?.recordset || []
    ) {

        const employeeId =
            String(
                row?.employee_id ??
                ""
            ).trim();

        const employeeName =
            String(
                row?.employee_name ??
                ""
            ).trim();

        if (
            employeeId &&
            employeeName
        ) {

            names.set(
                employeeId,
                employeeName
            );

        }

    }

    return {

        employeeIdByTicket,

        names

    };

}


export async function getSellerPerformance({
    branchId,
    employeeId,
    fromDate,
    toDate,
    connection = null,
    historyMonths =
        HISTORY_MONTHS_DEFAULT
}) {

    const numericBranchId =
        Number(
            branchId
        );

    if (
        !Number.isInteger(
            numericBranchId
        ) ||
        numericBranchId <=
            0
    ) {

        throw new Error(
            "Invalid branchId"
        );

    }

    const selectedEmployeeId =
        String(
            employeeId ??
            ""
        ).trim();

    if (
        !selectedEmployeeId ||
        selectedEmployeeId ===
            "UNASSIGNED"
    ) {

        throw new Error(
            "Invalid seller employeeId"
        );

    }

    const end =
        validateDate(
            toDate,
            "toDate"
        );

    const months =
        Number.isInteger(
            Number(
                historyMonths
            )
        )

            ? Math.max(
                1,
                Math.min(
                    24,
                    Number(
                        historyMonths
                    )
                )
            )

            : HISTORY_MONTHS_DEFAULT;

    const historyRange =
        buildHistoryRange(
            end,
            months
        );

    const branchConnection =
        resolveConnection(
            numericBranchId,
            connection
        );

    const [
        rows,
        employeeContext
    ] =
        await Promise.all([

            getSales({

                branchId:
                    numericBranchId,

                connection:
                    branchConnection,

                fromDate:
                    historyRange.fromDate,

                toDate:
                    historyRange.toDate

            }),

            loadEmployeeContext({

                branchId:
                    numericBranchId,

                connection:
                    branchConnection,

                fromDate:
                    historyRange.fromDate,

                toDate:
                    historyRange.toDate

            })

        ]);

    const sellerName =
        employeeContext
            .names
            .get(
                selectedEmployeeId
            ) ||
        `موظف (${selectedEmployeeId})`;

    const employeesByMonth =
        new Map();

    for (
        const row
        of Array.isArray(
            rows
        )
            ? rows
            : []
    ) {

        const ticketId =
            String(
                row?.ticketId ??
                ""
            ).trim();

        const employeeKey =
            employeeContext
                .employeeIdByTicket
                .get(
                    ticketId
                );

        if (
            !employeeKey ||
            !employeeContext
                .names
                .has(
                    employeeKey
                )
        ) {

            continue;

        }

        const dateText =
            String(
                row?.date ??
                ""
            ).slice(
                0,
                10
            );

        if (
            !/^\d{4}-\d{2}-\d{2}$/.test(
                dateText
            )
        ) {

            continue;

        }

        const month =
            dateText.slice(
                0,
                7
            );

        const isReturn =
            row?.transactionType ===
            "RETURN";

        const salesValue =
            isReturn

                ? -Math.abs(
                    number(
                        row?.netLineValue
                    )
                )

                : number(
                    row?.netLineValue
                );

        if (
            !employeesByMonth.has(
                employeeKey
            )
        ) {

            employeesByMonth.set(
                employeeKey,
                new Map()
            );

        }

        const monthly =
            employeesByMonth.get(
                employeeKey
            );

        if (
            !monthly.has(
                month
            )
        ) {

            monthly.set(
                month,
                createMonthBucket(
                    month
                )
            );

        }

        const bucket =
            monthly.get(
                month
            );

        bucket.sales +=
            salesValue;

        if (
            ticketId
        ) {

            bucket.invoices.add(
                ticketId
            );

        }

    }

    const monthsList =
        [];

    const endDate =
        new Date(
            `${end}T00:00:00Z`
        );

    const startDate =
        firstDayOfMonth(
            endDate.getUTCFullYear(),
            endDate.getUTCMonth() -
                (
                    months -
                    1
                )
        );

    let cursor =
        startDate;

    while (
        cursor <=
        endDate
    ) {

        monthsList.push(
            monthKey(
                cursor
            )
        );

        cursor =
            firstDayOfMonth(
                cursor.getUTCFullYear(),
                cursor.getUTCMonth() +
                    1
            );

    }

    const allMonthlyMetrics =
        new Map();

    for (
        const employeeMonthly
        of employeesByMonth.values()
    ) {

        for (
            const month
            of monthsList
        ) {

            const bucket =
                employeeMonthly.get(
                    month
                ) ||
                createMonthBucket(
                    month
                );

            const days =
                daysCoveredInMonth(
                    month,
                    end
                );

            const metrics =
                getMonthlyMetrics(
                    bucket,
                    days
                );

            if (
                !allMonthlyMetrics.has(
                    month
                )
            ) {

                allMonthlyMetrics.set(
                    month,
                    []
                );

            }

            allMonthlyMetrics
                .get(
                    month
                )
                .push(
                    metrics
                );

        }

    }

    const maxByMonth =
        new Map();

    for (
        const month
        of monthsList
    ) {

        const list =
            allMonthlyMetrics.get(
                month
            ) ||
            [];

        maxByMonth.set(
            month,
            {

                averageDailySales:
                    Math.max(
                        0,
                        ...list.map(
                            item =>
                                item
                                    .averageDailySales
                        )
                    ),

                averageDailyInvoices:
                    Math.max(
                        0,
                        ...list.map(
                            item =>
                                item
                                    .averageDailyInvoices
                        )
                    ),

                averageInvoice:
                    Math.max(
                        0,
                        ...list.map(
                            item =>
                                item
                                    .averageInvoice
                        )
                    )

            }
        );

    }

    const sellerMonthly =
        employeesByMonth.get(
            selectedEmployeeId
        ) ||
        employeeMetricBucket();

    const monthly =
        monthsList.map(
            month => {

                const days =
                    daysCoveredInMonth(
                        month,
                        end
                    );

                const bucket =
                    sellerMonthly.get(
                        month
                    ) ||
                    createMonthBucket(
                        month
                    );

                const metrics =
                    getMonthlyMetrics(
                        bucket,
                        days
                    );

                const maxMetrics =
                    maxByMonth.get(
                        month
                    ) ||
                    {

                        averageDailySales:
                            0,

                        averageDailyInvoices:
                            0,

                        averageInvoice:
                            0

                    };

                const score =
                    scoreMonth(
                        metrics,
                        maxMetrics
                    );

                return {

                    month,

                    days,

                    ...metrics,

                    score,

                    scoreLabel:
                        scoreLabel(
                            score
                        )

                };

            }
        );

    const activeMonths =
        monthly.filter(
            item =>
                item.invoices > 0 ||
                item.sales !== 0
        );

    const latest =
        activeMonths[
            activeMonths.length - 1
        ] ||
        null;

    const averageScore =
        activeMonths.length

            ? round(
                activeMonths.reduce(
                    (
                        sum,
                        item
                    ) =>
                        sum +
                        item.score,
                    0
                ) /
                activeMonths.length
            )

            : 0;

    return {

        success:
            true,

        branchId:
            numericBranchId,

        branchName:
            branchConnection.branchName ||
            `Branch ${numericBranchId}`,

        employeeId:
            selectedEmployeeId,

        employeeName:
            sellerName,

        fromDate:
            historyRange.fromDate,

        toDate:
            historyRange.toDate,

        historyMonths:
            months,

        weights: {

            averageDailySales:
                40,

            averageDailyInvoices:
                30,

            averageInvoice:
                30

        },

        latest,

        averageScore,

        monthly

    };

}


export default {

    getSellerPerformance

};