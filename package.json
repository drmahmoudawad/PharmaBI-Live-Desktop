{
  "name": "pharmabi-live",
  "version": "0.1.0",
  "private": true,
  "description": "PharmaBI Live Desktop - direct PharmaFly SQL Server analytics",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "powershell -NoProfile -Command \"$env:PHARMABI_DEV_SERVER='1'; Start-Process npm.cmd -ArgumentList 'run vite' -NoNewWindow; Start-Sleep -Seconds 2; .\\node_modules\\.bin\\electron.cmd .\"",
    "build:renderer": "vite build",
    "start": "npm run build:renderer && electron .",
    "dist": "npm run prepare:installer-snapshot && npm run build:renderer && electron-builder --win nsis",
    "dist:dir": "npm run prepare:installer-snapshot && npm run build:renderer && electron-builder --win dir",
    "vite": "vite --host 127.0.0.1",
    "prepare:installer-snapshot": "node tools/prepareInstallerSnapshot.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "mssql": "12.7.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "whatsapp-web.js": "github:carlosalaniz/whatsapp-web.js#fix/lid-getchats-crash",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "vite": "8.2.2"
  },
  "build": {
    "appId": "com.pharmabi.live",
    "productName": "PharmaBI Live",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PharmaBI Live",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "extraResources": [
      {
        "from": "installer-seed",
        "to": "installer-seed",
        "filter": [
          "**/*",
          "!persistent-cache/**",
          "!persistent-data-cache.json"
        ]
      }
    ]
  }
}
