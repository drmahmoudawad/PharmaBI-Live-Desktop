import React from "react";

import ProductAnalyticsPanel
    from "../components/ProductAnalyticsPanel.jsx";

import WhatsAppPage
    from "../components/WhatsAppPage.jsx";

import AnalyticsHubPanel
    from "../components/AnalyticsHubPanel.jsx";

import SalesAnalyticsPanel
    from "../components/SalesAnalyticsPanel.jsx";

import SalesPage
    from "./SalesPage.jsx";


export default function BranchAnalyticsRouter({

    activeSection,
    activeModule,
    activeModuleDefinition,
    activeSectionDefinition,

    selectedConnection,
    selectedBranchId,
    selectedBranchName,

    fromDate,
    toDate,

    branchOverview,
    branchOverviewLoading,
    branchOverviewError,

    renderBranchOverview,
    renderBranchConnections,
    renderCacheStatus

}) {

    /*
     * =========================================================
     * CRM / WHATSAPP
     * =========================================================
     */

    if (
        activeSection ===
        "crm"
    ) {

        return (

            <WhatsAppPage

                selectedBranchId={
                    selectedBranchId
                }

            />

        );

    }


    /*
     * =========================================================
     * DASHBOARD
     * =========================================================
     */

    if (
        activeSection ===
        "dashboard"
    ) {

        if (
            activeModule ===
            "overview"
        ) {

            return renderBranchOverview();

        }


        return (

            <section className="page-card empty-state">

                <div className="page-eyebrow">
                    لوحة التحكم
                </div>


                <h2>
                    {
                        activeModuleDefinition?.label ||
                        activeModule
                    }
                </h2>


                <p>
                    هذا التحليل غير مرتبط بعد بمكوّن عرض فعلي.
                </p>

            </section>

        );

    }


    /*
     * =========================================================
     * SALES
     * =========================================================
     */

    if (
        activeSection ===
        "sales"
    ) {

        /*
         * Sales Overview stays on the dedicated SalesPage.
         */

        if (
            activeModule ===
                "sales-overview" ||
            activeModule ===
                "overview" ||
            activeModule ===
                "sales"
        ) {

            return (

                <SalesPage

                    selectedBranchId={
                        selectedBranchId
                    }

                    selectedConnection={
                        selectedConnection
                    }

                    fromDate={
                        fromDate
                    }

                    toDate={
                        toDate
                    }

                    activeModule={
                        "sales-overview"
                    }

                />

            );

        }


        /*
         * All other sales modules go to AnalyticsHubPanel.
         */

        return (

            
        if (
            activeModule ===
                "sales-shifts"
        ) {

            return (
                <SalesAnalyticsPanel

                    branchId={
                        selectedBranchId
                    }

                    connection={
                        selectedConnection
                    }

                    fromDate={
                        fromDate
                    }

                    toDate={
                        toDate
                    }

                    activeModule={
                        "sales-shifts"
                    }

                />
            );

        }


<AnalyticsHubPanel

                moduleId={
                    activeModule
                }

                branchId={
                    selectedBranchId
                }

                connection={
                    selectedConnection
                }

                fromDate={
                    fromDate
                }

                toDate={
                    toDate
                }

            />

        );

    }


    /*
     * =========================================================
     * CUSTOMERS
     * =========================================================
     */

    if (
        activeSection ===
        "customers"
    ) {

        return (

            <AnalyticsHubPanel

                moduleId={
                    activeModule
                }

                branchId={
                    selectedBranchId
                }

                connection={
                    selectedConnection
                }

                fromDate={
                    fromDate
                }

                toDate={
                    toDate
                }

            />

        );

    }


    /*
     * =========================================================
     * PRODUCTS
     * =========================================================
     */

    if (
        activeSection ===
        "products"
    ) {

        if (
            !selectedConnection
        ) {

            return (

                <section className="page-card empty-state">

                    <h2>
                        اختر فرعًا لعرض تحليلات المنتجات
                    </h2>

                </section>

            );

        }


        return (

            <ProductAnalyticsPanel

                connectionPayload={
                    selectedConnection
                }

                fromDate={
                    fromDate
                }

                toDate={
                    toDate
                }

            />

        );

    }


    /*
     * =========================================================
     * ANALYTICS HUB SECTIONS
     * =========================================================
     */

    if (
        activeSection ===
            "profitability" ||
        activeSection ===
            "branches" ||
        activeSection ===
            "staff" ||
        activeSection ===
            "forecast" ||
        activeSection ===
            "quality"
    ) {

        return (

            <AnalyticsHubPanel

                moduleId={
                    activeModule
                }

                branchId={
                    selectedBranchId
                }

                connection={
                    selectedConnection
                }

                fromDate={
                    fromDate
                }

                toDate={
                    toDate
                }

            />

        );

    }


    /*
     * =========================================================
     * SYSTEM
     * =========================================================
     */

    if (
        activeSection ===
        "system"
    ) {

        if (
            activeModule ===
            "connections"
        ) {

            return renderBranchConnections();

        }


        if (
            activeModule ===
            "cache"
        ) {

            return renderCacheStatus();

        }


        return renderBranchConnections();

    }


    /*
     * =========================================================
     * FALLBACK
     * =========================================================
     */

    return (

        <section className="page-card empty-state">

            <div className="page-eyebrow">

                {
                    activeSectionDefinition?.label
                }

            </div>


            <h2>

                {
                    activeModuleDefinition?.label ||
                    activeModule ||
                    activeSection ||
                    "Analytics"
                }

            </h2>


            <p>

                هذا التحليل موجود في القائمة ولكنه غير مرتبط حاليًا بمكوّن عرض.

            </p>

        </section>

    );

}