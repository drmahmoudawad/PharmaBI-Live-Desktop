function n(v) {
    const x = Number(v);
    return Number.isFinite(x) ? x : 0;
}

function money(v) {
    return n(v).toLocaleString('ar-EG', {
        maximumFractionDigits: 2
    });
}

function num(v) {
    return n(v).toLocaleString('ar-EG', {
        maximumFractionDigits: 2
    });
}

function pct(v) {
    return `${n(v).toLocaleString('ar-EG', {
        maximumFractionDigits: 1
    })}%`;
}

function fmtDate(v) {
    if (!v) return '-';

    const text = String(v);

    if (text.length >= 16) {
        return text
            .slice(0, 16)
            .replace('T', ' ');
    }

    if (text.length >= 10) {
        return text.slice(0, 10);
    }

    return text;
}

function dayCount(fromDate, toDate) {
    const start =
        new Date(`${fromDate}T00:00:00Z`);

    const end =
        new Date(`${toDate}T00:00:00Z`);

    if (
        !Number.isFinite(start.getTime()) ||
        !Number.isFinite(end.getTime()) ||
        start > end
    ) {
        return 1;
    }

    return (
        Math.floor(
            (end.getTime() - start.getTime()) /
            86400000
        ) + 1
    );
}

