function SellersTable({
    rows,
    fromDate,
    toDate,
    branchLabel,
    onSellerClick
}) {
    const totals =
        useMemo(
            () => {

                const sales =
                    rows.reduce(
                        (sum, row) =>
                            sum + n(row.sales),
                        0
                    );

                const invoices =
                    rows.reduce(
                        (sum, row) =>
                            sum + n(row.invoices),
                        0
                    );

                const customers =
                    rows.reduce(
                        (sum, row) =>
                            sum +
                            n(row.customers),
                        0
                    );

                const units =
                    rows.reduce(
                        (sum, row) =>
                            sum + n(row.units),
                        0
                    );

                return {
                    sales,
                    invoices,
                    customers,
                    units,
                    averageInvoice:
                        invoices
                            ? sales /
                              invoices
                            : 0
                };
            },
            [rows]
        );

    return (
        <>
            <div
                style={{
                    display: 'flex',
