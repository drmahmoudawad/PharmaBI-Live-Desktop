                            row =>
                                row.branchName ||
                                row.name ||
                                row.branchId
                    },

                    {
                        key: 'sales',
                        label:
                            'المبيعات',
                        render:
                            row =>
                                money(
                                    row.sales
                                )
                    },

                    {
                        key: 'profit',
                        label:
                            'الربح',
                        render:
                            row =>
                                money(
                                    row.profit
                                )
                    },

                    {
                        key: 'margin',
                        label:
                            'الهامش',
                        render:
                            row =>
                                pct(
                                    row.margin
                                )
                    },

                    {
                        key: 'invoices',
                        label:
                            'الفواتير'
                    }
                ]}
                rows={data.branches}
            />
        );
    } else if (
        moduleId.includes(
            'reconciliation'
        )
    ) {
        body = (
            <Cards
                items={[
                    {
                        label:
                            'عدد الفواتير',
                        value:
                            num(
                                data.reconciliation?.ticketCount
                            )
                    },

                    {
                        label:
                            'فروقات',
                        value:
                            num(
                                data.reconciliation?.ticketsWithDifference
                            )
                    },

                    {
                        label:
                            'إجمالي الفرق',
                        value:
                            money(
                                data.reconciliation?.absoluteDifference
                            )
                    }
                ]}
            />
        );
    } else {
        body = null;
    }

    return (
        <>
            <section className="page-card">
                <div className="page-header">
                    <div>
                        <div className="page-eyebrow">
                            PharmaBI Analytics
                        </div>

                        <h2>
                            {title}
                        </h2>

                        <p>
                            {fromDate} → {toDate}
                        </p>
                    </div>

                    <div className="period-chip">
                        {
                            branchId ===
                            'all'
                                ? 'كل الفروع'
                                : `الفرع ${branchId}`
                        }
                    </div>
                </div>

                {cards.length > 0 && (
                    <Cards
                        items={cards}
                    />
                )}

                <div
                    style={{
                        marginTop: 18
                    }}
                >
                    {body}
                </div>

                <Diagnosis
                    data={data}
                    moduleId={moduleId}
                />
            </section>

            {sellerLoading && (
                <Overlay
                    text="جاري تحميل تاريخ البائع..."
                />
            )}

            {sellerProfile && (
                <SellerProfile
                    profile={
                        sellerProfile
                    }
                    onClose={() =>
                        setSellerProfile(
                            null
                        )
                    }
                />
            )}

            {customerLoading && (
                <Overlay
                    text="جاري تحميل تقييم العميل..."
                    zIndex={10000}
                />
            )}

            {customerProfile && (
                <CustomerProfile
                    profile={
                        customerProfile
                    }
                    onClose={() => {
                        setCustomerProfile(
                            null
                        );

                        setInvoiceDetails(
                            null
                        );
                    }}
                    onInvoice={
                        openCustomerInvoice
                    }
                    onExport={
                        exportCustomerInvoices
                    }
                />
            )}

            {invoiceLoading && (
                <Overlay
                    text="جاري تحميل تفاصيل الفاتورة..."
                    zIndex={10002}
                />
            )}

            {invoiceDetails && (
                <CustomerInvoiceDetails
                    details={
                        invoiceDetails
                    }
                    onClose={() =>
                        setInvoiceDetails(
                            null
                        )
                    }
                />
            )}
        </>
    );
}

export default function AnalyticsHubPanel(props){

    const moduleId = props?.moduleId;

    if(
        moduleId === 'branch-health' ||
        moduleId === 'branch-overview'
    ){
        return (
            <BranchPerformancePanel
                mode="overview"
                branchId={props?.branchId}
                connection={props?.connection}
                toDate={props?.toDate}
                historyMonths={12}
            />
        );
    }

    if(moduleId === 'branch-comparison'){
        return (
            <BranchPerformancePanel
                mode="comparison"
                branchId={props?.branchId}
                connection={props?.connection}
                toDate={props?.toDate}
                historyMonths={12}
            />
        );
    }

    if(moduleId === 'branch-ranking'){
        return (
            <BranchPerformancePanel
                mode="ranking"
                branchId={props?.branchId}
                connection={props?.connection}
                toDate={props?.toDate}
                historyMonths={12}
            />
        );
    }

    if(moduleId === 'forecast-sales'){
        return (
            <BranchPerformancePanel
                mode="forecast"
                branchId={props?.branchId}
                connection={props?.connection}
                toDate={props?.toDate}
                historyMonths={12}
            />
        );
    }

    return (
        <AnalyticsHubPanelBody
            moduleId={props?.moduleId}
            branchId={props?.branchId}
            connection={props?.connection}
            fromDate={props?.fromDate}
            toDate={props?.toDate}
        />
    );
}
