function Diagnosis({
    data,
    moduleId
}) {
    let text =
        'التحليل التشخيصي سيقارن العوامل الرئيسية ويحدد مصدر التغير عندما تتوفر بيانات كافية.';

    if (
        data?.performance?.flags?.length
    ) {
        text =
            data.performance.flags
                .slice(0, 2)
                .map(
                    item =>
                        item.message ||
                        item.label
                )
                .join(' + ');
    }

    if (
        data?.primary?.message
    ) {
        text =
            data.primary.message;
    }

    if (
        moduleId === 'quality-cost' &&
        data?.quality
    ) {
        text =
            `جودة التكلفة: ${data.quality.zeroCostRate}% من السطور بتكلفة صفر و${data.quality.missingCostRate}% بدون تكلفة مرجعية.`;
