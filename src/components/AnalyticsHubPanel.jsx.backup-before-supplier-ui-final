function exportSellersToExcel({
    rows,
    fromDate,
    toDate,
    branchLabel
}) {
    const totals = {
        sales:
            rows.reduce(
                (sum, row) =>
                    sum + n(row.sales),
                0
            ),

        invoices:
            rows.reduce(
                (sum, row) =>
                    sum + n(row.invoices),
                0
            ),

        customers:
            rows.reduce(
                (sum, row) =>
                    sum + n(row.customers),
                0
            ),

        units:
            rows.reduce(
                (sum, row) =>
                    sum + n(row.units),
                0
            )
    };

    totals.averageInvoice =
        totals.invoices
            ? totals.sales /
              totals.invoices
            : 0;

    const rowsForExcel = [
        [
            'PharmaBI - البائعون'
        ],

        [
            'الفرع',
            branchLabel
        ],

        [
            'من',
            fromDate
        ],

        [
            'إلى',
            toDate
        ],

        [],

        [
            'البائع',
            'متوسط المبيعات / يوم',
            'نسبة المبيعات',
            'متوسط الفواتير / يوم',
            'نسبة الفواتير',
            'متوسط الفاتورة',
            'نسبة متوسط الفاتورة',
            'متوسط العملاء / يوم',
            'نسبة العملاء',
            'متوسط الوحدات / يوم',
            'نسبة الوحدات'
        ]
    ];

    for (const row of rows) {
        rowsForExcel.push([
            row.employeeName ||
                row.employeeId ||
                '-',

            n(row.sales),
            sellerShare(
                row.sales,
                totals.sales
            ),

            n(row.invoices),
            sellerShare(
                row.invoices,
                totals.invoices
            ),

            n(row.averageInvoice),
            sellerShare(
                row.averageInvoice,
                totals.averageInvoice
            ),

            n(row.customers),
            sellerShare(
                row.customers,
                totals.customers
            ),

            n(row.units),
            sellerShare(
                row.units,
                totals.units
            )
        ]);
    }

    const worksheet =
        XLSX.utils.aoa_to_sheet(
            rowsForExcel
        );

    const workbook =
        XLSX.utils.book_new();

    XLSX.utils.book_append_sheet(
        workbook,
        worksheet,
        'البائعون'
    );

    XLSX.writeFile(
        workbook,
        `PharmaBI-البائعون-${String(
            branchLabel || 'كل الفروع'
        ).replace(
            /[\\/:*?"<>|]/g,
            '-'
        )}-${fromDate}-${toDate}.xlsx`
    );
}

