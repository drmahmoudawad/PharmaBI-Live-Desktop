function SimpleLineChart({
    rows,
    field,
    title,
    formatter = money
}) {
    const clean =
        Array.isArray(rows)
            ? rows
            : [];

    const values =
        clean.map(
            row => n(
                row?.[field]
            )
        );

    const width = 900;
    const height = 280;

    const max =
        Math.max(
            ...values,
            1
        );

    const min =
        Math.min(
            ...values,
            0
        );

    const span =
        Math.max(
            max - min,
            1
        );

    const points =
        values.length > 0
            ? values
                .map(
                    (
                        value,
                        index
                    ) => {
                        const x =
                            values.length === 1
                                ? width / 2
                                : (
                                    index *
                                    width
                                ) /
                                (
                                    values.length - 1
                                );

                        const y =
                            height -
                            38 -
                            (
                                (
                                    value -
                                    min
                                ) /
                                span
                            ) *
                            (
                                height -
                                80
                            );

                        return {
                            x,
                            y,
                            value
                        };
                    }
                )
            : [];

    const polyline =
        points
            .map(
                point =>
                    `${point.x.toFixed(1)},${point.y.toFixed(1)}`
            )
            .join(" ");

    return (
        <div
            className="table-card"
            style={{
                marginTop: 18
            }}
        >
            <div className="table-card-header">
                <div>
                    <strong>
                        {title}
                    </strong>

                    <span>
                        {clean.length} شهر
                    </span>
                </div>
            </div>

            <div
                style={{
                    padding:
                        "14px 18px 18px"
                }}
            >
                {points.length === 0 ? (
                    <div
                        style={{
                            padding: 20,
                            textAlign:
                                "center"
                        }}
                    >
                        لا توجد بيانات
                    </div>
                ) : (
                    <svg
                        viewBox={
                            `0 0 ${width} ${height}`
                        }
                        width="100%"
                        height="280"
                        role="img"
                        aria-label={
                            title
                        }
                    >
                        <line
                            x1="0"
                            y1="40"
                            x2={width}
                            y2="40"
                            stroke="currentColor"
                            opacity="0.08"
                        />

                        <line
                            x1="0"
                            y1={height - 40}
                            x2={width}
                            y2={
                                height - 40
                            }
                            stroke="currentColor"
                            opacity="0.12"
                        />

                        <polyline
                            points={
                                polyline
                            }
                            fill="none"
                            stroke="currentColor"
                            strokeWidth="4"
                            strokeLinecap="round"
                            strokeLinejoin="round"
                            opacity="0.85"
                        />

                        {points.map(
                            (
                                point,
                                index
                            ) => (
                                <g
                                    key={
                                        clean[
                                            index
                                        ]?.month ||
                                        index
                                    }
                                >
                                    <circle
                                        cx={
                                            point.x
                                        }
                                        cy={
                                            point.y
                                        }
                                        r="5"
                                        fill="currentColor"
                                        opacity="0.9"
                                    />

                                    <text
                                        x={
                                            point.x
                                        }
                                        y={
                                            point.y -
                                            10
                                        }
                                        textAnchor="middle"
                                        fontSize="11"
                                        opacity="0.75"
                                    >
                                        {formatter(
                                            point.value
                                        )}
                                    </text>

                                    <text
                                        x={
                                            point.x
                                        }
                                        y={
                                            height -
                                            12
                                        }
                                        textAnchor="middle"
                                        fontSize="11"
                                        opacity="0.65"
                                    >
                                        {String(
                                            clean[
                                                index
                                            ]?.month ||
                                            ""
                                        ).slice(5)}
                                    </text>
                                </g>
                            )
                        )}
                    </svg>
                )}
            </div>
        </div>
    );
}


