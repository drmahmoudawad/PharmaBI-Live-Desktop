export default function BranchPerformancePanel({
    mode = "overview",
    branchId,
    connection,
    toDate,
    historyMonths = 12
}) {
    const [
        data,
        setData
    ] = useState(null);

    const [
        loading,
        setLoading
    ] = useState(true);

    const [
        error,
        setError
    ] = useState("");

    useEffect(
        () => {
            let cancelled = false;

            async function load() {
                setLoading(true);
                setError("");

                try {
                    let result;

                    if (
                        mode ===
                        "forecast"
                    ) {
                        result =
                            await window.pharmaBI.dashboard.overview({
                                action:
                                    "branch-forecast",

                                branchId:
                                    branchId,

                                toDate:
                                    toDate,

                                connection:
                                    connection,

                                historyMonths:
                                    historyMonths
                            });
                    }
                    else {
                        const comparison =
                            mode ===
                            "comparison" ||
                            mode ===
                            "ranking";

                        result =
                            await window.pharmaBI.dashboard.overview({
                                action:
                                    "branch-performance",

                                branchId:
                                    comparison
                                        ? "all"
                                        : branchId,

                                toDate:
                                    toDate,

                                connection:
                                    comparison
                                        ? null
                                        : connection,

                                historyMonths:
                                    historyMonths,

                                mode:
                                    comparison
                                        ? "comparison"
                                        : "branch"
                            });
                    }

                    if (
                        !cancelled
                    ) {
                        setData(
                            result
                        );
                    }
                }
                catch (err) {
                    if (
                        !cancelled
                    ) {
                        setError(
                            err?.message ||
                            "تعذر تحميل أداء الفرع."
                        );
                    }
                }
                finally {
                    if (
                        !cancelled
                    ) {
                        setLoading(
                            false
                        );
                    }
                }
            }

            load();

            return () => {
                cancelled = true;
            };
        },
        [
            mode,
            branchId,
            connection,
            toDate,
            historyMonths
        ]
    );


    const pageTitle =
        mode === "forecast"
            ? "توقع مبيعات الشهر القادم"
            : mode === "comparison"
                ? "مقارنة أداء الفروع"
                : mode === "ranking"
                    ? "تحليل تطور واستقرار الفروع"
                    : "تقييم أداء الفرع";


    const rankingMode =
        mode === "ranking"
            ? "growth"
            : "comparison";


    const monthlyRows =
        useMemo(
            () =>
                Array.isArray(
                    data?.monthly
                )
                    ? data.monthly
                    : [],
            [
                data
            ]
        );


    if (loading) {
        return (
            <section className="page-card loading-card">
                <div className="loading-spinner" />

                <h2>
                    جاري تحميل {pageTitle}...
                </h2>

                <p>
                    يتم استخدام بيانات PharmaFly
                    والكاش المتاح للفترة المطلوبة.
                </p>
            </section>
        );
    }


    if (error) {
        return (
            <section className="page-card">
                <div className="status error">
                    {error}
                </div>
            </section>
        );
    }


    if (!data) {
        return (
            <section className="page-card empty-state">
                <h2>
                    {pageTitle}
                </h2>

                <p>
                    لا توجد نتيجة.
                </p>
            </section>
        );
    }


    if (
        mode ===
        "forecast"
    ) {
        const forecast =
            data;

        return (
            <section className="page-card">
                <div className="page-header">
                    <div>
                        <div className="page-eyebrow">
                            PharmaBI Analytics
                        </div>

                        <h2>
                            {pageTitle}
                        </h2>

                        <p>
                            {forecast.branchName}
                            {" · "}
                            الهدف للشهر التالي:
                            {" "}
                            {monthLabel(
                                forecast.targetMonth
                            )}
                        </p>
                    </div>

                    <div className="period-chip">
                        {forecast.historyMonths}
                        {" شهر تاريخي"}
                    </div>
                </div>


                <ForecastCards
                    forecast={
                        forecast
                    }
                />


                <div
                    className="table-card"
                    style={{
                        marginTop: 18
                    }}
                >
                    <div
                        style={{
                            padding: 20,
                            lineHeight: 1.9
                        }}
                    >
                        <strong>
                            سياسة الأهداف
                        </strong>

                        <div
                            style={{
                                marginTop: 10
                            }}
                        >
                            الهدف A هو الرقم الذي يعتبره البرنامج
                            قابلاً للتحقيق بالمجهود الطبيعي.
                        </div>

                        <div>
                            الهدف B أعلى من A ويتطلب مجهوداً واستمراراً
                            أعلى، لكنه مبني على التاريخ الفعلي للفرع.
                        </div>

                        <div>
                            الربحية والهامش غير داخلين في الحسابات
                            الحالية.
                        </div>
                    </div>
                </div>


                <SimpleLineChart
                    rows={
                        forecast.historicalMonthly
                    }
                    field="averageDailySales"
                    title="تطور متوسط المبيعات اليومية"
                    formatter={
                        money
                    }
                />


                <MetricTable
                    rows={
                        forecast.historicalMonthly
                    }
                />
            </section>
        );
    }


    if (
        mode ===
        "comparison" ||
        mode ===
        "ranking"
    ) {
        const branches =
            data.branches ||
            [];

        return (
            <section className="page-card">
                <div className="page-header">
                    <div>
                        <div className="page-eyebrow">
                            PharmaBI Analytics
                        </div>

                        <h2>
                            {pageTitle}
                        </h2>

                        <p>
                            الشهر:
                            {" "}
                            {monthLabel(
                                data.month
                            )}
                        </p>
                    </div>

                    <button
                        type="button"
                        onClick={() =>
                            ExportBranchComparison({
                                branches,
                                month:
                                    data.month
                            })
                        }
                        style={{
                            border:
                                "1px solid #D7E0EE",
                            background:
                                "#fff",
                            color:
                                "#173A73",
                            borderRadius:
                                10,
                            padding:
                                "9px 14px",
                            cursor:
                                "pointer",
                            fontWeight:
                                800,
                            fontFamily:
                                "inherit"
                        }}
                    >
                        ↓ تصدير Excel
                    </button>
                </div>


                <div className="kpi-grid">
                    <Card
                        label="عدد الفروع"
                        value={num(
                            branches.length
                        )}
                    />

                    <Card
                        label="الشهر محل المقارنة"
                        value={monthLabel(
                            data.month
                        )}
                    />

                    <Card
                        label="منهج المقارنة"
                        value="يومي"
                        note="لا يتم ترتيب الفروع على إجمالي الشهر"
                    />
                </div>


                <SectionTitle
                    title={
                        mode ===
                        "ranking"
                            ? "التطور والاستقرار"
                            : "جدول المقارنة"
                    }
                    description={
                        "كل الأرقام التشغيلية متوسطات يومية داخل الشهر."
                    }
                />


                <BranchRankingTable
                    branches={
                        branches
                    }
                    mode={
                        rankingMode
                    }
                />


                <SectionTitle
                    title="حسب النمو"
                    description={
                        "آخر شهر مقابل الشهر السابق."
                    }
                />

                <BranchRankingTable
                    branches={
                        data.growthRanking ||
                        []
                    }
                    mode="growth"
                />


                <SectionTitle
                    title="حسب التطور"
                    description={
                        "آخر شهر مقابل متوسط أول 3 أشهر من فترة التحليل."
                    }
                />

                <BranchRankingTable
                    branches={
                        data.developmentRanking ||
                        []
                    }
                    mode="development"
                />


                <SectionTitle
                    title="حسب الاستقرار"
                    description={
                        "مؤشر مبني على تذبذب متوسط المبيعات اليومية خلال آخر 6 أشهر."
                    }
                />

                <BranchRankingTable
                    branches={
                        data.stabilityRanking ||
                        []
                    }
                    mode="stability"
                />
            </section>
        );
    }


    const latest =
        data.latest ||
        {};

    const previous =
        data.previous ||
        {};

    const indicators =
        data.indicators ||
        {};


    return (
        <section className="page-card">
            <div className="page-header">
                <div>
                    <div className="page-eyebrow">
                        PharmaBI Analytics
                    </div>

                    <h2>
                        {pageTitle}
                    </h2>

                    <p>
                        {data.branchName}
                        {" · "}
                        آخر شهر:
                        {" "}
                        {monthLabel(
                            latest.month
                        )}
                    </p>
                </div>

                <button
                    type="button"
                    onClick={() =>
                        ExportBranchHistory({
                            rows:
                                monthlyRows,
                            branchName:
                                data.branchName
                        })
                    }
                    style={{
                        border:
                            "1px solid #D7E0EE",
                        background:
                            "#fff",
                        color:
                            "#173A73",
                        borderRadius:
                            10,
                        padding:
                            "9px 14px",
                        cursor:
                            "pointer",
                        fontWeight:
                            800,
                        fontFamily:
                            "inherit"
                    }}
                >
                    ↓ تصدير Excel
                </button>
            </div>


            <BranchSummary
                latest={
                    latest
                }
                previous={
                    previous
                }
                indicators={
                    indicators
                }
            />


            <SimpleLineChart
                rows={
                    monthlyRows
                }
                field="averageDailySales"
                title="تطور متوسط المبيعات اليومية"
                formatter={
                    money
                }
            />


            <SimpleLineChart
                rows={
                    monthlyRows
                }
                field="averageDailyInvoices"
                title="تطور متوسط الفواتير اليومية"
                formatter={
                    num
                }
            />


            <SimpleLineChart
                rows={
                    monthlyRows
                }
                field="averageInvoiceValue"
                title="تطور متوسط قيمة الفاتورة"
                formatter={
                    money
                }
            />


            <SimpleLineChart
                rows={
                    monthlyRows
                }
                field="averageDailyDeliverySales"
                title="تطور متوسط مبيعات الدليفري اليومية"
                formatter={
                    money
                }
            />


            <MetricTable
                rows={
                    monthlyRows
                }
            />


            <div
                className="table-card"
                style={{
                    marginTop: 18
                }}
            >
                <div
                    style={{
                        padding: 20,
                        lineHeight: 1.9
                    }}
                >
                    <strong>
                        قراءة الأداء
                    </strong>

                    <div
                        style={{
                            marginTop: 10
                        }}
                    >
                        النمو الشهري:
                        {" "}
                        <b>
                            {pct(
                                indicators.growthPct
                            )}
                        </b>
                    </div>

                    <div>
                        التطور عن خط الأساس:
                        {" "}
                        <b>
                            {pct(
                                indicators.developmentPct
                            )}
                        </b>
                    </div>

                    <div>
                        الاستقرار:
                        {" "}
                        <b>
                            {num(
                                indicators.stabilityIndex
                            )}
                        </b>
                        {" / 100"}
                    </div>

                    <div>
                        جميع المقارنات الحالية تعتمد على
                        متوسط المبيعات اليومية وليس إجمالي الشهر.
                    </div>
                </div>
            </div>
        </section>
    );
}