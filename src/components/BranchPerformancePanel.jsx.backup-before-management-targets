function n(value) {
    const result = Number(value);

    return Number.isFinite(result)
        ? result
        : 0;
}


function money(value) {
    return n(value).toLocaleString(
        "ar-EG",
        {
            maximumFractionDigits: 0
        }
    );
}


function num(value) {
    return n(value).toLocaleString(
        "ar-EG",
        {
            maximumFractionDigits: 2
        }
    );
}


function pct(value) {
    return `${n(value).toLocaleString(
        "ar-EG",
        {
            maximumFractionDigits: 1
        }
    )}%`;
}


function monthLabel(value) {
    const text =
        String(value || "");

    if (
        !/^\d{4}-\d{2}$/.test(text)
    ) {
        return text;
    }

    const [
        year,
        month
    ] = text.split("-");

    const labels = [
        "يناير",
        "فبراير",
        "مارس",
        "أبريل",
        "مايو",
        "يونيو",
        "يوليو",
        "أغسطس",
        "سبتمبر",
        "أكتوبر",
        "نوفمبر",
        "ديسمبر"
    ];

    return `${labels[
        Number(month) - 1
    ] || month} ${year}`;
}


function scoreText(
    value
) {
    const score =
        n(value);

    if (score >= 80) {
        return "مرتفع";
    }

    if (score >= 60) {
        return "جيد";
    }

    if (score >= 40) {
        return "متوسط";
    }

    return "منخفض";
}


function trendText(
    value
) {
    const growth =
        n(value);

    if (growth > 5) {
        return "نمو";
    }

    if (growth < -5) {
        return "تراجع";
    }

    return "مستقر";
}


