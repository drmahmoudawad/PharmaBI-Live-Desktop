function BranchRankingTable({
    branches,
    mode
}) {
    let sorted =
        Array.isArray(branches)
            ? [
                ...branches
            ]
            : [];

    if (mode === "growth") {
        sorted.sort(
            (
                a,
                b
            ) =>
                n(
                    b.growthPct
                ) -
                n(
                    a.growthPct
                )
        );
    }

    if (mode === "development") {
        sorted.sort(
            (
                a,
                b
