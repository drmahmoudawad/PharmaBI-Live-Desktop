function normalizeSegments(
    result
) {

    const raw =
        result?.summary?.segments;


    if (
        Array.isArray(
            raw
        )
    ) {

        return raw;

    }


    if (
        raw &&
        typeof raw ===
            "object"
    ) {

        return Object.entries(
            raw
        ).map(
            (
                [
                    code,
                    value
                ]
            ) => ({

                code,

                name:
                    value?.name ||
                    value?.segment ||
                    code,

                customers:
                    value?.customers ??
                    value?.count ??
                    value?.customerCount ??
                    0,

                netSales:
                    value?.netSales ??
                    value?.sales ??
                    value?.totalSales ??
                    0,

                priority:
                    value?.priority ??
                    "-"

            })
        );

    }


    const customers =
        Array.isArray(
            result?.customers
        )
            ? result.customers
            : [];


    const grouped =
        new Map();


    for (
        const customer
        of customers
    ) {

        const code =
            String(
                customer?.segmentCode ||
                customer?.segment ||
                "UNCLASSIFIED"
            );


        const name =
            customer?.segmentName ||
            customer?.segment ||
            code;


        if (
            !grouped.has(
                code
            )
        ) {

            grouped.set(
                code,
                {
                    code,

                    name,

                    customers:
                        0,

                    netSales:
                        0
                }
            );

        }


        const row =
            grouped.get(
                code
            );


        row.customers +=
            1;


        row.netSales +=
            n(
                customer?.netSales ??
                customer?.monetary
            );

    }


    return Array.from(
        grouped.values()
    );

}


