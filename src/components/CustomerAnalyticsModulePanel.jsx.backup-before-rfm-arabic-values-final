function getRfmSegmentLabel(
    customer
) {

    const rawCode =
        customer?.segmentCode ??
        customer?.segment_code ??
        customer?.segmentName ??
        customer?.segment ??
        customer?.rfm?.segmentCode ??
        customer?.rfm?.segment_code ??
        customer?.rfm?.segmentName ??
        customer?.rfm?.segment ??
        "";

    const code =
        String(
            rawCode
        )
            .trim()
            .toUpperCase();

    if (
        RFM_SEGMENT_LABELS[code]
    ) {
        return RFM_SEGMENT_LABELS[code];
    }

    if (
        code
    ) {
        return code
            .replace(/_/g, " ")
            .replace(
                /\b\w/g,
                c => c.toUpperCase()
            );
    }

    return "-";
}

function text(
    value
) {

    if (
        value ===
            null ||
        value ===
            undefined ||
        value ===
            ""
    ) {

        return "-";

    }

    return String(
        value
    );

}


function dateOnly(
    value
) {

    if (
        !value
    ) {

        return "-";

    }

    return String(
        value
    ).slice(
        0,
        10
    );

}


