                        rows={products}
                    />

                </div>

            </div>


            <div style={{ marginTop: 18 }}>

                <SectionTitle
                    title="ط£ظپط¶ظ„ ط§ظ„ظ…ظˆط¸ظپظٹظ†"
                    subtitle="طھط±طھظٹط¨ طھظ†ط§ط²ظ„ظٹ ط­ط³ط¨ طµط§ظپظٹ ط§ظ„ظ…ط¨ظٹط¹ط§طھ"
                />

                <MiniTable
                    columns={[
                        {
                            key: "rank",
                            label: "ط§ظ„طھط±طھظٹط¨"
                        },
                        {
