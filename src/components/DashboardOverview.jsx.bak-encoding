            <div className="page-header">

                <div>

                    <div className="page-eyebrow">
                        ظ„ظˆط­ط© ط§ظ„طھط­ظƒظ…
                    </div>

                    <h2>
                        {modeLabel}
                    </h2>

                    <p>
                        ظ…ظ„ط®طµ ظٹظˆظ…ظٹ ظ…ط¨ط§ط´ط± ظ„ظ„ظ…ط¨ظٹط¹ط§طھ ظˆط§ظ„ط¹ظ…ظ„ط§ط، ظˆط§ظ„ط¯ظ„ظٹظپط±ظٹ ظˆط£ظپط¶ظ„ ط§ظ„ط£ط¯ط§ط،ط§طھ.
                    </p>

                </div>

                <div className="period-chip">
                    {fromDate}
                    <span>â†’</span>
                    {toDate}
                </div>

            </div>


            <div className="kpi-grid">

                <div className="kpi-card">
                    <span>ظ…طھظˆط³ط· ط§ظ„ظ…ط¨ظٹط¹ط§طھ ط§ظ„ظٹظˆظ…ظٹ</span>
                    <strong>{money(data?.averageDailySales)}</strong>
                </div>


                <div className="kpi-card">
                    <span>ظ…طھظˆط³ط· ط¹ط¯ط¯ ط§ظ„ط¹ظ…ظ„ط§ط، ط§ظ„ظٹظˆظ…ظٹ</span>
                    <strong>{numeric(data?.averageDailyInvoices)}</strong>
                </div>


                <div className="kpi-card">
                    <span>ظ…طھظˆط³ط· ظ‚ظٹظ…ط© ط§ظ„ط¯ظ„ظٹظپط±ظٹ ط§ظ„ظٹظˆظ…ظٹ</span>
                    <strong>{money(data?.averageDailyDeliverySales)}</strong>
