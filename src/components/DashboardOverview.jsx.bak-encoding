                            render: row =>
                                numeric(
                                    row.averageDailyInvoices
                                )
                        },
                        {
                            key: "customers",
                            label: "ط¹ط¯ط¯ ط§ظ„ط¹ظ…ظ„ط§ط،",
                            render: row =>
                                numeric(
