                        subtitle="ظ…ط±طھط¨ط© طھظ†ط§ط²ظ„ظٹظ‹ط§ ط­ط³ط¨ طµط§ظپظٹ ط§ظ„ظ…ط¨ظٹط¹ط§طھ"
                    />

                    <MiniTable
                        columns={[
                            {
                                key: "itemName",
                                label: "ط§ظ„ظ…ظ†طھط¬"
                            },
                            {
                                key: "units",
                                label: "ط§ظ„ظƒظ…ظٹط©",
                                render: row => numeric(row.units)
                            },
                            {
