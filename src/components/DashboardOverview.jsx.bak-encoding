                <h2>
                    ط¬ط§ط±ظٹ طھط­ظ…ظٹظ„ ظ„ظˆط­ط© ط§ظ„طھط­ظƒظ…...
                </h2>

                <p>
                    ظٹطھظ… ط§ط³طھط®ط¯ط§ظ… ط¨ظٹط§ظ†ط§طھ ط§ظ„ظ…ط¨ظٹط¹ط§طھ ط§ظ„ظ…ط­ظ…ظ„ط© ظˆط§ظ„ظƒط§ط´ ط§ظ„ظ…طھط§ط­.
                </p>

            </section>

        );

    }


    if (error) {

        return (

            <section className="page-card">

                <div className="status error">
                    {error}
                </div>

            </section>

        );

    }


    const modeLabel =
        selectedBranchId === "all"
