
import React, {
    useCallback,
    useEffect,
    useMemo,
    useState
} from "react";


const SHIFTS = [
    {
        code: "MORNING",
        name:
            "\u0627\u0644\u0635\u0628\u0627\u062d\u064a",
        time:
            "09:00 - 17:00"
    },
    {
        code: "EVENING",
        name:
            "\u0627\u0644\u0645\u0633\u0627\u0626\u064a",
        time:
            "17:00 - 02:00"
    },
    {
        code: "NIGHT",
        name:
            "\u0627\u0644\u0644\u064a\u0644\u064a",
        time:
            "02:00 - 09:00"
    }
];


function normalizeEmployees(
    result
) {

    const source =
        Array.isArray(
            result?.employees
        )
            ? result.employees
            : Array.isArray(
                result?.sellers
            )
                ? result.sellers
                : [];

    return source
        .map(
            row => ({
                employeeId:
                    String(
                        row?.employeeId ??
                        row?.employee_id ??
                        row?.sellerId ??
                        ""
                    ).trim(),

                employeeName:
                    String(
                        row?.employeeName ??
                        row?.employee_name ??
                        row?.sellerName ??
                        row?.name ??
                        row?.employeeId ??
                        "-"
                    ).trim()
            })
        )
        .filter(
            row =>
                row.employeeId &&
                row.employeeId !==
                    "UNASSIGNED"
        );
}



function normalizeDateInput(
    value,
    monthStart = false
) {

    const raw =
        String(
            value ?? ""
        ).trim();

    if (
        /^\\d{4}-\\d{2}-\\d{2}/.test(
            raw
        )
    ) {
        return raw.slice(0, 10);
    }

    if (
        value instanceof Date &&
        Number.isFinite(
            value.getTime()
        )
    ) {

        const year =
            value.getFullYear();

        const month =
            String(
                value.getMonth() + 1
            ).padStart(
                2,
                "0"
            );

        const day =
            String(
                value.getDate()
            ).padStart(
                2,
                "0"
            );

        return (
            year +
            "-" +
            month +
            "-" +
            day
        );
    }

    const parsed =
        new Date(
            raw
        );

    if (
        Number.isFinite(
            parsed.getTime()
        )
    ) {

        const year =
            parsed.getFullYear();

        const month =
            String(
                parsed.getMonth() + 1
            ).padStart(
                2,
                "0"
            );

        const day =
            String(
                parsed.getDate()
            ).padStart(
                2,
                "0"
            );

        return (
            year +
            "-" +
            month +
            "-" +
            day
        );
    }

    const now =
        new Date();

    const year =
        now.getFullYear();

    const month =
        String(
            now.getMonth() + 1
        ).padStart(
            2,
            "0"
        );

    const day =
        monthStart
            ? "01"
            : String(
                new Date(
                    year,
                    now.getMonth() + 1,
                    0
                ).getDate()
            ).padStart(
                2,
                "0"
            );

    return (
        year +
        "-" +
        month +
        "-" +
        day
    );
}

export default function EmployeeShiftsPage({
    branchId,
    connection,
    fromDate,
    toDate
}) {

    const normalizedFromDate =
        normalizeDateInput(
            fromDate,
            true
        );

    const normalizedToDate =
        normalizeDateInput(
            toDate,
            false
        );


    const [
        loading,
        setLoading
    ] = useState(true);

    const [
        savingId,
        setSavingId
    ] = useState("");

    const [
        error,
        setError
    ] = useState("");

    const [
        employees,
        setEmployees
    ] = useState([]);

    const [
        assignments,
        setAssignments
    ] = useState({});


    const assignmentMap =
        useMemo(
            () => {

                const map = {};

                for (
                    const row
                    of (
                        Array.isArray(
                            assignments
                        )
                            ? assignments
                            : []
                    )
                ) {

                    map[
                        String(
                            row.employee_id
                        )
                    ] =
                        row.shift_code;

                }

                return map;

            },
            [
                assignments
            ]
        );


    const load =
        useCallback(
            async () => {

                if (
                    branchId ===
                    "all" ||
                    branchId == null
                ) {

                    setEmployees([]);
                    setAssignments([]);
                    setLoading(false);
                    return;

                }

                try {

                    setLoading(true);
                    setError("");

                    const [
                        sellerResult,
                        shiftResult
                    ] =
                        await Promise.all([

                            window
                                .pharmaBI
                                .dashboard
                                .overview({

                                    action:
                                        "seller-overview",

                                    branchId,

                                    fromDate:
                                        normalizedFromDate,

                                    toDate:
                                        normalizedToDate,

                                    connection

                                }),

                            window
                                .pharmaBI
                                .dashboard
                                .overview({

                                    action:
                                        "employee-shift-get",

                                    branchId

                                })

                        ]);


                    setEmployees(
                        normalizeEmployees(
                            sellerResult
                        )
                    );


                    setAssignments(
                        Array.isArray(
                            shiftResult?.assignments
                        )
                            ? shiftResult.assignments
                            : []
                    );

                }
                catch (
                    requestError
                ) {

                    console.error(
                        "[EmployeeShiftsPage] load failed:",
                        requestError
                    );

                    setError(
                        requestError?.message ||
                        "\u062a\u0639\u0630\u0631 \u062a\u062d\u0645\u064a\u0644 \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0645\u0648\u0638\u0641\u064a\u0646."
                    );

                }
                finally {

                    setLoading(false);

                }

            },
            [
                branchId,
                connection,
                fromDate,
                toDate
            ]
        );


    useEffect(
        () => {

            load();

        },
        [load]
    );


    const save =
        async (
            employeeId,
            shiftCode
        ) => {

            try {

                setSavingId(
                    String(
                        employeeId
                    )
                );

                setError("");

                await window
                    .pharmaBI
                    .dashboard
                    .overview({

                        action:
                            "employee-shift-save",

                        branchId,

                        employeeId,

                        shiftCode

                    });


                setAssignments(
                    previous => {

                        const rows =
                            Array.isArray(
                                previous
                            )
                                ? previous.filter(
                                    row =>
                                        String(
                                            row.employee_id
                                        ) !==
                                        String(
                                            employeeId
                                        )
                                )
                                : [];

                        rows.push({

                            branch_id:
                                Number(
                                    branchId
                                ),

                            employee_id:
                                String(
                                    employeeId
                                ),

                            shift_code:
                                shiftCode

                        });

                        return rows;

                    }
                );

            }
            catch (
                requestError
            ) {

                console.error(
                    "[EmployeeShiftsPage] save failed:",
                    requestError
                );

                setError(
                    requestError?.message ||
                    "\u062a\u0639\u0630\u0631 \u062d\u0641\u0638 \u0627\u0644\u0634\u064a\u0641\u062a."
                );

            }
            finally {

                setSavingId("");

            }

        };


    if (
        branchId ===
        "all"
    ) {

        return (
            <section className="page-card">

                <div className="page-header">
                    <div>

                        <div className="page-eyebrow">
                            STAFF SHIFTS
                        </div>

                        <h2>
                            {"\u0634\u064a\u0641\u062a\u0627\u062a \u0627\u0644\u0645\u0648\u0638\u0641\u064a\u0646"}
                        </h2>

                    </div>
                </div>

                <p>
                    {"\u0627\u062e\u062a\u0631 \u0641\u0631\u0639\u064b\u0627 \u0645\u062d\u062f\u062f\u064b\u0627 \u0644\u0625\u062f\u0627\u0631\u0629 \u0634\u064a\u0641\u062a\u0627\u062a \u0627\u0644\u0645\u0648\u0638\u0641\u064a\u0646."}
                </p>

            </section>
        );

    }


    return (
        <section className="page-card">

            <div className="page-header">

                <div>

                    <div className="page-eyebrow">
                        STAFF SHIFTS
                    </div>

                    <h2>
                        {"\u0634\u064a\u0641\u062a\u0627\u062a \u0627\u0644\u0645\u0648\u0638\u0641\u064a\u0646"}
                    </h2>

                    <p>
                        {"\u0644\u0643\u0644 \u0645\u0648\u0638\u0641 \u0634\u064a\u0641\u062a \u0623\u0633\u0627\u0633\u064a \u0648\u0627\u062d\u062f."}
                    </p>

                </div>

            </div>


            {error && (
                <div className="error-card">
                    {error}
                </div>
            )}


            {loading ? (
                <div className="loading-card">
                    <div className="loading-spinner" />
                    <h2>
                        {"\u062c\u0627\u0631\u064a \u062a\u062d\u0645\u064a\u0644 \u0627\u0644\u0645\u0648\u0638\u0641\u064a\u0646..."}
                    </h2>
                </div>
            ) : (
                <div className="table-card">

                    <div className="table-wrap">

                        <table>

                            <thead>

                                <tr>

                                    <th>
                                        {"\u0627\u0644\u0645\u0648\u0638\u0641"}
                                    </th>

                                    <th>
                                        ID
                                    </th>

                                    <th>
                                        {"\u0627\u0644\u0634\u064a\u0641\u062a \u0627\u0644\u0623\u0633\u0627\u0633\u064a"}
                                    </th>

                                    <th>
                                        {"\u0627\u0644\u062d\u0627\u0644\u0629"}
                                    </th>

                                </tr>

                            </thead>

                            <tbody>

                                {employees.length ? (
                                    employees.map(
                                        employee => {

                                            const current =
                                                assignmentMap[
                                                    employee.employeeId
                                                ];

                                            const selected =
                                                current ||
                                                "";

                                            const saving =
                                                savingId ===
                                                employee.employeeId;

                                            return (
                                                <tr
                                                    key={
                                                        employee.employeeId
                                                    }
                                                >

                                                    <td>
                                                        <strong>
                                                            {
                                                                employee.employeeName
                                                            }
                                                        </strong>
                                                    </td>

                                                    <td>
                                                        {
                                                            employee.employeeId
                                                        }
                                                    </td>

                                                    <td>

                                                        <select
                                                            value={
                                                                selected
                                                            }
                                                            disabled={
                                                                saving
                                                            }
                                                            onChange={
                                                                event =>
                                                                    save(
                                                                        employee.employeeId,
                                                                        event.target.value
                                                                    )
                                                            }
                                                            style={{
                                                                minWidth: 210,
                                                                padding: 8,
                                                                borderRadius: 8,
                                                                border: "1px solid rgba(127,127,127,.3)",
                                                                fontFamily: "inherit"
                                                            }}
                                                        >

                                                            <option value="">
                                                                {"\u0627\u062e\u062a\u0631 \u0627\u0644\u0634\u064a\u0641\u062a"}
                                                            </option>

                                                            {SHIFTS.map(
                                                                shift => (
                                                                    <option
                                                                        key={
                                                                            shift.code
                                                                        }
                                                                        value={
                                                                            shift.code
                                                                        }
                                                                    >
                                                                        {
                                                                            shift.name
                                                                        }
                                                                        {"  "}
                                                                        (
                                                                        {
                                                                            shift.time
                                                                        }
                                                                        )
                                                                    </option>
                                                                )
                                                            )}

                                                        </select>

                                                    </td>

                                                    <td>

                                                        {saving ? (
                                                            <span>
                                                                {"\u062c\u0627\u0631\u064a \u0627\u0644\u062d\u0641\u0638..."}
                                                            </span>
                                                        ) : current ? (
                                                            <span>
                                                                {"\u0645\u0631\u062a\u0628\u0637"}
                                                            </span>
                                                        ) : (
                                                            <span>
                                                                {"\u063a\u064a\u0631 \u0645\u062d\u062f\u062f"}
                                                            </span>
                                                        )}

                                                    </td>

                                                </tr>
                                            );

                                        }
                                    )
                                ) : (
                                    <tr>
                                        <td
                                            colSpan={4}
                                        >
                                            {"\u0644\u0627 \u062a\u0648\u062c\u062f \u0628\u064a\u0627\u0646\u0627\u062a \u0645\u0648\u0638\u0641\u064a\u0646 \u0644\u0644\u0641\u062a\u0631\u0629 \u0627\u0644\u0645\u062d\u062f\u062f\u0629."}
                                        </td>
                                    </tr>
                                )}

                            </tbody>

                        </table>

                    </div>

                </div>
            )}

        </section>
    );

}
