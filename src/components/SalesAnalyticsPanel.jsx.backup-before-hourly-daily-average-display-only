import React, {
    useEffect,
    useMemo,
    useState
} from "react";


function getCurrentMonthRange() {

    const now =
        new Date();


    const year =
        now.getFullYear();


    const month =
        String(
            now.getMonth() + 1
        ).padStart(
            2,
            "0"
        );


    const day =
        String(
            now.getDate()
        ).padStart(
            2,
            "0"
        );


    return {

        fromDate:
            `${year}-${month}-01`,

        toDate:
            `${year}-${month}-${day}`

    };

}


function formatMoney(
    value
) {

    return Number(
        value || 0
    ).toLocaleString(
        "en-US",
        {
            minimumFractionDigits:
                2,

            maximumFractionDigits:
                2
        }
    );

}


function formatNumber(
    value
) {

    return Number(
        value || 0
    ).toLocaleString(
        "en-US"
    );

}


function formatDailyTicketCount(
    value
) {

    return toNumber(
        value
    ).toLocaleString(
        "ar-EG",
        {
            minimumFractionDigits:
                1,

            maximumFractionDigits:
                1
        }
    );
}

function formatPercent(
    value
) {

    return `${Number(
        value || 0
    ).toFixed(
        2
    )}%`;

}


function formatMilliseconds(
    value
) {

    const number =
        Number(
            value
        );


    if (
        !Number.isFinite(
            number
        )
    ) {

        return "—";

    }


    return `${number.toLocaleString(
        "en-US",
        {
            maximumFractionDigits:
                0
        }
    )} ms`;

}


function getModuleTitle(
    activeModule
) {

    switch (
        activeModule
    ) {

        case "sales-trend":
            return "اتجاه المبيعات";

        case "sales-day-hour":
            return "Day / Hour";

        case "sales-sellers":
            return "البائعون";

        case "sales-returns":
            return "المرتجعات";

        case "sales-overview":
        default:
            return "نظرة عامة على المبيعات";

    }

}


function normalizeResponseRows(
    result
) {

    if (
        Array.isArray(
            result
        )
    ) {

        return result;

    }


    if (
        Array.isArray(
            result?.rows
        )
    ) {

        return result.rows;

    }


    if (
        Array.isArray(
            result?.days
        )
    ) {

        return result.days;

    }


    if (
        Array.isArray(
            result?.hours
        )
    ) {

        return result.hours;

    }


    return [];

}


function EmptyState(
    {
        title,
        text
    }
) {

    return (

        <div className="empty-state">

            <div className="empty-icon">
                PB
            </div>


            <h2>
                {title}
            </h2>


            <p>
                {text}
            </p>

        </div>

    );

}


/*
 * =========================================================
 * PERFORMANCE RESULT
 * =========================================================
 */

function PerformanceResultCard(
    {
        title,
        elapsed,
        status,
        rows,
        detail
    }
) {

    const isSuccess =
        status ===
        "success";


    return (

        <div
            className="kpi-card"
            style={{
                minHeight:
                    "120px"
            }}
        >

            <span>
                {title}
            </span>


            <strong
                style={{
                    fontSize:
                        "18px"
                }}
            >
                {
                    formatMilliseconds(
                        elapsed
                    )
                }
            </strong>


            <div
                style={{
                    marginTop:
                        "8px",

                    color:
                        isSuccess
                            ? "#166534"
                            : "#991b1b",

                    fontSize:
                        "10px",

                    fontWeight:
                        "700"
                }}
            >

                {
                    isSuccess
                        ? `${formatNumber(
                            rows
                        )} rows`
                        : "FAILED"
                }

            </div>


            {
                detail && (

                    <div
                        style={{
                            marginTop:
                                "5px",

                            color:
                                "#64748b",

                            fontSize:
                                "9px"
                        }}
                    >
                        {
                            detail
                        }
                    </div>

                )
            }

        </div>

    );

}


/*
 * =========================================================
 * SALES ANALYTICS PANEL
 * =========================================================
 */

export default function SalesAnalyticsPanel(
    {
        connectionPayload,
        fromDate:
            externalFromDate = null,
        toDate:
            externalToDate = null,
        activeModule:
            requestedModule = "sales-overview"
    }
) {

    const defaultRange =
        useMemo(
            () =>
                getCurrentMonthRange(),
            []
        );


    const fromDate =
        externalFromDate ||
        defaultRange.fromDate;


    const toDate =
        externalToDate ||
        defaultRange.toDate;


    const activeModule =
        requestedModule ||
        "sales-overview";


    const [
        loading,
        setLoading
    ] =
        useState(
            false
        );


    const [
        error,
        setError
    ] =
        useState(
            ""
        );


    const [
        summary,
        setSummary
    ] =
        useState(
            null
        );


    const [
        dayData,
        setDayData
    ] =
        useState(
            []
        );


    const [
        hourData,
        setHourData
    ] =
        useState(
            []
        );


    const [
        preview,
        setPreview
    ] =
        useState(
            null
        );


    const [
        reconciliation,
        setReconciliation
    ] =
        useState(
            null
        );


    const [
        initialised,
        setInitialised
    ] =
        useState(
            false
        );


    /*
     * =========================================================
     * PERFORMANCE TEST STATE
     * =========================================================
     */

    const [
        performanceLoading,
        setPerformanceLoading
    ] =
        useState(
            false
        );


    const [
        performanceError,
        setPerformanceError
    ] =
        useState(
            ""
        );


    const [
        performanceResult,
        setPerformanceResult
    ] =
        useState(
            null
        );


    const [
        performanceStartedAt,
        setPerformanceStartedAt
    ] =
        useState(
            null
        );


    /*
     * =========================================================
     * REQUEST BUILDER
     * =========================================================
     */

    function buildRequest() {

        if (
            !connectionPayload
        ) {

            throw new Error(
                "بيانات الاتصال غير متاحة."
            );

        }


        if (
            !fromDate ||
            !toDate
        ) {

            throw new Error(
                "نطاق التاريخ غير صالح."
            );

        }


        return {

            ...connectionPayload,

            fromDate,

            toDate

        };

    }


    /*
     * =========================================================
     * LOAD SUMMARY
     * =========================================================
     */

    async function loadSummary() {

        try {

            setLoading(
                true
            );


            setError(
                ""
            );


            const result =
                await window
                    .pharmaBI
                    .sales
                    .summary(
                        buildRequest()
                    );


            setSummary(
                result
            );

        }
        catch (
            requestError
        ) {

            console.error(

                "[SalesAnalyticsPanel] summary failed:",

                requestError

            );


            setError(

                requestError?.message ||
                "فشل تحميل نظرة عامة على المبيعات."

            );

        }
        finally {

            setLoading(
                false
            );

        }

    }


    /*
     * =========================================================
     * LOAD TREND
     * =========================================================
     */

    async function loadTrend() {

        try {

            setLoading(
                true
            );


            setError(
                ""
            );


            const result =
                await window
                    .pharmaBI
                    .sales
                    .byDay(
                        buildRequest()
                    );


            setDayData(

                normalizeResponseRows(
                    result
                )

            );

        }
        catch (
            requestError
        ) {

            console.error(

                "[SalesAnalyticsPanel] trend failed:",

                requestError

            );


            setError(

                requestError?.message ||
                "فشل تحميل اتجاه المبيعات."

            );

        }
        finally {

            setLoading(
                false
            );

        }

    }


    /*
     * =========================================================
     * LOAD DAY / HOUR
     * =========================================================
     */

    async function loadDayHour() {

        try {

            setLoading(
                true
            );


            setError(
                ""
            );


            const request =
                buildRequest();


            const [
                dayResult,
                hourResult
            ] =
            await Promise.all([

                window
                    .pharmaBI
                    .sales
                    .byDay(
                        request
                    ),

                window
                    .pharmaBI
                    .sales
                    .byHour(
                        request
                    )

            ]);


            setDayData(

                normalizeResponseRows(
                    dayResult
                )

            );


            setHourData(
                normalizeResponseRows(
                    hourResult
                ).map(
                    row => {

                        const from =
                            new Date(
                                String(
                                    fromDate
                                ) +
                                "T00:00:00"
                            );

                        const to =
                            new Date(
                                String(
                                    toDate
                                ) +
                                "T00:00:00"
                            );

                        const days =
                            Math.max(
                                1,
                                Math.round(
                                    (
                                        to.getTime() -
                                        from.getTime()
                                    ) /
                                    (
                                        24 *
                                        60 *
                                        60 *
                                        1000
                                    )
                                ) +
                                1
                            );

                        return {
                            ...row,

                            sales:
                                toNumber(
                                    row?.sales
                                ) / days,

                            returns:
                                toNumber(
                                    row?.returns
                                ) / days,

                            netSales:
                                toNumber(
                                    row?.netSales
                                ) / days,

                            cost:
                                toNumber(
                                    row?.cost
                                ) / days,

                            profit:
                                toNumber(
                                    row?.profit
                                ) / days,

                            units:
                                toNumber(
                                    row?.units
                                ) / days,

                            tickets:
                                toNumber(
                                    row?.tickets
                                ) / days
                        };

                    }
                )
            );

        }
        catch (
            requestError
        ) {

            console.error(

                "[SalesAnalyticsPanel] day/hour failed:",

                requestError

            );


            setError(

                requestError?.message ||
                "فشل تحميل Day / Hour."

            );

        }
        finally {

            setLoading(
                false
            );

        }

    }


    /*
     * =========================================================
     * LOAD RETURNS
     * =========================================================
     */

    async function loadالمرتجعات() {

        try {

            setLoading(
                true
            );


            setError(
                ""
            );


            const result =
                await window
                    .pharmaBI
                    .sales
                    .summary(
                        buildRequest()
                    );


            setSummary(
                result
            );

        }
        catch (
            requestError
        ) {

            console.error(

                "[SalesAnalyticsPanel] returns failed:",

                requestError

            );


            setError(

                requestError?.message ||
                "فشل تحميل المرتجعات."

            );

        }
        finally {

            setLoading(
                false
            );

        }

    }


    /*
     * =========================================================
     * SELLERS
     * =========================================================
     */

    async function loadالبائعون() {

        setLoading(
            false
        );


        setError(
            ""
        );

    }


    /*
     * =========================================================
     * LOAD PREVIEW
     * =========================================================
     */

    async function loadPreview() {

        try {

            const result =
                await window
                    .pharmaBI
                    .sales
                    .preview({

                        ...buildRequest(),

                        limit:
                            50

                    });


            setPreview(
                result
            );

        }
        catch (
            requestError
        ) {

            console.error(

                "[SalesAnalyticsPanel] preview failed:",

                requestError

            );


            setPreview(
                null
            );

        }

    }


    /*
     * =========================================================
     * LOAD RECONCILIATION
     * =========================================================
     */

    async function loadReconciliation() {

        try {

            const result =
                await window
                    .pharmaBI
                    .sales
                    .reconciliation(
                        buildRequest()
                    );


            setReconciliation(
                result
            );

        }
        catch (
            requestError
        ) {

            console.error(

                "[SalesAnalyticsPanel] reconciliation failed:",

                requestError

            );


            setReconciliation(
                null
            );

        }

    }


    /*
     * =========================================================
     * PERFORMANCE TEST
     *
     * This uses the existing application APIs only.
     *
     * It does NOT modify cache behavior.
     * It does NOT modify the warm-up.
     * It simply measures how long each request takes.
     * =========================================================
     */

    async function runPerformanceTest() {

        if (
            !connectionPayload
        ) {

            return;

        }


        let request;


        try {

            request =
                buildRequest();

        }
        catch (
            requestError
        ) {

            setPerformanceError(

                requestError?.message ||
                "تعذر بناء طلب اختبار الأداء."

            );


            return;

        }


        const startedAt =
            performance.now();


        setPerformanceLoading(
            true
        );


        setPerformanceError(
            ""
        );


        setPerformanceResult(
            null
        );


        setPerformanceStartedAt(
            new Date().toISOString()
        );


        try {

            console.log(

                "[SalesAnalyticsPanel] PERFORMANCE TEST START",

                {

                    branchId:
                        request.branchId,

                    fromDate:
                        request.fromDate,

                    toDate:
                        request.toDate

                }

            );


            /*
             * -------------------------------------------------
             * 1. Preview
             * -------------------------------------------------
             *
             * Preview is useful because it reads normalized
             * sales rows through the same salesService path.
             */

            const previewStarted =
                performance.now();


            let previewResponse =
                null;


            let previewStatus =
                "success";


            let previewError =
                "";


            try {

                previewResponse =
                    await window
                        .pharmaBI
                        .sales
                        .preview({

                            ...request,

                            limit:
                                1

                        });

            }
            catch (
                previewRequestError
            ) {

                previewStatus =
                    "error";


                previewError =
                    previewRequestError?.message ||
                    String(
                        previewRequestError
                    );

            }


            const previewElapsed =
                performance.now() -
                previewStarted;


            /*
             * -------------------------------------------------
             * 2. Summary
             * -------------------------------------------------
             */

            const summaryStarted =
                performance.now();


            let summaryResponse =
                null;


            let summaryStatus =
                "success";


            let summaryError =
                "";


            try {

                summaryResponse =
                    await window
                        .pharmaBI
                        .sales
                        .summary(
                            request
                        );

            }
            catch (
                summaryRequestError
            ) {

                summaryStatus =
                    "error";


                summaryError =
                    summaryRequestError?.message ||
                    String(
                        summaryRequestError
                    );

            }


            const summaryElapsed =
                performance.now() -
                summaryStarted;


            /*
             * -------------------------------------------------
             * 3. Optional daily endpoint
             * -------------------------------------------------
             *
             * This is intentionally executed after Summary,
             * not in parallel, so we can see its own timing.
             */

            const dayStarted =
                performance.now();


            let dayResponse =
                null;


            let dayStatus =
                "success";


            let dayError =
                "";


            try {

                dayResponse =
                    await window
                        .pharmaBI
                        .sales
                        .byDay(
                            request
                        );

            }
            catch (
                dayRequestError
            ) {

                dayStatus =
                    "error";


                dayError =
                    dayRequestError?.message ||
                    String(
                        dayRequestError
                    );

            }


            const dayElapsed =
                performance.now() -
                dayStarted;


            /*
             * -------------------------------------------------
             * 4. Optional hourly endpoint
             * -------------------------------------------------
             */

            const hourStarted =
                performance.now();


            let hourResponse =
                null;


            let hourStatus =
                "success";


            let hourError =
                "";


            try {

                hourResponse =
                    await window
                        .pharmaBI
                        .sales
                        .byHour(
                            request
                        );

            }
            catch (
                hourRequestError
            ) {

                hourStatus =
                    "error";


                hourError =
                    hourRequestError?.message ||
                    String(
                        hourRequestError
                    );

            }


            const hourElapsed =
                performance.now() -
                hourStarted;


            /*
             * -------------------------------------------------
             * FINAL RESULT
             * -------------------------------------------------
             */

            const totalElapsed =
                performance.now() -
                startedAt;


            const result = {

                branchId:
                    Number(
                        request.branchId
                    ),

                branchName:
                    request.branchName ||
                    null,

                fromDate:
                    request.fromDate,

                toDate:
                    request.toDate,

                totalElapsed,

                preview: {

                    elapsed:
                        previewElapsed,

                    status:
                        previewStatus,

                    rows:

                        Number(
                            previewResponse?.totalRows
                        ) ||

                        Number(
                            previewResponse?.count
                        ) ||

                        Number(
                            previewResponse?.rows?.length
                        ) ||

                        0,

                    error:
                        previewError

                },

                summary: {

                    elapsed:
                        summaryElapsed,

                    status:
                        summaryStatus,

                    rows:
                        Number(
                            summaryResponse?.rows
                        ) || 0,

                    error:
                        summaryError

                },

                byDay: {

                    elapsed:
                        dayElapsed,

                    status:
                        dayStatus,

                    rows:
                        Array.isArray(
                            dayResponse?.days
                        )

                            ? dayResponse.days.length

                            : Array.isArray(
                                dayResponse
                            )

                                ? dayResponse.length

                                : 0,

                    error:
                        dayError

                },

                byHour: {

                    elapsed:
                        hourElapsed,

                    status:
                        hourStatus,

                    rows:
                        Array.isArray(
                            hourResponse?.hours
                        )

                            ? hourResponse.hours.length

                            : Array.isArray(
                                hourResponse
                            )

                                ? hourResponse.length

                                : 0,

                    error:
                        hourError

                }

            };


            setPerformanceResult(
                result
            );


            console.log(

                "[SalesAnalyticsPanel] PERFORMANCE TEST RESULT",

                result

            );

        }
        catch (
            requestError
        ) {

            console.error(

                "[SalesAnalyticsPanel] PERFORMANCE TEST FAILED:",

                requestError

            );


            setPerformanceError(

                requestError?.message ||
                "فشل اختبار الأداء."

            );

        }
        finally {

            setPerformanceLoading(
                false
            );

        }

    }


    /*
     * =========================================================
     * LOAD MODULE DATA
     * =========================================================
     */

    useEffect(
        () => {

            let cancelled =
                false;


            async function loadModule() {

                if (
                    !connectionPayload
                ) {

                    setInitialised(
                        true
                    );


                    return;

                }


                setInitialised(
                    false
                );


                setError(
                    ""
                );


                try {

                    if (
                        activeModule ===
                        "sales-overview"
                    ) {

                        await loadSummary();


                        if (
                            !cancelled
                        ) {

                            await loadReconciliation();


                            await loadPreview();

                        }

                    }
                    else if (
                        activeModule ===
                        "sales-trend"
                    ) {

                        await loadTrend();

                    }
                    else if (
                        activeModule ===
                        "sales-day-hour"
                    ) {

                        await loadDayHour();

                    }
                    else if (
                        activeModule ===
                        "sales-returns"
                    ) {

                        await loadالمرتجعات();

                    }
                    else if (
                        activeModule ===
                        "sales-sellers"
                    ) {

                        await loadالبائعون();

                    }

                }
                catch (
                    requestError
                ) {

                    if (
                        !cancelled
                    ) {

                        setError(

                            requestError?.message ||
                            "فشل تحميل بيانات المبيعات."

                        );

                    }

                }
                finally {

                    if (
                        !cancelled
                    ) {

                        setInitialised(
                            true
                        );

                    }

                }

            }


            loadModule();


            return () => {

                cancelled =
                    true;

            };

        },
        [
            connectionPayload,
            fromDate,
            toDate,
            activeModule
        ]
    );


    /*
     * =========================================================
     * NO CONNECTION
     * =========================================================
     */

    if (
        !connectionPayload
    ) {

        return (

            <section className="page-card">

                <div className="page-eyebrow">
                    SALES
                </div>


                <EmptyState

                    title="لا يوجد اتصال بالفرع"

                    text="اختر فرعًا متصلًا لعرض تحليلات المبيعات."

                />

            </section>

        );

    }


    /*
     * =========================================================
     * LOADING
     * =========================================================
     */

    if (
        !initialised ||
        loading
    ) {

        return (

            <section className="page-card">

                <div className="page-header">

                    <div>

                        <div className="page-eyebrow">
                            SALES ANALYTICS
                        </div>


                        <h2>
                            {
                                getModuleTitle(
                                    activeModule
                                )
                            }
                        </h2>


                        <p>
                            {
                                fromDate
                            }

                            {" → "}

                            {
                                toDate
                            }

                        </p>

                    </div>

                </div>


                <div className="loading-card">

                    <div className="loading-spinner" />


                    <h2>
                        جاري تحميل بيانات المبيعات...
                    </h2>

                </div>

            </section>

        );

    }


    /*
     * =========================================================
     * ERROR
     * =========================================================
     */

    if (
        error
    ) {

        return (

            <section className="page-card">

                <div className="page-eyebrow">
                    SALES ANALYTICS
                </div>


                <div className="status-banner error">

                    {
                        error
                    }

                </div>

            </section>

        );

    }


    /*
     * =========================================================
     * SALES OVERVIEW
     * =========================================================
     */

    if (
        activeModule ===
        "sales-overview"
    ) {

        if (
            !summary
        ) {

            return (

                <section className="page-card">

                    <EmptyState

                        title="لا توجد بيانات"

                        text="لم يتم إرجاع بيانات ملخص المبيعات."

                    />

                </section>

            );

        }


        const reconciliationSummary =
            reconciliation?.summary;


        return (

            <section className="page-card">

                <div className="page-header">

                    <div>

                        <div className="page-eyebrow">
                            SALES ANALYTICS
                        </div>


                        <h2>
                            نظرة عامة على المبيعات
                        </h2>


                        <p>
                            نظرة تنفيذية على أداء المبيعات خلال الفترة المحددة.
                        </p>

                    </div>


                    <div
                        style={{
                            display:
                                "flex",

                            flexDirection:
                                "column",

                            alignItems:
                                "flex-end",

                            gap:
                                "8px"
                        }}
                    >

                        <div className="period-chip">

                            {
                                fromDate
                            }

                            <span>
                                →
                            </span>

                            {
                                toDate
                            }

                        </div>


                        <button

                            type="button"

                            className="primary-button"

                            onClick={
                                runPerformanceTest
                            }

                            disabled={
                                performanceLoading
                            }

                            style={{
                                minWidth:
                                    "190px"
                            }}

                        >

                            {
                                performanceLoading

                                    ? "جاري قياس الأداء..."

                                    : "اختبار أداء قاعدة البيانات"

                            }

                        </button>

