function normalizeStatusPayload(
    payload
) {
    if (
        !payload ||
        typeof payload !== "object"
    ) {
        return {};
    }

    return payload;
}


function getEventPayload(
    first,
    second
) {
    return (
        second !== undefined
            ? second
            : first
    );
}


function statusLabel(
    status
) {
    switch (
        String(
            status ||
            ""
        ).toLowerCase()
    ) {
        case "ready":
        case "connected":
            return "ظ…طھطµظ„";

        case "connecting":
        case "initializing":
            return "ط¬ط§ط±ظچ ط§ظ„ط§طھطµط§ظ„";

        case "authenticated":
            return "طھظ… ط§ظ„طھط­ظ‚ظ‚";

        case "error":
        case "auth_failure":
            return "ط®ط·ط£";

        case "disconnected":
        default:
            return "ط؛ظٹط± ظ…طھطµظ„";
    }
}


function statusTone(
    status
) {
    switch (
        String(
            status ||
            ""
        ).toLowerCase()
    ) {
        case "ready":
        case "connected":
            return {
                background: "rgba(34,197,94,0.12)",
                border: "rgba(34,197,94,0.35)",
                color: "#86efac"
            };

        case "connecting":
        case "initializing":
        case "authenticated":
            return {
                background: "rgba(56,189,248,0.12)",
                border: "rgba(56,189,248,0.35)",
                color: "#7dd3fc"
            };

        case "error":
        case "auth_failure":
            return {
                background: "rgba(239,68,68,0.12)",
                border: "rgba(239,68,68,0.35)",
                color: "#fca5a5"
            };

        default:
            return {
                background: "rgba(148,163,184,0.10)",
                border: "rgba(148,163,184,0.25)",
                color: "#cbd5e1"
            };
    }
}


