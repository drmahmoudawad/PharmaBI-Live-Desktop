$files =
    Get-ChildItem `
        -LiteralPath $sourceRoot `
        -Recurse `
        -File `
        -Include *.js,*.jsx,*.ts,*.tsx,*.html

$changedFiles = 0
$totalReplacements = 0

foreach ($file in $files) {

    $relative =
        $file.FullName.Substring(
            $sourceRoot.Length
        ).TrimStart('\')

    $backupPath =
        Join-Path `
            $backupRoot `
            $relative

    $backupDir =
        Split-Path `
            -Parent `
            $backupPath

    New-Item `
        -ItemType Directory `
        -Path $backupDir `
        -Force |
        Out-Null

    $original =
        [System.IO.File]::ReadAllText(
            $file.FullName
        )

    $text = $original
    $fileReplacements = 0

    foreach ($pair in $map.GetEnumerator()) {

        $english =
            [regex]::Escape(
                $pair.Key
            )

        $arabic =
            $pair.Value

        # 1) UI object properties:
        # title, label, placeholder, aria-label, alt,
        # helperText, emptyText, buttonLabel, header,
        # caption, description, message, tooltip
        $patterns = @(

            "(?i)(\b(?:title|label|placeholder|aria-label|alt|helperText|emptyText|buttonLabel|header|caption|description|message|tooltip)\s*:\s*)(['""])" +
            $english +
            "\2",

            "(?i)(<(?:Typography|Button|MenuItem|Tab|TableCell|FormLabel|InputLabel|DialogTitle|DialogContentText|Chip|Tooltip|Alert)\b[^>]*>\s*)" +
            $english +
            "(\s*</)",

            ">(\s*)" +
            $english +
            "(\s*<)"
        )

        foreach ($pattern in $patterns) {

            $before =
                $text

            if ($pattern -like "*`2*") {

                $text =
                    [regex]::Replace(
                        $text,
                        $pattern,
                        {
                            param($m)
                            $m.Groups[1].Value +
                            $m.Groups[2].Value +
                            $arabic +
                            $m.Groups[2].Value
                        }
                    )

            }
            else {

                $text =
                    [regex]::Replace(
                        $text,
                        $pattern,
                        {
                            param($m)

                            if ($m.Groups.Count -ge 3) {
                                return (
                                    $m.Groups[1].Value +
                                    $arabic +
                                    $m.Groups[2].Value
                                )
                            }

                            return $m.Value
                        }
                    )
            }

            if ($text -ne $before) {
                $fileReplacements++
            }
        }

        # 2) Common quoted values only when they are used as a direct
        # UI label/value in JSX or configuration objects.
        $quotedPatterns = @(
            "(['""])" + $english + "\1(?=\s*(?:,|}|\]))",
            "(['""])" + $english + "\1(?=\s*[,}])"
        )

        foreach ($pattern in $quotedPatterns) {

            $before = $text

            $text =
                [regex]::Replace(
                    $text,
                    $pattern,
                    {
                        param($m)
                        $m.Groups[1].Value +
                        $arabic +
                        $m.Groups[1].Value
                    }
                )

            if ($text -ne $before) {
                $fileReplacements++
            }
        }
    }

    if ($text -ne $original) {

        Copy-Item `
            -LiteralPath $file.FullName `
            -Destination $backupPath `
            -Force

        [System.IO.File]::WriteAllText(
            $file.FullName,
            $text,
            (New-Object System.Text.UTF8Encoding($false))
        )

        $changedFiles++
        $totalReplacements += $fileReplacements

        Write-Host `
            "UPDATED: $relative" `
            -ForegroundColor Green
    }
}

